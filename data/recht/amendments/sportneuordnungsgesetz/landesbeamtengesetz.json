      "expectedMatches": 1,
      "value": {
        "type": "paragraph",
        "label": "§ 96a",
        "title": "Sportförderstellen“.",
        "children": [
          {
            "type": "item",
            "label": "2.",
            "text": "Nach § 96 wird folgender § 96a eingefügt:",
            "level": 0,
            "listId": "tdn98xp7yz3c",
            "numberingStyle": "decimal",
            "children": [
              {
                "type": "quotedProvision",
                "children": [
                  {
                    "type": "paragraph",
                    "label": "§ 96a",
                    "title": "Sportförderstellen",
                    "children": [
                      {
                        "type": "subparagraph",
                        "label": "(1)",
                        "text": "Beamten kann im dienstlichen Interesse ermöglicht werden, eine Tätigkeit im öffentlichen Dienst mit leistungssportlichem Training und Wettkampf zu verbinden.",
                        "children": []
                      },
                      {
                        "type": "subparagraph",
                        "label": "(2)",
                        "text": "Die Bewilligung setzt voraus, dass",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "1.",
                        "text": "eine Kaderzugehörigkeit nach § 19 des Ostdeutschen Sportfördergesetzes besteht,",
                        "level": 0,
                        "listId": "19fa2z9gm6tf",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "2.",
                        "text": "die Dienstleistung in angemessenem Umfang tatsächlich erbracht wird,",
                        "level": 0,
                        "listId": "19fa2z9gm6tf",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "3.",
                        "text": "dienstliche Belange nicht entgegenstehen,",
                        "level": 0,
                        "listId": "19fa2z9gm6tf",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "4.",
                        "text": "die Antidoping-, Schutz- und Integritätsanforderungen eingehalten werden.",
                        "level": 0,
                        "listId": "19fa2z9gm6tf",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "subparagraph",
                        "label": "(3)",
                        "text": "Zur Vereinbarkeit von Dienst, Training und Wettkampf kann eine Freistellung von bis zu 80 Prozent der regelmäßigen Arbeitszeit bewilligt werden.",
                        "children": []
                      },
                      {
                        "type": "subparagraph",
                        "label": "(4)",
                        "text": "Nach Beendigung der sportlichen Laufbahn ist eine der Laufbahn, Ausbildung und Befähigung entsprechende Verwendung vorzusehen.",
                        "children": []
                      },
                      {
                        "type": "subparagraph",
                        "label": "(5)",
                        "text": "Die Staatsregierung wird ermächtigt, durch Rechtsverordnung das Nähere zu regeln über",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "1.",
                        "text": "Voraussetzungen der Bewilligung,",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "2.",
                        "text": "Umfang der Freistellung,",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "3.",
                        "text": "Dienstleistungspflichten,",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "4.",
                        "text": "Rückkehr in die reguläre Verwendung,",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "5.",
                        "text": "Widerruf der Bewilligung und",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      },
                      {
                        "type": "item",
                        "label": "6.",
                        "text": "Verfahren und Zuständigkeiten.”",
                        "level": 0,
                        "listId": "d8cj7s91pdu9",
                        "numberingStyle": "decimal",
                        "children": []
                      }
                    ]
                  }
                ]
              }
            ]
          }
        ]
      },
      "source": "Gesetze/OGVBl.2026Nr.68.html",
      "sourceProvision": "Artikel 10 Nummer 2",
