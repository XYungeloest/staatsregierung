        "children": [
          {
            "type": "subparagraph",
            "label": "(1)",
            "text": "Der Freistaat Sachsen unterhält für den Polizeivollzugsdienst folgende Polizeidienststellen:",
            "children": []
          },
          {
            "type": "item",
            "label": "1.",
            "text": "das Landespolizeipräsidium im Staatsministerium des Innern,",
            "level": 0,
            "numberingStyle": "decimal",
            "children": []
          },
          {
            "type": "item",
            "label": "2.",
            "text": "das Landeskriminalamt,",
            "level": 0,
            "numberingStyle": "decimal",
            "children": []
          },
          {
            "type": "item",
            "label": "3.",
            "text": "das Polizeiverwaltungsamt,",
            "level": 0,
            "numberingStyle": "decimal",
            "children": []
          },
          {
            "type": "item",
            "label": "4.",
            "text": "das Präsidium der Bereitschaftspolizei,",
            "level": 0,
            "numberingStyle": "decimal",
            "children": []
          },
          {
            "type": "item",
            "label": "5.",
            "text": "die Kasernierte Grenzpolizei und",
