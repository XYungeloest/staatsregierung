{
  "name": "ostrecht-portal",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "content:check": "node scripts/import-normen.mjs --source-dir Gesetze --strict --quiet && node scripts/check-content.mjs",
    "norms:audit": "node scripts/import-normen.mjs --source-dir Gesetze",
    "norms:import": "node scripts/import-normen.mjs --source-dir Gesetze",
    "test:parser": "node --test tests/norm-html-parser.test.mjs tests/norm-markdown-parser.test.mjs tests/import-audit.test.mjs",
    "kreisreform:prepare": "node scripts/prepare-kreisreform-map.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "check": "astro check",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "build": "astro build && node scripts/stamp-build.mjs",
    "links:check": "npm run build && node scripts/check-links.mjs",
    "seo:check": "npm run build && node scripts/check-seo.mjs",
    "test:links": "npm run links:check",
    "test:seo": "npm run seo:check",
    "test:visual": "npm run build && playwright test tests/visual.spec.ts",
    "test:visual:update": "npm run build && playwright test tests/visual.spec.ts --update-snapshots",
    "test:a11y": "npm run build && playwright test tests/accessibility.spec.ts",
    "test:quality": "npm run build && playwright test tests/quality.spec.ts --config=playwright.quality.config.ts --project=chromium",
    "test:browsers": "npm run build && playwright test tests/browser-smoke.spec.ts --config=playwright.quality.config.ts",
    "preview": "astro preview",
    "deploy": "wrangler deploy",
    "deploy:staging": "wrangler deploy --env staging",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^6.1.5",
    "leaflet": "^1.9.4",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/cloudflare": "^13.1.10",
    "@axe-core/playwright": "^4.11.3",
    "@playwright/test": "^1.61.0",
    "@types/leaflet": "^1.9.21",
    "@types/node": "^25.6.0",
    "polygon-clipping": "^0.15.7",
    "wrangler": "^4.83.0"
  }
}
