{
  "name": "ostrecht-portal",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "public:portal": "npm run public --workspace @ostrecht/portal",
    "public:recht": "npm run public --workspace @ostrecht/recht",
    "dev": "npm run dev --workspace @ostrecht/portal",
    "dev:portal": "npm run dev",
    "dev:recht": "npm run dev --workspace @ostrecht/recht",
    "content:check": "npm run holdings:check && node scripts/import-normen.mjs --source-dir Gesetze --strict --quiet && node scripts/revosax-snapshot.mjs audit && node scripts/audit-consolidation.mjs --check && node --experimental-strip-types scripts/check-organization.ts && node scripts/check-content.mjs && node scripts/audit-norm-metadata.mjs && node scripts/check-topic-coverage.mjs && node scripts/knowledge.mjs check",
    "knowledge:check": "node scripts/knowledge.mjs check",
    "knowledge:build": "node scripts/knowledge.mjs build && npm run holdings:build",
    "holdings:build": "node scripts/build-public-holdings.mjs",
    "holdings:check": "node scripts/build-public-holdings.mjs --check",
    "norms:audit": "node scripts/import-normen.mjs --source-dir Gesetze",
    "norms:metadata:audit": "node scripts/audit-norm-metadata.mjs",
    "norms:workflow": "node scripts/norm-workflow.mjs",
    "norms:import": "node scripts/import-normen.mjs --source-dir Gesetze",
    "norms:consolidation:audit": "node scripts/audit-consolidation.mjs",
    "norms:revosax:audit": "node scripts/revosax-snapshot.mjs audit",
    "norms:revosax:fetch": "node scripts/revosax-snapshot.mjs fetch",
    "norms:revosax:parse": "node scripts/revosax-snapshot.mjs parse",
    "norms:revosax:materialize": "node scripts/materialize-revosax-norms.mjs",
    "norms:publications:pdf-sync": "node scripts/sync-publication-pdfs.mjs",
    "norms:corrections:apply": "node scripts/apply-corrections.mjs",
    "norms:consolidate": "node scripts/consolidate-norms.mjs",
    "norms:alt-sources:build": "node scripts/build-alt-source-transcriptions.mjs",
    "norms:alt-sources:migrate": "node scripts/migrate-alt-sources.mjs",
    "test:parser": "node --test tests/norm-html-parser.test.mjs tests/norm-markdown-parser.test.mjs tests/import-audit.test.mjs tests/revosax-parser.test.mjs",
    "kreisreform:prepare": "node scripts/prepare-kreisreform-map.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "check:portal": "npm run check --workspace @ostrecht/portal",
    "check:recht": "npm run check --workspace @ostrecht/recht",
    "check": "npm run check:portal && npm run check:recht",
    "test:unit": "node --experimental-strip-types --test tests/*.test.ts tests/*.test.mjs",
    "build:portal": "npm run build --workspace @ostrecht/portal",
    "build:recht": "npm run build --workspace @ostrecht/recht",
    "build": "npm run build:portal && npm run build:recht && npm run deploy:assets:check",
    "links:check": "npm run build && npm run test:links:run",
    "seo:check": "npm run build && npm run test:seo:run",
    "test:links": "npm run links:check",
    "test:links:run": "node scripts/check-links.mjs",
    "test:seo": "npm run seo:check",
    "test:seo:run": "node scripts/check-seo.mjs",
    "test:visual": "npm run build && npm run test:visual:run",
    "test:visual:run": "playwright test tests/visual.spec.ts",
    "test:visual:update": "npm run build && playwright test tests/visual.spec.ts --update-snapshots",
    "test:a11y": "npm run build && npm run test:a11y:run",
    "test:a11y:run": "playwright test tests/accessibility.spec.ts",
    "test:a11y:ci": "playwright test tests/accessibility.spec.ts --project=desktop-wide --project=mobile-390",
    "test:quality": "npm run build && npm run test:quality:run",
    "test:quality:run": "playwright test tests/quality.spec.ts --config=playwright.quality.config.ts --project=chromium",
    "test:browsers": "npm run build && npm run test:browsers:run",
    "test:browsers:run": "playwright test tests/browser-smoke.spec.ts --config=playwright.quality.config.ts",
    "test:browsers:ci": "playwright test tests/browser-smoke.spec.ts --config=playwright.quality.config.ts --project=chromium",
    "preview": "npm run preview:portal",
    "preview:portal": "npm run preview --workspace @ostrecht/portal",
    "preview:recht": "npm run preview --workspace @ostrecht/recht",
    "deploy": "npm run deploy:recht && npm run deploy:portal",
    "deploy:assets:check": "node scripts/check-deploy-assets.mjs",
    "deploy:portal": "npm run deploy --workspace @ostrecht/portal",
    "deploy:recht": "npm run deploy --workspace @ostrecht/recht",
    "deploy:staging": "npm run deploy:recht:staging && npm run deploy:portal:staging",
    "deploy:portal:staging": "npm run deploy:staging --workspace @ostrecht/portal",
    "deploy:recht:staging": "npm run deploy:staging --workspace @ostrecht/recht",
    "test:deployment": "node --test tests/deployment-smoke.test.mjs",
    "test:deployment:production": "node scripts/check-deployment.mjs",
    "editorial:dev": "npm run dev --workspace @ostrecht/redaktion",
    "editorial:check": "npm run check --workspace @ostrecht/redaktion",
    "editorial:deploy": "npm run deploy --workspace @ostrecht/redaktion"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^25.9.5",
    "polygon-clipping": "^0.15.7"
  }
}
