{
  "name": "ostrecht-portal",
  "type": "module",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "public:portal": "npm run public --workspace @ostrecht/portal",
    "public:recht": "npm run public --workspace @ostrecht/recht",
    "dev": "npm run dev --workspace @ostrecht/portal",
    "dev:portal": "npm run dev",
    "dev:recht": "npm run dev --workspace @ostrecht/recht",
    "content:check": "npm run holdings:check && node scripts/import-normen.mjs --source-dir Gesetze --strict --quiet && node scripts/revosax-snapshot.mjs audit && node scripts/audit-consolidation.mjs --check && node --experimental-strip-types scripts/check-organization.ts && node scripts/check-content.mjs && node scripts/audit-norm-metadata.mjs && node --experimental-strip-types scripts/audit-norm-derivations.ts && node scripts/audit-ost-residuals.mjs --quiet && node scripts/check-topic-coverage.mjs && node scripts/knowledge.mjs check",
    "knowledge:check": "node scripts/knowledge.mjs check",
    "docs:check": "node scripts/check-docs.mjs",
    "knowledge:build": "node scripts/knowledge.mjs build && npm run holdings:build",
    "holdings:build": "node scripts/build-public-holdings.mjs",
    "holdings:check": "node scripts/build-public-holdings.mjs --check",
    "norms:audit": "node scripts/import-normen.mjs --source-dir Gesetze",
    "norms:metadata:audit": "node scripts/audit-norm-metadata.mjs",
    "norms:workflow": "node scripts/norm-workflow.mjs",
    "norms:import": "node scripts/import-normen.mjs --source-dir Gesetze",
    "norms:consolidation:audit": "node scripts/audit-consolidation.mjs",
    "norms:revosax:audit": "node scripts/revosax-snapshot.mjs audit",
    "norms:revosax:fetch": "node scripts/revosax-snapshot.mjs fetch",
    "norms:revosax:parse": "node scripts/revosax-snapshot.mjs parse",
    "norms:revosax:materialize": "node scripts/materialize-revosax-norms.mjs",
    "norms:revosax:discover-baseline": "node scripts/revosax-discover-baseline.mjs",
    "norms:revosax:stage-baseline": "node scripts/revosax-stage-baseline.mjs",
    "norms:revosax:plan-materialization": "node scripts/plan-revosax-materialization.mjs",
    "norms:revosax:materialize-baseline": "node --experimental-strip-types scripts/materialize-revosax-baseline.mjs",
    "norms:revosax:r2-upload": "node scripts/upload-revosax-r2.mjs",
    "norms:revosax:classify-envelopes": "node scripts/classify-revosax-envelopes.mjs",
    "norms:revosax:archive-attachments": "node scripts/archive-revosax-attachments.mjs",
    "norms:revosax:import-audit": "node scripts/build-revosax-import-audit.mjs",
    "norms:ost:residual-audit": "node scripts/audit-ost-residuals.mjs",
    "norms:runtime:d1-sync": "node --experimental-strip-types scripts/sync-recht-d1.mjs",
    "norms:runtime:d1-local": "node scripts/serve-law-worker.mjs --seed-only",
    "norms:runtime:d1-seed": "node --experimental-strip-types scripts/d1-runtime-seed.mjs ensure",
    "norms:runtime:d1-seed-fingerprint": "node --experimental-strip-types scripts/d1-runtime-seed.mjs fingerprint",
    "norms:runtime:d1-verify": "node --experimental-strip-types scripts/verify-recht-d1.mjs",
    "norms:runtime:d1-closure": "node --experimental-strip-types scripts/d1-projection-snapshot.mjs closure",
    "norms:runtime:d1-prove": "node --experimental-strip-types scripts/d1-projection-snapshot.mjs prove",
    "norms:runtime:d1-write-probe": "node scripts/d1-write-probe.mjs",
    "norms:advance-reference-date": "node scripts/advance-reference-date.mjs",
    "norms:migrate-origin-bodies": "node --experimental-strip-types scripts/migrate-saxon-enacting-body.mjs",
    "norms:publications:pdf-sync": "node scripts/sync-publication-pdfs.mjs",
    "norms:corrections:apply": "node scripts/apply-corrections.mjs",
    "norms:consolidate": "node scripts/consolidate-norms.mjs",
    "norms:alt-sources:build": "node scripts/build-alt-source-transcriptions.mjs",
    "norms:alt-sources:migrate": "node scripts/migrate-alt-sources.mjs",
    "test:parser": "node --test tests/norm-html-parser.test.mjs tests/norm-markdown-parser.test.mjs tests/import-normen-cli.test.mjs tests/revosax-parser.test.mjs",
    "kreisreform:prepare": "node scripts/prepare-kreisreform-map.mjs",
    "images:generate": "node scripts/generate-responsive-images.mjs",
    "check:portal": "npm run check --workspace @ostrecht/portal",
    "check:recht": "npm run check --workspace @ostrecht/recht",
    "check": "npm run check:portal && npm run check:recht",
    "test:fast": "node --experimental-strip-types --max-old-space-size=4096 --test tests/*.test.ts tests/*.test.mjs",
    "test:corpus": "node --experimental-strip-types --max-old-space-size=4096 --test tests/corpus/*.test.ts tests/corpus/*.test.mjs",
    "test:unit": "node --experimental-strip-types --max-old-space-size=4096 --test tests/*.test.ts tests/*.test.mjs tests/corpus/*.test.ts tests/corpus/*.test.mjs",
    "test:pr": "OSTRECHT_D1_FIXTURE=data/recht/runtime-fixture.json npm run test:pr:checks",
    "test:pr:checks": "npm run check && npm run test:fast && npm run build && npm run test:pr:run",
    "test:pr:run": "npm run test:links:run && npm run test:seo:run && npm run test:a11y:ci && npm run test:browsers:ci && npm run test:visual:critical",
    "test:full": "npm run docs:check && npm run content:check && npm run check && npm run test:unit && npm run build && npm run test:full:run",
    "test:full:run": "npm run test:links:run && npm run test:seo:run && npm run test:a11y:run && npm run test:browsers:run && npm run test:visual:extended",
    "build:portal": "npm run build --workspace @ostrecht/portal",
    "build:recht": "npm run build --workspace @ostrecht/recht",
    "build": "npm run build:portal && npm run build:recht && npm run deploy:assets:check",
    "links:check": "npm run build && npm run test:links:run",
    "seo:check": "npm run build && npm run test:seo:run",
    "test:links": "npm run links:check",
    "test:links:run": "node scripts/check-links.mjs",
    "test:seo": "npm run seo:check",
    "test:seo:run": "node scripts/check-seo.mjs",
    "test:visual": "npm run build && npm run test:visual:extended",
    "test:visual:critical": "OSTRECHT_VISUAL_SUITE=critical playwright test tests/visual.spec.ts --grep @critical --project=desktop-wide --project=tablet --project=mobile-390",
    "test:visual:extended": "playwright test tests/visual.spec.ts --project=desktop-wide --project=tablet --project=mobile-390",
    "test:visual:update:linux": "node scripts/visual-baselines.mjs update",
    "test:visual:baselines:apply": "node scripts/visual-baselines.mjs apply",
    "test:a11y": "npm run build && npm run test:a11y:run",
    "test:a11y:run": "playwright test tests/accessibility.spec.ts",
    "test:a11y:ci": "playwright test tests/accessibility.spec.ts --project=desktop-wide --project=mobile-390",
    "test:browsers": "npm run build && npm run test:browsers:run",
    "test:browsers:run": "playwright test tests/browser-smoke.spec.ts tests/holdings-navigator.spec.ts --config=playwright.quality.config.ts",
    "test:browsers:ci": "playwright test tests/browser-smoke.spec.ts tests/holdings-navigator.spec.ts --config=playwright.quality.config.ts --project=chromium",
    "preview": "npm run preview:portal",
    "preview:portal": "npm run preview --workspace @ostrecht/portal",
    "preview:recht": "npm run preview --workspace @ostrecht/recht",
    "deploy": "npm run deploy:recht && npm run deploy:portal",
    "deploy:assets:check": "node scripts/check-deploy-assets.mjs",
    "deploy:portal": "npm run deploy --workspace @ostrecht/portal",
    "deploy:recht": "npm run deploy --workspace @ostrecht/recht",
    "deploy:staging": "npm run deploy:recht:staging && npm run deploy:portal:staging",
    "deploy:portal:staging": "npm run deploy:staging --workspace @ostrecht/portal",
    "deploy:recht:staging": "npm run deploy:staging --workspace @ostrecht/recht",
    "test:deployment": "node --test tests/deployment-smoke.test.mjs",
    "test:deployment:production": "node scripts/check-deployment.mjs"
  },
  "dependencies": {
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.4.1",
    "esbuild": "^0.28.2",
    "polygon-clipping": "^0.15.7"
  }
}
