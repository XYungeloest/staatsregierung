{
  "versionId": "2026-07-21",
  "validFrom": "2026-07-21",
  "validTo": null,
  "isCurrent": true,
  "citation": "Gesetz vom 20. Juli 2026 (OGVBl. 2026 Nr. 52)",
  "changeNote": "Eingeführte Stammfassung.",
  "body": [
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Begriffbestimmungen",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Dieses Gesetz gilt für die Förderung, soziale Absicherung, Versorgung und Übergangsförderung von Kaderathlet:innen des Freistaates Ostdeutschland.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Kaderathlet:innen im Sinne dieses Gesetzes sind Athlet:innen, die einem Kader nach § 19 des Ostdeutschen Sportfördergesetzes angehören.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Die Förderung nach diesem Gesetz setzt einen Fördervertrag voraus, soweit dieses Gesetz nichts anderes bestimmt.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Monatliche Kaderförderung",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen erhalten nach Maßgabe des Haushaltsplans und der Rechtsverordnung nach § 15 eine monatliche Kaderförderung.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Die monatliche Kaderförderung beträgt mindestens",
          "children": []
        },
        {
          "type": "item",
          "label": "1.",
          "text": "400 Euro für den Jugend-Landeskader,",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "1 000 Euro für den Landeskader,",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "1 500 Euro für den Anschlusskader,",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "2 500 Euro für den Perspektivkader Ost,",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "3 500 Euro für den Olympiakader Ost und",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "5 500 Euro für den Medaillenkader Ost.",
          "level": 0,
          "listId": "zi958s9uvitl",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Höhere Förderbeträge können durch Rechtsverordnung festgesetzt werden.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 3",
      "title": "Athletenversorgungswerk Ost",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Freistaat errichtet bei der Landesagentur Spitzensport Ost das Athletenversorgungswerk Ost.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Das Athletenversorgungswerk Ost dient der zusätzlichen sozialen Absicherung von Kaderathlet:innen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Es gewährt insbesondere",
          "children": []
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Zuschüsse zur Altersvorsorge,",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "erweiterten Unfallversicherungsschutz,",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Zuschüsse zu einer Berufsunfähigkeitsabsicherung,",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Rehabilitationsleistungen nach sportbedingten Verletzungen,",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "psychologische Betreuung während und nach der sportlichen Laufbahn,",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Leistungen aus einem Karriereausstiegsfonds.",
          "level": 0,
          "listId": "ewk7fv6eqabo",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(4)",
          "text": "Leistungen werden nach Maßgabe der Satzung des Athletenversorgungswerks und der verfügbaren Mittel gewährt.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 4",
      "title": "Altersvorsorge",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen ab dem Perspektivkader Ost erhalten einen monatlichen Zuschuss zur zusätzlichen Altersvorsorge.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der Zuschuss beträgt mindestens 500 Euro monatlich.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Für Medaillenkader Ost kann der Zuschuss durch Rechtsverordnung erhöht werden.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 5",
      "title": "Unfallversicherung und Berufsunfähigkeitsabsicherung",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen sind für sportbedingte Unfälle im Zusammenhang mit Training, Wettkampf, Trainingslager und An- und Abreise zusätzlich abzusichern.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Ab dem Anschlusskader wird eine zusätzliche Berufsunfähigkeitsabsicherung gefördert.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Das Nähere regelt die Landesagentur Spitzensport Ost in der Satzung des Athletenversorgungswerks.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 6",
      "title": "Rehabilitationsleistungen",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen haben bei sportbedingten Verletzungen Anspruch auf Beratung über geeignete Rehabilitationsmaßnahmen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Zuschüsse zu Rehabilitationsmaßnahmen können gewährt werden, soweit andere Leistungsträger nicht vorrangig verpflichtet sind.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 7",
      "title": "Karriereausstiegsfonds",
      "children": [
        {
          "type": "paragraphText",
          "text": "Bei dem Athletenversorgungswerk Ost wird ein Karriereausstiegsfonds eingerichtet."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 8",
      "title": "Wohnraumleistungen",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen ab dem Anschlusskader können Wohnraumleistungen erhalten.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Minderjährige Kaderathlet:innen dürfen nur in Einrichtungen untergebracht werden, die ein pädagogisches Schutzkonzept vorhalten.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 9",
      "title": "Landessportticket",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Kaderathlet:innen erhalten ein Landessportticket für den öffentlichen Personennahverkehr im Freistaat Ostdeutschland.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Das Landessportticket dient der Erreichbarkeit von Schule, Ausbildung, Studium, Training, Wettkampf, Stützpunkt und sportmedizinischer Betreuung.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 10",
      "title": "Studien- und Ausbildungsgarantie",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Freistaat wirkt darauf hin, dass Kaderathlet:innen Ausbildung, Studium und Sport vereinbaren können.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Landesbehörden, landesunmittelbare juristische Personen des öffentlichen Rechts und landeseigene Unternehmen sollen Ausbildungsplätze für Kaderathlet:innen bereitstellen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Hochschulen berücksichtigen die besondere Situation von Kaderathlet:innen nach Maßgabe des Hochschulrechts.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 11",
      "title": "Rückkehr und Berufseinstieg",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Inhaber von Sportförderstellen haben nach Beendigung der sportlichen Laufbahn Anspruch auf Rückkehr in eine ihrer Ausbildung und Befähigung entsprechende Verwendung.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der Anspruch nach Absatz 1 besteht nicht, wenn schwerwiegende dienstliche Gründe entgegenstehen.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 12",
      "title": "Ausschluss und Rückforderung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Rückforderungen gegenüber Minderjährigen sind ausgeschlossen, soweit der/die Minderjährige den Rückforderungstatbestand nicht selbst vorsätzlich verursacht hat."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 13",
      "title": "Verordnungsermächtigung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Staatsregierung wird ermächtigt, durch Rechtsverordnung das Nähere zu regeln über"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Förderstufen,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Förderbeträge,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Nachweise,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Förderverträge,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "Altersvorsorgezuschüsse,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Unfall- und Berufsunfähigkeitsabsicherung,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "7.",
          "text": "Wohnraumleistungen,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "8.",
          "text": "Landessportticket,",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "9.",
          "text": "Karriereausstiegsfonds und",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "10.",
          "text": "Ausschluss und Rückforderung.",
          "level": 0,
          "listId": "qzocwjgcemq5",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
