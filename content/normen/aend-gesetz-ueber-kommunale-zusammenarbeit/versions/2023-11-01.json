  "body": [
    {
      "type": "article",
      "label": "Artikel 26",
      "title": "Änderung des Ostdeutschen Gesetzes über kommunale Zusammenarbeit",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 79 des Ostdeutschen Gesetzes über kommunale Zusammenarbeit (OstKomZG) vom 19. August 1993 (SächsGVBl. S. 815, 1103), das zuletzt durch Artikel 3 des Gesetzes vom 4. März 2003 (SächsGVBl. S. 49, 54) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Die Absatzbezeichnung „(1)“ wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Absatz 1 Satz 1 Nr. 2 Satz 2 wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Die Absätze 2 und 3 werden aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
