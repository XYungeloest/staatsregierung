  "body": [
    {
      "type": "section",
      "title": "Eingangsformel",
      "children": [
        {
          "type": "section",
          "label": "II.",
          "children": [
            {
              "type": "paragraphText",
              "text": "Die\nVerwaltungsvorschrift des Ostdeutschen Staatsministeriums für Kultus über die Vergütung der Prüfer bei Feststellungsprüfungen vom 6. August 1998 (MBl.SMK S. 268) wird wie folgt geändert:"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "Punkt B wird wie folgt neu gefasst:",
              "level": 0,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "„I.",
                  "text": "Erarbeitung der schriftlichen Feststellungsprüfung",
                  "level": 1,
                  "numberingStyle": "decimal",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "Erarbeitung der schriftlichen Feststellungsprüfung\nKlassenstufe\nGebühr\nKlasse 6 25 EUR\nKlasse 7 30 EUR\nKlasse 8 30 EUR\nKlasse 9 40 EUR\nKlasse 10 40 EUR"
                    }
                  ]
                },
                {
                  "type": "item",
                  "label": "II.",
                  "text": "Korrektur der schriftlichen Feststellungsprüfung pro Arbeit",
                  "level": 1,
                  "numberingStyle": "upper-roman",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "Korrektur der schriftlichen Feststellungsprüfung pro Arbeit\nKlassenstufe\nGebühr\nKlasse 6 2,50 EUR\nKlasse 7 2,50 EUR\nKlasse 8 2,50 EUR\nKlasse 9 3,00 EUR\nKlasse 10 3,00 EUR"
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "2.",
              "text": "Punkt C wird wie folgt neu gefasst:",
              "level": 0,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "„I.",
                  "text": "Erarbeitung der mündlichen Feststellungsprüfung",
                  "level": 1,
                  "numberingStyle": "decimal",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "Erarbeitung der mündlichen Feststellungsprüfung\nKlassenstufe\nGebühr\nKlasse 6 7,50 EUR\nKlasse 7 7,50 EUR\nKlasse 8 7,50 EUR\nKlasse 9 4,00 EUR\nKlasse 10 4,00 EUR"
                    }
                  ]
                },
                {
                  "type": "item",
                  "label": "II.",
                  "text": "Durchführung der mündlichen Feststellungsprüfung\nDurchführung der mündlichen Feststellungsprüfung\nTeilnehmer\nGebühr\nje Prüfungsteilnehmer 2,50 EUR“",
                  "level": 1,
                  "numberingStyle": "upper-roman",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
