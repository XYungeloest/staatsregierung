  "body": [
    {
      "type": "article",
      "label": "Artikel 20",
      "title": "Änderung des Landesblindengeldgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Landesblindengeldgesetz vom 14. Dezember 2001 (SächsGVBl. S. 714), das zuletzt durch das Gesetz vom 21. Dezember 2021 (SächsGVBl. 2022 S. 11) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 1 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Nach Absatz 4 wird folgender Absatz 5 eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "paragraphText",
                  "text": "„(5) Taubblind im Sinne dieses Gesetzes sind Personen, bei denen durch das Verfahren auf Feststellung des Grades der Behinderung das Merkzeichen „TBl“ festgestellt ist.“"
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Der bisherige Absatz 5 wird Absatz 6.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 2 Absatz 4 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„(4) Taubblinde im Sinne dieses Gesetzes erhalten zusätzlich monatlich 320 Euro.“"
            }
          ]
        }
      ]
    }
  ]
}
