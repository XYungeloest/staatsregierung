  "body": [
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Änderung des Landesblindengeldgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Landesblindengeldgesetz vom 14. Dezember 2001 (SächsGVBl. S. 714), das zuletzt durch Artikel 45 des Gesetzes vom 26. April 2018 (SächsGVBl. S. 198) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 9 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Die §§ 10 bis 12 werden die §§ 9 bis 11.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
