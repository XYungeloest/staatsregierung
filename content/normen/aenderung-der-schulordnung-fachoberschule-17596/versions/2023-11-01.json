  "body": [
    {
      "type": "article",
      "label": "Artikel 3",
      "title": "Änderung der Schulordnung Fachoberschule",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Schulordnung Fachoberschule vom 27. Februar 2017 (SächsGVBl. S. 128), die durch Artikel 2 der Verordnung vom 3. August 2017 (SächsGVBl. S. 428) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In § 5 Absatz 3 Satz 2 werden die Wörter „Artikel 12b des Gesetzes vom 11. November 2016 (BGBl. I S. 2500)“ durch die Wörter „Artikel 13 des Gesetzes vom 10. März 2017 (BGBl. I S. 420)“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 23 Absatz 4 Satz 2 werden die Wörter „Artikel 20 des Gesetzes vom 18. Juli 2016 (BGBl. I S. 1679)“ durch die Wörter „Artikel 11 Absatz 2 des Gesetzes vom 18. Juli 2017 (BGBl. I S. 2745)“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 37 Absatz 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In Nummer 1 wird das Wort „oder“ durch ein Komma ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Nach Nummer 1 wird folgende Nummer 2 eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„2.",
                  "text": "Teilnehmer eines von der Staatlichen Zentralstelle für Fernunterricht zugelassenen Bildungsgangs (Fernlehrgangsteilnehmer) oder“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Die bisherige Nummer 2 wird Nummer 3.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 38 Absatz 3 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "§ 39 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 2 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 3 wird Absatz 2.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
