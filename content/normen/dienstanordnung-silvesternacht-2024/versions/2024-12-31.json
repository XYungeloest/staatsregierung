  "body": [
    {
      "type": "paragraphText",
      "text": "Die Ostdeutsche Staatsregierung hat am 31. Dezember 2024 folgende Verordnung verkündet."
    },
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Dienstanordnung",
      "children": [
        {
          "type": "item",
          "label": "1.",
          "text": "In Innenstädten und an Orten von großen öffentlichen Ansammlungen",
          "level": 0,
          "listId": "source-outline",
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a.",
              "text": "unterstützt die Polizei jegliche eingeteilte Rettungsdienste bei der Errichtung von Zelten und Plätzen zur Erstversorgung,",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b.",
              "text": "bereitet sich die Feuerwehr im Falle einer Überlastung der Rettungsdienste auf entlastende Erste Hilfe Maßnahmen vor und",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c.",
              "text": "wird die Polizeipräsenz erhöht.",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Die genaue Festlegung der Zahlen und Räume obliegt den kommunalen Entscheidungsträgern.",
          "level": 0,
          "listId": "source-outline",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Inkrafttreten, Außerkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Verordnung tritt am 31.12.2024 um 20:00 Uhr in Kraft und am 01.01.2025 um 08:00 Uhr in Kraft."
        }
      ]
    }
  ]
}
