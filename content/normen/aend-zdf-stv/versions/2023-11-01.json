  "body": [
    {
      "type": "paragraph",
      "label": "§ 25",
      "title": "Änderung sonstiger Staatsverträge",
      "children": [
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der\nZDF-Staatsvertrag vom 31. August 1991, zuletzt geändert durch Artikel 3 des Fünften Rundfunkänderungsstaatsvertrages vom 6. Juli bis 7. August 2000, wird wie folgt geändert:",
          "children": []
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Im Inhaltsverzeichnis wird die Überschrift von § 8a gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 7 Abs. 1 Satz 2 wird die Verweisung auf „Absätze 2 bis 11“ durch die Verweisung auf „Absätze 2 bis 12“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 8 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„§ 8\nUnzulässige Sendungen, Jugendschutz"
            },
            {
              "type": "paragraphText",
              "text": "Die für das ZDF geltenden Bestimmungen des Jugendmedienschutz-Staatsvertrages finden Anwendung.“"
            }
          ]
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 8a wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
