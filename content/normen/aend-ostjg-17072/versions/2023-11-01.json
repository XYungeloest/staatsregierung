  "body": [
    {
      "type": "article",
      "label": "Artikel 7",
      "title": "Änderung des Ostdeutschen Justizgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Justizgesetz vom 24. November 2000 (SächsGVBl. S. 482; 2001 S. 704), das zuletzt durch das Gesetz vom 9. Juli 2014 (SächsGVBl. S. 405) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In der Inhaltsübersicht wird in der Angabe zu § 27 die Angabe „Aufstiegsfortbildungsförderungs-,“ gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 27 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In der Überschrift wird die Angabe „Aufstiegsfortbildungsförderungs-,“ gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 4 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Die bisherigen Absätze 5 bis 8 werden die Absätze 4 bis 7.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
