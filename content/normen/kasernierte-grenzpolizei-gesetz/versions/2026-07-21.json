          "children": [
            {
              "type": "paragraphText",
              "text": "Sonder-, Reserve- und Prüfstandorte"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "Wünsdorf-Waldstadt",
              "level": 0,
              "listId": "cavs2pj1rd3",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Verwaltungs-, Archiv-, Schulungs-, Lage- oder Führungsstandort."
            },
            {
              "type": "item",
              "label": "2.",
              "text": "Jüterbog",
              "level": 0,
              "listId": "cavs2pj1rd3",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
