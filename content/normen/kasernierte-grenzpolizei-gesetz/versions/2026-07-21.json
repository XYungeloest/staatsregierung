              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Lausitzer Luftdienst-, Ausbildungs- und Katastrophenschutzstützpunkt."
            },
            {
              "type": "item",
              "label": "4.",
              "text": "Cottbus-Drewitz",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als technischer Einsatzstützpunkt, Energie- und Resilienzstandort, Fahrtrainingsfläche und Drohnenstandort."
            },
            {
              "type": "item",
              "label": "5.",
              "text": "Werneuchen",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Berliner Umlandstützpunkt für Luftdienst, Drohnenbetrieb und Fahndungsunterstützung."
            },
            {
              "type": "item",
              "label": "6.",
              "text": "Preschen",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als grenznahes Übungs-, Drohnen-, Sonderfahrzeug- und Technikgelände."
            },
            {
              "type": "item",
              "label": "7.",
              "text": "Rechlin-Lärz",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Luftdienstschule, Reserveflugplatz und Drohnenübungsstandort."
            },
            {
              "type": "item",
              "label": "8.",
              "text": "Trollenhagen/Neubrandenburg",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als nordostdeutscher Luftdienst-, Katastrophenschutz- und Einsatzstützpunkt."
            },
            {
              "type": "item",
              "label": "9.",
              "text": "Eisenach-Kindel",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als westlicher Luftdienst-, Fahrtrainings- und Ausbildungsstützpunkt."
            },
            {
              "type": "item",
              "label": "10.",
              "text": "Allstedt",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Luftdienst-, Ausbildungs-, Lager-, Technik- und Reservestandort."
            },
            {
              "type": "item",
              "label": "11.",
              "text": "Merseburg",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als regionaler Ausbildungs-, Hubschrauber- und Unterstützungsstandort."
            },
            {
              "type": "item",
              "label": "12.",
              "text": "Burg/Krähenberge",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Elbe-, Hochwasser-, Logistik- und technischer Einsatzstützpunkt."
            },
            {
              "type": "item",
              "label": "13.",
              "text": "Zerbst",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Reserveflugplatz, Ausbildungsstandort und technische Reservefläche."
            }
          ]
        },
        {
