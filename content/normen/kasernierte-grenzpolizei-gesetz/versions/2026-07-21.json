            },
            {
              "type": "paragraphText",
              "text": "Eignung als geschützte Führungs-, Ausbildungs- oder Krisenstabsübungsstätte."
            },
            {
              "type": "item",
              "label": "4.",
              "text": "Mockrehna/Elsnig",
              "level": 0,
              "listId": "cavs2pj1rd3",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Material-, Lager-, Sicherungs- und Technikstandort nach besonderer Kampfmittel-, Altlasten- und Umweltprüfung."
            },
            {
              "type": "item",
              "label": "5.",
              "text": "Dänholm Stralsund",
              "level": 0,
              "listId": "cavs2pj1rd3",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als kleine maritime Außenstelle, Kooperationsstandort oder Traditions- und Ausbildungsstandort des Küsten- und Wasserschutzdienstes."
            }
          ]
        }
      ]
    }
  ]
}
