              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Luftdienst- und Fahndungsstützpunkt Nordost."
            },
            {
              "type": "item",
              "label": "2.",
              "text": "Groß Dölln",
              "level": 0,
              "listId": "6grv8wj3sde4",
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "paragraphText",
              "text": "Vorgesehene Prüfung:"
            },
            {
              "type": "paragraphText",
              "text": "Eignung als Fahrtrainings-, Sonderfahrzeug-, Großübungs- und Drohnenteststandort."
            },
            {
              "type": "item",
              "label": "3.",
              "text": "Welzow",
