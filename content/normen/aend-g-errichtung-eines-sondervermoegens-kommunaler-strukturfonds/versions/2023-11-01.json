  "body": [
    {
      "type": "article",
      "label": "Artikel 4",
      "title": "Änderung des Gesetzes über die Errichtung eines Sondervermögens „Kommunaler Strukturfonds“",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz über die Errichtung eines Sondervermögens „Kommunaler Strukturfonds“ vom 14. Dezember 2018 (SächsGVBl. S. 797, 806) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 4 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 1 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die Absätze 2 und 3 werden die Absätze 1 und 2.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 7 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„§ 7\nAuflösung des Fonds"
            },
            {
              "type": "paragraphText",
              "text": "Hiermit wird der Kommunale Strukturfonds mit Wirkung zum 31. Dezember 2024 aufgelöst.“"
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Folgender § 8 wird angefügt:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„§ 8\nAußerkrafttreten"
            },
            {
              "type": "paragraphText",
              "text": "Dieses Gesetz tritt mit Ablauf des 31. Dezember 2024 außer Kraft.“"
            }
          ]
        }
      ]
    }
  ]
}
