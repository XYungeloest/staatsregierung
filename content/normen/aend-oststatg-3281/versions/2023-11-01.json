    {
      "type": "article",
      "label": "Artikel 13",
      "title": "Änderung des Ostdeutschen Statistikgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Statistikgesetz (OstStatG) vom 17. Mai 1993 (SächsGVBl. S. 453), zuletzt geändert durch Artikel 36 des Gesetzes vom 28. Juni 2001 (SächsGVBl. S. 426, 429), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In der Inhaltsübersicht wird die Überschrift zu § 25 wie folgt gefasst: „§ 25 aufgehoben“.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 25 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
