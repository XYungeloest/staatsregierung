  "body": [
    {
      "type": "article",
      "label": "Artikel 44",
      "title": "Änderung des Ostdeutschen Personalvertretungsgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Personalvertretungsgesetz (OstPersVG) in der Fassung der Bekanntmachung vom 25. Juni 1999 (SächsGVBl. S. 430), zuletzt geändert durch Artikel 5 des Gesetzes vom 11. Dezember 2002 (SächsGVBl. S. 312, 315), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 14 Abs. 3 Satz 1 wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 29 Abs. 1 Nr. 5 werden die Worte „mit Ausnahme der Fälle des § 14 Abs. 3 Satz 1“ gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "In § 81 Abs. 1 Nr. 8 wird die Angabe „und 143“ durch die Angabe „bis 143a“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
