  "body": [
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Änderung der Zuschussverordnung",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 6 Satz 1 der Zuschussverordnung vom 26. Mai 2016 (SächsGVBl. S. 229), die zuletzt durch Artikel 3 der Verordnung vom 13. Juli 2023 (SächsGVBl. S. 585) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Nummer 6 wird das Wort „und“ am Ende durch ein Komma ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In Nummer 7 wird der Punkt am Ende durch ein Komma ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Nach Nummer 7 werden folgende Nummern 8 bis 10 eingefügt:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "„8.",
              "text": "Berufsschule, Förderschwerpunkt Sehen: 5,",
              "level": 1,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "9.",
              "text": "Berufsschule, Förderschwerpunkt Hören: 6 und",
              "level": 1,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "10.",
              "text": "Berufsschule, Förderschwerpunkt Sprache: 6.“",
              "level": 1,
              "numberingStyle": "decimal",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
