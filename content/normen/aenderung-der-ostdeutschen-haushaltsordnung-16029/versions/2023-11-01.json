  "body": [
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung der Ostdeutschen Haushaltsordnung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die\nOstdeutsche Haushaltsordnung in der Fassung der Bekanntmachung vom 10. April 2001 (SächsGVBl. S. 153), die zuletzt durch das Gesetz vom 6. Mai 2014 (SächsGVBl. S. 286) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In § 13 Absatz 3 Nummer 1 wird das Wort „als“ durch das Wort „aus“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 49 Absatz 2 Satz 3 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
