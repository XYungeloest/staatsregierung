                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "„2."
                },
                {
                  "type": "tableCell",
                  "text": "Amtsgericht Leipzig"
                },
                {
                  "type": "tableCell",
                  "text": "Grundbuchsachen"
                },
                {
                  "type": "tableCell",
                  "text": "1. Februar 2015“"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "children": [
        {
          "type": "paragraphText",
          "text": "Diese Verordnung tritt am 1. Februar 2015 in Kraft."
        }
      ]
    }
  ]
