                  "text": "SP-1"
                },
                {
                  "type": "tableCell",
                  "text": "pädagogische Ausgangslage"
                },
                {
                  "type": "tableCell",
                  "text": "Lernentwicklung, bisherige Förderung, Stärken, Barrieren"
                }
              ]
            },
