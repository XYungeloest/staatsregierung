{
  "versionId": "2026-07-21",
  "validFrom": "2026-07-21",
  "validTo": null,
  "isCurrent": true,
  "citation": "Gesetz vom 20. Juli 2026 (OGVBl. 2026 Nr. 52)",
  "changeNote": "Eingeführte Stammfassung.",
  "body": [
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Errichtung, Rechtsform und Sitz",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Freistaat Ostdeutschland errichtet die Sportstiftung Ostdeutschland als rechtsfähige Stiftung des öffentlichen Rechts.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Die Stiftung hat ihren Sitz in Magdeburg.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Aufgaben",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Die Sportstiftung Ost finanziert und fördert Maßnahmen des Breiten-, Kinder-, Jugend-, Nachwuchsleistungs- und Spitzensports sowie der Sportinfrastruktur im Freistaat Ostdeutschland.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Sie fördert insbesondere",
          "children": []
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Sportstättenbau und Sportstättensanierung,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Schwimmhallen und Schwimmausbildung,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "den Landessportpass Ost,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Kaderförderung und Prämien,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "Athletenversorgung,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Olympia-, Paralympics- und Deaflympics-Vorbereitung,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "7.",
          "text": "Sportangebote in strukturschwachen Räumen,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "8.",
          "text": "inklusive Sportangebote,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "9.",
          "text": "Kinder- und Jugendsport,",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "10.",
          "text": "Betriebssportprogramme und",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "11.",
          "text": "Sportwissenschaft und Trainerqualifizierung.",
          "level": 0,
          "listId": "kd0iseb2znuw",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 3",
      "title": "Sportfonds Ost",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Bei der Sportstiftung Ost wird der Sportfonds Ost als rechtlich unselbständiger Sonderfonds eingerichtet.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Die Mittel des Sportfonds Ost sind zweckgebunden für Aufgaben nach § 2 zu verwenden.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Die Stiftung führt für den Sportfonds Ost eine gesonderte Wirtschafts- und Vermögensrechnung.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 4",
      "title": "Organe",
      "children": [
        {
          "type": "paragraphText",
          "text": "Organe der Sportstiftung Ost sind"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "der Stiftungsrat und",
          "level": 0,
          "listId": "8boyv6qx94rq",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "der Vorstand.",
          "level": 0,
          "listId": "8boyv6qx94rq",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 5",
      "title": "Stiftungsrat",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Stiftungsrat überwacht den Vorstand und beschließt über die Grundsätze der Mittelverwendung.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Dem Stiftungsrat gehören an",
          "children": []
        },
        {
          "type": "item",
          "label": "1.",
          "text": "zwei Vertreter:innen des für Bildung zuständigen Staatsministeriums,",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "ein:e Vertreter:in des für Finanzen zuständigen Staatsministeriums,",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "ein:e Vertreter:in des für Gesundheitswesen zuständigen Staatsministeriums,",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "ein:e Vertreter:in des für Inneres zuständigen Staatsministeriums,",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "ein:e Vertreter:in des Ostdeutschen Sportbundes,",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "ein:e Vertreter:in der Athletenvertretung und",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "7.",
          "text": "ein:e Vertreter:in der kommunalen Spitzenverbände.",
          "level": 0,
          "listId": "io2xrzykmh61",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 6",
      "title": "Vorstand",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Vorstand führt die Geschäfte der Sportstiftung Ost.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Er wird vom Stiftungsrat mit Zustimmung des für Bildung zuständigen Staatsministeriums bestellt.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 7",
      "title": "Aufsicht",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Sportstiftung Ost untersteht der Rechtsaufsicht des für Bildung zuständigen Staatsministeriums. Maßnahmen mit erheblicher finanzieller Bedeutung bedürfen des Einvernehmens mit dem für Finanzen zuständigen Staatsministerium."
        }
      ]
    }
  ]
}
