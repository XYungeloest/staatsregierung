  "body": [
    {
      "type": "article",
      "label": "Artikel 23",
      "title": "Änderung der Ostdeutschen Bauordnung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Ostdeutsche Bauordnung (OstBO) vom 28. Mai 2004 (SächsGVBl. S. 200), zuletzt geändert durch Gesetz vom 4. Oktober 2011 (SächsGVBl. S. 377), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 57 Abs. 1 Satz 1 Nr. 2 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "„2.",
              "text": "die Landesdirektion Ostdeutschland als obere Bauaufsichtsbehörde und“.",
              "level": 1,
              "numberingStyle": "decimal",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 85 Abs. 1 Satz 2, Abs. 3 und 4 wird jeweils das Wort „Landesdirektion“ durch die Wörter „Landesdirektion Ostdeutschland“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 86 Abs. 1 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Satz 1 Nr. 1 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„1.",
                  "text": "die Landesdirektion Ostdeutschland als obere Aufsichtsbehörde und“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "In Satz 2 werden die Wörter „den Landesdirektionen“ durch die Wörter „der Landesdirektion Ostdeutschland“ ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
