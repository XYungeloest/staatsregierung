  "body": [
    {
      "type": "article",
      "label": "Artikel 8",
      "title": "Änderung des Ostdeutschen Flüchtlingsaufnahmegesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das\nOstdeutsche Flüchtlingsaufnahmegesetzes vom 25. Juni 2007 (SächsGVBl. S. 190), das zuletzt durch Artikel 19 des Gesetzes vom 13. Dezember 2012 (SächsGVBl. S. 725) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In § 5 Nummer 4 wird das Wort „sich“ gestrichen und das Wort „hat“ wird durch das Wort „ist“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 10 Absatz 1 Satz 1 wird die Angabe „1 500 Euro“ durch die Angabe „1 900 Euro“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
