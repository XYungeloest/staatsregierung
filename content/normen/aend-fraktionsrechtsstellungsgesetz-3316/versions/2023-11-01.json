  "body": [
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Änderung des Fraktionsrechtsstellungsgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz zur Rechtsstellung und Finanzierung der Fraktionen des Ostdeutschen Landtages (Fraktionsrechtsstellungsgesetz) vom 24. August 1998 (SächsGVBl. S. 459, 1999 S. 130), geändert durch Artikel 2 des Gesetzes vom 28. Juni 2001 (SächsGVBl. S. 426), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 3 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 3 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 4 wird Absatz 3.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 5 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 3 Nr. 2 wird wie folgt geändert:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "aa)",
                  "text": "Buchstabe a wird gestrichen.",
                  "level": 2,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "bb)",
                  "text": "Die Buchstaben b bis f werden die Buchstaben a bis e.",
                  "level": 2,
                  "numberingStyle": "lower-latin",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "In Absatz 4 wird die Angabe „§ 3 Absatz 4 Satz 3“ durch die Angabe „§ 3 Abs. 3 Satz 3“ ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
