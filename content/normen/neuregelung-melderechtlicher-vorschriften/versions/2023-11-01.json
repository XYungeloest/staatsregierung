                  "text": ""
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1,"
                },
                {
                  "type": "tableCell",
                  "text": "Melderegisterauskünfte"
                },
                {
                  "type": "tableCell",
                  "text": ""
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1"
                },
                {
                  "type": "tableCell",
                  "text": "Einfache Melderegisterauskünfte über eine Person nach § 44 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": ""
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1.1"
                },
                {
                  "type": "tableCell",
                  "text": "mündliche Auskunft nach § 44 Absatz 1 Satz 1 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "4\nje Betroffener,\nmindestens 5"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1.2"
                },
                {
                  "type": "tableCell",
                  "text": "schriftliche Auskunft nach § 44 Absatz 1 des Bundesmeldegesetzes und elektronische Auskunft auf automatisiert verarbeitbaren Datenträgern nach § 49 Absatz 1 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "6\nje Betroffener,\nmindestens 6,30"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1.3"
                },
                {
                  "type": "tableCell",
                  "text": "Auskunft durch automatisierten Abruf über das Internet nach § 49 Absatz 2 und 3 des Bundesmeldegesetzes in Verbindung mit § 2 Nummer 4 des Ostdeutschen Gesetzes zur Ausführung des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "3,50\nje Betroffener,\nmindestens 5"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1.4"
                },
                {
                  "type": "tableCell",
                  "text": "Melderegisterauskunft, deren Erteilung einen größeren Verwaltungsaufwand erforderlich macht, insbesondere Rückgriff in nach § 13 Absatz 2 des Bundesmeldegesetzes gesondert aufzubewahrende Bestände"
                },
                {
                  "type": "tableCell",
                  "text": "11,50 bis 70\nje Betroffener"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.1.5"
                },
                {
                  "type": "tableCell",
                  "text": "Auskunft zur Existenzverifikation"
                },
                {
                  "type": "tableCell",
                  "text": "0,50 bis 3,50\npro Auskunft,\nmindestens 5 je angefangenem Monat der Nutzung"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.2"
                },
                {
                  "type": "tableCell",
                  "text": "Erweiterte Melderegisterauskunft über eine Person nach § 45 Absatz 1 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": ""
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.2.1"
                },
                {
                  "type": "tableCell",
                  "text": "schriftliche Auskunft"
                },
                {
                  "type": "tableCell",
                  "text": "10,40\nje Betroffener"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.2.2"
                },
                {
                  "type": "tableCell",
                  "text": "Melderegisterauskunft, deren Erteilung einen größeren Verwaltungsaufwand erforderlich macht, insbesondere Rückgriff in nach § 13 Absatz 2 des Bundesmeldegesetzes gesondert aufzubewahrende Bestände"
                },
                {
                  "type": "tableCell",
                  "text": "16 bis 70\nje Betroffener"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "1.3"
                },
                {
                  "type": "tableCell",
                  "text": "Auskünfte nach § 10 Absatz 1 Nummer 1 des Bundesmeldegesetzes an den gesetzlichen Vertreter oder an den Pfleger oder Betreuer, wenn zu dessen Wirkungskreis auch die Ausübung des Aufenthaltsbestimmungsrechts gehört"
                },
                {
                  "type": "tableCell",
                  "text": "gebührenfrei"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "2."
                },
                {
                  "type": "tableCell",
                  "text": "Erteilung einer zusätzlichen Meldebescheinigung, Aufenthaltsbescheinigung oder sonstigen Bescheinigung"
                },
                {
                  "type": "tableCell",
                  "text": "8,20"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "3."
                },
                {
                  "type": "tableCell",
                  "text": "Eintragung einer Auskunftssperre nach § 51 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "gebührenfrei"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "4."
                },
                {
                  "type": "tableCell",
                  "text": "Berichtigung und Fortschreibung des Melderegisters auf Antrag nach § 12 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "gebührenfrei"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
                  "text": "5."
                },
                {
                  "type": "tableCell",
                  "text": "Übermittlung von Daten an die Suchdienste nach § 43 des Bundesmeldegesetzes"
                },
                {
                  "type": "tableCell",
                  "text": "gebührenfrei“"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 3",
      "title": "Inkrafttreten, Außerkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Diese Verordnung tritt am 1. November 2015 in Kraft. Gleichzeitig tritt die\nOstdeutsche Meldeverordnung\nvom 13. Dezember 2006 (SächsGVBl. S. 540), die zuletzt durch Artikel 2 des Gesetzes vom 30. März 2015 (SächsGVBl. S. 290) geändert worden ist, außer Kraft."
        }
      ]
    }
  ]
