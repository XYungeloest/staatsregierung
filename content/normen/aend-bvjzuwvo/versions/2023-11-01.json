  "body": [
    {
      "type": "article",
      "label": "Artikel 4",
      "title": "Änderung der Berufsvorbereitungsjahrzuweisungsverordnung",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 4 Absatz 3 der Berufsvorbereitungsjahrzuweisungsverordnung vom 30. April 2019 (SächsGVBl. S. 326) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Satz 1 Nummer 3 wird die Angabe „Absatz 2“ durch die Angabe „Absatz 3“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In Satz 2 wird die Angabe „Satz 3“ gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
