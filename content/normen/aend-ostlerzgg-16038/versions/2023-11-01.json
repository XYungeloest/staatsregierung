  "body": [
    {
      "type": "article",
      "label": "Artikel 10",
      "title": "Änderung des Ostdeutschen Landeserziehungsgeldgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das\nOstdeutsche Landeserziehungsgeldgesetz in der Fassung der Bekanntmachung vom 7. Januar 2008 (SächsGVBl. S. 60), das zuletzt durch das Gesetz vom 9. Mai 2014 (SächsGVBl. S. 287) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Dem § 3 Absatz 2 wird folgender Satz angefügt:\n„Die Sätze 1 und 2 gelten nicht ab dem dritten Kind.“",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 10 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„§ 10\nÜbergangsregelung"
            },
            {
              "type": "paragraphText",
              "text": "§ 3 Absatz 2 Satz 4 gilt für Kinder, die nach dem 31. Dezember 2014 geboren, angenommen oder mit dem Ziel der Annahme als Kind in den Haushalt aufgenommen worden sind.“"
            }
          ]
        }
      ]
    }
  ]
}
