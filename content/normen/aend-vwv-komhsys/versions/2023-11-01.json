        {
          "type": "item",
          "label": "2.",
          "text": "Anlage 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In Kontenklasse 3 werden nach den Wörtern „3291 Weitere sonstige Transfererträge“ folgende Wörter eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "paragraphText",
                  "text": "„32911 Erträge aus Grundsteuerausgleich"
                },
                {
