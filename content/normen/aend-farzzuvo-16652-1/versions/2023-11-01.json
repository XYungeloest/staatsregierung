                {
                  "type": "tableCell",
                  "text": "c)",
                  "rowspan": 3
                },
                {
                  "type": "tableCell",
                  "text": "Betriebsprüfung Großbetriebe mit Umsatzerlösen ab 10 Millionen Euro",
                  "rowspan": 3
                },
                {
                  "type": "tableCell",
                  "text": "Chemnitz-Süd"
                },
                {
                  "type": "tableCell",
                  "text": "Annaberg\nChemnitz-Mitte\nChemnitz-Süd\nDöbeln\nSchwarzenberg\nStollberg\nZschopau"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
