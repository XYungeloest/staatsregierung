                },
                {
                  "type": "tableCell",
                  "text": "Borna\nEilenburg\nGrimma\nLeipzig I\nLeipzig II\nOschatz"
                }
              ]
            },
            {
              "type": "tableRow",
              "children": [
                {
                  "type": "tableCell",
