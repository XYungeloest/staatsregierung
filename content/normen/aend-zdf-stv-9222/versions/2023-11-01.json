  "body": [
    {
      "type": "article",
      "label": "Artikel 5",
      "title": "Änderung des ZDF-Staatsvertrages",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 4 Abs. 3 des\nZDF-Staatsvertrages vom 31. August 1991, zuletzt geändert durch den Achten Rundfunkänderungsstaatsvertrag vom 8. bis 15. Oktober 2004, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Satz 1 werden die Worte „Mediendienste im Sinne von § 2 Abs. 2 Nr. 4 des Mediendienste-Staatsvertrages” ersetzt durch das Wort „Telemedien”.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In Satz 2 wird das Wort „Mediendiensten” ersetzt durch das Wort „Telemedien”.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
