                }
              ]
            }
          ]
        },
        {
          "type": "item",
          "label": "b)",
          "text": "Nummer 2 wird wie folgt gefasst:",
          "level": 1,
          "numberingStyle": "lower-latin",
          "children": [
            {
              "type": "item",
              "label": "„2.",
              "text": "Notfallbezogene Indikationen",
              "level": 2,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "a.",
                  "text": "schwerer Verkehrsunfall mit Hinweis auf Verletzte",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "b.",
                  "text": "sonstiger Unfall mit Schwerverletzten",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "c.",
                  "text": "Unfall mit Kindern",
                  "level": 3,
                  "numberingStyle": "lower-roman",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "d.",
                  "text": "Brände/Rauchgasentwicklung mit Hinweis auf Personenbeteiligung",
                  "level": 3,
                  "numberingStyle": "lower-roman",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "e.",
                  "text": "Explosionsunfälle mit Hinweis auf Personenbeteiligung",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "f.",
                  "text": "thermische oder chemische Unfälle mit Hinweis auf Personenbeteiligung",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "g.",
                  "text": "Strom- oder Blitzunfälle",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
