                  "text": "Ertrinkungs- oder Tauchunfälle oder Eiseinbruch",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "i.",
                  "text": "Einklemmung oder Verschüttung",
                  "level": 3,
                  "numberingStyle": "lower-roman",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "j.",
                  "text": "drohender Suizid",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
