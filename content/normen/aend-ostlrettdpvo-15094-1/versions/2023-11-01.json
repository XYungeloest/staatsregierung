                  "text": "unmittelbar einsetzende oder stattgefundene Geburt",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "o.",
                  "text": "Vergiftungen mit vitaler Gefährdung“.",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "children": [
        {
          "type": "paragraphText",
          "text": "Diese Verordnung tritt am Tag nach ihrer Verkündung in Kraft."
        }
      ]
    }
  ]
}
