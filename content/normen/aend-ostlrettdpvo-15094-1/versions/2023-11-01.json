                  "text": "Sturz aus Höhe (≥ 3 m)",
                  "level": 3,
                  "numberingStyle": "decimal",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "l.",
                  "text": "Schuss-/Stich-/Hiebverletzungen im Kopf-, Hals- oder Rumpfbereich",
                  "level": 3,
                  "numberingStyle": "lower-roman",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "m.",
                  "text": "Geiselnahme, Amoklage oder sonstige Verbrechen mit unmittelbarer Gefahr für Menschenleben",
                  "level": 3,
                  "numberingStyle": "lower-roman",
                  "children": []
                },
                {
