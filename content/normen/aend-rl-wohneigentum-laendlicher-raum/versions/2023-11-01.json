  "body": [
    {
      "type": "section",
      "label": "V.",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Richtlinie Wohneigentum ländlicher Raum vom 4. Dezember 2018 (SächsABl. S. 1463), die durch Ziffer IV der Richtlinie vom 25. Oktober 2019 (SächsABl. S. 1606) geändert worden ist, enthalten in der Verwaltungsvorschrift vom 27. November 2019 (SächsABl. SDr. S. S 339) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Ziffer VI Nummer 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In Satz 1 wird nach dem Wort „Projektförderung“ die Angabe „-ANBest-P“ eingefügt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die Sätze 2 bis 5 werden aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Ziffer VII wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Nummer 1 Satz 2 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "paragraphText",
                  "text": "„Dieser kann auch elektronisch unter www.ostdeutschland.de gestellt werden.“"
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Nummer 4 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "paragraphText",
                  "text": "„Der Verwendungsnachweis ist mit dem Antrag auf Schlussauszahlung bei der Bewilligungsstelle einzureichen.“"
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
