  "body": [
    {
      "type": "article",
      "label": "Artikel 17",
      "title": "Änderung des Gesetzes über den öffentlichen Personennahverkehr im Freistaat Ostdeutschland",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz über den öffentlichen Personennahverkehr im Freistaat Ostdeutschland (ÖPNVG) vom 14. Dezember 1995 (SächsGVBl. S. 412, 449) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 3 Abs. 3 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 4 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 2 Satz 2 und 3 wird gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 3 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "In § 5 Abs. 1 werden die Worte „und unter Beachtung der Entscheidungen der Aufgabenträger gemäß § 3 Abs. 2“ gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 8 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Die Absatzbezeichnung „(1)“ wird gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 2 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
