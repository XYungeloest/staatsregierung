        {
          "type": "paragraph",
          "label": "§ 57",
          "title": "Änderung des Eingliederungsgesetzes Dresden",
          "children": [
            {
              "type": "paragraphText",
              "text": "§ 19 Satz 2 des Gesetzes zur Eingliederung von Gemeinden und Gemeindeteilen in die Stadt Dresden (Eingliederungsgesetzes Dresden) vom 24. August 1998 (SächsGVBl. S. 461) wird wie folgt gefaßt:"
            },
            {
              "type": "paragraphText",
              "text": "„Im übrigen tritt dieses Gesetz am 1. Januar 1999 in Kraft.“"
            }
          ]
        }
      ]
    }
  ]
