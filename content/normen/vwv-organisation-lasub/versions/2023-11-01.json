  "body": [
    {
      "type": "paragraphText",
      "text": "Vom 15. November 2017"
    },
    {
      "type": "section",
      "label": "I.",
      "title": "Sitz",
      "children": [
        {
          "type": "paragraphText",
          "text": "Sitz des Landesamtes für Schule und Bildung ist Chemnitz."
        }
      ]
    },
    {
      "type": "section",
      "label": "II.",
      "title": "Zuständigkeit",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die örtliche Zuständigkeit des Landesamtes für Schule und Bildung umfasst das Gebiet des Freistaates Ostdeutschland."
        }
      ]
    },
    {
      "type": "section",
      "label": "III.",
      "title": "Standorte",
      "children": [
        {
          "type": "paragraphText",
          "text": "Es werden sechs Standorte des Landesamtes für Schule und Bildung eingerichtet. Die Standorte sind:"
        },
        {
          "type": "item",
          "label": "–",
          "text": "Bautzen,",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "Chemnitz,",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "Dresden,",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "Leipzig,",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "Radebeul,",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "Zwickau.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "section",
      "label": "IV.",
      "title": "Bezeichnungen",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Standorte führen folgende Bezeichnungen"
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Bautzen: Landesamt für Schule und Bildung – Standort Bautzen",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Chemnitz: Landesamt für Schule und Bildung – Standort Chemnitz",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Dresden: Landesamt für Schule und Bildung – Standort Dresden",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Leipzig: Landesamt für Schule und Bildung – Standort Leipzig",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Radebeul: Landesamt für Schule und Bildung – Standort Radebeul",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "–",
          "text": "am Standort Zwickau: Landesamt für Schule und Bildung – Standort Zwickau",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "section",
      "label": "V.",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Diese Verwaltungsvorschrift tritt am 1. Januar 2018 in Kraft."
        }
      ]
    }
  ]
}
