  "body": [
    {
      "type": "article",
      "label": "Artikel 7",
      "title": "Änderung der Ostdeutschen Laufbahnverordnung",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 4 Nummer 2 der Ostdeutschen Laufbahnverordnung in der Fassung der Bekanntmachung vom 22. August 2017 (SächsGVBl. S. 485) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Buchstabe b wird das Wort „und“ durch ein Komma ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In Buchstabe c wird das Komma durch das Wort „und“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Folgender Buchstabe d wird angefügt:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "„d)",
              "text": "Vollzugsdienst in Abschiebungshaft- und Ausreisegewahrsamseinrichtungen,“.",
              "level": 1,
              "numberingStyle": "decimal",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
