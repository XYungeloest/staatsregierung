    {
      "type": "paragraph",
      "label": "§ 19",
      "title": "Raumordnungsbehörden, sachliche Zuständigkeit",
      "children": [
        {
          "type": "item",
          "label": "1)",
          "text": "Oberste Raumordnungs- und Landesplanungsbehörde ist das Staatsministerium für Regionalentwicklung.",
          "numberingStyle": "decimal",
          "level": 0,
          "children": []
        },
        {
          "type": "item",
          "label": "2)",
          "text": "Raumordnungsbehörde ist der jeweilige Bezirk.",
          "numberingStyle": "decimal",
          "level": 0,
          "children": []
        },
        {
          "type": "item",
          "label": "3)",
          "text": "Zuständig ist die Raumordnungsbehörde, soweit nichts anderes bestimmt ist.",
          "numberingStyle": "decimal",
          "level": 0,
          "children": []
        }
      ]
