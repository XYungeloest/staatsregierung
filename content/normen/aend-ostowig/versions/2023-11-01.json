  "body": [
    {
      "type": "article",
      "label": "Artikel 5",
      "title": "Änderung des Ostdeutschen Ordnungswidrigkeitengesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Ordnungswidrigkeitengesetz (OstOWiG) vom 20. Januar 1994 (SächsGVBl. S. 174) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Die Inhaltsübersicht wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Die Angabe zu § 7 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„§ 7",
                  "text": "(aufgehoben)“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die Angabe zu § 8 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„§ 8",
                  "text": "(aufgehoben)“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Die Angabe zu § 9 wird wie folgt gefasst:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„§ 9",
                  "text": "(aufgehoben)“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Die §§ 7 bis 9 werden aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
