  "body": [
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Änderung des Ostdeutschen Finanzausgleichsgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Finanzausgleichsgesetz in der Fassung der Bekanntmachung vom 23. April 2021 (SächsGVBl. S. 487), das durch Artikel 2 des Gesetzes vom 20. Dezember 2022 (SächsGVBl. S. 743) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In § 22 Satz 2 wird die Angabe „90 000 000 Euro“ durch die Angabe „223 140 000 Euro“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 22a wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In Nummer 7 wird das Wort „sowie“ am Ende gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "In Nummer 8 wird der Punkt am Ende durch das Wort „sowie“ ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Folgende Nummer 9 wird angefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„9.",
                  "text": "Zuweisungen im Jahr 2023 in Höhe von insgesamt 133 140 000 Euro, die den Landkreisen und Kreisfreien Städten zu gleichen Teilen gewährt werden.“",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 31 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 1 wird wie folgt geändert:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "aa)",
                  "text": "In Satz 1 werden die Wörter „Nummer 1 bis 6 und 8“ durch die Wörter „Nummer 1 bis 6, 8 und 9“ ersetzt.",
                  "level": 2,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "bb)",
                  "text": "In Satz 4 werden die Wörter „Nummer 1 bis 8“ durch die Wörter „Nummer 1 bis 9“ ersetzt.",
                  "level": 2,
                  "numberingStyle": "lower-latin",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Nach Absatz 3 Satz 1 Nummer 5 wird folgende Nummer 5a eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„5a.",
                  "text": "nach § 22a Nummer 9 am 30. November 2023,“.",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
