      "title": "Änderung des Gesetzes über den Ostdeutschen Ausländerbeauftragten",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 6 des Gesetzes über den Ostdeutschen Ausländerbeauftragten (OstAuslBeauftrG) vom 9. März 1994 (SächsGVBl. S. 465) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Die Absatzbezeichnung „(1)“ wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Absatz 2 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
