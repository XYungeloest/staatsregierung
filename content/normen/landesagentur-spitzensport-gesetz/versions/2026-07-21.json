{
  "versionId": "2026-07-21",
  "validFrom": "2026-07-21",
  "validTo": null,
  "isCurrent": true,
  "citation": "Gesetz vom 20. Juli 2026 (OGVBl. 2026 Nr. 52)",
  "changeNote": "Eingeführte Stammfassung.",
  "body": [
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Errichtung, Rechtsform und Sitz",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Freistaat Ostdeutschland errichtet die Landesagentur Spitzensport Ost (LASpO) als rechtsfähige Anstalt des öffentlichen Rechts."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Die Landesagentur hat ihren Sitz in Leipzig. Außenstellen können durch Satzung eingerichtet werden."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Aufgaben",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Die Landesagentur nimmt Aufgaben der Spitzensportförderung nach Maßgabe des Ostdeutschen Sportfördergesetzes wahr."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Sie ist insbesondere zuständig für"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Verwaltung von Förderverträgen,"
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Auszahlung von Kaderförderungen,"
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Verwaltung von Prämien,"
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Betrieb oder Förderung von Sportinternaten,"
        },
        {
          "type": "item",
          "label": "5.",
          "text": "Anstellung und Einsatz von Trainern,"
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Koordination sportmedizinischer Betreuung,"
        },
        {
          "type": "item",
          "label": "7.",
          "text": "Laufbahnberatung,"
        },
        {
          "type": "item",
          "label": "8.",
          "text": "Antidoping-Compliance,"
        },
        {
          "type": "item",
          "label": "9.",
          "text": "Unterstützung der Athletenvertretung,"
        },
        {
          "type": "item",
          "label": "10.",
          "text": "Berichtswesen gegenüber der obersten Sportbehörde und"
        },
        {
          "type": "item",
          "label": "11.",
          "text": "Betrieb des Athletenversorgungswerks Ost nach Maßgabe des Athletenförder- und Versorgungsgesetzes."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 3",
      "title": "Organe",
      "children": [
        {
          "type": "paragraphText",
          "text": "Organe der Landesagentur sind"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "der Verwaltungsrat und"
        },
        {
          "type": "item",
          "label": "2.",
          "text": "der Vorstand."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 4",
      "title": "Verwaltungsrat",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Verwaltungsrat überwacht den Vorstand."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Dem Verwaltungsrat gehören an"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "zwei Vertreter:innen der obersten Sportbehörde,"
        },
        {
          "type": "item",
          "label": "2.",
          "text": "ein:e Vertreter:in des für Finanzen zuständigen Staatsministeriums,"
        },
        {
          "type": "item",
          "label": "3.",
          "text": "ein:e Vertreter:in des für Gesundheitswesen zuständigen Staatsministerium,"
        },
        {
          "type": "item",
          "label": "4.",
          "text": "ein:e Vertreter:in des Ostdeutschen Sportbundes,"
        },
        {
          "type": "item",
          "label": "5.",
          "text": "ein:e Vertreter:in der Athletenvertretung,"
        },
        {
          "type": "item",
          "label": "6.",
          "text": "ein:e Vertreter:in der Universität Leipzig und"
        },
        {
          "type": "item",
          "label": "7.",
          "text": "ein:e Vertreter:in der kommunalen Spitzenverbände."
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Den Vorsitz führt ein:e Vertreter:in der obersten Sportbehörde."
        },
        {
          "type": "subparagraph",
          "label": "(4)",
          "text": "Das Nähere regelt die Satzung."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 5",
      "title": "Vorstand",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Der Vorstand leitet die Landesagentur."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der Vorstand besteht aus einem oder mehreren Mitgliedern."
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Die Mitglieder des Vorstandes werden vom Verwaltungsrat mit Zustimmung der obersten Sportbehörde bestellt."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 6",
      "title": "Satzung",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Die Landesagentur gibt sich eine Satzung."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Die Satzung bedarf der Genehmigung der obersten Sportbehörde im Einvernehmen mit dem für Finanzen zuständigen Staatsministerium."
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Die Satzung regelt insbesondere"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "innere Organisation,"
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Geschäftsverteilung,"
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Verfahren des Verwaltungsrates,"
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Wirtschaftsführung,"
        },
        {
          "type": "item",
          "label": "5.",
          "text": "Berichtspflichten,"
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Einrichtung von Außenstellen und"
        },
        {
          "type": "item",
          "label": "7.",
          "text": "Beteiligung der Athletenvertretung."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 7",
      "title": "Aufsicht",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Die Landesagentur untersteht der Rechtsaufsicht der obersten Sportbehörde."
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Soweit die Landesagentur staatliche Aufgaben wahrnimmt, unterliegt sie der Fachaufsicht der obersten Sportbehörde."
        }
      ]
    }
  ]
}
