  "body": [
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Änderung des Gesetzes über die Errichtung der Ostdeutschen Anstalt für kommunale Datenverarbeitung",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz über die Errichtung der Ostdeutschen Anstalt für kommunale Datenverarbeitung (SAKDG) vom 15. Juli 1994 (SächsGVBl. S. 1432), zuletzt geändert durch Artikel 12 des Gesetzes vom 13. Dezember 2012 (SächsGVBl. S. 725, 733), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 4a wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 10 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 1 Satz 2 wird gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 2 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Die Absätze 3 und 4 werden die Absätze 2 und 3.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "d)",
              "text": "Absatz 5 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 11 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 2 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Absatz 3 wird Absatz 2.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 15 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
