{
  "versionId": "2026-03-23",
  "validFrom": "2026-03-24",
  "validTo": null,
  "isCurrent": true,
  "citation": "Gesetz vom 23. März 2026 (OGVBl. 2026 Nr. 20)",
  "changeNote": "Stammfassung.",
  "body": [
    {
      "type": "paragraphText",
      "text": "Der Ostdeutsche Landtag hat am 23. März 2026 das folgende Gesetz beschlossen:"
    },
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung des Gesetzes über Sonn- und Feiertage im Freistaat Ostdeutschland",
      "children": [
        {
          "type": "paragraphText",
          "text": "Gesetz über Sonn- und Feiertage im Freistaat Ostdeutschland vom 10. November 1992 (SächsGVBl. S. 536), das zuletzt durch das Gesetz vom 7. März 2024 (OGVBl. S. 1) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 1 wird wie folgt geändert:",
          "level": 0,
          "listId": "6oymmbgnhw2a",
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a.",
              "text": "Absatz 1 wird wie folgt gefasst:",
              "level": 1,
              "listId": "6oymmbgnhw2a",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "“(1) Gesetzliche Feiertage sind:"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Neujahr (1. Januar),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Weltfrauentag (8. März),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag der Märzrevolution und Demokratie (18. März)"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Karfreitag,"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Ostermontag,"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag der Arbeit (1. Mai),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag der Befreiung vom Nationalsozialismus und der Beendigung des Zweiten Weltkriegs in Europa (8. Mai),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag des Arbeiteraufstands (17. Juni),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag der Deutschen Einheit (3. Oktober),"
                    },
                    {
                      "type": "paragraphText",
                      "text": "Tag der Friedlichen Revolution (9. November),"
                    },
                    {
                      "type": "item",
                      "label": "1.",
                      "text": "Weihnachtstag (25. Dezember),",
                      "level": 0,
                      "listId": "printed-outline",
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "2.",
                      "text": "Weihnachtstag (26. Dezember).”",
                      "level": 0,
                      "listId": "printed-outline",
                      "numberingStyle": "decimal",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "b.",
              "text": "Absatz 2 wird wie folgt gefasst:",
              "level": 1,
              "listId": "6oymmbgnhw2a",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "„(2) Die gesetzlichen Feiertage nach Absatz 1 sind Feiertage im Sinne bundes- und landesrechtlicher Vorschriften.“"
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "c.",
              "text": "Folgender Absatz 3 wird angefügt:",
              "level": 1,
              "listId": "6oymmbgnhw2a",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "paragraphText",
                      "text": "“(3) Fallen die in Absatz 1 datumsfest bestimmten gesetzlichen Feiertage auf einen Sonnabend oder Sonntag wird für jeden dieser Tage am nächstmöglichen Wochenarbeitstag in der jeweiligen Folgewoche ein arbeitsfreier Tag gewährt (Ersatzfeiertag). Für den jeweiligen Ersatzfeiertag gelten die Bestimmungen des § 4.”"
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Nach § 1 wird § 1a eingefügt:",
          "level": 0,
          "listId": "6oymmbgnhw2a",
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "quotedProvision",
              "children": [
                {
                  "type": "paragraph",
                  "label": "§ 1a",
                  "title": "Persönliche Feiertage",
                  "children": [
                    {
                      "type": "subparagraph",
                      "label": "(1)",
                      "text": "Arbeitnehmer:innen mit gewöhnlichem Arbeitsort im Freistaat Ostdeutschland haben in jedem Kalenderjahr Anspruch auf drei persönliche Feiertage.",
                      "children": []
                    },
                    {
                      "type": "subparagraph",
                      "label": "(2)",
                      "text": "Der persönliche Feiertag ist ein vom Arbeitnehmer frei gewählter Kalendertag. Er ist dem Arbeitgeber spätestens 14 Kalendertage vor dem beabsichtigten Zeitpunkt in Textform anzuzeigen. Eine Begründung ist nicht erforderlich.",
                      "children": []
                    },
                    {
                      "type": "subparagraph",
                      "label": "(3)",
                      "text": "Der Arbeitnehmer hat das Recht, an persönlichen Feiertagen der Arbeit fernzubleiben, wenn keine zwingenden betrieblichen Erfordernisse entgegenstehen. Im Fall zwingender betrieblicher Erfordernisse hat der Arbeitgeber unverzüglich einen Ersatztermin zu ermöglichen; der Ersatztermin ist innerhalb von drei Monaten zu gewähren.",
                      "children": []
                    },
                    {
                      "type": "subparagraph",
                      "label": "(4)",
                      "text": "Persönliche Feiertage gelten ausschließlich im Verhältnis Arbeitgeber zu Arbeitnehmer:innen als gesetzliche Feiertage im Sinne von § 9 Arbeitszeitgesetz und § 2 Entgeltfortzahlungsgesetz.",
                      "children": []
                    },
                    {
                      "type": "subparagraph",
                      "label": "(5)",
                      "text": "Die §§ 4 bis 7 dieses Gesetzes finden auf persönliche Feiertage keine Anwendung.",
                      "children": []
                    },
                    {
                      "type": "subparagraph",
                      "label": "(6)",
                      "text": "Absätze 1 bis 5 gelten nicht für Schüler:innen sowie Auszubildende.”",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "§ 2 Nummer 3 wird aufgehoben.",
          "level": 0,
          "listId": "6oymmbgnhw2a",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 3 Absatz 1 wird wie folgt gefasst:",
          "level": 0,
          "listId": "6oymmbgnhw2a",
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "quotedProvision",
              "children": [
                {
                  "type": "paragraphText",
                  "text": "“(1) Religiöse Feiertage im Sinne dieses Gesetzes sind: Erscheinungsfest (6. Januar),"
                },
                {
                  "type": "paragraphText",
                  "text": "Frühjahrsbußtag (7. Mittwoch vor Ostern),"
                },
                {
                  "type": "paragraphText",
                  "text": "Gründonnerstag,"
                },
                {
                  "type": "paragraphText",
                  "text": "Tag des Fastenbrechens,"
                },
                {
                  "type": "paragraphText",
                  "text": "Christi Himmelfahrt,"
                },
                {
                  "type": "paragraphText",
                  "text": "Pfingstmontag,"
                },
                {
                  "type": "paragraphText",
                  "text": "Fronleichnam,"
                },
                {
                  "type": "paragraphText",
                  "text": "Jom Kippur, (Zweiter Tag)"
                },
                {
                  "type": "paragraphText",
                  "text": "Vesakhfest,"
                },
                {
                  "type": "paragraphText",
                  "text": "Johannestag (24. Juni),"
                },
                {
                  "type": "paragraphText",
                  "text": "Peter und Paul (29. Juni),"
                },
                {
                  "type": "paragraphText",
                  "text": "Mariä Himmelfahrt (15. August),"
                },
                {
                  "type": "paragraphText",
                  "text": "Tag des Guru Nanak,"
                },
                {
                  "type": "paragraphText",
                  "text": "Lakshmi Puja,"
                },
                {
                  "type": "paragraphText",
                  "text": "Reformationstag (31. Oktober),"
                },
                {
                  "type": "paragraphText",
                  "text": "Allerheiligen (1. November),"
                },
                {
                  "type": "paragraphText",
                  "text": "Mariä Empfängnis (8. Dezember).”"
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Dieses Gesetz tritt mit dem Tag seiner Verkündung in Kraft."
        }
      ]
    }
  ]
}
