  "body": [
    {
      "type": "section",
      "label": "I.",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die FRL MINT-Fachkräfteprogramm ESF Plus 2021–2027 vom 19. September 2022 (SächsABl. S. 1126) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Ziffer I Nummer 2 wird die Angabe „9. Dezember 2021 (SächsABl. S. 1723)“ durch die Angabe „9. Mai 2023 (SächsABl. S. 576)“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Ziffer II Abschnitt A Nummer 5 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "folgender Buchstabe a wird neu eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„a)",
                  "text": "Die Aufstellung aller durch den Antragsteller vorzulegender Nachweise und Unterlagen ist im Internet unter www.sab.ostdeutschland.de abrufbar. Dazu gehören",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": [
                    {
                      "type": "item",
                      "label": "–",
                      "text": "eine Vorhabenbeschreibung,",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "–",
                      "text": "eine Stellenbeschreibung für die neu zu schaffende Stelle,",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "–",
                      "text": "der Entwurf eines Arbeitsvertrages,",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "–",
                      "text": "Nachweise zur Qualifikation der einzustellenden Person.“",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Der bisherigen Buchstabe a, b, und c werden zu Buchstaben b, c und d.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Ziffer II Abschnitt B Nummer 5 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "folgender Buchstabe b wird neu eingefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„b)",
                  "text": "Die Aufstellung aller durch den Antragsteller vorzulegender Nachweise und Unterlagen ist im Internet unter www.sab.ostdeutschland.de abrufbar. Dazu gehören",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": [
                    {
                      "type": "item",
                      "label": "–",
                      "text": "eine Vorhabenbeschreibung,",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "–",
                      "text": "der Entwurf eines Kooperationsvertrages einschließlich Festlegungen zum Projektkoordinator und zu den Veröffentlichungsrechten für Projektergebnisse,",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "–",
                      "text": "Nachweise zur Qualifikation der zu fördernden Personen.“",
                      "level": 3,
                      "numberingStyle": "decimal",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die bisherigen Buchstaben b, c und d werden zu Buchstaben c, d und e.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    },
    {
      "type": "section",
      "label": "II.",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Richtlinie tritt mit Wirkung vom 1. Juli 2023 in Kraft."
        }
      ]
    }
  ]
}
