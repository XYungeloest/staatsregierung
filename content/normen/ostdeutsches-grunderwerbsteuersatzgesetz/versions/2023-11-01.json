  "body": [
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Steuersatz",
      "children": [
        {
          "type": "paragraphText",
          "text": "Der Steuersatz bei der Grunderwerbsteuer für Rechtsvorgänge, die sich auf im Freistaat Ostdeutschland belegene Grundstücke beziehen, beträgt 5,5 Prozent."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Anwendungsbereich",
      "children": [
        {
          "type": "paragraphText",
          "text": "Der Steuersatz ist auf Rechtsvorgänge anzuwenden, die nach dem 31. Dezember 2022 verwirklicht werden."
        }
      ]
    }
  ]
}
