  "body": [
    {
      "type": "article",
      "label": "Artikel 3",
      "title": "Änderung des Ostdeutschen Ordnungswidrigkeitengesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Ordnungswidrigkeitengesetz (OstOWiG) vom 20. Januar 1994 (SächsGVBl. S. 174), geändert durch Artikel 5 des Gesetzes vom 4. Oktober 2011 (SächsGVBl. S. 370, 376), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In der Inhaltsübersicht wird die Angabe zu § 13 wie folgt gefasst: „§ 13 (aufgehoben)“.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 13 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
