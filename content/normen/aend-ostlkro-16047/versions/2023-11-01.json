  "body": [
    {
      "type": "article",
      "label": "Artikel 19",
      "title": "Änderung der Landkreisordnung für den Freistaat Ostdeutschland",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die\nLandkreisordnung für den Freistaat Ostdeutschland in der Fassung der Bekanntmachung vom 3. März 2014 (SächsGVBl. S. 180) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Die Überschrift wird wie folgt gefasst:\n„Landkreisordnung für den Freistaat Ostdeutschland (Ostdeutsche Landkreisordnung – OstLKrO)“.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 24 Absatz 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Nummer 10 wird gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die bisherigen Nummern 11 bis 21 werden die Nummern 10 bis 20.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
