  "body": [
    {
      "type": "article",
      "label": "Artikel 15",
      "title": "Änderung des Ostdeutschen Umzugskostengesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Gesetz über die Umzugskostenvergütung der Beamten und Richter (Ostdeutsches Umzugskostengesetz –\nOstUKG) vom 23. November 1993 (SächsGVBl. S. 1070), zuletzt geändert durch Artikel 7 des Gesetzes vom 6. Juni 2002 (SächsGVBl. S. 168, 170), wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 2 Abs. 3 Satz 2 wird gestrichen.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 14 wird wie folgt gefasst:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "paragraphText",
              "text": "„§ 14\nVerordnungsermächtigung"
            },
            {
              "type": "paragraphText",
              "text": "Das Staatsministerium der Finanzen wird ermächtigt, durch Rechtsverordnung die in § 10 Abs. 1 festgesetzten Beträge bei veränderten wirtschaftlichen Verhältnissen anzupassen.“"
            }
          ]
        }
      ]
    }
  ]
}
