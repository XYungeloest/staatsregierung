  "body": [
    {
      "type": "paragraphText",
      "text": "Die Ostdeutsche Staatsregierung hat am 23. September 2024 die folgende Verordnung erlassen:"
    },
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Änderung der Fachbereichszuteilungen",
      "children": [
        {
          "type": "paragraphText",
          "text": "Der Fachbereich „Angelegenheiten der nationalen Minderheit der Sorbinnen und Sorben“ wird der Staatskanzlei zugeordnet."
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Inkrafttreten, Außerkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Verordnung tritt am Tage der Verkündung in Kraft."
        }
      ]
    }
  ]
}
