  "body": [
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung des Finanzausgleichsmassengesetzes 2023/2024",
      "children": [
        {
          "type": "paragraphText",
          "text": "§ 1 Absatz 2 des Finanzausgleichsmassengesetzes 2023/2024 vom 20. Dezember 2022 (SächsGVBl. S. 743) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "In Satz 1 wird die Angabe „4 207 339 600 Euro“ durch die Angabe „4 340 479 600 Euro“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Satz 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "In Nummer 6 wird das Wort „und“ durch ein Komma ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "In Nummer 7 wird der Punkt am Ende durch das Wort „und“ ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Folgende Nummer 8 wird angefügt:",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "item",
                  "label": "„8.",
                  "text": "ein Erhöhungsbetrag aus dem Ist-Ergebnis des Haushaltsjahres 2022 in Höhe von 133 140 000 Euro.“",
                  "level": 2,
                  "numberingStyle": "decimal",
                  "children": []
                }
              ]
            }
          ]
        }
      ]
    }
  ]
}
