  "body": [
    {
      "type": "paragraphText",
      "text": "Der Ostdeutsche Landtag hat am 6. März 2025 folgendes Gesetz beschlossen."
    },
    {
      "type": "article",
      "label": "Artikel 1",
      "title": "Änderung der Verfassung des Ostdeutschen Freistaates",
      "children": [
        {
          "type": "paragraphText",
          "text": "Die Verfassung des Ostdeutschen Freistaates vom 15.10.2024, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Der Artikel 114 wird wie folgt geändert:",
          "level": 0,
          "listId": "source-outline",
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a.",
              "text": "Der Artikel wird in „Artikel 114 Demokratiegebot“ umbenannt.",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b.",
              "text": "Der Absatz 1 wird wie folgt neu gefasst:",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "subparagraph",
                      "label": "(1)",
                      "text": "Keinerlei Verfassungs- oder Gesetzes- oder Verordnungsänderung oder -einführung darf den Grundgedanken des demokratischen, republikanischen Rechtsstaates und der parlamentarischen Staatsform antasten.",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "c.",
              "text": "Dem Artikel wird ein folgender Absatz 2 angefügt:",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "subparagraph",
                      "label": "(2)",
                      "text": "Die Errichtung einer Diktatur, unabhängig der Form, ist verboten.",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "d.",
              "text": "Dem Artikel wird ein folgender Absatz 3 angefügt:",
              "level": 1,
              "listId": "source-outline",
              "numberingStyle": "lower-latin",
              "children": [
                {
                  "type": "quotedProvision",
                  "children": [
                    {
                      "type": "subparagraph",
                      "label": "(3)",
                      "text": "Den in Absatz 1 und 2 genannten Vorschriften widersprechende Gesetze, Verordnungen und Beschlüsse sind nicht auszuarbeiten, nicht zu verkünden, oder, bei vorausgegangener Verkündung, nicht zu befolgen.",
                      "children": []
                    }
                  ]
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "type": "article",
      "label": "Artikel 2",
      "title": "Inkrafttreten",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Gesetz tritt am Tage seiner Verkündung in Kraft."
        }
      ]
    }
  ]
}
