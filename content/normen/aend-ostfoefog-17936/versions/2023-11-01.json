  "body": [
    {
      "type": "article",
      "label": "Artikel 4",
      "title": "Änderung des Ostdeutschen Förderfondsgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Förderfondsgesetz vom 15. Dezember 2010 (SächsGVBl. S. 387, 389), das zuletzt durch Artikel 13 des Gesetzes vom 29. April 2015 (SächsGVBl. S. 349) geändert worden ist, wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 1 Absatz 1 Nummer 4 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "§ 2 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 1 Nummer 4 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "In Absatz 3 wird die Angabe „§ 1 Abs. 1“ durch die Angabe „§ 1 Absatz 1“ und die Angabe „§ 1 Abs. 1 Nr. 1“ wird durch die Wörter „§ 1 Absatz 1 Nummer 1“ ersetzt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "3.",
          "text": "In § 3 Absatz 5 Satz 1 wird die Angabe „§ 1 Abs. 1“ durch die Angabe „§ 1 Absatz 1“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "§ 4 Absatz 1 Satz 1 Nummer 4 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "§ 5 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Absatz 1 Satz 3 wird aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die Absätze 2 und 4 werden aufgehoben.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "c)",
              "text": "Absatz 3 wird Absatz 2.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "d)",
              "text": "Absatz 5 wird Absatz 3.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Die §§ 7 und 8 werden aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "7.",
          "text": "In § 9 Satz 1 Nummer 2 wird die Angabe „§ 3 Abs. 1“ durch die Angabe „§ 3 Absatz 1“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "8.",
          "text": "Anlage 4 wird aufgehoben.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
