  "body": [
    {
      "type": "article",
      "label": "Artikel 14",
      "title": "Änderung des Ostdeutschen Schulgesetzes",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Ostdeutsche Schulgesetz in der Fassung der Bekanntmachung vom 27. September 2018 (SächsGVBl. S. 648) wird wie folgt geändert:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "§ 3b Absatz 2 Satz 1 wird wie folgt geändert:",
          "level": 0,
          "numberingStyle": "decimal",
          "children": [
            {
              "type": "item",
              "label": "a)",
              "text": "Vor dem Wort „Schulträgern“ werden die Wörter „öffentlichen und freien“ eingefügt.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            },
            {
              "type": "item",
              "label": "b)",
              "text": "Die Wörter „gemäß § 3 Absatz 2 Satz 1 Nummer 1“ werden gestrichen.",
              "level": 1,
              "numberingStyle": "lower-latin",
              "children": []
            }
          ]
        },
        {
          "type": "item",
          "label": "2.",
          "text": "In § 63b Absatz 5 Satz 1 werden die Wörter „im Jahr 2018“ durch die Wörter „in den Jahren 2018, 2020 sowie 2021“ ersetzt.",
          "level": 0,
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    }
  ]
}
