  "body": [
    {
      "type": "section",
      "label": "Abschnitt 1",
      "title": "Euro-bedingte Änderungen",
      "children": [
        {
          "type": "article",
          "label": "Artikel 1",
          "title": "Änderung des Abgeordnetengesetzes",
          "children": [
            {
              "type": "paragraphText",
              "text": "Das Gesetz über die Rechtsverhältnisse der Mitglieder des Ostdeutschen Landtages (Abgeordnetengesetz) in der Fassung der Bekanntmachung vom 4. Juli 2000 (SächsGVBl. S. 326) wird wie folgt geändert:"
            },
            {
              "type": "item",
              "label": "1.",
              "text": "In § 5 Abs. 1 wird die Angabe „7 712 DM“ durch die Angabe „3 943,08 EUR“ ersetzt.",
              "level": 0,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "2.",
              "text": "§ 6 Abs. 2 wird wie folgt geändert:",
              "level": 0,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "a)",
                  "text": "In Nummer 1 wird die Angabe „2 160 DM“ durch die Angabe „1 104,39 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "b)",
                  "text": "Nummer 2 wird wie folgt geändert:",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": [
                    {
                      "type": "item",
                      "label": "aa)",
                      "text": "Die Angabe „1 200 DM“ wird durch die Angabe „613,55 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "bb)",
                      "text": "Die Angabe „110 DM“ wird durch die Angabe „56,24 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "cc)",
                      "text": "Die Angabe „400 DM“ wird durch die Angabe „204,52 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    }
                  ]
                }
              ]
            },
            {
              "type": "item",
              "label": "3.",
              "text": "In § 6 Abs. 2a Satz 1 wird die Angabe „0,52 DM“ durch die Angabe „0,27 EUR“ ersetzt.",
              "level": 0,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "4.",
              "text": "§ 6 Abs. 6 Satz 1 wird wie folgt geändert:",
              "level": 0,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "a)",
                  "text": "Die Angabe „900,00 DM“ wird durch die Angabe „460,16 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "b)",
                  "text": "Die Angabe „450,00 DM“ wird durch die Angabe „230,08 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "c)",
                  "text": "Die Angabe „300,00 DM“ wird durch die Angabe „153,39 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "d)",
                  "text": "Die Angabe „600,00 DM“ wird durch die Angabe „306,78 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "e)",
                  "text": "Die Angabe „650,00 DM“ wird jeweils durch die Angabe „332,34 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "5.",
              "text": "In § 6 Abs. 7 wird die Angabe „5 600 DM“ durch die Angabe „2 863,23 EUR“ ersetzt.",
              "level": 0,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "6.",
              "text": "§ 8 wird wie folgt geändert:",
              "level": 0,
              "numberingStyle": "decimal",
              "children": [
                {
                  "type": "item",
                  "label": "a)",
                  "text": "Absatz 1 wird wie folgt geändert:",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": [
                    {
                      "type": "item",
                      "label": "aa)",
                      "text": "In Satz 3 wird die Angabe „70 DM“ durch die Angabe „35,79 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "bb)",
                      "text": "In Satz 4 wird die Angabe „30 DM“ durch die Angabe „15,34 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    },
                    {
                      "type": "item",
                      "label": "cc)",
                      "text": "In Satz 5 wird die Angabe „120 DM“ durch die Angabe „61,36 EUR“ ersetzt.",
                      "level": 2,
                      "numberingStyle": "lower-latin",
                      "children": []
                    }
                  ]
                },
                {
                  "type": "item",
                  "label": "b)",
                  "text": "In Absatz 2 Satz 1 wird die Angabe „40 DM“ durch die Angabe „20,45 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                },
                {
                  "type": "item",
                  "label": "c)",
                  "text": "In Absatz 3 Satz 2 wird die Angabe „70 DM“ durch die Angabe „35,79 EUR“ ersetzt.",
                  "level": 1,
                  "numberingStyle": "lower-latin",
                  "children": []
                }
              ]
            },
            {
              "type": "item",
              "label": "7.",
              "text": "In § 9 Satz 1 wird die Angabe „30 DM“ durch die Angabe „15,34 EUR“ ersetzt.",
              "level": 0,
              "numberingStyle": "decimal",
              "children": []
            },
            {
              "type": "item",
              "label": "8.",
              "text": "In § 27 werden die Worte „Deutsche Mark“ durch das Wort „Euro“ ersetzt.",
              "level": 0,
              "numberingStyle": "decimal",
              "children": []
            }
          ]
        }
      ]
    }
  ]
}
