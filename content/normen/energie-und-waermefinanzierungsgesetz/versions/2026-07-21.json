{
  "versionId": "2026-07-21",
  "validFrom": "2026-07-21",
  "validTo": null,
  "isCurrent": true,
  "citation": "Gesetz vom 20. Juli 2026 (OGVBl. 2026 Nr. 49)",
  "changeNote": "Eingeführte Stammfassung.",
  "body": [
    {
      "type": "paragraph",
      "label": "§ 1",
      "title": "Errichtung des Sondervermögens",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Es wird ein Sondervermögen des Freistaates Ostdeutschland mit der Bezeichnung „Sondervermögen Energie- und Wärmevergesellschaftung“ errichtet.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Das Sondervermögen ist nicht rechtsfähig. Es wird vom Staatsministerium der Finanzen verwaltet.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 2",
      "title": "Zweck",
      "children": [
        {
          "type": "paragraphText",
          "text": "Das Sondervermögen dient"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "der Finanzierung von Entschädigungen nach dem Energie- und Wärmevergesellschaftungsgesetz,",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "der Absicherung von Schuldverschreibungen,",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "der Finanzierung von Investitionen in Strom-, Gas- und Wärmeinfrastruktur,",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "der Finanzierung der Dekarbonisierung überführter Anlagen,",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "der Finanzierung von Transformations-, Stilllegungs- und Rückbaumaßnahmen,",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "der Kapitalausstattung der Ostdeutsche Netze und der Landesenergiewerke Ost.",
          "level": 0,
          "listId": "kwdt8jp5z6e3",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 3",
      "title": "Einnahmen",
      "children": [
        {
          "type": "paragraphText",
          "text": "Dem Sondervermögen fließen zu:"
        },
        {
          "type": "item",
          "label": "1.",
          "text": "Zuführungen aus dem Landeshaushalt,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "2.",
          "text": "Kreditmittel,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "3.",
          "text": "Rückflüsse aus Schuldverschreibungen,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "4.",
          "text": "Überschüsse der Trägerinnen des Gemeineigentums, soweit sie nicht für deren unmittelbare Aufgaben benötigt werden,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "5.",
          "text": "Einnahmen aus öffentlichen Energie- und Wärmebeteiligungen,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "6.",
          "text": "Mittel der Europäischen Union, des Bundes und sonstiger öffentlicher Stellen,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "7.",
          "text": "zweckgebundene Abgaben, soweit sie durch Gesetz bestimmt werden,",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        },
        {
          "type": "item",
          "label": "8.",
          "text": "sonstige Einnahmen.",
          "level": 0,
          "listId": "yaltz66hwacr",
          "numberingStyle": "decimal",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 4",
      "title": "Kredit- und Garantieermächtigung",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Das Staatsministerium der Finanzen wird ermächtigt, für das Sondervermögen Kredite aufzunehmen, soweit dies zur Erfüllung der Zwecke nach § 2 erforderlich ist.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der Freistaat Ostdeutschland kann Garantien, Bürgschaften und Gewährleistungen für Schuldverschreibungen und Finanzierungsinstrumente der Ostdeutsche Netze und der Landesenergiewerke Ost übernehmen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Das Haushaltsgesetz bestimmt für jedes Haushaltsjahr die Höchstbeträge der Kreditaufnahme, der Verpflichtungsermächtigungen sowie der Garantien, Bürgschaften und Gewährleistungen nach diesem Gesetz.",
          "children": []
        }
      ]
    },
    {
      "type": "paragraph",
      "label": "§ 5",
      "title": "Wirtschaftsplan",
      "children": [
        {
          "type": "subparagraph",
          "label": "(1)",
          "text": "Für das Sondervermögen ist für jedes Haushaltsjahr ein Wirtschaftsplan aufzustellen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(2)",
          "text": "Der Wirtschaftsplan ist dem Haushaltsplan als Anlage beizufügen.",
          "children": []
        },
        {
          "type": "subparagraph",
          "label": "(3)",
          "text": "Der Wirtschaftsplan hat eine mehrjährige Finanzierungsübersicht zu enthalten. Diese umfasst insbesondere die voraussichtlichen Entschädigungsleistungen, Investitionsausgaben, Transformationskosten, Schuldendienstleistungen und Rückflüsse.",
          "children": []
        }
      ]
    }
  ]
}
