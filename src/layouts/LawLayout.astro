---
import '../styles/global.css';
import AnalyticsConsentBanner from '../components/analytics/AnalyticsConsentBanner.astro';
import PageHead from '../components/PageHead.astro';
import PortalIcon from '../components/portal/PortalIcon.astro';
import { isAnalyticsEnabled } from '../config/analytics.ts';
import { lawSiteConfig } from '../config/site.ts';
import type { SeoBreadcrumbItem, SeoImage, StructuredData } from '../lib/seo/index.ts';
import {
  getAccessibilityUrl,
  getHomeUrl,
  getImprintUrl,
  getPrivacyUrl,
} from '../lib/portal/routes.ts';
import {
  getHelpUrl,
  getLawPortalUrl,
  getSearchUrl,
} from '../lib/norms/routes.ts';

interface Props {
  title: string;
  description?: string;
  scripts?: ('portal-modules')[];
  breadcrumbs?: SeoBreadcrumbItem[];
  structuredData?: StructuredData | StructuredData[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: SeoImage;
  mainWidth?: 'contained' | 'full';
}

const {
  title,
  description = lawSiteConfig.seo.defaultDescription,
  scripts = [],
  breadcrumbs = [],
  structuredData,
  noindex = false,
  ogType = 'website',
  ogImage = lawSiteConfig.seo.defaultSocialImage,
  mainWidth = 'contained',
} = Astro.props;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const coatOfArmsAssetUrl = `${base}${lawSiteConfig.officialCoatOfArmsAssetPath.replace(/^\//, '')}`;
const smallFlagAssetUrl = `${base}${lawSiteConfig.officialFlagSmallAssetPath.replace(/^\//, '')}`;
const analyticsEnabled = isAnalyticsEnabled();
const loadPortalModules = scripts.includes('portal-modules');

function isActivePath(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path);
}

const mainNavLinks = lawSiteConfig.mainNavigation.map((entry) => {
  const href = `${base}${lawSiteConfig.paths[entry.pathKey].replace(/^\//, '')}`;
  return { href, label: entry.label, isActive: isActivePath(lawSiteConfig.paths[entry.pathKey]) };
});

const footerResearchLinks = [
  ...mainNavLinks.filter((link) => ['Suche', 'A–Z', 'Sachgebiete', 'Verkündungen'].includes(link.label)),
  { href: getHelpUrl(), label: 'Hilfe', isActive: isActivePath(lawSiteConfig.paths.help) },
];
const footerStateLinks = [
  { href: getHomeUrl(), label: 'Staatsportal' },
  { href: getImprintUrl(), label: 'Impressum' },
  { href: getPrivacyUrl(), label: 'Datenschutz' },
  { href: getAccessibilityUrl(), label: 'Barrierefreiheit' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <PageHead {title} {description} {breadcrumbs} {structuredData} {noindex} {ogType} {ogImage} />
  </head>
  <body class="law-site">
    <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
    <div class="page-shell law-shell">
      <div class="site-notice law-notice" role="note" aria-label="Hinweis zum Rechtsportal">
        <div class="container site-notice__inner">
          <div class="site-notice__flag">
            <img src={smallFlagAssetUrl} alt="" width="480" height="288" />
          </div>
          <p>{lawSiteConfig.simulationNotice}</p>
        </div>
      </div>

      <header class="law-header">
        <div class="container law-header__identity">
          <a class="law-wordmark" href={getLawPortalUrl()} aria-label="Startseite OstRecht">
            <img src={coatOfArmsAssetUrl} alt="" width="596" height="694" />
            <span>
              <strong>{lawSiteConfig.brand}</strong>
              <small>{lawSiteConfig.subtitle}</small>
            </span>
          </a>
          <a class="law-header__state-link" href={getHomeUrl()}>
            <PortalIcon name="arrow" />
            <span>Staatsportal</span>
          </a>
        </div>

        <div class="law-header__navigation">
          <div class="container law-header__navigation-inner">
            <nav class="law-main-nav" aria-label="Hauptnavigation Rechtsportal">
              <a href={getLawPortalUrl()} aria-current={currentPath === '/' ? 'page' : undefined}>Start</a>
              {mainNavLinks.map((link) => (
                <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>{link.label}</a>
              ))}
            </nav>
            <form class="law-header-search" action={getSearchUrl()} method="get" role="search">
              <label class="visually-hidden" for="law-header-search">{lawSiteConfig.searchLabel}</label>
              <input id="law-header-search" type="search" name="q" autocomplete="off" placeholder="Recht durchsuchen" />
              <button type="submit" aria-label="Rechtssuche starten"><PortalIcon name="search" /></button>
            </form>
            <details class="law-mobile-nav">
              <summary><PortalIcon name="menu" /><span>Menü</span></summary>
              <div class="law-mobile-nav__panel">
                <form action={getSearchUrl()} method="get" role="search">
                  <label for="law-mobile-search">{lawSiteConfig.searchLabel}</label>
                  <div>
                    <input id="law-mobile-search" type="search" name="q" autocomplete="off" placeholder="Recht durchsuchen" />
                    <button type="submit">Suchen</button>
                  </div>
                </form>
                <nav aria-label="Mobile Navigation Rechtsportal">
                  <a href={getLawPortalUrl()} aria-current={currentPath === '/' ? 'page' : undefined}>Start</a>
                  {mainNavLinks.map((link) => (
                    <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>{link.label}</a>
                  ))}
                  <a href={getHelpUrl()} aria-current={isActivePath(lawSiteConfig.paths.help) ? 'page' : undefined}>Hilfe</a>
                  <a href={getHomeUrl()}>Staatsportal</a>
                </nav>
              </div>
            </details>
          </div>
        </div>
      </header>

      <main id="main-content" class:list={['law-main', mainWidth === 'contained' ? 'container' : 'law-main--full']}>
        <slot />
      </main>

      <footer class="law-footer">
        <div class="container law-footer__grid">
          <section>
            <a class="law-footer__brand" href={getLawPortalUrl()}>
              <img src={coatOfArmsAssetUrl} alt="" width="596" height="694" />
              <span><strong>{lawSiteConfig.brand}</strong><small>{lawSiteConfig.subtitle}</small></span>
            </a>
            <p>{lawSiteConfig.footerNote}</p>
            <p class="law-footer__simulation">{lawSiteConfig.simulationNotice}</p>
          </section>
          <section>
            <h2>Recherchieren</h2>
            <nav aria-label="Recherchewege im Footer">
              {footerResearchLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </nav>
          </section>
          <section>
            <h2>Freistaat</h2>
            <nav aria-label="Staatsportal und rechtliche Hinweise">
              {footerStateLinks.map((link) => <a href={link.href}>{link.label}</a>)}
            </nav>
          </section>
        </div>
        <div class="container law-footer__bottom">
          <span>{lawSiteConfig.seo.siteName}</span>
          {analyticsEnabled ? (
            <button type="button" class="text-link-button" data-analytics-consent-reset>Datenschutzeinstellungen</button>
          ) : null}
        </div>
      </footer>
    </div>
    {analyticsEnabled ? <AnalyticsConsentBanner /> : null}
    {analyticsEnabled ? <script>import '../scripts/analytics-consent.ts';</script> : null}
    {loadPortalModules ? <script>import '../scripts/portal-modules.ts';</script> : null}
    <script>import '../scripts/global.ts';</script>
  </body>
</html>
