---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import { getHomeUrl, getLawSearchUrl, getPortalSearchUrl } from '../lib/portal/index.ts';

const indexUrl = `${import.meta.env.BASE_URL}search-index.json`;
---

<BaseLayout
  title="Suche"
  description="Durchsuchen Sie Themen, Gesetze, Pressemitteilungen, Personen, Ressorts und Servicehinweise im Ostdeutschen Freistaat."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Suche', href: getPortalSearchUrl() },
  ]}
  noindex={true}
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Suche' }]} />

  <section class="section page-header">
    <p class="eyebrow">Portalsuche</p>
    <h1>Wonach suchen Sie?</h1>
    <p class="lead">
      Durchsuchen Sie Themen, Gesetze, Pressemitteilungen, Personen, Ressorts und Servicehinweise.
    </p>
  </section>

  <section class="section search-shell" data-portal-search-root data-index-url={indexUrl}>
    <form class="search-form" method="get" action={getPortalSearchUrl()} data-portal-search-form>
      <div class="search-form__primary">
        <label class="search-field">
          <span>Suchbegriff eingeben</span>
          <input
            type="search"
            name="q"
            autocomplete="off"
            placeholder="Suchbegriff eingeben, z. B. Kreisreform, Kulturpass, Wohnvergesellschaftung"
            data-portal-search-query
          />
        </label>
      </div>
      <div class="search-form__filters">
        <label class="search-field">
          <span>Bereich</span>
          <select name="type" data-portal-search-type>
            <option value="">Alle Bereiche</option>
            <option value="government">Staatsregierung</option>
            <option value="ministry">Ressorts</option>
            <option value="topic">Themen</option>
            <option value="press">Pressemitteilungen</option>
            <option value="speech">Reden</option>
            <option value="event">Termine</option>
            <option value="budget">Haushalt</option>
            <option value="freestate">Über den Freistaat</option>
            <option value="service">Service</option>
            <option value="job">Karriere</option>
            <option value="law">Recht</option>
          </select>
        </label>
        <label class="search-field">
          <span>Sortierung</span>
          <select name="sort" data-portal-search-sort>
            <option value="relevance">Relevanz</option>
            <option value="latest">Aktualität</option>
          </select>
        </label>
      </div>
      <div class="search-form__actions">
        <button class="button-link" type="submit">Suchen</button>
        <a class="button-link button-link--secondary" href={getLawSearchUrl()}>Nur im Recht suchen</a>
      </div>
    </form>

    <p class="search-feedback search-feedback--hint" data-portal-search-status role="status" aria-live="polite">
      Wonach suchen Sie? Geben Sie einen Begriff ein, zum Beispiel Kreisreform, Haushalt, Kabinett, Kultur, Gesetz oder Bezirk.
    </p>
    <p class="search-feedback search-feedback--examples" data-portal-search-examples>
      Beispiele: Kreisreform, Kulturpass, Wohnvergesellschaftung, Kabinett, OGVBl.
    </p>
    <p class="search-feedback search-feedback--warning" data-portal-search-empty hidden>
      Keine Treffer gefunden. Prüfen Sie die Schreibweise oder suchen Sie nur in einem bestimmten Bereich.
    </p>
    <p class="search-feedback search-feedback--warning" data-portal-search-error hidden>
      Die Suche ist derzeit nicht erreichbar. Nutzen Sie vorübergehend die Bereiche Recht, Themen, Presse und Service.
    </p>
    <h2 id="portal-search-results-heading" class="visually-hidden">Suchergebnisse</h2>
    <ol
      class="record-list search-results__list"
      data-portal-search-results
      aria-labelledby="portal-search-results-heading"
    ></ol>
    <p class="search-results__more" data-portal-search-more-wrap hidden>
      <button class="button-link button-link--secondary" type="button" data-portal-search-more>
        Weitere Treffer laden
      </button>
    </p>
  </section>

  <script>
    import '../scripts/portal-search-page.ts';
  </script>
</BaseLayout>
