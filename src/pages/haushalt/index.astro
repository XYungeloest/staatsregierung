---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BudgetKpiCards from '../../components/portal/BudgetKpiCards.astro';
import BudgetSectionNav from '../../components/portal/BudgetSectionNav.astro';
import BudgetTaskAreaChart from '../../components/portal/BudgetTaskAreaChart.astro';
import BudgetYearSelector from '../../components/portal/BudgetYearSelector.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import {
  budgetPlans,
  budgetSpecialInstruments,
  budgetTotals,
  getBudgetShare,
  getBudgetTaskAreas,
} from '../../data/haushalt.ts';
import { formatEuroCompact, formatPercent } from '../../lib/portal/modules.ts';
import { getBudgetPageUrl, getBudgetPlanUrl, getBudgetUrl, getHomeUrl } from '../../lib/portal/routes.ts';
import { buildDatasetJsonLd } from '../../lib/seo/index.ts';

const ressortPlans = budgetPlans
  .filter((plan) => plan.category === 'Ressort')
  .sort((left, right) => right.amounts['2026'].expenses - left.amounts['2026'].expenses);
const financePlan = budgetPlans.find((plan) => plan.number === '20');
const totalChange = budgetTotals['2026'].expenses - budgetTotals['2025'].expenses;
const investmentChange = budgetTotals['2026'].investments - budgetTotals['2025'].investments;
const taxChange = budgetTotals['2026'].tax - budgetTotals['2025'].tax;
const taskAreas = getBudgetTaskAreas();
---

<BaseLayout
  title="Doppelhaushalt 2025/2026"
  description="Das Haushaltsportal zum Doppelhaushalt 2025/2026 mit Gesamtplan, Einzelplänen und Sondervermögen."
  scripts={['portal-modules']}
  structuredData={buildDatasetJsonLd({
    name: 'Doppelhaushalt 2025/2026 des Ostdeutschen Freistaates',
    description: 'Einnahmen, Ausgaben, Investitionen, Einzelpläne und Sondervermögen des Doppelhaushalts 2025/2026.',
    url: getBudgetUrl(),
    distributionUrl: '/haushalt/daten.csv',
  }, Astro.site)}
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Haushalt' }]} />

  <SectionHero
    eyebrow="Haushaltsportal"
    title="Doppelhaushalt 2025/2026"
    lead="Einnahmen, Ausgaben, Investitionen, Einzelpläne und Sondervermögen des Ostdeutschen Freistaates."
    variant="budget"
    facts={[
      { label: 'Ausgaben 2026', value: formatEuroCompact(budgetTotals['2026'].expenses) },
      { label: 'Investitionen 2026', value: formatEuroCompact(budgetTotals['2026'].investments) },
      { label: 'Einzelpläne', value: String(budgetPlans.length) },
      { label: 'Sonderinstrumente', value: String(budgetSpecialInstruments.length) },
    ]}
    actions={[{ label: 'Haushaltsdaten herunterladen', href: `${import.meta.env.BASE_URL}haushalt/daten.csv`, primary: true }]}
  />
  <BudgetSectionNav current="portal" />

  <section class="section budget-dashboard" data-budget-year-switcher data-visual-section="budget-year-kpis" aria-labelledby="haushaltsstand">
    <div class="section-header section-header--with-control">
      <div>
        <h2 id="haushaltsstand">Haushaltsstand im Überblick</h2>
        <p>Wählen Sie ein Haushaltsjahr oder den direkten Vergleich. Alle Kennzahlen beziehen sich auf den Kernhaushalt.</p>
      </div>
      <BudgetYearSelector id="portal-year" label="Haushaltsjahr" />
    </div>
    <p class="visually-hidden" data-budget-year-status role="status" aria-live="polite"></p>

    {(['2025', '2026'] as const).map((year) => (
      <div class="budget-year-content" data-budget-year-content={year} hidden={year !== '2026'}>
        <BudgetKpiCards year={year} amounts={budgetTotals[year]} specialInstrumentCount={budgetSpecialInstruments.length} />
        <div class="budget-explanation-grid">
          <article class="budget-explanation-card">
            <span class="meta-label">Einordnung {year}</span>
            <h3>Was prägt diesen Haushalt?</h3>
            <p>
              Zuweisungen und Zuschüsse bilden mit {formatPercent(getBudgetShare(budgetTotals[year].transfers, budgetTotals[year].expenses) ?? 0)}
              {' '}den größten Ausgabenblock. Die Investitionen und Investitionsförderung betragen
              {' '}{formatPercent(getBudgetShare(budgetTotals[year].investments, budgetTotals[year].expenses) ?? 0)} der Gesamtausgaben.
            </p>
          </article>
          <article class="budget-explanation-card">
            <span class="meta-label">Haushaltsstruktur</span>
            <h3>Was die Kennzahlen nicht zeigen</h3>
            <p>
              Die Einzelpläne ordnen Ausgaben nach Verwaltungsbereichen. Sie sind keine Rangfolge politischer Bedeutung.
              Zentral gebündelte Mittel, etwa in der Allgemeinen Finanzverwaltung, werden daher gesondert eingeordnet.
            </p>
          </article>
        </div>
      </div>
    ))}

    <div class="budget-year-content" data-budget-year-content="vergleich" hidden>
      <div class="budget-comparison-grid" aria-label="Vergleich zentraler Haushaltskennzahlen 2025 und 2026">
        <article>
          <span class="meta-label">Gesamtausgaben</span>
          <strong>{formatEuroCompact(budgetTotals['2025'].expenses)}</strong>
          <span>2025</span>
          <strong>{formatEuroCompact(budgetTotals['2026'].expenses)}</strong>
          <span>2026 · Veränderung {formatEuroCompact(totalChange)}</span>
        </article>
        <article>
          <span class="meta-label">Investitionen und Investitionsförderung</span>
          <strong>{formatEuroCompact(budgetTotals['2025'].investments)}</strong>
          <span>2025</span>
          <strong>{formatEuroCompact(budgetTotals['2026'].investments)}</strong>
          <span>2026 · Veränderung {formatEuroCompact(investmentChange)}</span>
        </article>
        <article>
          <span class="meta-label">Steuereinnahmen</span>
          <strong>{formatEuroCompact(budgetTotals['2025'].tax)}</strong>
          <span>2025</span>
          <strong>{formatEuroCompact(budgetTotals['2026'].tax)}</strong>
          <span>2026 · Veränderung {formatEuroCompact(taxChange)}</span>
        </article>
      </div>
      <p class="detail-line">Der Vergleich zeigt absolute Ansätze. Die Ausgabenstruktur und alle Ausgabearten stehen im <a class="inline-link" href={getBudgetPageUrl('gesamtplan')}>Gesamtplan</a>.</p>
    </div>
  </section>

  <section class="section" aria-labelledby="aufgabenbereiche">
    <BudgetTaskAreaChart areas={taskAreas} year="2026" />
  </section>

  <section class="section section-muted" aria-labelledby="ressortvergleich" data-visual-section="budget-table">
    <div class="section-header">
      <h2 id="ressortvergleich">Ressortübergreifender Überblick</h2>
      <p>Ausgaben der Ressort-Einzelpläne im Haushalt 2026. Die Tabelle zeigt den Anteil am Gesamthaushalt, keine Bewertung der politischen Priorität oder Mittelversorgung.</p>
    </div>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Ressortausgaben im Haushalt 2026">
      <table class="data-table budget-portal-table">
        <caption>Ausgaben im Vergleich der Ressort-Einzelpläne</caption>
        <thead>
          <tr><th scope="col">Einzelplan</th><th scope="col">Ressort</th><th scope="col">Ausgaben 2026</th><th scope="col">Anteil am Gesamthaushalt</th><th scope="col">Details</th></tr>
        </thead>
        <tbody>
          {ressortPlans.slice(0, 8).map((plan) => (
            <tr>
              <td>{plan.number}</td>
              <td><strong>{plan.title}</strong></td>
              <td>{formatEuroCompact(plan.amounts['2026'].expenses)}</td>
              <td>{formatPercent(getBudgetShare(plan.amounts['2026'].expenses, budgetTotals['2026'].expenses) ?? 0)}</td>
              <td><a class="inline-link" href={getBudgetPlanUrl(plan.number)}>Einzelplan öffnen</a></td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
    {financePlan ? (
      <aside class="budget-context-note">
        <strong>Allgemeine Finanzverwaltung getrennt betrachten</strong>
        <span>Einzelplan 20 bündelt unter anderem Steuereinnahmen, kommunalen Finanzausgleich, Versorgung und Beteiligungen. Sein Volumen ist deshalb nicht mit einem Ressorthaushalt gleichzusetzen. <a class="inline-link" href={getBudgetPlanUrl(financePlan.number)}>Einordnung öffnen</a></span>
      </aside>
    ) : null}
  </section>

  <section class="section" aria-labelledby="zugang-haushalt">
    <div class="section-header">
      <h2 id="zugang-haushalt">Den Haushalt erschließen</h2>
      <p>Die Bereiche folgen der Struktur der Haushaltsunterlagen und machen die jeweiligen Bezugsgrößen sichtbar.</p>
    </div>
    <ul class="direct-entry-list">
      <li><strong>Gesamtplan</strong><span><a class="inline-link" href={getBudgetPageUrl('gesamtplan')}>Einnahmen, Ausgabenarten und Jahresvergleich</a></span></li>
      <li><strong>Einzelpläne</strong><span><a class="inline-link" href={getBudgetPageUrl('einzelplaene')}>Verwaltungsbereiche, Veränderungen und Haushaltsanteile</a></span></li>
      <li><strong>Sondervermögen und Fonds</strong><span><a class="inline-link" href={getBudgetPageUrl('sondervermoegen')}>Zweck, Zuständigkeit und Bezug zum Kernhaushalt</a></span></li>
    </ul>
    <p class="detail-line">{budgetSpecialInstruments.length} rechtlich belegte Instrumente sind im Bereich Sondervermögen und Fonds eingeordnet.</p>
  </section>
</BaseLayout>
