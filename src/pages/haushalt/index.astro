---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import BudgetExplorer from '../../components/portal/BudgetExplorer.astro';
import BudgetKpiGrid from '../../components/portal/BudgetKpiGrid.astro';
import BudgetMethodology from '../../components/portal/BudgetMethodology.astro';
import {
  budgetExplorerEntries,
  budgetSpecialFunds,
  budgetSummaryRows,
} from '../../data/dashboard/budget.ts';
import {
  getBudgetPageUrl,
  getHomeUrl,
} from '../../lib/portal/index.ts';
import { loadBudgetPages } from '../../lib/portal/content.ts';
import { getNormUrl } from '../../lib/norms/index.ts';

const pages = await loadBudgetPages();
const orderedPages = ['gesamtplan', 'einzelplaene', 'sondervermoegen']
  .map((slug) => pages.find((page) => page.slug === slug))
  .filter((page): page is NonNullable<typeof page> => Boolean(page));
---

<BaseLayout
  title="Haushalt"
  description="Doppelhaushalt 2025/2026 mit Gesamtüberblick, Einzelplänen, Einnahmen, Investitionen und Sondervermögen des Ostdeutschen Freistaates."
  scripts={['portal-modules']}
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Haushalt' }]} />

  <section class="section page-header">
    <p class="eyebrow">Haushalt</p>
    <h1>Haushalt des Ostdeutschen Freistaates</h1>
    <p class="lead">
      Der Doppelhaushalt 2025/2026 zeigt, wofür der Freistaat Mittel einsetzt, welche Ressorts
      welche Einzelpläne verantworten und wie Investitionen, Sondervermögen und laufende Ausgaben
      zusammenwirken.
    </p>
    <nav class="hero-actions" aria-label="Direkteinstiege zum Haushalt">
      <a class="button-link" href="#haushalt-explorer">Gesamtüberblick</a>
      <a class="button-link button-link--secondary" href="#budget-tab-distribution">Ausgaben nach Einzelplänen</a>
      <a class="button-link button-link--secondary" href="#budget-tab-revenue">Einnahmen und Finanzierung</a>
      <a class="button-link button-link--secondary" href="#budget-tab-investment">Investitionen</a>
      <a class="button-link button-link--secondary" href="#budget-tab-funds">Sondervermögen und Fonds</a>
      <a class="button-link button-link--secondary" href={`${import.meta.env.BASE_URL}haushalt/daten.csv`} download>Daten herunterladen</a>
    </nav>
  </section>

  <BudgetKpiGrid summaryRows={budgetSummaryRows} specialFunds={budgetSpecialFunds} />

  <section class="section section-muted" aria-labelledby="haushaltsbereiche">
    <div class="section-header">
      <h2 id="haushaltsbereiche">Haushaltsbereiche</h2>
      <p>Gesamtplan, Einzelpläne und Sondervermögen sind nach Bereichen gegliedert.</p>
    </div>
    <div class="card-grid card-grid--three">
      {orderedPages.map((page) => (
        <article class="panel">
          <h2><a class="inline-link" href={getBudgetPageUrl(page.slug)}>{page.title}</a></h2>
          <p>{page.teaser}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <BudgetExplorer
      summaryRows={budgetSummaryRows}
      entries={budgetExplorerEntries}
      specialFunds={budgetSpecialFunds}
    />
  </section>

  <BudgetMethodology />

  <section class="section">
    <div class="section-header">
      <h2>Direkte Rechtsgrundlagen</h2>
      <p>Finanzpolitische Kernnormen des Freistaates bleiben unmittelbar im Rechtsportal erreichbar.</p>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('gesetz-uber-die-feststellung-des-haushaltsplanes-des-freista-cc1hib-2')}>Haushaltsgesetz 2025/2026</a></strong>
        <span>Gesetzlicher Rahmen des Doppelhaushalts.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('ostdeutsches-landesbankgesetz')}>Landesbank an der Elbe</a></strong>
        <span>Finanzpolitische Infrastruktur des Freistaates.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('ostdeutsches-tariftreueund-vergabegesetz')}>Tariftreue- und Vergabegesetz</a></strong>
        <span>Vergabe- und Beschaffungsrahmen mit finanzpolitischer Relevanz.</span>
      </li>
    </ul>
  </section>
</BaseLayout>
