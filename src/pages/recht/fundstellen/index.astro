---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  formatDate,
  formatPublicationEntryType,
  getHomeUrl,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionUrl,
  getPublicationLabel,
  getPublicationUrl,
  getPublicationsUrl,
  getReferencesUrl,
  listPublicationEntries,
  loadAllVerkuendungen,
  toDisplayText,
} from '../../../lib/norms/index.ts';
import { loadAllNorms } from '../../../lib/norms/content.ts';

const [publications, norms] = await Promise.all([loadAllVerkuendungen(), loadAllNorms()]);
const entries = listPublicationEntries(publications).sort((left, right) => {
  if (left.publication.publication !== right.publication.publication) {
    return left.publication.publication.localeCompare(right.publication.publication, 'de');
  }

  if (left.publication.year !== right.publication.year) {
    return right.publication.year - left.publication.year;
  }

  return right.publication.issue.localeCompare(left.publication.issue, 'de', { numeric: true });
});
const publicationNames = [...new Set(publications.map((publication) => publication.publication))].sort((left, right) =>
  left.localeCompare(right, 'de'),
);
const normBySlug = new Map(norms.map((norm) => [norm.meta.slug, norm]));

function getEntryNormUrl(normSlug: string | undefined, versionId: string | undefined): string | undefined {
  if (!normSlug) {
    return undefined;
  }

  const norm = normBySlug.get(normSlug);
  if (!norm) {
    return undefined;
  }

  const version = versionId ? norm.versions.find((entry) => entry.versionId === versionId) : undefined;
  return !version || version.isCurrent ? getNormUrl(normSlug) : getNormVersionUrl(normSlug, version.versionId);
}
---

<BaseLayout
  title="Fundstellennachweise"
  description="Fundstellen, Verkündungsblätter und Verweise auf Normfassungen im Rechtsbereich."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: 'Fundstellennachweise', href: getReferencesUrl() },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: 'Fundstellennachweise' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Rechtsbereich</p>
    <h1>Fundstellennachweise</h1>
    <p class="lead">
      Nachweise aus Gesetz- und Verordnungsblatt, Staatsanzeiger, Amtsblatt und Vertragsblatt mit
      direkter Verknüpfung zu den gepflegten Normfassungen.
    </p>
    <nav class="link-list link-list--inline" aria-label="Weitere Rechtseinstiege">
      <a href={getPublicationsUrl()}>Verkündungen</a>
      <a href={getLawPortalUrl()}>Rechtsbereich</a>
    </nav>
  </section>

  <section class="section">
    <div class="meta-grid">
      <div class="meta-card">
        <span class="meta-label">Nachweise</span>
        <strong>{entries.length}</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Ausgaben</span>
        <strong>{publications.length}</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Blätter</span>
        <strong>{publicationNames.length}</strong>
      </div>
    </div>
  </section>

  {publicationNames.map((publicationName) => {
    const publicationEntries = entries.filter((entry) => entry.publication.publication === publicationName);

    return (
      <section class="section">
        <div class="section-header">
          <h2>{publicationName}</h2>
          <p>Fundstellen aus {publicationName} nach Jahr und Ausgabe.</p>
        </div>
        <div class="table-wrap">
          <table class="data-table">
            <thead>
              <tr>
                <th scope="col">Fundstelle</th>
                <th scope="col">Datum</th>
                <th scope="col">Titel</th>
                <th scope="col">Normfassung</th>
              </tr>
            </thead>
            <tbody>
              {publicationEntries.map(({ publication, entry }) => {
                const normUrl = getEntryNormUrl(entry.normSlug, entry.versionId);

                return (
                  <tr>
                    <td>
                      <strong>
                        <a class="inline-link" href={`${getPublicationUrl(publication.slug)}#${entry.id}`}>
                          {toDisplayText(entry.citation)}
                        </a>
                      </strong>
                      <span>{getPublicationLabel(publication)}</span>
                    </td>
                    <td><time datetime={publication.date}>{formatDate(publication.date)}</time></td>
                    <td>
                      {toDisplayText(entry.title)}
                      <span>{formatPublicationEntryType(entry.type)}</span>
                    </td>
                    <td>
                      {normUrl ? (
                        <a class="inline-link" href={normUrl}>
                          {entry.versionId ? `Fassung ${entry.versionId}` : 'Norm öffnen'}
                        </a>
                      ) : (
                        <span>Kein Normlink</span>
                      )}
                    </td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </div>
      </section>
    );
  })}
</BaseLayout>
