---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  getHomeUrl,
  getLawPortalUrl,
  getNormUrl,
  toDisplayText,
} from '../../../lib/norms/index.ts';
import { loadAllNorms } from '../../../lib/norms/content.ts';

const norms = await loadAllNorms();
const constitutionNorms = norms.filter((norm) =>
  `${norm.meta.title} ${norm.meta.shortTitle ?? ''} ${norm.meta.abbr ?? ''}`
    .toLowerCase()
    .includes('verfassung'),
);
const currentConstitution = constitutionNorms.find(
  (norm) => norm.meta.slug === 'staatsverfassung-des-freistaates-ostdeutschland',
);
const amendmentNorms = constitutionNorms.filter((norm) => norm !== currentConstitution);
---

<BaseLayout title="Verfassung" description="Zugang zu verfassungsbezogenen Inhalten des Rechtsbereichs.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: 'Verfassung' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Rechtsbereich</p>
    <h1>Verfassung</h1>
    <p class="lead">
      Hier finden Sie die seit dem 21. Juli 2026 geltende Lesefassung und die verfassungsändernden Gesetze.
    </p>
  </section>

  <section class="section">
    {currentConstitution ? (
      <article class="panel">
        <p class="eyebrow">Aktuelle Lesefassung</p>
        <h2><a class="inline-link" href={getNormUrl(currentConstitution.meta.slug)}>{toDisplayText(currentConstitution.meta.title)}</a></h2>
        <p>{currentConstitution.meta.initialCitation}</p>
      </article>
    ) : null}
    {amendmentNorms.length > 0 ? (
      <ul class="record-list">
        {amendmentNorms.map((norm) => (
          <li class="record-list__item">
            <a class="inline-link" href={getNormUrl(norm.meta.slug)}>{toDisplayText(norm.meta.title)}</a>
            <span>{norm.meta.abbr}</span>
          </li>
        ))}
      </ul>
    ) : !currentConstitution ? (
      <article class="panel">
        <h2>Keine verfassungsbezogenen Vorschriften gefunden</h2>
        <p>Derzeit sind keine passenden Vorschriften vorhanden.</p>
      </article>
    ) : null}
  </section>
</BaseLayout>
