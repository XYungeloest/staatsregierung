---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import {
  getHomeUrl,
  getLawPortalUrl,
  getNormUrl,
  getPublicationUrl,
  toDisplayText,
} from '../../../lib/norms/index.ts';
import { buildNormPublicationReferenceLookup, loadAllVerkuendungen } from '../../../lib/norms/publications.ts';
import { formatDate } from '../../../lib/norms/presentation.ts';
import { getCurrentVersion, loadAllNorms } from '../../../lib/norms/content.ts';

const [norms, publications] = await Promise.all([loadAllNorms(), loadAllVerkuendungen()]);
const currentConstitution = norms.find(
  (norm) => norm.meta.slug === 'staatsverfassung-des-freistaates-ostdeutschland',
);
const normBySlug = new Map(norms.map((norm) => [norm.meta.slug, norm]));
const publicationReferences = buildNormPublicationReferenceLookup(publications);
const amendmentNorms = currentConstitution
  ? currentConstitution.history.entries
      .filter((entry) => entry.type === 'amendment' && entry.relatedNorm)
      .map((entry) => entry.relatedNorm ? normBySlug.get(entry.relatedNorm) : undefined)
      .filter((norm): norm is NonNullable<typeof norm> => Boolean(norm))
  : [];
const amendmentRows = amendmentNorms.map((norm) => {
  const version = getCurrentVersion(norm);
  return {
    norm,
    version,
    publication: publicationReferences.get(`${norm.meta.slug}:${version.versionId}`),
  };
});
---

<BaseLayout title="Verfassung" description="Zugang zu verfassungsbezogenen Inhalten des Rechtsbereichs.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: 'Verfassung' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Rechtsbereich</p>
    <h1>Verfassung</h1>
    <p class="lead">
      Hier finden Sie die seit dem 21. Juli 2026 geltende Lesefassung und die verfassungsändernden Gesetze.
    </p>
  </section>

  <section class="section">
    {currentConstitution ? (
      <article class="panel">
        <p class="eyebrow">Aktuelle Lesefassung</p>
        <h2><a class="inline-link" href={getNormUrl(currentConstitution.meta.slug)}>{toDisplayText(currentConstitution.meta.title)}</a></h2>
        <p>{currentConstitution.meta.initialCitation}</p>
        <p><strong>Stand:</strong> Redaktionelle konsolidierte Lesefassung vom 21. Juli 2026.</p>
        <aside class="notice-card" aria-labelledby="artikel-121a-konflikt">
          <h3 id="artikel-121a-konflikt">Dokumentierter Wortlautkonflikt in Artikel 121a</h3>
          <p>
            Die Lesefassung nennt die siebte Volkskammer, den siebten Landtag und die Wahl zur achten Volkskammer.
            Das verkündete Erste Gesetz zur Großen Staatsreform nennt dagegen die achte Volkskammer, den achten Landtag
            und die Wahl zur neunten Volkskammer. Die Lesefassung wird deshalb nicht als wortgleich mit dem Verkündungsblatt ausgewiesen.
          </p>
        </aside>
      </article>
    ) : null}
    {amendmentRows.length > 0 ? (
      <ul class="record-list">
        {amendmentRows.map(({ norm, version, publication }) => (
          <li class="record-list__item">
            <a class="inline-link" href={getNormUrl(norm.meta.slug)}>{toDisplayText(norm.meta.title)}</a>
            <span>In Kraft seit <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time></span>
            {publication ? (
              <span>
                <a class="inline-link" href={getPublicationUrl(publication.publicationSlug)}>
                  {publication.publication} {publication.publicationDate.slice(0, 4)} Nr. {publication.issue}
                </a>
                {publication.startPage ? ` · Beginn auf Seite ${publication.startPage}` : ''}
              </span>
            ) : null}
          </li>
        ))}
      </ul>
    ) : !currentConstitution ? (
      <article class="panel">
        <h2>Keine verfassungsbezogenen Vorschriften gefunden</h2>
        <p>Derzeit sind keine passenden Vorschriften vorhanden.</p>
      </article>
    ) : null}
  </section>
</BaseLayout>
