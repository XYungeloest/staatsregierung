---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getFundingUrl,
  getHelpUrl,
  getHomeUrl,
  getIndexUrl,
  getLawPortalUrl,
  getPublicationsUrl,
  getReferencesUrl,
  getSearchUrl,
  getSubjectsUrl,
} from '../../lib/norms/index.ts';
import { buildSearchIndexPayload } from '../../lib/norms/search.ts';

const searchPayload = await buildSearchIndexPayload();
---

<BaseLayout
  title="Normensuche"
  description="Suche nach Normtiteln, Sachgebieten, Fundstellen und Vorschriftentexten."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: 'Suche', href: getSearchUrl() },
  ]}
  noindex={true}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: 'Suche' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Rechtsbereich</p>
    <h1>Normensuche</h1>
    <p class="lead">
      Die Suche erschließt Titel, Metadaten, Fundstellen und Normtexte aller gespeicherten
      Fassungen.
    </p>
    <p class="status-line">
      Im Suchindex stehen derzeit {searchPayload.documentCount} Normfassungen bereit.
    </p>
    <nav class="link-list link-list--inline" aria-label="Weitere Rechtseinstiege">
      <a href={getIndexUrl()}>Alphabetischer Index</a>
      <a href={getSubjectsUrl()}>Sachgebiete</a>
      <a href={getReferencesUrl()}>Fundstellennachweise</a>
      <a href={getPublicationsUrl()}>Verkündungen</a>
      <a href={getFundingUrl()}>Förderrichtlinien</a>
      <a href={getHelpUrl()}>Hilfe</a>
    </nav>
  </section>

  <section
    class="section search-shell"
    aria-labelledby="search-form-title"
    data-search-root
    data-index-url={`${import.meta.env.BASE_URL}recht/search-index.json`}
  >
    <div class="section-header">
      <h2 id="search-form-title">Suchanfrage und Filter</h2>
      <p>
        Durchsucht werden Titel, Kurztitel, Abkürzung, Metadaten, Fundstellen und die
        gespeicherten Normtexte.
      </p>
    </div>

    <form class="search-form" action={getSearchUrl()} method="get" data-search-form>
      <div class="search-form__primary">
        <label class="search-field">
          <span>Suchbegriff</span>
          <input
            type="search"
            name="q"
            autocomplete="off"
            placeholder="z. B. Polizei, Förderung, Datenpakt"
            data-search-query
          />
        </label>
        <label class="search-field">
          <span>Suchbereich</span>
          <select name="scope" data-search-filter="scope">
            <option value="all">Titel, Metadaten und Text</option>
            <option value="title">Nur Titel, Kurztitel und Abkürzung</option>
            <option value="metadata">Nur Metadaten und Fundstellen</option>
            <option value="body">Nur Normtext</option>
          </select>
        </label>
      </div>

      <div class="search-form__filters">
        <label class="search-field">
          <span>Enthält nicht</span>
          <input type="search" name="exclude" autocomplete="off" placeholder="auszuschließender Begriff" data-search-filter="exclude" />
        </label>

        <label class="search-field">
          <span>Exakte Wortfolge</span>
          <input type="search" name="exact" autocomplete="off" placeholder="z. B. bezahlbarer Wohnraum" data-search-filter="exact" />
        </label>

        <label class="search-field">
          <span>Fundstelle</span>
          <input type="search" name="citation" autocomplete="off" placeholder="z. B. OGVBl. 2026 Nr. 16" data-search-filter="citation" />
        </label>
      </div>

      <div class="search-form__filters">
        <label class="search-field">
          <span>Normtyp</span>
          <select name="type" data-search-filter="type">
            <option value="">Alle</option>
            {searchPayload.filters.types.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <label class="search-field">
          <span>Ressort</span>
          <select name="ministry" data-search-filter="ministry">
            <option value="">Alle</option>
            {searchPayload.filters.ministries.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </label>

        <label class="search-field">
          <span>Sachgebiet</span>
          <select name="subject" data-search-filter="subject">
            <option value="">Alle</option>
            {searchPayload.filters.subjects.map((option) => (
              <option value={option}>{option}</option>
            ))}
          </select>
        </label>

        <label class="search-field">
          <span>Status</span>
          <select name="status" data-search-filter="status">
            <option value="">Alle</option>
            {searchPayload.filters.statuses.map((option) => (
              <option value={option.value}>{option.label}</option>
            ))}
          </select>
        </label>

        <label class="search-field">
          <span>Fassung</span>
          <select name="versionScope" data-search-filter="versionScope">
            <option value="all">Alle gespeicherten Fassungen</option>
            <option value="current">Nur aktuelle Fassungen</option>
            <option value="historical">Nur historische Fassungen</option>
          </select>
        </label>

        <label class="search-field">
          <span>Sortierung</span>
          <select name="sort" data-search-filter="sort">
            <option value="relevance">Relevanz</option>
            <option value="title">Titel A-Z</option>
            <option value="rechtsstand">Neuester Rechtsstand</option>
          </select>
        </label>
      </div>

      <div class="search-form__filters">
        <label class="search-field">
          <span>Geltungstag</span>
          <input type="date" name="geltungstag" data-search-filter="geltungstag" />
        </label>

        <label class="search-field">
          <span>Gültig ab</span>
          <input type="date" name="validFrom" data-search-filter="validFrom" />
        </label>

        <label class="search-field">
          <span>Gültig bis</span>
          <input type="date" name="validTo" data-search-filter="validTo" />
        </label>
      </div>

      <div class="search-form__actions">
        <button class="button-link" type="submit">Suchen</button>
        <a class="button-link button-link--secondary" href={getSearchUrl()}>Zurücksetzen</a>
      </div>
    </form>

    <div class="search-feedback" aria-live="polite" data-search-summary>
      Der Suchindex wird geladen.
    </div>

    <noscript>
      <div class="search-feedback search-feedback--warning">
        <p>
          Für die freie Volltextsuche wird JavaScript benötigt. Die amtlichen Einstiege bleiben
          ohne JavaScript erreichbar.
        </p>
        <nav class="link-list link-list--inline" aria-label="Rechtseinstiege ohne JavaScript">
          <a href={getIndexUrl()}>Alphabetischer Index</a>
          <a href={getSubjectsUrl()}>Sachgebiete</a>
          <a href={getReferencesUrl()}>Fundstellennachweise</a>
          <a href={getPublicationsUrl()}>Verkündungen</a>
          <a href={getFundingUrl()}>Förderrichtlinien</a>
        </nav>
      </div>
    </noscript>

    <div class="search-results" data-search-results></div>
  </section>
  <script>
    import "../../scripts/search-page.ts";
  </script>
</BaseLayout>
