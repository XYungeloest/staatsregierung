---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import LawNavigation from '../../../components/portal/LawNavigation.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import {
  getHomeUrl,
  getLawPortalUrl,
  getSubjectAreaGroups,
  getSubjectUrl,
  getSubjectGroups,
  toDisplayText,
} from '../../../lib/norms/index.ts';
import { loadAllNorms } from '../../../lib/norms/content.ts';

const norms = await loadAllNorms();
const groups = getSubjectGroups(norms);
const areaGroups = getSubjectAreaGroups(norms);
---

<BaseLayout
  title="Sachgebiete"
  description="Sachgebietsübersicht des Rechtsbereichs mit thematischem Zugang zum Normenbestand."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: 'Sachgebiete', href: getLawPortalUrl() + 'sachgebiete/' },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: 'Sachgebiete' },
    ]}
  />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Sachgebiete"
    lead="Vorschriften nach fachlicher Zuordnung und thematischen Hauptbereichen recherchieren."
    variant="law"
    facts={[{ label: 'Sachgebiete', value: String(groups.length) }, { label: 'Vorschriften', value: String(norms.length) }]}
  />
  <LawNavigation />

  <section class="section">
    <div class="section-header">
      <h2>Systematische Übersicht</h2>
      <p>Die Hauptbereiche fassen verwandte Sachgebiete für die Recherche zusammen.</p>
    </div>
    <div class="content-grid content-grid--wide">
      {areaGroups.map((area) => (
        <section class="panel">
          <h3>{area.name}</h3>
          <p>{area.description}</p>
          <p class="detail-line">{area.normCount} Vorschriften in {area.subjects.length} Sachgebieten</p>
          <ul class="record-list">
            {area.subjects.map((group) => (
              <li class="record-list__item">
                <a class="inline-link" href={getSubjectUrl(group.name)}>{toDisplayText(group.name)}</a>
                <span>{group.norms.length} Normen</span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Alphabetische Liste</h2>
    </div>
    <div class="tag-list">
      {groups.map((group) => (
        <a class="tag" href={getSubjectUrl(group.name)}>{toDisplayText(group.name)} ({group.norms.length})</a>
      ))}
    </div>
  </section>
</BaseLayout>
