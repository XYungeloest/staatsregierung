---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NormBody from '../../../../components/norms/NormBody.astro';
import NormMetaCard from '../../../../components/norms/NormMetaCard.astro';
import NormOutline from '../../../../components/norms/NormOutline.astro';
import NormStatusNotice from '../../../../components/norms/NormStatusNotice.astro';
import NormDocumentTools from '../../../../components/norms/NormDocumentTools.astro';
import NormPrintSources from '../../../../components/norms/NormPrintSources.astro';
import NormVersionNavigation from '../../../../components/norms/NormVersionNavigation.astro';
import SectionHero from '../../../../components/portal/SectionHero.astro';
import SectionNavigation from '../../../../components/portal/SectionNavigation.astro';
import { loadPressReleases, loadTopics } from '../../../../lib/portal/content.ts';
import {
  getPressReleaseIndexUrl,
  getPressReleaseUrl,
  getTopicUrl,
  getTopicsUrl,
} from '../../../../lib/portal/routes.ts';
import {
  buildNormOutline,
  formatDate,
  formatNormStatus,
  formatNormType,
  toDisplayText,
} from '../../../../lib/norms/presentation.ts';
import {
  getHomeUrl,
  getLawPortalUrl,
  getNormHistoryUrl,
  getNormUrl,
  buildNormTextLinkReferences,
  buildNormPublicationReferenceLookup,
  getRelatedNormRecommendations,
  loadAllVerkuendungen,
} from '../../../../lib/norms/index.ts';
import { getCurrentVersion, loadAllNorms } from '../../../../lib/norms/content.ts';

export async function getStaticPaths() {
  const [norms, publications] = await Promise.all([loadAllNorms(), loadAllVerkuendungen()]);
  const publicationReferences = buildNormPublicationReferenceLookup(publications);

  return norms.map((norm) => ({
    params: { slug: norm.meta.slug },
    props: {
      norm,
      currentVersion: getCurrentVersion(norm),
      textReferences: buildNormTextLinkReferences(norms, norm.meta.slug),
      relatedNorms: getRelatedNormRecommendations(norm, norms),
      publicationReferences,
      publications,
    },
  }));
}

const { norm, currentVersion, textReferences, relatedNorms, publicationReferences, publications } = Astro.props;
const publicationReference = publicationReferences.get(`${norm.meta.slug}:${currentVersion.versionId}`);
const publication = publicationReference
  ? publications.find((entry) => entry.slug === publicationReference.publicationSlug)
  : undefined;
const outline = buildNormOutline(currentVersion.body);
const normTitle = toDisplayText(norm.meta.title);
const normLabel = norm.meta.abbr ? `${normTitle} (${toDisplayText(norm.meta.abbr)})` : normTitle;
const normStatusLabel = formatNormStatus(norm.meta.status);
const statusDate = norm.meta.effectiveDate ?? currentVersion.validFrom;
const responsibility = toDisplayText(norm.meta.responsibleMinistry ?? norm.meta.ministry);
const currentDescription = `${normLabel} im Rechtsbereich des Freistaates Ostdeutschland. Status: ${normStatusLabel}.${responsibility ? ` Zuständiger Geschäftsbereich: ${responsibility}.` : ''}`;
const [topics, pressReleases] = await Promise.all([loadTopics(), loadPressReleases()]);
const relatedTopics = topics.filter((topic) =>
  topic.rechtsgrundlagen.some((entry) => entry.normSlug === norm.meta.slug),
);
const relatedPressReleases = pressReleases
  .filter((release) => release.relatedNormSlugs?.includes(norm.meta.slug))
  .slice(0, 3);
---

<BaseLayout
  title={normLabel}
  description={currentDescription}
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: toDisplayText(norm.meta.shortTitle || norm.meta.title) },
    ]}
  />

  <SectionHero
    eyebrow={norm.meta.status === 'in-force' ? 'Aktuelle Fassung' : 'Veröffentlichte Fassung'}
    title={toDisplayText(norm.meta.title)}
    titleSize="long"
    lead={toDisplayText(norm.meta.summary)}
    status={norm.meta.status === 'future-effective'
      ? `Verkündet · Inkrafttreten am ${formatDate(statusDate)}`
      : norm.meta.status === 'pending-effective'
        ? 'Verkündet · Inkrafttreten noch nicht belegt'
      : norm.meta.status === 'repealed' || norm.meta.status === 'historical'
        ? `${normStatusLabel}${norm.meta.expiryDate ? ` seit ${formatDate(norm.meta.expiryDate)}` : ''}`
        : `${normStatusLabel} seit ${formatDate(statusDate)}`}
    variant="law"
    facts={[
      ...(norm.meta.abbr ? [{ label: 'Abkürzung', value: toDisplayText(norm.meta.abbr) }] : []),
      { label: 'Normtyp', value: formatNormType(norm.meta.type) },
      { label: 'Fundstelle', value: toDisplayText(currentVersion.citation) },
    ]}
    actions={[{ label: 'Normenhistorie', href: getNormHistoryUrl(norm.meta.slug), primary: true }]}
  />
  <SectionNavigation
    label="Vorschrift"
    variant="law"
    items={[
      { label: 'Inhalt', href: '#norm-inhalt' },
      { label: 'Text', href: '#normtext' },
      { label: 'Daten', href: '#normdaten' },
      { label: 'Historie', href: getNormHistoryUrl(norm.meta.slug) },
      ...(relatedNorms.length > 0 ? [{ label: 'Verwandte Vorschriften', href: '#normverwandt' }] : []),
    ]}
  />
  <NormVersionNavigation norm={norm} version={currentVersion} />

  <NormStatusNotice norm={norm} version={currentVersion} />

  <div class="content-grid norm-detail-layout">
    <div class="content-stack">
      <div id="norm-inhalt"><NormOutline items={outline} /></div>
      <section class="section" id="normtext" data-visual-section="norm-text">
        <div class="section-header">
          <h2>Vorschriftentext</h2>
          <p>{toDisplayText(currentVersion.changeNote)}</p>
        </div>
        <NormDocumentTools norm={norm} />
        <NormBody blocks={currentVersion.body} references={textReferences} />
      </section>
      <NormPrintSources
        norm={norm}
        version={currentVersion}
        publicationReference={publicationReference}
        publication={publication}
      />
    </div>

    <div class="content-stack norm-sidebar" data-visual-section="norm-sidebar">
      <NormMetaCard
        norm={norm}
        version={currentVersion}
        publicationReference={publicationReference}
      />
      {relatedNorms.length > 0 || relatedTopics.length > 0 || relatedPressReleases.length > 0 ? (
        <section class="section norm-sidebar__portal-links" data-visual-section="norm-portal-relations">
          <div class="section-header section-header--compact">
            <h2>Weiterführende Bezüge</h2>
          </div>
          {relatedNorms.length > 0 ? (
            <>
              <h3 id="normverwandt">Verwandte Vorschriften</h3>
              <ul class="norm-sidebar__link-list">
                {relatedNorms.map(({ norm: entry, relation }) => (
                  <li>
                    <a class="inline-link" href={getNormUrl(entry.meta.slug)}>
                      {toDisplayText(entry.meta.shortTitle || entry.meta.title)}
                    </a>
                    <span>{relation}</span>
                  </li>
                ))}
              </ul>
            </>
          ) : null}
          {relatedTopics.length > 0 ? (
            <>
              <h3>Themen</h3>
              <ul class="norm-sidebar__link-list">
                {relatedTopics.map((topic) => (
                  <li>
                    <a class="inline-link" href={getTopicUrl(topic.slug)}>{topic.title}</a>
                  </li>
                ))}
              </ul>
              <p class="section-link-row">
                <a class="inline-link" href={getTopicsUrl()}>Zu Themen & Projekte</a>
              </p>
            </>
          ) : null}
          {relatedPressReleases.length > 0 ? (
            <>
              <h3>Presse</h3>
              <ul class="norm-sidebar__link-list">
                {relatedPressReleases.map((release) => (
                  <li>
                    <a class="inline-link" href={getPressReleaseUrl(release.slug)}>{release.title}</a>
                    <time datetime={release.date}>{formatDate(release.date)}</time>
                  </li>
                ))}
              </ul>
              <p class="section-link-row">
                <a class="inline-link" href={getPressReleaseIndexUrl()}>Zu den Pressemitteilungen</a>
              </p>
            </>
          ) : null}
        </section>
      ) : null}
    </div>
  </div>
</BaseLayout>
