---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NormVersionNavigation from '../../../../components/norms/NormVersionNavigation.astro';
import SectionHero from '../../../../components/portal/SectionHero.astro';
import { buildStructuralVersionDiff } from '../../../../lib/norms/diff.ts';
import {
  formatDate,
  getHomeUrl,
  getLawPortalUrl,
  getNormCompareUrl,
  getNormUrl,
  toDisplayText,
} from '../../../../lib/norms/index.ts';
import { loadAllNorms } from '../../../../lib/norms/content.ts';

export async function getStaticPaths() {
  const norms = await loadAllNorms();

  return norms
    .filter((norm) => norm.versions.length > 1)
    .map((norm) => {
      const versions = [...norm.versions].sort((left, right) =>
        left.validFrom.localeCompare(right.validFrom),
      );
      const pairs = versions.flatMap((fromVersion) =>
        versions.filter((toVersion) => toVersion.versionId !== fromVersion.versionId).map((toVersion) => ({
          fromVersion,
          toVersion,
          diff: buildStructuralVersionDiff(fromVersion, toVersion),
        })),
      );

      return {
        params: { slug: norm.meta.slug },
        props: {
          norm,
          versions,
          pairs,
          defaultFrom: versions.at(-2)!,
          defaultTo: versions.at(-1)!,
        },
      };
    });
}

const { norm, versions, pairs, defaultFrom, defaultTo } = Astro.props;
const normTitle = toDisplayText(norm.meta.title);
const normSeoTitle = norm.meta.abbr ? `${normTitle} (${toDisplayText(norm.meta.abbr)})` : normTitle;
const defaultPairKey = `${defaultFrom.versionId}::${defaultTo.versionId}`;
---

<BaseLayout
  title={`${normSeoTitle} vergleichen`}
  description={`Struktureller Vergleich gespeicherter Fassungen von ${normTitle}.`}
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
    { label: 'Vergleich' },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
      { label: 'Vergleich' },
    ]}
  />

  <SectionHero
    eyebrow="Fassungsvergleich"
    title={normTitle}
    titleSize="long"
    lead="Gespeicherte Fassungen strukturell vergleichen. Maßgeblich bleiben die einzeln gespeicherten Normfassungen."
    variant="law"
  />
  <NormVersionNavigation norm={norm} currentPage="compare" />

  <section class="section norm-compare" data-version-compare>
    <div class="section-header">
      <h2>Fassungen auswählen</h2>
      <p>Die Auswahl wird über die Parameter <code>von</code> und <code>bis</code> in der URL festgehalten.</p>
    </div>
    <form class="norm-compare__form" action={getNormCompareUrl(norm.meta.slug)} method="get" data-compare-form>
      <label class="search-field">
        <span>Ausgangsfassung</span>
        <select name="von" data-compare-from>
          {versions.map((version) => (
            <option value={version.versionId} selected={version.versionId === defaultFrom.versionId}>
              {formatDate(version.validFrom)} · {toDisplayText(version.changeNote)}
            </option>
          ))}
        </select>
      </label>
      <label class="search-field">
        <span>Vergleichsfassung</span>
        <select name="bis" data-compare-to>
          {versions.map((version) => (
            <option value={version.versionId} selected={version.versionId === defaultTo.versionId}>
              {formatDate(version.validFrom)} · {toDisplayText(version.changeNote)}
            </option>
          ))}
        </select>
      </label>
      <button class="button-link" type="submit">Vergleichen</button>
    </form>

    <p class="status-line" data-compare-feedback aria-live="polite"></p>

    {pairs.map(({ fromVersion, toVersion, diff }) => {
      const pairKey = `${fromVersion.versionId}::${toVersion.versionId}`;
      return (
        <section
          class="norm-diff"
          data-compare-pair={pairKey}
          hidden={pairKey !== defaultPairKey}
          aria-label={`Vergleich ${formatDate(fromVersion.validFrom)} mit ${formatDate(toVersion.validFrom)}`}
        >
          <header class="norm-diff__header">
            <h3>
              <time datetime={fromVersion.validFrom}>{formatDate(fromVersion.validFrom)}</time>
              {' '}mit{' '}
              <time datetime={toVersion.validFrom}>{formatDate(toVersion.validFrom)}</time>
            </h3>
            <p>
              <span class="diff-key diff-key--added">Hinzugefügt</span>
              <span class="diff-key diff-key--removed">Entfernt</span>
              <span class="diff-key diff-key--changed">Geändert</span>
            </p>
          </header>
          <ol class="norm-diff__list">
            {diff.filter((unit) => unit.kind !== 'unchanged').map((unit) => (
              <li class:list={['norm-diff__unit', `norm-diff__unit--${unit.kind}`]}>
                <h4>{[unit.label, unit.afterTitle || unit.beforeTitle].filter(Boolean).join(' ')}</h4>
                <p class="visually-hidden">
                  {unit.kind === 'added' ? 'Hinzugefügte Einheit' : unit.kind === 'removed' ? 'Entfernte Einheit' : 'Geänderte Einheit'}
                </p>
                {unit.kind === 'added' ? <p><ins>{unit.afterText}</ins></p> : null}
                {unit.kind === 'removed' ? <p><del>{unit.beforeText}</del></p> : null}
                {unit.kind === 'changed' ? (
                  <>
                    {unit.beforeTitle !== unit.afterTitle ? (
                      <p class="norm-diff__title-change">
                        Überschrift: <del>{unit.beforeTitle}</del> <ins>{unit.afterTitle}</ins>
                      </p>
                    ) : null}
                    <p>
                      {unit.textDiff?.map((chunk) =>
                        chunk.kind === 'insert' ? <ins>{chunk.text}</ins> : chunk.kind === 'delete' ? <del>{chunk.text}</del> : chunk.text,
                      )}
                    </p>
                  </>
                ) : null}
              </li>
            ))}
          </ol>
          {diff.every((unit) => unit.kind === 'unchanged') ? <p>Zwischen diesen Fassungen wurden keine strukturellen Textänderungen erkannt.</p> : null}
        </section>
      );
    })}
  </section>

  <script>
    const form = document.querySelector<HTMLFormElement>('[data-compare-form]');
    const fromSelect = document.querySelector<HTMLSelectElement>('[data-compare-from]');
    const toSelect = document.querySelector<HTMLSelectElement>('[data-compare-to]');
    const feedback = document.querySelector<HTMLElement>('[data-compare-feedback]');
    const pairs = Array.from(document.querySelectorAll<HTMLElement>('[data-compare-pair]'));

    function showPair(updateUrl = false): void {
      if (!form || !fromSelect || !toSelect) return;
      const key = `${fromSelect.value}::${toSelect.value}`;
      const selected = pairs.find((entry) => entry.dataset.comparePair === key);
      pairs.forEach((entry) => {
        entry.hidden = entry !== selected;
      });
      if (feedback) {
        feedback.textContent = selected
          ? ''
          : 'Bitte wählen Sie zwei unterschiedliche gespeicherte Fassungen.';
      }
      if (updateUrl && selected) {
        const url = new URL(window.location.href);
        url.searchParams.set('von', fromSelect.value);
        url.searchParams.set('bis', toSelect.value);
        window.history.pushState({}, '', url);
      }
    }

    if (form && fromSelect && toSelect) {
      const params = new URLSearchParams(window.location.search);
      const from = params.get('von');
      const to = params.get('bis');
      if (from && Array.from(fromSelect.options).some((option) => option.value === from)) fromSelect.value = from;
      if (to && Array.from(toSelect.options).some((option) => option.value === to)) toSelect.value = to;
      showPair();
      form.addEventListener('submit', (event) => {
        event.preventDefault();
        showPair(true);
      });
      window.addEventListener('popstate', () => {
        const next = new URLSearchParams(window.location.search);
        fromSelect.value = next.get('von') ?? fromSelect.value;
        toSelect.value = next.get('bis') ?? toSelect.value;
        showPair();
      });
    }
  </script>
</BaseLayout>
