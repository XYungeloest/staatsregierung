---
import BaseLayout from '../../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../../../components/Breadcrumbs.astro';
import NormBody from '../../../../../components/norms/NormBody.astro';
import NormMetaCard from '../../../../../components/norms/NormMetaCard.astro';
import NormOutline from '../../../../../components/norms/NormOutline.astro';
import NormStatusNotice from '../../../../../components/norms/NormStatusNotice.astro';
import { buildNormOutline, formatDate, toDisplayText } from '../../../../../lib/norms/presentation.ts';
import {
  buildNormTextLinkReferences,
  buildNormPublicationReferenceLookup,
  getRelatedNormRecommendations,
  getHomeUrl,
  getLawPortalUrl,
  getNormHistoryUrl,
  getNormUrl,
  loadAllVerkuendungen,
} from '../../../../../lib/norms/index.ts';
import { loadAllNorms } from '../../../../../lib/norms/content.ts';

export async function getStaticPaths() {
  const [norms, publications] = await Promise.all([loadAllNorms(), loadAllVerkuendungen()]);
  const publicationReferences = buildNormPublicationReferenceLookup(publications);

  return norms.flatMap((norm) =>
    norm.versions
      .filter((version) => !version.isCurrent)
      .map((version) => ({
        params: { slug: norm.meta.slug, versionId: version.versionId },
        props: {
          norm,
          version,
          textReferences: buildNormTextLinkReferences(norms, norm.meta.slug),
          relatedNorms: getRelatedNormRecommendations(norm, norms),
          publicationReferences,
        },
      })),
  );
}

const { norm, version, textReferences, relatedNorms, publicationReferences } = Astro.props;
const publicationReference = publicationReferences.get(`${norm.meta.slug}:${version.versionId}`);
const outline = buildNormOutline(version.body);
const normTitle = toDisplayText(norm.meta.title);
const normSeoTitle = norm.meta.abbr ? `${normTitle} (${toDisplayText(norm.meta.abbr)})` : normTitle;
const versionDescription = `Historische Fassung von ${normTitle} mit Rechtsstand vom ${formatDate(version.validFrom)} im Rechtsbereich des Freistaates Ostdeutschland.`;
---

<BaseLayout
  title={`${normSeoTitle} ${version.versionId}`}
  description={versionDescription}
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Recht', href: getLawPortalUrl() },
    { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
    { label: `Fassung vom ${formatDate(version.validFrom)}` },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Recht', href: getLawPortalUrl() },
      { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
      { label: `Fassung vom ${formatDate(version.validFrom)}` },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Historische Fassung</p>
    <h1>{toDisplayText(norm.meta.title)}</h1>
    <p class="lead">Historische Fassung mit Stand vom <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time>.</p>
    <p class="status-line">
      Gültig vom <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time> bis {version.validTo ? <time datetime={version.validTo}>{formatDate(version.validTo)}</time> : 'heute'}
    </p>
    <nav class="link-list link-list--inline" aria-label="Seitennavigation">
      <a href={getNormUrl(norm.meta.slug)}>Zur aktuellen Fassung</a>
      <a href={getNormHistoryUrl(norm.meta.slug)}>Zur Historie</a>
    </nav>
  </section>

  <NormStatusNotice norm={norm} version={version} historical={true} />

  <div class="content-grid">
    <div class="content-stack">
      <NormOutline items={outline} />
      <section class="section" id="normtext">
        <div class="section-header">
          <h2>Historischer Normtext</h2>
          <p>{toDisplayText(version.changeNote)}</p>
        </div>
        <NormBody blocks={version.body} references={textReferences} />
      </section>
    </div>

    <NormMetaCard
      norm={norm}
      version={version}
      historical={true}
      relatedNorms={relatedNorms}
      publicationReference={publicationReference}
    />
  </div>
</BaseLayout>
