---
import { readFileSync } from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import SectionNavigation from '../../components/portal/SectionNavigation.astro';
import {
  getFreestateUrl,
  getHomeUrl,
  getLawHomeUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
import {
  formatArea,
  formatCount,
  formatInteger,
  formatLongDate,
} from '../../lib/kreisreform/format.ts';
import { buildFaqPageJsonLd } from '../../lib/seo/index.ts';
import type {
  GeoJsonFeatureCollection,
  KreisreformManifest,
  NeuerBezirkProperties,
  NeuerKreisProperties,
} from '../../lib/kreisreform/types.ts';
import 'leaflet/dist/leaflet.css';

const dataRoot = path.join(process.cwd(), 'public', 'data', 'kreisreform');

function readMapData<T>(fileName: string): T {
  return JSON.parse(readFileSync(path.join(dataRoot, fileName), 'utf8')) as T;
}

const manifest = readMapData<KreisreformManifest>('manifest.json');
const kreiseCollection = readMapData<GeoJsonFeatureCollection<NeuerKreisProperties>>('neue-kreise.geojson');
const bezirkeCollection = readMapData<GeoJsonFeatureCollection<NeuerBezirkProperties>>('neue-bezirke.geojson');

const neueKreise = [...kreiseCollection.features]
  .map((feature) => feature.properties)
  .sort((left, right) => `${left.name}-${left.typ}`.localeCompare(`${right.name}-${right.typ}`, 'de'));
const neueBezirke = [...bezirkeCollection.features]
  .map((feature) => feature.properties)
  .sort((left, right) => left.name.localeCompare(right.name, 'de'));

const base = import.meta.env.BASE_URL;
const oldLayersAvailable =
  manifest.layers.alteKreise.available ||
  manifest.layers.alteBezirke.available ||
  manifest.layers.alteBundeslaender.available;
const bisherigeBezirke = [
  'Berlin',
  'Brandenburg',
  'Mecklenburg-Vorpommern',
  'Niederlausitz',
  'Oberlausitz',
  'Sachsen',
  'Sachsen-Anhalt',
  'Thüringen',
];
const kreisreformFaq = [
  { question: 'Muss ich meine Adresse ändern?', answer: 'Nein. Gemeindegrenzen und postalische Anschriften bleiben durch die Neuordnung unverändert. Die Kreis- und Bezirkszuordnung ändert sich zum Wirksamwerden des Gesetzes.' },
  { question: 'Ändern sich Kfz-Kennzeichen?', answer: 'Die Regelungen zu Kfz-Kennzeichen werden gesondert bekannt gemacht. Bestehende Kennzeichen werden durch die Gebietszuordnung nicht unmittelbar ungültig.' },
  { question: 'Welche Behörde ist künftig zuständig?', answer: 'Die Gebietssuche zeigt den neuen Kreis und Bezirk. Für einzelne Aufgaben gelten bis zum Abschluss der Übergangsregelungen die jeweils bekannt gemachten Zuständigkeiten.' },
  { question: 'Wann gilt die neue Zuordnung?', answer: 'Die neue Kreis- und Bezirksgliederung soll am 1. August 2026 wirksam werden.' },
  { question: 'Was passiert mit bisherigen Landkreisen?', answer: 'Die bisherigen Kreise bleiben für Rechtsnachfolge, Übergangsaufgaben und die Bereinigung bestehender Regelungen bedeutsam. Die Einzelheiten ergeben sich aus dem Gesetzesentwurf und seinen Anlagen.' },
  { question: 'Wo finde ich die Rechtsgrundlagen?', answer: 'Die Seite bündelt die vorgesehenen Grundlagen. Verkündete Fassungen und Fundstellen werden im Rechtsportal veröffentlicht.' },
];
---

<BaseLayout
  title="Kreis- und Bezirksreform 2026"
  description="Interaktive Übersicht zur Kreis- und Bezirksreform mit Karte, Bezirken, Kreisen, Tabellen und Rechtsgrundlagen."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Themen & Projekte', href: getTopicsUrl() },
    { label: 'Kreis- und Bezirksreform' },
  ]}
  structuredData={buildFaqPageJsonLd(kreisreformFaq)}
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Themen & Projekte', href: getTopicsUrl() },
      { label: 'Kreis- und Bezirksreform' },
    ]}
  />

  <SectionHero
    eyebrow="Gebietsordnung"
    title="Kreis- und Bezirksreform 2026"
    lead="Suchen Sie Ihre Gemeinde und sehen Sie, welchem Kreis und Bezirk sie künftig zugeordnet ist."
    status="Im Gesetzgebungsverfahren"
    variant="reform"
    facts={[
      { label: 'Neue Bezirke', value: formatInteger(manifest.stats.neueBezirke) },
      { label: 'Neue Kreise', value: formatInteger(manifest.stats.neueKreise) },
      { label: 'Vorgesehen ab', value: formatLongDate(manifest.stats.wirksamAb) },
    ]}
  >
    <div
      id="bezirk-suche"
      class="kreisreform-search-panel"
      aria-labelledby="gebietssuche"
      data-kreisreform-search
      data-base-url={base}
    >
      <h2 id="gebietssuche">Gebiet suchen</h2>
      <p>Suchen Sie nach Gemeinde, Kreis oder Bezirk. Das Ergebnis steht auch ohne Kartenansicht bereit.</p>
      <label class="search-field kreisreform-search-field">
        <span>Gemeinde, Kreis oder Bezirk suchen</span>
        <input type="search" data-kreisreform-search-input autocomplete="off" placeholder="z. B. Leipzig, Lausitz, Potsdam" />
      </label>
      <p class="search-feedback" data-kreisreform-search-status role="status" aria-live="polite">
        Geben Sie mindestens zwei Buchstaben ein, um ein Gebiet zu suchen.
      </p>
      <ul class="kreisreform-search-results" data-kreisreform-search-results hidden></ul>
      <article class="panel kreisreform-search-detail" data-kreisreform-search-detail aria-live="polite" hidden></article>
    </div>
  </SectionHero>
  <SectionNavigation
    label="Kreisreform"
    variant="reform"
    items={[
      { label: 'Gebietssuche', href: '#bezirk-suche' },
      { label: 'Bezirke & Kreise', href: '#bezirke' },
      { label: 'Karte', href: '#karte' },
      { label: 'Was ändert sich?', href: '#aenderungen' },
      { label: 'Tabellen', href: '#tabellen' },
      { label: 'Rechtsgrundlagen', href: '#rechtsgrundlagen' },
      { label: 'FAQ', href: '#kreisreform-faq' },
    ]}
  />

  <section id="bezirke" class="section kreisreform-mobile-alternative" aria-labelledby="bezirksuebersicht">
    <div class="section-header">
      <h2 id="bezirksuebersicht">Bezirke und Kreise ohne Karte</h2>
      <p>Diese Übersicht ist besonders für kleine Bildschirme und die Nutzung ohne Karte gedacht.</p>
    </div>
    <div class="card-grid card-grid--two">
      {neueBezirke.map((bezirk) => (
        <article class="panel">
          <h3>{bezirk.name}</h3>
          <p class="detail-line">Sitz: {bezirk.sitz} · {formatInteger(bezirk.einwohner)} Einwohner</p>
          <details class="faq-accordion__item">
            <summary class="faq-accordion__summary">Zugeordnete Kreise anzeigen</summary>
            <div class="faq-accordion__body"><ul>{bezirk.kreise.map((kreis) => <li>{kreis}</li>)}</ul></div>
          </details>
        </article>
      ))}
    </div>
  </section>

  <section id="karte" class="section section-muted" aria-labelledby="kartenueberschrift">
    <div class="section-header">
      <h2 id="kartenueberschrift">Interaktive Karte</h2>
      <p>
        Standardmäßig sind die neuen Kreise und die neuen Bezirksgrenzen sichtbar. Die bisherigen
        Kreise, Bezirke und Länder können als zurückhaltende Vergleichsebenen zugeschaltet werden.
      </p>
    </div>

    <div class="kreisreform-map-gate" data-map-gate>
      <div class="kreisreform-map-load-surface" data-map-load-surface>
        <h3>Interaktive Karte laden</h3>
        <p>
          Beim Laden der Karte werden Inhalte von OpenStreetMap abgerufen. Alternativ können Sie
          alle Zuordnungen über die Suche und die Tabellen ansehen.
        </p>
        <div class="hero-actions">
          <button class="button-link" type="button" data-map-load>Karte laden</button>
          <a class="button-link button-link--secondary" href="#tabellen">Ohne Karte fortfahren</a>
        </div>
      </div>
      <div class="kreisreform-map-shell" data-kreisreform-map data-base-url={base} hidden>
        <div class="kreisreform-map-layout">
        <div class="kreisreform-map-main">
          <div class="kreisreform-map-toolbar" aria-label="Karteneinstellungen">
            <details class="kreisreform-control-group" open>
              <summary>Layer</summary>
              <div class="kreisreform-layer-list">
                <label class="kreisreform-layer-toggle">
                  <input type="checkbox" data-layer-toggle="neueKreise" checked />
                  <span>Neue Kreise</span>
                  <small data-layer-note></small>
                </label>
                <label class="kreisreform-layer-toggle">
                  <input type="checkbox" data-layer-toggle="neueBezirke" checked />
                  <span>Neue Bezirke</span>
                  <small data-layer-note></small>
                </label>
                <label class:list={['kreisreform-layer-toggle', !manifest.layers.alteKreise.available && 'is-disabled']}>
                  <input type="checkbox" data-layer-toggle="alteKreise" disabled={!manifest.layers.alteKreise.available} />
                  <span>Alte Kreise</span>
                  <small data-layer-note>{manifest.layers.alteKreise.available ? '' : 'derzeit nicht verfügbar'}</small>
                </label>
                <label class:list={['kreisreform-layer-toggle', !manifest.layers.alteBezirke.available && 'is-disabled']}>
                  <input type="checkbox" data-layer-toggle="alteBezirke" disabled={!manifest.layers.alteBezirke.available} />
                  <span>Alte Bezirke</span>
                  <small data-layer-note>{manifest.layers.alteBezirke.available ? '' : 'derzeit nicht verfügbar'}</small>
                </label>
                <label class:list={['kreisreform-layer-toggle', !manifest.layers.alteBundeslaender.available && 'is-disabled']}>
                  <input type="checkbox" data-layer-toggle="alteBundeslaender" disabled={!manifest.layers.alteBundeslaender.available} />
                  <span>Alte Länder</span>
                  <small data-layer-note>{manifest.layers.alteBundeslaender.available ? '' : 'derzeit nicht verfügbar'}</small>
                </label>
              </div>
            </details>

            <button class="button-link button-link--secondary" type="button" data-map-reset>
              Auf neue Ordnung zurücksetzen
            </button>
          </div>

          <div
            class="kreisreform-map-canvas"
            data-map-canvas
            tabindex="0"
            role="region"
            aria-label="Interaktive Karte der Kreis- und Bezirksreform. Nutzen Sie die Suche und die Layer-Steuerung für eine zugängliche Auswahl."
          ></div>
          <p class="kreisreform-map-status" data-map-status role="status" aria-live="polite">
            Karte wird vorbereitet.
          </p>

          <div class="kreisreform-legend" aria-label="Legende">
            <span><i class="legend-fill"></i> Neue Kreise</span>
            <span><i class="legend-line"></i> Neue Bezirksgrenzen</span>
            <span><i class="legend-dashed"></i> Bisherige Kreisgrenzen</span>
          </div>

          <div class="status-notice kreisreform-map-notice">
            <h3>Hinweis zur Karte</h3>
            <p>{manifest.notice}</p>
          </div>
        </div>

        <aside class="kreisreform-detail-panel" data-detail-panel aria-live="polite">
          <p class="eyebrow">Auswahl</p>
          <h3>Gebiet auswählen</h3>
          <p>Wählen Sie ein Gebiet in der Karte oder einen Treffer aus der Suche aus.</p>
        </aside>
        </div>
      </div>
    </div>
    <noscript>
      <p class="kreisreform-map-status is-error">
        Die Karte konnte nicht geladen werden. Nutzen Sie die tabellarische Übersicht oder die Suche.
      </p>
    </noscript>
  </section>

  <section id="aenderungen" class="section" aria-labelledby="aenderungen-ueberschrift">
    <div class="section-header">
      <h2 id="aenderungen-ueberschrift">Was ändert sich?</h2>
      <p>Die Reform verbindet eine neue Bezirksordnung mit einer neuen Kreisgliederung.</p>
    </div>
    <div class="compare-grid">
      <article>
        <h3>Bisherige Bezirke</h3>
        <p>
          Bis zum <time datetime="2026-07-31">31. Juli 2026</time> bestehen acht Bezirke: {bisherigeBezirke.join(', ')}. Sie beruhen auf dem
          bisherigen Bezirkseinführungsgesetz.
        </p>
      </article>
      <article>
        <h3>Neue Bezirke</h3>
        <p>
          Ab <time datetime={manifest.stats.wirksamAb}>{formatLongDate(manifest.stats.wirksamAb)}</time> sind vierzehn Bezirke vorgesehen. Sie
          erhalten feste Sitze, eine neue Bezirksordnung und klar zugeordnete Kreise.
        </p>
      </article>
      <article>
        <h3>Bisherige Kreise</h3>
        <p>
          Die bisherigen Landkreise und kreisfreien Städte bleiben für Übergänge, Rechtsnachfolge
          und örtliche Zuordnung wichtig. Ihre Grenzen werden aus den amtlichen VG250-Daten des
          Bundesamtes für Kartographie und Geodäsie abgeleitet.
        </p>
      </article>
      <article>
        <h3>Neue Kreise</h3>
        <p>
          Die neue Ordnung umfasst {formatInteger(manifest.stats.neueKreise)} Landkreise und
          Kreisfreie Städte. Berlin bleibt Sonderfall: Die Stadt ist zugleich Bezirk, Kreisfreie
          Stadt und Bundeshauptstadt; Stadt- und Bezirksorgane werden in Personalunion geführt.
        </p>
      </article>
    </div>
    {!oldLayersAvailable ? (
      <p class="detail-line">
        Die Vergleichslayer zu bisherigen Kreisen, bisherigen Bezirken und alten Ländern sind in
        dieser Datenfassung noch nicht veröffentlicht.
      </p>
    ) : null}
  </section>

  <section id="tabellen" class="section section-muted" aria-labelledby="tabellenueberschrift">
    <div class="section-header">
      <h2 id="tabellenueberschrift">Tabellarische Übersicht</h2>
      <p>
        Die Tabellen bieten eine nicht-kartografische Übersicht über die neuen Bezirke und Kreise.
      </p>
    </div>

    <div class="kreisreform-table-tools" data-kreisreform-table-filter>
      <label class="search-field" for="kreisreform-table-query">
        <span>Kreis oder Bezirk filtern</span>
        <input
          id="kreisreform-table-query"
          type="search"
          autocomplete="off"
          placeholder="z. B. Lausitz oder Berlin"
          data-kreisreform-table-query
        />
      </label>
      <label class="search-field" for="kreisreform-table-bezirk">
        <span>Bezirk auswählen</span>
        <select id="kreisreform-table-bezirk" data-kreisreform-table-bezirk>
          <option value="">Alle Bezirke</option>
          {neueBezirke.map((bezirk) => <option value={bezirk.name}>{bezirk.name}</option>)}
        </select>
      </label>
      <p class="search-feedback" role="status" aria-live="polite" data-kreisreform-table-status>
        {formatCount(neueBezirke.length, 'Bezirk', 'Bezirke')} und {formatCount(neueKreise.length, 'Kreis', 'Kreise')} sichtbar.
      </p>
    </div>

    <p class="table-scroll-hint" id="bezirke-scroll-hint">
      Auf kleinen Bildschirmen können Sie die Tabelle innerhalb dieses Bereichs horizontal verschieben.
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabelle der neuen Bezirke" aria-describedby="bezirke-scroll-hint">
      <table class="data-table">
        <caption>Neue Bezirke</caption>
        <thead>
          <tr>
            <th scope="col">Bezirk</th>
            <th scope="col">Sitz</th>
            <th scope="col">Einwohner</th>
            <th scope="col">Fläche</th>
            <th scope="col">Zugeordnete Kreise</th>
          </tr>
        </thead>
        <tbody>
          {neueBezirke.map((bezirk) => (
            <tr data-kreisreform-table-row data-kind="bezirk" data-name={bezirk.name.toLocaleLowerCase('de-DE')} data-bezirk={bezirk.name}>
              <th scope="row">{bezirk.name}</th>
              <td>{bezirk.sitz}</td>
              <td>{formatInteger(bezirk.einwohner)}</td>
              <td>{formatArea(bezirk.flaecheKm2)}</td>
              <td>{bezirk.kreise.join(', ')}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <p class="table-scroll-hint" id="kreise-scroll-hint">
      Auf kleinen Bildschirmen können Sie die Tabelle innerhalb dieses Bereichs horizontal verschieben.
    </p>
    <div class="table-wrap" tabindex="0" role="region" aria-label="Tabelle der neuen Kreise und Kreisfreien Städte" aria-describedby="kreise-scroll-hint">
      <table class="data-table">
        <caption>Neue Kreise und Kreisfreie Städte</caption>
        <thead>
          <tr>
            <th scope="col">Kreis</th>
            <th scope="col">Typ</th>
            <th scope="col">Bezirk</th>
            <th scope="col">Einwohner</th>
            <th scope="col">Fläche</th>
            <th scope="col">Bisherige Gebietsteile</th>
          </tr>
        </thead>
        <tbody>
          {neueKreise.map((kreis) => (
            <tr data-kreisreform-table-row data-kind="kreis" data-name={`${kreis.name} ${kreis.bezirkNeu}`.toLocaleLowerCase('de-DE')} data-bezirk={kreis.bezirkNeu}>
              <th scope="row">{kreis.name}</th>
              <td>{kreis.typ}</td>
              <td>{kreis.bezirkNeu}</td>
              <td>{formatInteger(kreis.einwohner)}</td>
              <td>{formatArea(kreis.flaecheKm2)}</td>
              <td>
                {kreis.alteKreise.map((entry) => entry.name).join(', ')}
                <span>{formatCount(kreis.gemeinden, 'Gemeinde', 'Gemeinden')}</span>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section id="rechtsgrundlagen" class="section" aria-labelledby="rechtsgrundlagen-ueberschrift">
    <div class="section-header">
      <h2 id="rechtsgrundlagen-ueberschrift">Rechtsgrundlagen</h2>
      <p>Maßgeblich bleibt die verkündete Rechtsfassung mit Anlagen.</p>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong>Entwurf eines Gesetzes zur Neuordnung der Kreise und Bezirke</strong>
        <span>insbesondere Anlagen 1 bis 3 mit Bezirksgrunddaten und Kreiszuordnung.</span>
      </li>
      <li class="record-list__item">
        <strong>Ostdeutsches Bezirkseinführungsgesetz</strong>
        <span>Grundlage der bisherigen acht Bezirke bis zum Wirksamwerden der Neuordnung.</span>
      </li>
      <li class="record-list__item">
        <strong>Digitale Grenzdaten</strong>
        <span>
          ergänzende anschauliche Darstellung; bisherige Kreise und Länder beruhen auf VG250 des
          Bundesamtes für Kartographie und Geodäsie.
        </span>
      </li>
    </ul>
    <p class="section-link-row">
      <a class="inline-link" href={getLawHomeUrl()}>Zum Rechtsportal</a>
      <span aria-hidden="true"> · </span>
      <a class="inline-link" href={getFreestateUrl()}>Über den Freistaat</a>
    </p>
  </section>

  <section id="kreisreform-faq" class="section section-muted" aria-labelledby="kreisreform-faq-ueberschrift">
    <div class="section-header">
      <h2 id="kreisreform-faq-ueberschrift">Häufige Fragen</h2>
      <p>Antworten zur vorgesehenen Neuordnung und zum Übergang am <time datetime="2026-08-01">1. August 2026</time>.</p>
    </div>
    <div class="faq-accordion" data-faq-root data-allow-multiple="false">
      {kreisreformFaq.map((entry) => (
        <details class="faq-accordion__item">
          <summary class="faq-accordion__summary">{entry.question}</summary>
          <div class="faq-accordion__body">
            <p>{entry.question === 'Wo finde ich die Rechtsgrundlagen?' ? <>Die Seite bündelt die vorgesehenen Grundlagen. Verkündete Fassungen und Fundstellen werden im <a class="inline-link" href={getLawHomeUrl()}>Rechtsportal</a> veröffentlicht.</> : entry.question === 'Wann gilt die neue Zuordnung?' ? <>Die neue Kreis- und Bezirksgliederung soll am <time datetime="2026-08-01">1. August 2026</time> wirksam werden.</> : entry.answer}</p>
          </div>
        </details>
      ))}
    </div>
  </section>

  <script>
    import '../../scripts/kreisreform-search.ts';
    import '../../scripts/kreisreform-map.ts';
    import '../../scripts/kreisreform-table.ts';
  </script>

  <style>
    .kreisreform-search-panel {
      padding: 1rem;
      border: 1px solid #9bb79f;
      border-radius: var(--radius-md);
      background: rgba(255, 255, 255, 0.94);
    }

    .kreisreform-search-panel h2,
    .kreisreform-search-panel p {
      margin: 0;
    }

    .kreisreform-search-panel > p {
      margin-top: 0.4rem;
    }

    .kreisreform-search-field {
      max-width: 44rem;
      margin-top: 0.85rem;
    }

    .kreisreform-search-detail {
      margin-top: 1rem;
    }

    .kreisreform-map-gate {
      margin-top: 1.5rem;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
      box-shadow: var(--shadow-card);
    }

    .kreisreform-map-load-surface {
      padding: clamp(1.25rem, 3vw, 2rem);
    }

    .kreisreform-map-load-surface h3 {
      margin: 0;
    }

    .kreisreform-map-shell {
      margin: 0;
    }

    .kreisreform-table-tools {
      display: grid;
      grid-template-columns: minmax(16rem, 1fr) minmax(14rem, 0.65fr);
      gap: 1rem;
      align-items: end;
      margin: 1.25rem 0;
    }

    .kreisreform-table-tools .search-feedback {
      grid-column: 1 / -1;
      margin: 0;
    }

    .table-scroll-hint {
      margin: 1rem 0 0.45rem;
      color: var(--color-text-muted);
      font-size: 0.92rem;
    }

    .kreisreform-map-layout {
      display: grid;
      grid-template-columns: minmax(0, 2.2fr) minmax(18rem, 0.8fr);
      gap: 1rem;
      align-items: stretch;
    }

    .kreisreform-map-main,
    .kreisreform-detail-panel {
      min-width: 0;
      border: 1px solid var(--color-border);
      border-radius: var(--radius-md);
      background: var(--color-surface);
