---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion from '../../components/portal/FaqAccordion.astro';
import MinistryCard from '../../components/portal/MinistryCard.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import SectionNavigation from '../../components/portal/SectionNavigation.astro';
import { formatTopicStatus } from '../../lib/portal/presentation.ts';
import { loadLegislativeProcedures } from '../../lib/portal/legislation.ts';
import {
  getContactUrl,
  getFreestatePageUrl,
  getHomeUrl,
  getMinistryUrl,
  getPortalSearchUrl,
  getTopicUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
import {
  getRuntimeNormLookup,
  loadRuntimeMinistries,
  loadRuntimeTopics,
} from '../../lib/runtime-content/index.ts';
import { getNormUrl } from '../../lib/norms/index.ts';
import type { Themenseite } from '../../lib/portal/index.ts';

export function getStaticPaths() {
  return loadRuntimeTopics().map((topic) => ({
    params: { slug: topic.slug },
    props: { topic },
  }));
}

const { topic } = Astro.props as { topic: Themenseite };

const topics = loadRuntimeTopics();
const ministries = loadRuntimeMinistries();
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const normLookup = getRuntimeNormLookup();
const leadMinistry = topic ? ministryLookup.get(topic.federfuehrendesRessort) : undefined;
const coMinistries = (topic?.mitzeichnungsressorts ?? [])
  .map((entrySlug) => ministryLookup.get(entrySlug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));
const legalReferences = (topic?.rechtsgrundlagen ?? []).map((entry) => ({
  ...entry,
  norm: entry.normSlug ? normLookup.get(entry.normSlug) : undefined,
}));
const relatedTopics = topic
  ? topics
      .filter((entry) => entry.slug !== topic.slug)
      .filter(
        (entry) =>
          entry.federfuehrendesRessort === topic.federfuehrendesRessort ||
          (entry.mitzeichnungsressorts ?? []).includes(topic.federfuehrendesRessort),
      )
      .slice(0, 3)
  : [];
const pressSearchUrl = topic
  ? `${getPortalSearchUrl()}?${new URLSearchParams({ q: topic.title, type: 'press' }).toString()}`
  : getPortalSearchUrl();
const relatedProcedures = topic
  ? (await loadLegislativeProcedures()).filter((procedure) => procedure.relatedTopics.includes(topic.slug))
  : [];
---

{topic ? (
  <BaseLayout
    title={topic.title}
    description={topic.teaser}
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Themen & Projekte', href: getTopicsUrl() },
      { label: topic.title },
    ]}
    scripts={['portal-modules']}
  >
    <Breadcrumbs
      items={[
        { label: 'Startseite', href: getHomeUrl() },
        { label: 'Themen & Projekte', href: getTopicsUrl() },
        { label: topic.title },
      ]}
    />

    <SectionHero
      eyebrow="Themen & Projekte"
      title={topic.title}
      titleSize="long"
      lead={topic.hero ?? topic.teaser}
      status={formatTopicStatus(topic.status)}
      variant="topics"
      facts={[
        ...(leadMinistry ? [{ label: 'Federführendes Ressort', value: leadMinistry.kurzname, href: getMinistryUrl(leadMinistry.slug) }] : []),
        { label: 'Nächster Schritt', value: topic.naechsteSchritte[0] },
        { label: 'Rechtsgrundlagen', value: String(topic.rechtsgrundlagen.length), href: '#rechtsgrundlagen' },
      ]}
      actions={[
        ...(leadMinistry ? [{ label: 'Zum zuständigen Ressort', href: getMinistryUrl(leadMinistry.slug), primary: true }] : []),
        ...(topic.slug === 'kommunen-regionen-und-berlin' ? [{ label: 'Berlin im Freistaat', href: getFreestatePageUrl('berlin') }] : []),
        { label: 'Rechtsgrundlagen', href: '#rechtsgrundlagen' },
      ]}
    />
    <SectionNavigation
      label="Auf dieser Seite"
      variant="topics"
      items={[
        { label: 'Auf einen Blick', href: '#auf-einen-blick' },
        { label: 'Was ändert sich?', href: '#was-aendert-sich' },
        { label: 'Umsetzungsstand', href: '#umsetzung' },
        { label: 'Nächste Schritte', href: '#naechste-schritte' },
        ...(relatedProcedures.length > 0 ? [{ label: 'Gesetzgebung', href: '#gesetzgebung' }] : []),
        { label: 'Rechtsgrundlagen', href: '#rechtsgrundlagen' },
        { label: 'FAQ', href: '#faq' },
        { label: 'Zuständiges Ressort', href: '#ressort' },
      ]}
    />

    <section id="auf-einen-blick" class="section topic-orientation" aria-labelledby="themen-ueberblick">
      <div class="section-header">
        <h2 id="themen-ueberblick">Auf einen Blick</h2>
        <p>Die Kurzstruktur führt direkt zu den wichtigsten Informationen und weiterführenden Bereichen.</p>
      </div>
      <dl class="topic-overview-list">
        <div><dt>Kurzfassung</dt><dd>{topic.teaser}</dd></div>
        <div><dt>Was ändert sich?</dt><dd>{topic.beschlossen[0]}</dd></div>
        <div><dt>Nächster Schritt</dt><dd>{topic.naechsteSchritte[0]}</dd></div>
        <div><dt>Federführung</dt><dd>{leadMinistry ? <a class="inline-link" href={getMinistryUrl(leadMinistry.slug)}>{leadMinistry.kurzname}</a> : 'Keine Angabe'}</dd></div>
      </dl>
    </section>

    <section id="was-aendert-sich" class="section">
      <div class="section-header">
        <h2>Was ändert sich?</h2>
        <p>{topic.teaser}</p>
      </div>
      <ul class="record-list">
        {topic.beschlossen.map((entry) => (
          <li class="record-list__item"><span>{entry}</span></li>
        ))}
      </ul>
    </section>

    <section id="umsetzung" class="section section-muted">
      <div class="section-header">
        <h2>Was ist umgesetzt?</h2>
        <p>Der Stand bildet bereits erreichte und rechtlich abgesicherte Schritte des Vorhabens ab.</p>
      </div>
      <ul class="record-list">
        {topic.umgesetzt.map((entry) => (
          <li class="record-list__item"><span>{entry}</span></li>
        ))}
      </ul>
    </section>

    <section id="naechste-schritte" class="section" data-visual-section="topic-next-steps">
      <div class="section-header">
        <h2>Nächste Schritte</h2>
        <p>Diese Punkte kennzeichnen laufende oder vorbereitete Ausbauschritte innerhalb des Themas.</p>
      </div>
      <ol class="topic-timeline">
        {topic.naechsteSchritte.map((entry) => (
          <li><p>{entry}</p></li>
        ))}
      </ol>
    </section>

    {relatedProcedures.length > 0 ? (
      <section id="gesetzgebung" class="section section-muted" aria-labelledby="gesetzgebung-title">
        <div class="section-header">
          <h2 id="gesetzgebung-title">Rechtsstand der Vorhaben</h2>
          <p>Bestätigter Stand am 1. August 2026. Beschluss, Verkündung und Inkrafttreten werden getrennt ausgewiesen.</p>
        </div>
        <ul class="record-list">
          {relatedProcedures.map((procedure) => (
            <li class="record-list__item">
              <strong>{procedure.shortTitle}</strong>
              <span>Drucksache {procedure.documentNumber} · {procedure.statusLabel}</span>
              {procedure.dateNote ? <span>{procedure.dateNote}</span> : null}
              {procedure.recommendation ? <span>Beschlussempfehlung {procedure.recommendation.documentNumber}: Annahme empfohlen</span> : null}
              {procedure.proposedCommittee ? <span>Bei Einbringung vorgeschlagene Überweisung: {procedure.proposedCommittee}</span> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <section id="rechtsgrundlagen" class="section section-muted" data-visual-section="topic-legal-bases">
      <div class="section-header">
        <h2>Rechtsgrundlagen</h2>
        <p>Hier finden Sie die einschlägigen Gesetze, Verordnungen und Richtlinien.</p>
      </div>
      <ul class="record-list">
        {legalReferences.map((entry) => (
          <li class="record-list__item">
            {entry.norm ? (
              <strong><a class="inline-link" href={getNormUrl(entry.norm.slug)}>{entry.label}</a></strong>
            ) : (
              <strong>{entry.label}</strong>
            )}
            {entry.note ? <span>{entry.note}</span> : null}
          </li>
        ))}
      </ul>
    </section>

    <section id="faq" class="section">
      <div class="section-header">
        <h2>FAQ</h2>
        <p>Antworten auf häufige Fragen zum Vorhaben.</p>
      </div>
      <FaqAccordion items={topic.faq} />
    </section>

    <section id="ressort" class="section section-muted">
      <div class="section-header">
        <h2>Zuständiges Ressort</h2>
        <p>Dieses Ressort ist für das Vorhaben zuständig.</p>
      </div>
      {leadMinistry ? <MinistryCard ministry={leadMinistry} /> : null}
      {coMinistries.length > 0 ? (
        <>
          <p class="detail-line">Mitzeichnende Ressorts</p>
          <div class="tag-list">
            {coMinistries.map((ministry) => (
              <a class="tag" href={getMinistryUrl(ministry.slug)}>{ministry.kurzname}</a>
            ))}
          </div>
        </>
      ) : null}
    </section>

    {relatedTopics.length > 0 ? (
      <section class="section">
        <div class="section-header">
          <h2>Verwandte Themen</h2>
        </div>
        <ul class="record-list">
          {relatedTopics.map((entry) => (
            <li class="record-list__item">
              <a class="inline-link" href={getTopicUrl(entry.slug)}>{entry.title}</a>
              <span>{entry.teaser}</span>
            </li>
          ))}
        </ul>
      </section>
    ) : null}

    <section class="section topic-next-actions" aria-labelledby="was-jetzt">
      <div class="section-header">
        <h2 id="was-jetzt">Was können Sie jetzt tun?</h2>
        <p>Nutzen Sie die weiterführenden Informationen zum Vorhaben.</p>
      </div>
      <nav class="hero-actions" aria-label="Weiterführende Schritte">
        <a class="button-link" href="#rechtsgrundlagen">Rechtsgrundlagen lesen</a>
        {topic.slug === 'kommunen-regionen-und-berlin' ? (
          <a class="button-link button-link--secondary" href={getFreestatePageUrl('berlin')}>Berlin-Übersicht öffnen</a>
        ) : null}
        {leadMinistry ? (
          <a class="button-link button-link--secondary" href={getMinistryUrl(leadMinistry.slug)}>Zuständiges Ressort öffnen</a>
        ) : null}
        <a class="button-link button-link--secondary" href={pressSearchUrl}>Presse zum Thema durchsuchen</a>
        <a class="button-link button-link--secondary" href={getContactUrl()}>Kontakt aufnehmen</a>
      </nav>
    </section>
  </BaseLayout>
) : (
  <BaseLayout
    title="Thema nicht gefunden"
    description="Die angeforderte Themenseite konnte nicht geladen werden."
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Themen & Projekte', href: getTopicsUrl() },
      { label: 'Nicht gefunden' },
    ]}
  >
    <Breadcrumbs
      items={[
        { label: 'Startseite', href: getHomeUrl() },
        { label: 'Themen & Projekte', href: getTopicsUrl() },
        { label: 'Nicht gefunden' },
      ]}
    />

    <section class="section">
      <div class="status-notice status-notice--warning">
        <h1>Themenseite nicht gefunden</h1>
        <p>Der angeforderte Inhalt konnte nicht gefunden werden. Bitte nutzen Sie die Themenübersicht.</p>
      </div>
    </section>
  </BaseLayout>
)}
