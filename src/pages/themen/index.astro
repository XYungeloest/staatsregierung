---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TopicCard from '../../components/portal/TopicCard.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import SectionNavigation from '../../components/portal/SectionNavigation.astro';
import {
  getActionPlanUrl,
  getEducationAndSchoolUrl,
  getHomeUrl,
  getKreisreformUrl,
  getLawHomeUrl,
  getSchoolSystemUrl,
  getServiceUrl,
} from '../../lib/portal/index.ts';
import { loadMinistries, loadTopics } from '../../lib/portal/content.ts';

const [topics, ministries] = await Promise.all([loadTopics(), loadMinistries()]);
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const implementationTopics = topics.filter((topic) => topic.status === 'in-umsetzung');
const legislativeTopics = topics.filter((topic) => topic.status === 'im-gesetzgebungsverfahren');
const plannedTopics = topics.filter((topic) => topic.status === 'geplant');
const linkedNormCount = topics.reduce((count, topic) => count + topic.rechtsgrundlagen.length, 0);
---

<BaseLayout title="Themen & Projekte" description="Reformthemen mit Umsetzungsstand, Zuständigkeiten, nächsten Schritten und Rechtsgrundlagen im Ostdeutschen Freistaat.">
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Themen & Projekte' }]} />

  <SectionHero
    eyebrow="Themen & Projekte"
    title="Themen & Projekte"
    lead="Politische Vorhaben mit Umsetzungsstand, nächsten Schritten, Rechtsgrundlagen und zuständigen Ressorts."
    variant="topics"
    facts={[
      { label: 'Themenseiten', value: String(topics.length) },
      { label: 'Rechtsgrundlagen', value: String(linkedNormCount) },
      { label: 'Federführende Ressorts', value: String(new Set(topics.map((topic) => topic.federfuehrendesRessort)).size) },
    ]}
    actions={[
      { label: 'Gemeinde in neuer Gliederung suchen', href: `${getKreisreformUrl()}#bezirk-suche`, primary: true },
      { label: '15-Punkte-Plan II', href: getActionPlanUrl() },
    ]}
  />
  <SectionNavigation
    label="Themenbereiche"
    variant="topics"
    items={[
      { label: 'Leitthemen', href: '#leitthemen' },
      { label: 'In Umsetzung', href: '#in-umsetzung' },
      { label: 'Gesetzgebung', href: '#gesetzgebung' },
      { label: 'Geplant', href: '#geplant' },
      { label: 'Recht', href: getLawHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
    ]}
  />

  <section id="leitthemen" class="section topic-lead-grid" aria-label="Leitthemen">
    <article class="reform-priority-card">
      <div>
        <p class="eyebrow">Aktuell</p>
        <h2 id="kreisreform-aktuell">Kreis- und Bezirksreform 2026</h2>
        <p>
          Das Kreis- und Bezirksneuordnungsgesetz wurde am <time datetime="2026-07-20">20. Juli 2026</time> verkündet.
          Die Übersicht zeigt den seit <time datetime="2026-08-01">1. August 2026</time> geltenden Zuschnitt,
          die Bezirke, Kreise, historischen Vergleichsstände und Rechtsgrundlagen.
        </p>
      </div>
      <div class="reform-priority-card__actions">
        <a class="button-link" href={`${getKreisreformUrl()}#karte`}>Kreisreform-Karte ansehen</a>
        <a class="button-link button-link--secondary" href={`${getKreisreformUrl()}#rechtsgrundlagen`}>Rechtsgrundlagen lesen</a>
      </div>
    </article>
    <article class="reform-priority-card">
      <div>
        <p class="eyebrow">Bildung</p>
        <h2 id="bildung-schule">Bildung und Schule</h2>
        <p>
          Der Themenbereich bündelt Informationen zu Schularten, Bildungswegen,
          Abschlüssen, Zuständigkeiten und Rechtsgrundlagen.
        </p>
      </div>
      <div class="reform-priority-card__actions">
        <a class="button-link" href={getSchoolSystemUrl()}>Schulsystem ansehen</a>
        <a class="button-link button-link--secondary" href={getEducationAndSchoolUrl()}>Bildung und Schule öffnen</a>
      </div>
    </article>
  </section>

  <section id="in-umsetzung" class="section section-muted" data-visual-section="topics-additional">
    <div class="section-header">
      <h2>In Umsetzung</h2>
      <p>Vorhaben, deren beschlossene oder vorbereitete Maßnahmen derzeit umgesetzt werden.</p>
    </div>
    <div class="card-grid card-grid--two">
      {implementationTopics.map((topic) => (
        <TopicCard topic={topic} ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname} />
      ))}
    </div>
  </section>

  <section id="gesetzgebung" class="section">
    <div class="section-header">
      <h2>Im Gesetzgebungsverfahren</h2>
      <p>Vorhaben, zu denen ein parlamentarisches oder rechtliches Verfahren läuft.</p>
    </div>
    <div class="card-grid card-grid--two">
      {legislativeTopics.map((topic) => (
        <TopicCard topic={topic} ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname} />
      ))}
    </div>
  </section>

  <section id="geplant" class="section section-muted">
    <div class="section-header">
      <h2>Geplant</h2>
      <p>Vorhaben, deren nächste fachliche oder rechtliche Schritte vorbereitet werden.</p>
    </div>
    <div class="card-grid card-grid--two">
      {plannedTopics.map((topic) => (
        <TopicCard topic={topic} ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname} />
      ))}
    </div>
  </section>
</BaseLayout>
