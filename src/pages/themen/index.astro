---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TopicCard from '../../components/portal/TopicCard.astro';
import {
  getActionPlanUrl,
  getEducationAndSchoolUrl,
  getHomeUrl,
  getKreisreformUrl,
  getLawHomeUrl,
  getSchoolSystemUrl,
  getServiceUrl,
} from '../../lib/portal/index.ts';
import { loadMinistries, loadTopics } from '../../lib/portal/content.ts';

const [topics, ministries] = await Promise.all([loadTopics(), loadMinistries()]);
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const flagshipTopics = topics.filter((topic) =>
  ['kernprojekt', 'umgesetzt', 'sehr-weit-umgesetzt'].includes(topic.status),
);
const developingTopics = topics.filter((topic) =>
  ['teilweise-umgesetzt', 'deutlich-umgesetzt', 'ausbauphase', 'laufend'].includes(topic.status),
);
const linkedNormCount = topics.reduce((count, topic) => count + topic.rechtsgrundlagen.length, 0);
---

<BaseLayout title="Themen & Projekte" description="Reformthemen mit Umsetzungsstand, Zuständigkeiten, nächsten Schritten und Rechtsgrundlagen im Ostdeutschen Freistaat.">
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Themen & Projekte' }]} />

  <section class="section page-header">
    <p class="eyebrow">Themen & Projekte</p>
    <h1>Themen & Projekte</h1>
    <p class="lead">
      Hier finden Sie politische Vorhaben, ihren aktuellen Stand, nächste Schritte,
      Rechtsgrundlagen und zuständige Ressorts.
    </p>
    <nav class="hero-actions" aria-label="Themeneinstiege">
      <a class="button-link" href={`${getKreisreformUrl()}#bezirk-suche`}>Gemeinde in neuer Gliederung suchen</a>
      <a class="button-link" href={getActionPlanUrl()}>Zum 15-Punkte-Plan</a>
      <a class="button-link button-link--secondary" href={getLawHomeUrl()}>Zum Rechtsbereich</a>
      <a class="button-link button-link--secondary" href={getServiceUrl()}>Zum Service</a>
    </nav>
  </section>

  <section class="section" aria-labelledby="kreisreform-aktuell">
    <article class="reform-priority-card">
      <div>
        <p class="eyebrow">Aktuell</p>
        <h2 id="kreisreform-aktuell">Kreis- und Bezirksreform 2026</h2>
        <p>
          Der Entwurf zur Neuordnung der Kreise und Bezirke wurde am 23. Juni 2026 in den
          Ostdeutschen Landtag eingebracht. Die Übersicht zeigt den vorgesehenen Zuschnitt,
          die Bezirke, Kreise und Rechtsgrundlagen.
        </p>
      </div>
      <div class="reform-priority-card__actions">
        <a class="button-link" href={`${getKreisreformUrl()}#karte`}>Kreisreform-Karte ansehen</a>
        <a class="button-link button-link--secondary" href={`${getKreisreformUrl()}#rechtsgrundlagen`}>Rechtsgrundlagen lesen</a>
      </div>
    </article>
  </section>

  <section class="section" aria-labelledby="bildung-schule">
    <article class="reform-priority-card">
      <div>
        <p class="eyebrow">Bildung</p>
        <h2 id="bildung-schule">Bildung und Schule</h2>
        <p>
          Der Themenbereich bündelt Informationen zu Schularten, Bildungswegen,
          Abschlüssen, Zuständigkeiten und Rechtsgrundlagen.
        </p>
      </div>
      <div class="reform-priority-card__actions">
        <a class="button-link" href={getSchoolSystemUrl()}>Schulsystem ansehen</a>
        <a class="button-link button-link--secondary" href={getEducationAndSchoolUrl()}>Bildung und Schule öffnen</a>
      </div>
    </article>
  </section>

  <section class="section">
    <div class="meta-grid">
      <div class="meta-card">
        <span class="meta-label">Themenseiten</span>
        <strong>{topics.length}</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Rechtsgrundlagen</span>
        <strong>{linkedNormCount}</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Ressorts beteiligt</span>
        <strong>{new Set(topics.map((topic) => topic.federfuehrendesRessort)).size}</strong>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Bereits weit getragene Vorhaben</h2>
      <p>
        Diese Themen sind politisch weit fortgeschritten und rechtlich abgesichert.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {flagshipTopics.map((topic) => (
        <TopicCard topic={topic} ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Weitere Ausbaubereiche</h2>
      <p>
        Diese Themen sind politisch angelegt und werden von der Staatsregierung schrittweise
        weiter vertieft.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {developingTopics.map((topic) => (
        <TopicCard topic={topic} ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname} />
      ))}
    </div>
  </section>
</BaseLayout>
