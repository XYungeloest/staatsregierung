---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getAccessibilityUrl,
  getContactUrl,
  getEasyLanguageUrl,
  getHomeUrl,
  getServiceUrl,
} from '../../lib/portal/index.ts';
---

<BaseLayout title="Hinweis zu Gebärdensprache" description="Hinweise zum derzeitigen Angebot in Gebärdensprache und zu barrierearmen Alternativen.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Hinweis zu Gebärdensprache' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>Hinweis zu Gebärdensprache</h1>
    <p class="lead">Informationen zum derzeitigen Stand und zu alternativen Zugängen.</p>
  </section>

  <section class="section">
    <div class="status-notice status-notice--current">
      <h2>Gebärdensprachvideos sind derzeit noch nicht verfügbar</h2>
      <p>
        Die wichtigsten Informationen werden bis dahin in Textform, in Leichter Sprache und über
        die Kontaktstelle bereitgestellt.
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="naechste-schritte-gebaerdensprache">
    <div class="section-header">
      <h2 id="naechste-schritte-gebaerdensprache">Geplante Inhalte</h2>
      <p>Das Angebot wird schrittweise aufgebaut.</p>
    </div>
    <ul class="record-list">
      <li class="record-list__item"><span>Einführungsvideos zu Startseite, Suche und Kontakt.</span></li>
      <li class="record-list__item"><span>Erklärungen zu zentralen Serviceangeboten und zum Rechtsportal.</span></li>
      <li class="record-list__item"><span>Hinweise zur Kreisreform und zu weiteren häufig nachgefragten Themen.</span></li>
    </ul>
  </section>

  <section class="section section-muted" aria-labelledby="alternative-zugaenge">
    <div class="section-header">
      <h2 id="alternative-zugaenge">Alternative Informationswege</h2>
      <p>Nutzen Sie bis zur Bereitstellung der Videos die folgenden Angebote.</p>
    </div>
    <nav class="hero-actions" aria-label="Alternative Informationswege">
      <a class="button-link" href={getEasyLanguageUrl()}>Leichte Sprache</a>
      <a class="button-link button-link--secondary" href={getAccessibilityUrl()}>Barrierefreiheit</a>
      <a class="button-link button-link--secondary" href={getContactUrl()}>Hinweise und Fragen mitteilen</a>
    </nav>
  </section>
</BaseLayout>
