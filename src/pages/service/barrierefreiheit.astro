---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getContactUrl, getHomeUrl, getServiceUrl } from '../../lib/portal/index.ts';
import { loadRuntimeServicePageBySlug } from '../../lib/runtime-content/index.ts';
import { siteConfig } from '../../config/site.ts';

const page = loadRuntimeServicePageBySlug('barrierefreiheit');
---

<BaseLayout title={page?.title ?? 'Barrierefreiheit'} description="Hinweise zur Barrierefreiheit des Regierungsportals.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Barrierefreiheit' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>{page?.title ?? 'Barrierefreiheit'}</h1>
    <p class="lead">Informationen zur Barrierefreiheit des Regierungsportals.</p>
  </section>

  <div class="content-grid">
    <section class="section body-copy">
      {(page?.body ?? []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      {page?.accessibilityAudit ? (
        <>
          <div class="section-header">
            <h2>Prüfstand</h2>
            <p>Die folgenden Angaben beziehen sich auf den Portalstand vom {siteConfig.date.formatLong(page.accessibilityAudit.checkedOn)}.</p>
          </div>
          <dl class="meta-list accessibility-audit-list">
            <div>
              <dt>Geprüfte Bereiche</dt>
              <dd>
                <ul>
                  {page.accessibilityAudit.scope.map((entry) => <li>{entry}</li>)}
                </ul>
              </dd>
            </div>
            <div>
              <dt>Prüfungen</dt>
              <dd>
                <ul>
                  {page.accessibilityAudit.methods.map((entry) => <li>{entry}</li>)}
                </ul>
              </dd>
            </div>
          </dl>

          <div class="section-header">
            <h2>Bekannte Einschränkungen</h2>
          </div>
          <ul class="record-list">
            {page.accessibilityAudit.knownLimitations.map((entry) => (
              <li class="record-list__item"><span>{entry}</span></li>
            ))}
          </ul>
        </>
      ) : null}

      <div class="section-header">
        <h2>Feedback und Kontakt</h2>
      </div>
      <p>
        Hinweise zur Barrierefreiheit, zu Darstellungsproblemen oder zu nicht ausreichend
        zugänglichen Inhalten können über die Kontaktseite übermittelt werden.
      </p>
      <p><a class="inline-link" href={getContactUrl()}>Zur Kontaktseite</a></p>
    </section>

    <aside class="section meta-panel">
      <div class="section-header section-header--compact">
        <h2>Prüfhinweise</h2>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Stand</dt>
          <dd>{page?.accessibilityAudit ? siteConfig.date.formatLong(page.accessibilityAudit.checkedOn) : 'Keine Angabe'}</dd>
        </div>
        <div>
          <dt>Grundsatz</dt>
          <dd>Es werden nur nachvollziehbar geprüfte Angaben veröffentlicht.</dd>
        </div>
        <div>
          <dt>Rückmeldung</dt>
          <dd>Über die zentrale Kontaktseite</dd>
        </div>
      </dl>
    </aside>
  </div>
</BaseLayout>
