---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getAccessibilityUrl,
  getCareerUrl,
  getContactUrl,
  getEasyLanguageUrl,
  getFaqUrl,
  getHomeUrl,
  getImprintUrl,
  getPrivacyUrl,
  getPublicationsUrl,
  getServiceOverviewUrl,
  getSignLanguageUrl,
} from '../../lib/portal/index.ts';
import { loadJobOffers } from '../../lib/portal/content.ts';

const offers = await loadJobOffers();
---

<BaseLayout title="Service" description="Kontakt, Karriere, Orientierung und barrierearme Serviceangebote des Regierungsportals.">
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Service' }]} />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>Service</h1>
    <p class="lead">
      Der Servicebereich bündelt Karriere, Kontakt, FAQ sowie rechtlich-organisatorische Hinweise
      an einem einheitlichen Ort.
    </p>
    <p class="detail-line">
      <a class="inline-link" href={getServiceOverviewUrl()}>Zur kompakten Übersicht aller Portalbereiche</a>
    </p>
  </section>

  <section class="section">
    <div class="meta-grid">
      <div class="meta-card">
        <span class="meta-label">Stellenangebote</span>
        <strong>{offers.length}</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Kontaktlogik</span>
        <strong>Digitaler Wegweiser</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Kontaktwege</span>
        <strong>Zentral gebündelt</strong>
      </div>
      <div class="meta-card">
        <span class="meta-label">Publikationen</span>
        <strong>Recht, Presse, Service</strong>
      </div>
    </div>
  </section>

  <section class="section section-muted">
    <div class="card-grid card-grid--three">
      <article class="panel">
        <h2>Karriere</h2>
        <p>Offene Stellen, Rahmendaten und Kontaktwege für die Arbeit in der Landesverwaltung.</p>
        <p><a class="inline-link" href={getCareerUrl()}>Zur Karriere</a></p>
      </article>
      <article class="panel">
        <h2>Kontakt</h2>
        <p>Zentrale Kontaktwege und ein digitaler Zuständigkeitswegweiser für typische Anliegen.</p>
        <p><a class="inline-link" href={getContactUrl()}>Zum Kontakt</a></p>
      </article>
      <article class="panel">
        <h2>FAQ</h2>
        <p>Hilfen zur Nutzung des Rechtsportals, zu Downloads, Informationsanträgen und Kontaktwegen.</p>
        <p><a class="inline-link" href={getFaqUrl()}>Zur FAQ</a></p>
      </article>
      <article class="panel">
        <h2>Publikationen</h2>
        <p>Verkündungen, Presseformate und zentrale Downloadangebote.</p>
        <p><a class="inline-link" href={getPublicationsUrl()}>Zu Publikationen</a></p>
      </article>
      <article class="panel">
        <h2>Leichte Sprache</h2>
        <p>Kurze Orientierung zu den wichtigsten Portalbereichen.</p>
        <p><a class="inline-link" href={getEasyLanguageUrl()}>Zu Leichte Sprache</a></p>
      </article>
      <article class="panel">
        <h2>Gebärdensprache in Vorbereitung</h2>
        <p>Derzeit gibt es noch keine Gebärdensprachvideos. Hier finden Sie Status und Feedbackweg.</p>
        <p><a class="inline-link" href={getSignLanguageUrl()}>Zum Hinweis zu Gebärdensprache</a></p>
      </article>
      <article class="panel">
        <h2>Barrierefreiheit</h2>
        <p>Stand der Zugänglichkeit, bekannte Einschränkungen und Feedbackweg.</p>
        <p><a class="inline-link" href={getAccessibilityUrl()}>Zur Barrierefreiheit</a></p>
      </article>
      <article class="panel">
        <h2>Impressum</h2>
        <p>Verantwortlichkeiten und Angaben zum Portal.</p>
        <p><a class="inline-link" href={getImprintUrl()}>Zum Impressum</a></p>
      </article>
      <article class="panel">
        <h2>Datenschutz</h2>
        <p>Datenschutzhinweise zu Webanalyse und Kontaktwegen.</p>
        <p><a class="inline-link" href={getPrivacyUrl()}>Zum Datenschutz</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
