---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import { getHomeUrl, getServiceUrl } from '../../lib/portal/index.ts';
import { loadRuntimeServicePageBySlug } from '../../lib/runtime-content/index.ts';

const page = loadRuntimeServicePageBySlug('datenschutz');
---

<BaseLayout title={page?.title ?? 'Datenschutz'} description="Datenschutzhinweise des Regierungsportals.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Datenschutz' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>{page?.title ?? 'Datenschutz'}</h1>
  </section>

  <div class="content-grid">
    <section class="section body-copy">
      {(page?.body ?? []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <div class="section-header">
        <h2>Nutzung des Portals</h2>
      </div>
      <p>
        Das öffentliche Portal bietet keine Benutzerkonten und keinen Anmeldebereich. Kontakt-,
        Karriere- und Beteiligungshinweise verweisen auf die jeweils genannten Kontaktwege.
      </p>
      <p>
        Die Normensuche stellt einen Suchindex für Titel, Metadaten und Normtexte bereit.
      </p>

      <div class="section-header">
        <h2>Statistik-Cookies</h2>
      </div>
      <p>
        Wir nutzen Statistik nur, wenn Sie zustimmen. Die Website funktioniert auch ohne
        Webanalyse vollständig. Ohne Zustimmung werden keine Statistik-Cookies aktiviert.
      </p>
      <p>
        Wenn Sie Statistik erlauben, wird Google Analytics 4 zur Reichweitenmessung eingebunden.
        Die Entscheidung wird lokal in Ihrem Browser gespeichert und kann jederzeit geändert
        werden.
      </p>
      <p>
        <button type="button" class="button-link button-link--secondary" data-analytics-consent-reset>
          Datenschutzeinstellungen ändern
        </button>
      </p>
    </section>

    <aside class="section meta-panel">
      <div class="section-header section-header--compact">
        <h2>Datenschutzprofil</h2>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Benutzerkonto</dt>
          <dd>Kein öffentlicher Anmeldebereich</dd>
        </div>
        <div>
          <dt>Formulare</dt>
          <dd>Keine Online-Formulare für Kontakt oder Bewerbung</dd>
        </div>
        <div>
          <dt>Suche</dt>
          <dd>Suchindex im Rechtsbereich</dd>
        </div>
        <div>
          <dt>Webanalyse</dt>
          <dd>Google Analytics 4 nur nach Zustimmung</dd>
        </div>
      </dl>
    </aside>
  </div>
</BaseLayout>
