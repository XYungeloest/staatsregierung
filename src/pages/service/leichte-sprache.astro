---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import {
  getContactUrl,
  getGovernmentUrl,
  getHomeUrl,
  getLawHomeUrl,
  getServiceUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
---

<BaseLayout title="Leichte Sprache" description="Kurze Orientierung zum Portal in leichter verständlicher Sprache.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Leichte Sprache' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>Leichte Sprache</h1>
    <p class="lead">
      Diese Seite erklärt die wichtigsten Bereiche der Website in kurzen Sätzen.
    </p>
  </section>

  <section class="section">
    <div class="card-grid card-grid--three">
      <article class="panel">
        <h2>Staatsregierung</h2>
        <p>Hier finden Sie Informationen über die Regierung, das Kabinett und die Ministerien.</p>
        <p><a class="inline-link" href={getGovernmentUrl()}>Zur Staatsregierung</a></p>
      </article>
      <article class="panel">
        <h2>Themen</h2>
        <p>Hier stehen wichtige Vorhaben der Regierung und die nächsten Schritte.</p>
        <p><a class="inline-link" href={getTopicsUrl()}>Zu den Themen</a></p>
      </article>
      <article class="panel">
        <h2>Recht</h2>
        <p>Hier finden Sie Gesetze, Verordnungen, Fundstellen und Hilfe zur Suche.</p>
        <p><a class="inline-link" href={getLawHomeUrl()}>Zum Rechtsbereich</a></p>
      </article>
      <article class="panel">
        <h2>Kontakt</h2>
        <p>Hier finden Sie Telefonnummern, E-Mail-Adressen und Hinweise zum richtigen Kontaktweg.</p>
        <p><a class="inline-link" href={getContactUrl()}>Zum Kontakt</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
