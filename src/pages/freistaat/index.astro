---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FreestateNavigation from '../../components/portal/FreestateNavigation.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import { siteConfig } from '../../config/site.ts';
import {
  getBudgetUrl,
  getFreestatePageUrl,
  getGovernmentUrl,
  getHomeUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
import { loadFreestatePages } from '../../lib/portal/content.ts';
import { getLawConstitutionUrl } from '../../lib/norms/index.ts';

const pages = await loadFreestatePages();
const orderedPages = [
  'verfassung-und-staatsziele',
  'bezirke',
  'landesfarben-und-hoheitszeichen',
  'hauptstaedte',
  'geschichte',
]
  .map((slug) => pages.find((page) => page.slug === slug))
  .filter((page): page is NonNullable<typeof page> => Boolean(page));
---

<BaseLayout title="Über den Freistaat" description="Grunddaten, Geschichte, Bezirke und Staatsziele des Ostdeutschen Freistaates.">
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Über den Freistaat' }]} />

  <SectionHero
    eyebrow="Über den Freistaat"
    title="Der Ostdeutsche Freistaat"
    lead="Grunddaten, staatliche Struktur, Hoheitszeichen und Geschichte des Freistaates."
    variant="freestate"
    facts={[
      { label: 'Landeshauptstadt', value: siteConfig.currentGovernment.seatOfGovernment },
      { label: 'Bundeshauptstadt', value: 'Berlin' },
      { label: 'Derzeitige Bezirke', value: '8' },
      { label: 'Landesfarben', value: 'Blau, Weiß und Grün' },
    ]}
    image={{
      src: siteConfig.officialFlagAssetPath,
      alt: 'Flagge des Ostdeutschen Freistaates in Blau, Weiß und Grün',
      width: 1920,
      height: 1152,
      widths: [480, 720, 960],
      kind: 'mark',
      position: 'center',
    }}
  />
  <FreestateNavigation />

  <section class="section" aria-labelledby="staatliche-orientierung">
    <div class="section-header">
      <h2 id="staatliche-orientierung">Staatliche Orientierung</h2>
    </div>
    <ul class="direct-entry-list">
      <li><strong>Staatsrat</strong><span><a class="inline-link" href={getGovernmentUrl()}>Staatspräsident, Mitglieder und Staatssekretariate</a></span></li>
      <li><strong>Themen</strong><span><a class="inline-link" href={getTopicsUrl()}>Vorhaben, Zuständigkeiten und nächste Schritte</a></span></li>
      <li><strong>Recht</strong><span><a class="inline-link" href={getLawConstitutionUrl()}>Verfassung und Rechtsordnung</a></span></li>
      <li><strong>Haushalt</strong><span><a class="inline-link" href={getBudgetUrl()}>Doppelhaushalt, Einzelpläne und Fonds</a></span></li>
    </ul>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Themenbereiche</h2>
      <p>
        Verfassung, Bezirke, Hoheitszeichen, Hauptstadtfunktionen und Geschichte im Überblick.
      </p>
    </div>
    <div class="card-grid card-grid--three">
      {orderedPages.map((page) => (
        <article class="panel">
          <h2><a class="inline-link" href={getFreestatePageUrl(page.slug)}>{page.title}</a></h2>
          <p>{page.body[0]}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Direkter Verfassungszugang</h2>
      <p>
        Die rechtliche Grundordnung des Freistaates bleibt parallel als Teil des integrierten
        Rechtsportals zugänglich.
      </p>
    </div>
    <p class="section-link-row">
      <a class="inline-link" href={getLawConstitutionUrl()}>Zur Verfassung im Rechtsportal</a>
    </p>
  </section>
</BaseLayout>
