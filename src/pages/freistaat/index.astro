---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FreestateNavigation from '../../components/portal/FreestateNavigation.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import { siteConfig } from '../../config/site.ts';
import {
  getBudgetUrl,
  getFreestatePageUrl,
  getGovernmentUrl,
  getHomeUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
import { loadCurrentGovernment, loadFreestatePages } from '../../lib/portal/content.ts';
import { getLawConstitutionUrl } from '../../lib/norms/index.ts';

const [pages, currentGovernment] = await Promise.all([loadFreestatePages(), loadCurrentGovernment()]);
const orderedPages = [
  'land-und-leute',
  'staatsaufbau',
  'grosse-staatsreform',
  'verfassung-und-staatsziele',
  'bezirke',
  'berlin',
  'landesfarben-und-hoheitszeichen',
  'hauptstaedte',
  'geschichte',
]
  .map((slug) => pages.find((page) => page.slug === slug))
  .filter((page): page is NonNullable<typeof page> => Boolean(page));
---

<BaseLayout
  title="Über den Freistaat"
  description="Land und Leute, Staatsaufbau, Verfassung, Regionen, Hoheitszeichen und Geschichte des Ostdeutschen Freistaates."
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Über den Freistaat' }]} />

  <SectionHero
    eyebrow="Über den Freistaat"
    title="Der Ostdeutsche Freistaat"
    lead="Land und Leute, Staatsaufbau, Verfassung, Regionen, Hoheitszeichen und Geschichte im Überblick."
    variant="freestate"
    facts={[
      { label: 'Landeshauptstadt', value: currentGovernment.seatOfGovernment },
      { label: 'Volksvertretung', value: currentGovernment.legislature },
      { label: 'Vollziehende Gewalt', value: currentGovernment.title },
      { label: 'Bezirke', value: '14' },
    ]}
    image={{
      src: siteConfig.officialFlagAssetPath,
      alt: 'Flagge des Ostdeutschen Freistaates in Blau, Weiß und Grün',
      width: 1920,
      height: 1152,
      widths: [480, 720, 960],
      kind: 'mark',
      position: 'center',
    }}
  />
  <FreestateNavigation />

  <section class="section" aria-labelledby="staatliche-orientierung">
    <div class="section-header">
      <h2 id="staatliche-orientierung">Staatliche Orientierung</h2>
      <p>Direkte Zugänge zu den wichtigsten Institutionen und Grundlagen des Freistaates.</p>
    </div>
    <ul class="direct-entry-list">
      <li>
        <strong>Staatsaufbau</strong>
        <span><a class="inline-link" href={getFreestatePageUrl('staatsaufbau')}>Volkskammer, Staatsrat und Verfassungsgerichtshof</a></span>
      </li>
      <li>
        <strong>Große Staatsreform</strong>
        <span><a class="inline-link" href={getFreestatePageUrl('grosse-staatsreform')}>Neuordnung seit dem 21. Juli 2026</a></span>
      </li>
      <li>
        <strong>Berlin</strong>
        <span><a class="inline-link" href={getFreestatePageUrl('berlin')}>Bundeshauptstadt, Stadtbezirke und Sonderregeln</a></span>
      </li>
      <li>
        <strong>Staatsrat</strong>
        <span><a class="inline-link" href={getGovernmentUrl()}>Staatspräsident, Mitglieder und Staatssekretariate</a></span>
      </li>
      <li>
        <strong>Recht</strong>
        <span><a class="inline-link" href={getLawConstitutionUrl()}>Verfassung und Rechtsordnung</a></span>
      </li>
      <li>
        <strong>Themen</strong>
        <span><a class="inline-link" href={getTopicsUrl()}>Vorhaben, Zuständigkeiten und nächste Schritte</a></span>
      </li>
      <li>
        <strong>Haushalt</strong>
        <span><a class="inline-link" href={getBudgetUrl()}>Doppelhaushalt, Einzelpläne und Fonds</a></span>
      </li>
    </ul>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Themenbereiche</h2>
      <p>
        Grundlagen des Landes, neue Staatsorganisation, regionale Gliederung und historische Entwicklung.
      </p>
    </div>
    <div class="card-grid card-grid--three">
      {orderedPages.map((page) => (
        <article class="panel">
          <h2><a class="inline-link" href={getFreestatePageUrl(page.slug)}>{page.title}</a></h2>
          <p>{page.body[0]}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Direkter Verfassungszugang</h2>
      <p>
        Die geltende Verfassung und die vier Gesetze zur Großen Staatsreform sind im integrierten
        Rechtsportal mit Fundstellen und Fassungen zugänglich.
      </p>
    </div>
    <p class="section-link-row">
      <a class="inline-link" href={getLawConstitutionUrl()}>Zur Verfassung im Rechtsportal</a>
    </p>
  </section>
</BaseLayout>
