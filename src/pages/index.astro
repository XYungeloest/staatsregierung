---
import BaseLayout from '../layouts/BaseLayout.astro';
import FreestateSummary from '../components/portal/FreestateSummary.astro';
import HomeMinistryList from '../components/portal/HomeMinistryList.astro';
import HomePressList from '../components/portal/HomePressList.astro';
import ImportantNoticeBand from '../components/portal/ImportantNoticeBand.astro';
import PortalAccessCard from '../components/portal/PortalAccessCard.astro';
import PortalIcon from '../components/portal/PortalIcon.astro';
import ResponsivePicture from '../components/portal/ResponsivePicture.astro';
import StatusBadge from '../components/portal/StatusBadge.astro';
import { siteConfig } from '../config/site.ts';
import { loadAllVerkuendungen } from '../lib/norms/publications.ts';
import { getPublicationUrl } from '../lib/norms/routes.ts';
import { buildOrganizationJsonLd, buildWebSiteJsonLd } from '../lib/seo/index.ts';
import {
  getActionPlanUrl,
  getBudgetUrl,
  getCareerUrl,
  getContactUrl,
  getFreestateUrl,
  getGovernmentUrl,
  getKreisreformUrl,
  getLawConstitutionUrl,
  getLawHomeUrl,
  getMinistriesUrl,
  getPortalSearchUrl,
  getPressUrl,
  getTopicUrl,
  getTopicsUrl,
} from '../lib/portal/index.ts';
import {
  loadCurrentJobOffers,
  loadMinistries,
  loadRecentPressReleases,
  loadTopics,
} from '../lib/portal/content.ts';

const [ministries, topics, latestReleases, publications, currentJobs] = await Promise.all([
  loadMinistries(),
  loadTopics(),
  loadRecentPressReleases(3),
  loadAllVerkuendungen(),
  loadCurrentJobOffers(1),
]);

const currentGovernment = siteConfig.currentGovernment;
const latestPublication = publications[0];
const latestJob = currentJobs[0];
const featuredTopics = ['bildungsreform', 'energie-und-klima', 'wohnen-und-vergesellschaftung']
  .flatMap((slug) => {
    const topic = topics.find((entry) => entry.slug === slug);
    return topic ? [topic] : [];
  });

const portalAccesses = [
  {
    title: 'Recht & Vorschriften',
    description: 'Gesetze, Fassungen und Verkündungen durchsuchen',
    href: getLawHomeUrl(),
    icon: 'law' as const,
  },
  {
    title: 'Themen & Reformen',
    description: 'Politische Vorhaben, Umsetzung und nächste Schritte',
    href: getTopicsUrl(),
    icon: 'topics' as const,
  },
  {
    title: 'Kreisreform',
    description: 'Gemeinden, neue Kreise und Bezirke finden',
    href: getKreisreformUrl(),
    icon: 'map' as const,
  },
  {
    title: 'Haushalt',
    description: 'Ausgaben, Einzelpläne und Sondervermögen',
    href: getBudgetUrl(),
    icon: 'budget' as const,
  },
  {
    title: 'Staatsregierung',
    description: 'Kabinett, Mitglieder und politische Vorhaben',
    href: getGovernmentUrl(),
    icon: 'government' as const,
  },
  {
    title: 'Ministerien',
    description: 'Ressorts, Zuständigkeiten und Kontaktwege',
    href: getMinistriesUrl(),
    icon: 'ministry' as const,
  },
  {
    title: 'Presse & Termine',
    description: 'Mitteilungen, Reden, Termine, RSS und Kalender',
    href: getPressUrl(),
    icon: 'press' as const,
  },
];

const importantItems = [
  {
    title: 'Kreis- und Bezirksreform 2026',
    description: 'Neue Gliederung ab 1. August 2026',
    href: getKreisreformUrl(),
    icon: 'map' as const,
  },
  {
    title: currentGovernment.cabinetName,
    description: `Seit ${siteConfig.date.formatLong(currentGovernment.formedOn)} im Amt`,
    href: getGovernmentUrl(),
    icon: 'government' as const,
  },
  {
    title: 'Doppelhaushalt 2025/2026',
    description: 'Kennzahlen, Einzelpläne und Vergleiche',
    href: getBudgetUrl(),
    icon: 'budget' as const,
  },
];
---

<BaseLayout
  title="Regierungsportal des Ostdeutschen Freistaates"
  description="Gesetze, Reformvorhaben, Haushaltsdaten, Pressemitteilungen und zuständige Ressorts im Regierungsportal des Ostdeutschen Freistaates."
  breadcrumbs={[{ label: 'Startseite', href: '/' }]}
  structuredData={[buildWebSiteJsonLd(Astro.site), buildOrganizationJsonLd(Astro.site)]}
  mainWidth="full"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <ResponsivePicture
        className="home-hero__image"
        src="/images/ministerien/staatskanzlei.jpg"
        alt="Blick über die Elbe auf das Regierungsviertel in Dresden"
        width={960}
        height={720}
        widths={[480, 720, 960]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container home-hero__inner">
        <div class="home-hero__content">
          <p class="eyebrow">Regierungsportal des Ostdeutschen Freistaates</p>
          <h1 id="home-hero-title">Schnell zur richtigen Information</h1>
          <p class="home-hero__lead">
            Finden Sie Gesetze, Reformvorhaben, Haushaltsdaten, Pressemitteilungen und die
            zuständigen Ressorts.
          </p>
          <form class="home-hero-search" action={getPortalSearchUrl()} method="get" role="search" aria-label="Portalsuche auf der Startseite">
            <label for="home-portal-search">Womit können wir Ihnen helfen?</label>
            <div class="home-hero-search__control">
              <input
                id="home-portal-search"
                type="search"
                name="q"
                autocomplete="off"
                placeholder="z. B. Kreisreform, Verfassung, Haushalt, Ressort oder Pressemitteilung"
              />
              <button type="submit"><PortalIcon name="search" /><span>Suchen</span></button>
            </div>
            <nav class="home-search-chips" aria-label="Häufige Sucheinstiege">
              <span>Häufig gesucht:</span>
              <a href={getKreisreformUrl()}>Kreisreform</a>
              <a href={getLawConstitutionUrl()}>Verfassung</a>
              <a href={getTopicUrl('bildungsreform')}>Bildungsreform</a>
              <a href={getBudgetUrl()}>Haushalt</a>
              <a href={getActionPlanUrl()}>15-Punkte-Plan</a>
            </nav>
          </form>
        </div>
      </div>
    </section>

    <section class="home-band home-access-section" aria-labelledby="home-access-title">
      <div class="container">
        <header class="home-section-heading home-section-heading--compact">
          <div>
            <p class="eyebrow">Direkteinstiege</p>
            <h2 id="home-access-title">Zentrale Portalbereiche</h2>
          </div>
          <a href={getFreestateUrl()}>Portal im Überblick <span aria-hidden="true">→</span></a>
        </header>
        <div class="portal-access-grid">
          {portalAccesses.map((access) => <PortalAccessCard {...access} />)}
        </div>
      </div>
    </section>

    <section class="home-band home-important-section">
      <div class="container"><ImportantNoticeBand items={importantItems} /></div>
    </section>

    <section class="home-band home-information-section" aria-label="Aktuelles, Ministerien und Orientierung">
      <div class="container home-information-grid">
        <HomePressList releases={latestReleases} />
        <HomeMinistryList ministries={ministries.slice(0, 6)} />
        <FreestateSummary />
      </div>
    </section>

    <section class="home-band home-priority-section" aria-labelledby="home-priority-title">
      <div class="container">
        <header class="home-section-heading">
          <div>
            <p class="eyebrow">Reformen und Vorhaben</p>
            <h2 id="home-priority-title">Was den Freistaat jetzt bewegt</h2>
            <p>Aktueller Stand, nächste Schritte und die verantwortlichen Ressorts.</p>
          </div>
          <a href={getTopicsUrl()}>Alle Themen und Reformen <span aria-hidden="true">→</span></a>
        </header>
        <div class="home-priority-grid">
          <article class="home-lead-feature">
            <div class="home-lead-feature__icon"><PortalIcon name="map" /></div>
            <p class="eyebrow">Leitthema</p>
            <h3>Kreis- und Bezirksreform 2026</h3>
            <p>
              Suchen Sie Gemeinden und sehen Sie die Zuordnung zu neuen Kreisen und Bezirken.
              Textliche Ergebnisse stehen auch ohne geöffnete Karte bereit.
            </p>
            <dl class="home-lead-feature__facts">
              <div><dt>Gesetzgebungsverfahren</dt><dd>2026</dd></div>
              <div><dt>Wirksamwerden</dt><dd>1. August 2026</dd></div>
            </dl>
            <a class="button-link" href={`${getKreisreformUrl()}#bezirk-suche`}>Gemeinde suchen <PortalIcon name="arrow" /></a>
          </article>
          <div class="home-topic-list">
            {featuredTopics.map((topic) => (
              <article>
                <div><StatusBadge status={topic.status} /></div>
                <h3><a href={getTopicUrl(topic.slug)}>{topic.title}</a></h3>
                <p>{topic.teaser}</p>
                <a class="home-topic-list__link" href={getTopicUrl(topic.slug)} aria-label={`${topic.title} ansehen`}><PortalIcon name="arrow" /></a>
              </article>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section class="home-band home-resource-section" aria-labelledby="home-resource-title">
      <div class="container">
        <header class="home-section-heading home-section-heading--compact">
          <div>
            <p class="eyebrow">Transparenz und Service</p>
            <h2 id="home-resource-title">Recht, Haushalt und Regierungsarbeit</h2>
          </div>
        </header>
        <div class:list={['home-resource-grid', latestJob && 'home-resource-grid--four']}>
          <article class="home-resource-card">
            <PortalIcon name="law" />
            <p class="eyebrow">Recht schnell finden</p>
            <h3>{latestPublication?.title ?? 'Gesetze und Vorschriften'}</h3>
            {latestPublication ? (
              <p>
                Verkündet am <time datetime={latestPublication.date}>{siteConfig.date.formatLong(latestPublication.date)}</time>
                {' · '}{latestPublication.entries.length} Einträge
              </p>
            ) : <p>Aktuelle Fassungen, Fundstellen und Verkündungen im Rechtsportal.</p>}
            <a href={latestPublication ? getPublicationUrl(latestPublication.slug) : getLawHomeUrl()}>Veröffentlichung öffnen <PortalIcon name="arrow" /></a>
          </article>
          <article class="home-resource-card">
            <PortalIcon name="budget" />
            <p class="eyebrow">Doppelhaushalt 2025/2026</p>
            <h3>Öffentliche Finanzen nachvollziehen</h3>
            <p>Gesamtplan, Einzelpläne, Jahresvergleich, Sondervermögen und offene Datenausgabe.</p>
            <a href={getBudgetUrl()}>Zum Haushalt <PortalIcon name="arrow" /></a>
          </article>
          <article class="home-resource-card">
            <PortalIcon name="government" />
            <p class="eyebrow">Regierungsprogramm</p>
            <h3>15-Punkte-Plan II</h3>
            <p>Vorhaben des {currentGovernment.cabinetName} mit Umsetzungsstand und Rechtsgrundlagen.</p>
            <a href={getActionPlanUrl()}>Programm ansehen <PortalIcon name="arrow" /></a>
          </article>
          {latestJob ? (
            <article class="home-resource-card">
              <PortalIcon name="contact" />
              <p class="eyebrow">Karriere</p>
              <h3>{latestJob.title}</h3>
              <p>
                {latestJob.ressort} · Bewerbung bis{' '}
                <time datetime={latestJob.applicationDeadline}>{siteConfig.date.formatLong(latestJob.applicationDeadline)}</time>
              </p>
              <a href={getCareerUrl()}>Aktuelle Stellenangebote <PortalIcon name="arrow" /></a>
            </article>
          ) : null}
        </div>
        <div class="home-follow-row">
          <div>
            <PortalIcon name="rss" />
            <span><strong>Pressemitteilungen abonnieren</strong><small>Neue Mitteilungen stehen als RSS-Feed bereit.</small></span>
          </div>
          <a href={`${getPressUrl()}rss.xml`}>RSS-Feed öffnen</a>
          <div>
            <PortalIcon name="calendar" />
            <span><strong>Termine im Kalender</strong><small>Öffentliche Termine als Kalenderdatei.</small></span>
          </div>
          <a href={`${getPressUrl()}termine/kalender.ics`}>Kalender abonnieren</a>
        </div>
        <p class="home-contact-link"><a href={getContactUrl()}>Kontakt und weitere Serviceangebote <span aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </div>
</BaseLayout>
