---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import TopicCard from '../components/portal/TopicCard.astro';
import { siteConfig } from '../config/site.ts';
import { buildOrganizationJsonLd, buildWebSiteJsonLd } from '../lib/seo/index.ts';
import {
  getActionPlanUrl,
  getBudgetUrl,
  getGovernmentUrl,
  getHomeUrl,
  getKreisreformUrl,
  getLawHomeUrl,
  getContactUrl,
  getEventIndexUrl,
  getPortalSearchUrl,
  getPressReleaseIndexUrl,
  getPressReleaseUrl,
  getPressUrl,
  getTopicsUrl,
} from '../lib/portal/index.ts';
import { loadMinistries, loadRecentPressReleases, loadTopics } from '../lib/portal/content.ts';

const [ministries, topics, latestReleases] = await Promise.all([
  loadMinistries(),
  loadTopics(),
  loadRecentPressReleases(1),
]);

const currentGovernment = siteConfig.currentGovernment;
const latestRelease = latestReleases[0];
const featuredTopics = [
  'wohnen-und-vergesellschaftung',
  'gute-arbeit',
  'energie-und-klima',
].flatMap((slug) => {
  const topic = topics.find((entry) => entry.slug === slug);
  return topic ? [topic] : [];
});
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
---

<BaseLayout
  title="Regierungsportal des Ostdeutschen Freistaates"
  description="Aktuelle Vorhaben, Rechtsgrundlagen, Pressemitteilungen und Kontaktwege der Staatsregierung des Ostdeutschen Freistaates."
  breadcrumbs={[{ label: 'Startseite', href: getHomeUrl() }]}
  structuredData={[buildWebSiteJsonLd(Astro.site), buildOrganizationJsonLd(Astro.site)]}
>
  <Breadcrumbs items={[{ label: 'Startseite' }]} />

  <section class="section page-header portal-home-header">
    <p class="eyebrow">Staatsregierung des Ostdeutschen Freistaates</p>
    <h1>Gesetze, Reformen und Services auf einen Blick</h1>
    <p class="lead">
      Finden Sie aktuelle Rechtsstände, politische Vorhaben, Haushaltsdaten und den passenden
      Kontakt zur Staatsregierung.
    </p>
    <nav class="hero-actions portal-home-header__actions" aria-label="Wichtige Einstiege">
      <a class="button-link" href={getPortalSearchUrl()}>Portal durchsuchen</a>
      <a class="button-link button-link--secondary" href="#aktuelle-vorhaben">Aktuelle Vorhaben</a>
    </nav>
  </section>

  <section class="section" aria-labelledby="portalpfade">
    <div class="section-header">
      <h2 id="portalpfade">Was suchen Sie?</h2>
      <p>Wählen Sie den Einstieg, der zu Ihrem Anliegen passt.</p>
    </div>
    <div class="card-grid card-grid--three portal-path-grid">
      <article class="panel portal-path-card">
        <h3>Gesetz finden</h3>
        <p>Durchsuchen Sie Vorschriften, Fassungen, Fundstellen und Verkündungen.</p>
        <p><a class="inline-link" href={getLawHomeUrl()}>Gesetz suchen</a></p>
      </article>
      <article class="panel portal-path-card">
        <h3>Reform verstehen</h3>
        <p>Sehen Sie Umsetzungsstand, Zuständigkeit, nächste Schritte und Rechtsgrundlagen.</p>
        <p><a class="inline-link" href={getTopicsUrl()}>Reformen ansehen</a></p>
      </article>
      <article class="panel portal-path-card">
        <h3>Neue Kreiszuordnung finden</h3>
        <p>Finden Sie Gemeinden, Kreise und Bezirke in der Kreisreform 2026.</p>
        <p><a class="inline-link" href={`${getKreisreformUrl()}#bezirk-suche`}>Gemeinde suchen</a></p>
      </article>
      <article class="panel portal-path-card">
        <h3>Zuständige Stelle finden</h3>
        <p>Nutzen Sie zentrale Kontaktwege und den Zuständigkeitswegweiser.</p>
        <p><a class="inline-link" href={getContactUrl()}>Kontaktweg finden</a></p>
      </article>
      <article class="panel portal-path-card">
        <h3>Presse und Termine</h3>
        <p>Lesen Sie Pressemitteilungen, Reden und Termine der Staatsregierung.</p>
        <p><a class="inline-link" href={getPressUrl()}>Pressebereich öffnen</a></p>
      </article>
    </div>
  </section>

  <section id="aktuelle-vorhaben" class="section portal-reform-priority" aria-labelledby="aktuell-wichtig">
    <div class="section-header">
      <h2 id="aktuell-wichtig">Aktuelle Vorhaben</h2>
      <p>Zentrale Reformen und ihr Umsetzungsstand im Überblick.</p>
    </div>
    <div class="card-grid card-grid--three">
      <article class="panel portal-project-card">
        <h3>Kreis- und Bezirksreform 2026</h3>
        <p>Gesetzgebungsverfahren 2026, Wirksamwerden zum <time datetime="2026-08-01">1. August 2026</time>.</p>
        <p><a class="inline-link" href={`${getKreisreformUrl()}#bezirk-suche`}>Gemeinde suchen</a></p>
      </article>
      {featuredTopics.map((topic) => (
        <TopicCard
          topic={topic}
          ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname}
        />
      ))}
    </div>
    <p class="section-link-row">
      <a class="inline-link" href={getTopicsUrl()}>Alle Reformthemen</a>
      <span aria-hidden="true"> · </span>
      <a class="inline-link" href={getBudgetUrl()}>Doppelhaushalt 2025/2026</a>
      <span aria-hidden="true"> · </span>
      <a class="inline-link" href={getLawHomeUrl()}>Aktuelle Gesetzgebung</a>
    </p>
  </section>

  <section class="section section-muted" aria-labelledby="regierungsstand">
    <div class="status-notice status-notice--current">
      <h2 id="regierungsstand">Aktueller Regierungsstand</h2>
      <p>
        Das {currentGovernment.cabinetName} ist seit dem{' '}
        <time datetime={currentGovernment.formedOn}>{siteConfig.date.formatLong(currentGovernment.formedOn)}</time> im Amt. Es wird von{' '}
        {currentGovernment.headOfGovernment} geleitet; die politischen Vorhaben sind im
        15-Punkte-Plan II gebündelt.
      </p>
      <p>
        <a class="inline-link" href={getGovernmentUrl()}>Zum Kabinett und den Ressorts</a>
        <span aria-hidden="true"> · </span>
        <a class="inline-link" href={getActionPlanUrl()}>Zum 15-Punkte-Plan</a>
      </p>
    </div>
  </section>

  <section class="section" aria-labelledby="presse-service">
    <div class="section-header">
      <h2 id="presse-service">Presse und Termine</h2>
      <p>Aktuelle Mitteilungen, öffentliche Termine und Abonnements der Staatsregierung.</p>
    </div>
    <div class="card-grid card-grid--three">
      <article class="panel">
        <p class="eyebrow">Neueste Pressemitteilung</p>
        {latestRelease ? (
          <>
            <h3><a class="inline-link" href={getPressReleaseUrl(latestRelease.slug)}>{latestRelease.title}</a></h3>
            <p>{latestRelease.teaser}</p>
            <p class="detail-line"><time datetime={latestRelease.date}>{siteConfig.date.formatLong(latestRelease.date)}</time> · {latestRelease.ressort}</p>
          </>
        ) : <p><a class="inline-link" href={getPressReleaseIndexUrl()}>Pressemitteilungen öffnen</a></p>}
      </article>
      <article class="panel">
        <h3>Termine und Abonnements</h3>
        <p>Öffentliche Termine lassen sich als Kalender öffnen; neue Mitteilungen stehen als RSS-Feed bereit.</p>
        <p>
          <a class="inline-link" href={getEventIndexUrl()}>Termine ansehen</a>
          <span aria-hidden="true"> · </span>
          <a class="inline-link" href={`${getEventIndexUrl()}kalender.ics`}>Kalender</a>
          <span aria-hidden="true"> · </span>
          <a class="inline-link" href={`${getPressUrl()}rss.xml`}>RSS</a>
        </p>
      </article>
      <article class="panel">
        <h3>Kontakt</h3>
        <p>Der Wegweiser führt zum passenden Bürgertelefon, Presse- oder Fachkontakt.</p>
        <p><a class="inline-link" href={getContactUrl()}>Zuständige Stelle finden</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
