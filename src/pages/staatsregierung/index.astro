---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import GovernmentMemberCard from '../../components/portal/GovernmentMemberCard.astro';
import GovernmentNavigation from '../../components/portal/GovernmentNavigation.astro';
import MinistryDirectory from '../../components/portal/MinistryDirectory.astro';
import SectionHero from '../../components/portal/SectionHero.astro';
import TopicCard from '../../components/portal/TopicCard.astro';
import { siteConfig } from '../../config/site.ts';
import {
  getActionPlanUrl,
  getCabinetUrl,
  getCoalitionUrl,
  getGovernmentMembersUrl,
  getHomeUrl,
  getMinisterPresidentUrl,
  getPreviousCabinetsUrl,
  getTopicsUrl,
} from '../../lib/portal/index.ts';
import {
  loadCurrentGovernmentMembers,
  loadMinistries,
  loadTopics,
} from '../../lib/portal/content.ts';

const [members, topics, ministries] = await Promise.all([
  loadCurrentGovernmentMembers(),
  loadTopics(),
  loadMinistries(),
]);
const currentGovernment = siteConfig.currentGovernment;
const stateMinistryCount = ministries.filter((ministry) => ministry.slug !== 'staatskanzlei').length;
const headOfGovernment = members[0];
const featuredMembers = members.slice(0, 6);
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const flagshipTopics = [
  'wohnen-und-vergesellschaftung',
  'gute-arbeit',
  'energie-und-klima',
].flatMap((slug) => {
  const topic = topics.find((entry) => entry.slug === slug);
  return topic ? [topic] : [];
});
---

<BaseLayout
  title="Staatsregierung"
  description="Kabinett, Regierungsmitglieder, Ministerien und Zuständigkeiten der Staatsregierung des Ostdeutschen Freistaates."
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Staatsregierung' }]} />

  <SectionHero
    eyebrow="Staatsregierung"
    title="Staatsregierung"
    lead={`Das ${currentGovernment.cabinetName} führt die Staatsregierung und koordiniert die Arbeit der Ministerien.`}
    variant="government"
    facts={[
      { label: 'Kabinett', value: currentGovernment.cabinetName },
      { label: 'Ministerpräsident', value: currentGovernment.headOfGovernment, href: getMinisterPresidentUrl() },
      { label: 'Koalition', value: currentGovernment.coalitionShort, href: getCoalitionUrl() },
      { label: 'Staatsministerien', value: String(stateMinistryCount), href: getCabinetUrl() },
    ]}
    actions={[
      { label: 'Kabinett und Ministerien', href: getCabinetUrl(), primary: true },
      { label: '15-Punkte-Plan', href: getActionPlanUrl() },
    ]}
    image={headOfGovernment ? {
      src: headOfGovernment.bild,
      alt: headOfGovernment.bildAlt ?? `Porträt von ${headOfGovernment.name}`,
      credit: headOfGovernment.bildnachweis,
      width: 352,
      height: 440,
      widths: [240, 360, 480],
      kind: 'portrait',
    } : undefined}
  />
  <GovernmentNavigation />

  <div class="content-grid" data-visual-section="government-leadership-entrypoints">
    <section class="section">
      <div class="section-header">
        <h2>Leitung der Staatsregierung</h2>
      </div>
      {headOfGovernment ? <GovernmentMemberCard member={headOfGovernment} /> : null}
      <div class="body-copy">
        <p>
          Die Staatsregierung bestimmt die Richtlinien der Politik, koordiniert Kabinettsverfahren
          und bündelt politische Kommunikation, Ressortsteuerung und zentrale Landesaufgaben.
        </p>
        <p>
          Seit dem <time datetime={currentGovernment.formedOn}>{siteConfig.date.formatLong(currentGovernment.formedOn)}</time> führt
          {` ${currentGovernment.headOfGovernment} `} die Staatsregierung. Stellvertretender
          Ministerpräsident ist {currentGovernment.deputyHead}.
        </p>
        <p>
          Dresden ist der sichtbare politische Bezugspunkt für Kabinettsarbeit,
          Regierungskoordination und ressortübergreifende Umsetzung.
        </p>
      </div>
    </section>

    <aside class="section meta-panel">
      <div class="section-header section-header--compact">
        <h2>Direkteinstiege</h2>
      </div>
      <nav class="link-list">
        <a href={getMinisterPresidentUrl()}>Ministerpräsident</a>
        <a href={getCabinetUrl()}>Kabinett und Ressorts</a>
        <a href={getCoalitionUrl()}>Koalition</a>
        <a href={getActionPlanUrl()}>15-Punkte-Plan</a>
        <a href={getGovernmentMembersUrl()}>Regierungsmitglieder</a>
        <a href={getPreviousCabinetsUrl()}>Frühere Kabinette</a>
      </nav>
    </aside>
  </div>

  <section class="section section-muted" data-visual-section="government-direct-entrypoints">
    <div class="section-header">
      <h2>Direkte Wege zur Regierungsarbeit</h2>
      <p>
        Die Staatsregierung wird als zusammenhängender Hauptbereich geführt und bindet personelle,
        politische und thematische Ebenen sichtbar zusammen.
      </p>
    </div>
    <ul class="direct-entry-list">
      <li><strong>Politische Leitung</strong><span><a class="inline-link" href={getMinisterPresidentUrl()}>Ministerpräsident und Staatskanzlei</a></span></li>
      <li><strong>Kabinett</strong><span><a class="inline-link" href={getCabinetUrl()}>Ministerien, Zuständigkeiten und Regierungsmitglieder</a></span></li>
      <li><strong>Arbeitsgrundlage</strong><span><a class="inline-link" href={getCoalitionUrl()}>Koalition</a> und <a class="inline-link" href={getActionPlanUrl()}>15-Punkte-Plan II</a></span></li>
    </ul>
  </section>

  <section class="section" aria-labelledby="ministerien" data-visual-section="government-ministry-directory">
    <div class="section-header">
      <h2 id="ministerien">Ministerien</h2>
      <p>Leitung und zentrale Aufgaben der Ministerien des {currentGovernment.cabinetName}.</p>
    </div>
    <MinistryDirectory ministries={ministries} />
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Politische Schwerpunkte</h2>
      <p>
        Diese Themen tragen die aktuelle Regierungsarbeit bereits sichtbar und sind direkt mit
        Ressorts und Rechtsgrundlagen verknüpft.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {flagshipTopics.map((topic) => (
        <TopicCard
          topic={topic}
          ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname}
        />
      ))}
    </div>
    <p class="section-link-row">
      <a class="inline-link" href={getTopicsUrl()}>Zu allen Themen & Projekte</a>
    </p>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Regierungsmitglieder</h2>
      <p>Die Profile stellen Amt, Zuständigkeiten, Lebenslauf und Kontakt übersichtlich zusammen.</p>
    </div>
    <div class="card-grid card-grid--two">
      {featuredMembers.map((member) => (
        <GovernmentMemberCard member={member} variant="compact" />
      ))}
    </div>
    <p class="section-link-row">
      <a class="inline-link" href={getGovernmentMembersUrl()}>Alle Regierungsmitglieder anzeigen</a>
    </p>
  </section>
</BaseLayout>
