---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import TopicCard from '../../../components/portal/TopicCard.astro';
import {
  getGovernmentUrl,
  getHomeUrl,
  getMinistriesUrl,
  resolvePortalPath,
} from '../../../lib/portal/index.ts';
import { toDisplayText } from '../../../lib/norms/presentation.ts';
import { loadAllNormMetas } from '../../../lib/norms/loader.ts';
import { loadMinistries, loadTopics } from '../../../lib/portal/content.ts';
import { getNormUrl } from '../../../lib/norms/index.ts';
import type { Ministerium } from '../../../lib/portal/index.ts';

export async function getStaticPaths() {
  const ministries = await loadMinistries();
  return ministries.map((ministry) => ({
    params: { ressort: ministry.slug },
    props: { ministry },
  }));
}

const { ministry } = Astro.props as { ministry: Ministerium };

const [topics, normMetas] = await Promise.all([loadTopics(), loadAllNormMetas()]);
const normLookup = new Map(normMetas.map((meta) => [
  meta.slug,
  {
    slug: meta.slug,
    title: toDisplayText(meta.title),
    summary: toDisplayText(meta.summary),
  },
]));
const relatedTopics = ministry
  ? topics.filter(
      (topic) =>
        topic.federfuehrendesRessort === ministry.slug ||
        (topic.mitzeichnungsressorts ?? []).includes(ministry.slug),
    )
  : [];
const legalReferences = Array.from(
  new Map(
    relatedTopics.flatMap((topic) =>
      topic.rechtsgrundlagen.map((entry) => [
        entry.normSlug ?? `${topic.slug}:${entry.label}`,
        {
          ...entry,
          topicTitle: topic.title,
          norm: entry.normSlug ? normLookup.get(entry.normSlug) : undefined,
        },
      ]),
    ),
  ).values(),
).slice(0, 10);
---

{ministry ? (
  <BaseLayout
    title={`${ministry.kurzname} | ${ministry.name}`}
    description={ministry.teaser}
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsrat', href: getGovernmentUrl() },
      { label: 'Geschäftsbereiche', href: getMinistriesUrl() },
      { label: ministry.kurzname },
    ]}
  >
    <Breadcrumbs
      items={[
        { label: 'Startseite', href: getHomeUrl() },
        { label: 'Staatsrat', href: getGovernmentUrl() },
        { label: 'Geschäftsbereiche', href: getMinistriesUrl() },
        { label: ministry.kurzname },
      ]}
    />

    <SectionHero
      eyebrow="Staatssekretariat"
      title={ministry.name}
      titleSize="long"
      lead={ministry.teaser}
      variant="government"
      facts={[
        { label: 'Leitung', value: ministry.leitung },
        { label: 'Aufgabenbereiche', value: String(ministry.aufgaben.length) },
        { label: 'Zugeordnete Themen', value: String(relatedTopics.length) },
      ]}
      actions={[{ label: 'Kontakt zum Staatssekretariat', href: '#kontakt', primary: true }]}
      image={{
        src: ministry.bild,
        alt: ministry.bildAlt ?? `Ansichtsbild für das ${ministry.name}`,
        credit: ministry.bildnachweis,
        width: 1280,
        height: 720,
        widths: [480, 720, 960],
        kind: 'landscape',
      }}
    />
    <GovernmentNavigation />

    <div class="content-grid" data-visual-section="ministry-profile-contact">
      <section class="section">
        <div class="section-header">
          <h2>Ressortprofil</h2>
        </div>
        <div class="body-copy">
          <p>{ministry.teaser}</p>
        </div>

        <div class="section-header">
          <h2>Aufgaben</h2>
        </div>
        <ul class="record-list">
          {ministry.aufgaben.map((task) => (
            <li class="record-list__item">
              <span>{task}</span>
            </li>
          ))}
        </ul>

        <div class="section-header">
          <h2>Thematische Schwerpunkte</h2>
        </div>
        <div class="tag-list">
          {ministry.themen.map((topic) => (
            <span class="tag">{topic}</span>
          ))}
        </div>
      </section>

      <aside id="kontakt" class="section meta-panel">
        <div class="section-header section-header--compact">
          <h2>Kontakt</h2>
        </div>
        <dl class="meta-list">
          <div>
            <dt>Leitung</dt>
            <dd>{ministry.leitung}</dd>
          </div>
          {ministry.kontakt.name ? (
            <div>
              <dt>Ansprechstelle</dt>
              <dd>{ministry.kontakt.name}</dd>
            </div>
          ) : null}
          {ministry.kontakt.referat ? (
            <div>
              <dt>Referat</dt>
              <dd>{ministry.kontakt.referat}</dd>
            </div>
          ) : null}
          {ministry.kontakt.email ? (
            <div>
              <dt>E-Mail</dt>
              <dd><a class="inline-link" href={`mailto:${ministry.kontakt.email}`}>{ministry.kontakt.email}</a></dd>
            </div>
          ) : null}
          {ministry.kontakt.telefon ? (
            <div>
              <dt>Telefon</dt>
              <dd><a class="inline-link" href={`tel:${ministry.kontakt.telefon.replace(/\s+/gu, '')}`}>{ministry.kontakt.telefon}</a></dd>
            </div>
          ) : null}
        </dl>
        <nav class="link-list">
          {ministry.verknuepfteLinks.map((link) => (
            <a href={resolvePortalPath(link.href)}>{link.label}</a>
          ))}
          <a href={getMinistriesUrl()}>Alle Staatssekretariate</a>
        </nav>
      </aside>
    </div>

    {relatedTopics.length > 0 ? (
      <section class="section section-muted" data-visual-section="ministry-topics">
        <div class="section-header">
          <h2>Zugeordnete Themen & Projekte</h2>
          <p>
            Diese Themenseiten werden federführend oder mitzeichnend von diesem Ressort begleitet.
          </p>
        </div>
        <div class="card-grid card-grid--two">
          {relatedTopics.map((topic) => (
            <TopicCard topic={topic} ministryName={ministry.kurzname} />
          ))}
        </div>
      </section>
    ) : null}

    {legalReferences.length > 0 ? (
      <section class="section">
        <div class="section-header">
          <h2>Rechtsgrundlagen aus den zugeordneten Themen</h2>
          <p>Hier finden Sie die Rechtsgrundlagen der zugeordneten Themen.</p>
        </div>
        <ul class="record-list">
          {legalReferences.map((entry) => (
            <li class="record-list__item">
              {entry.norm ? (
                <strong><a class="inline-link" href={getNormUrl(entry.norm.slug)}>{entry.label}</a></strong>
              ) : (
                <strong>{entry.label}</strong>
              )}
              <span>Themenbezug: {entry.topicTitle}</span>
              {entry.note ? <span>{entry.note}</span> : null}
            </li>
          ))}
        </ul>
      </section>
    ) : null}
  </BaseLayout>
) : (
  <BaseLayout
    title="Ressort nicht gefunden"
    description="Die angeforderte Ressortseite konnte nicht geladen werden."
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsrat', href: getGovernmentUrl() },
      { label: 'Kabinett', href: getMinistriesUrl() },
      { label: 'Nicht gefunden' },
    ]}
  >
    <Breadcrumbs
      items={[
        { label: 'Startseite', href: getHomeUrl() },
        { label: 'Staatsrat', href: getGovernmentUrl() },
        { label: 'Kabinett', href: getMinistriesUrl() },
        { label: 'Nicht gefunden' },
      ]}
    />

    <section class="section">
      <div class="status-notice status-notice--warning">
        <h1>Ressortseite nicht gefunden</h1>
        <p>Der angeforderte Inhalt konnte nicht gefunden werden. Bitte nutzen Sie die Kabinettsübersicht.</p>
      </div>
    </section>
  </BaseLayout>
)}
