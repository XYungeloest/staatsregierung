---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GovernmentMemberCard from '../../../components/portal/GovernmentMemberCard.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import MinistryDirectory from '../../../components/portal/MinistryDirectory.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import TopicCard from '../../../components/portal/TopicCard.astro';
import { siteConfig } from '../../../config/site.ts';
import {
  getGovernmentMembersUrl,
  getGovernmentUrl,
  getHomeUrl,
  getPreviousCabinetsUrl,
} from '../../../lib/portal/index.ts';
import {
  loadGovernmentMembers,
  loadMinistries,
  loadTopics,
} from '../../../lib/portal/content.ts';

const [members, ministries, topics] = await Promise.all([
  loadGovernmentMembers(),
  loadMinistries(),
  loadTopics(),
]);
const currentGovernment = siteConfig.currentGovernment;
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const topicHighlights = [
  'wohnen-und-vergesellschaftung',
  'gute-arbeit',
  'oepnv-und-mobilitaet',
  'kultur-erinnerung-und-medien',
].flatMap((slug) => {
  const topic = topics.find((entry) => entry.slug === slug);
  return topic ? [topic] : [];
});
---

<BaseLayout title="Kabinett Honecker II" description="Kabinettsübersicht der aktuellen Staatsregierung.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsregierung', href: getGovernmentUrl() },
      { label: 'Kabinett Honecker II' },
    ]}
  />

  <SectionHero
    eyebrow="Kabinett"
    title={currentGovernment.cabinetName}
    lead={`Seit dem ${siteConfig.date.formatLong(currentGovernment.formedOn)} führt das Kabinett die Staatsregierung und die Arbeit der Ministerien.`}
    variant="government"
    facts={[
      { label: 'Gebildet', value: siteConfig.date.formatLong(currentGovernment.formedOn) },
      { label: 'Koalition', value: currentGovernment.coalitionShort },
      { label: 'Leitung', value: currentGovernment.headOfGovernment },
      { label: 'Regierungssitz', value: currentGovernment.seatOfGovernment },
      { label: 'Ministerien', value: String(ministries.length) },
    ]}
    actions={[{ label: 'Ministeriumsverzeichnis', href: '#ministerien', primary: true }]}
  />
  <GovernmentNavigation />

  <div class="content-grid">
    <section class="section">
      <div class="section-header">
        <h2>Politische Einordnung</h2>
      </div>
      <div class="body-copy">
        <p>
          Das Kabinett Honecker II löste das {currentGovernment.predecessor} ab. Es verbindet die
          Sicherung der ersten Aufbauphase mit neuen Schwerpunkten bei Wohnen, guter Arbeit,
          öffentlicher Wirtschaft, sozialer Sicherheit, Energie und regionaler Entwicklung.
        </p>
        <p>
          Leitung, Ressorts und politische Vorhaben werden gemeinsam dargestellt. So werden
          Zuständigkeiten und politische Verantwortung unmittelbar nachvollziehbar.
        </p>
        <p>
          Der Organisationserlass 05/2026 vom <time datetime="2026-05-04">4. Mai 2026</time> benennt mehrere Staatsministerien neu
          und löst das bisherige Kultur-, Wissenschafts- und Tourismusressort auf. Wissenschaft
          liegt nun bei Volksbildung und Wissenschaft; Kultur und Tourismus liegen bei
          Rechtsstaatlichkeit und kultureller Emanzipation.
        </p>
      </div>
    </section>

    <aside class="section meta-panel">
      <div class="section-header section-header--compact">
        <h2>Kabinettsdaten</h2>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Gebildet</dt>
          <dd><time datetime={currentGovernment.formedOn}>{siteConfig.date.formatLong(currentGovernment.formedOn)}</time></dd>
        </div>
        <div>
          <dt>Vorgänger</dt>
          <dd>{currentGovernment.predecessor}</dd>
        </div>
        <div>
          <dt>Mitgliederprofile</dt>
          <dd>{members.length}</dd>
        </div>
      </dl>
      <p><a class="inline-link" href={getPreviousCabinetsUrl()}>Frühere Kabinette</a></p>
    </aside>
  </div>

  <section id="ministerien" class="section section-muted" data-visual-section="cabinet-ministry-directory">
    <div class="section-header">
      <h2>Ministeriumsverzeichnis</h2>
      <p>Alle Ressortangaben werden aus den zentral gepflegten Ministeriumsdaten übernommen.</p>
    </div>
    <MinistryDirectory ministries={ministries} />
  </section>

  <section class="section" data-visual-section="cabinet-members">
    <div class="section-header">
      <h2>Mitglieder der Staatsregierung</h2>
      <p>Die Profile bilden die aktuelle personelle Zusammensetzung des Kabinetts ab.</p>
    </div>
    <div class="card-grid card-grid--two">
      {members.map((member) => <GovernmentMemberCard member={member} variant="compact" />)}
    </div>
    <p class="detail-line">
      <a class="inline-link" href={getGovernmentMembersUrl()}>Alle Regierungsmitglieder mit Profilen</a>
    </p>
  </section>


  <section class="section">
    <div class="section-header">
      <h2>Regierungsprojekte im Kabinettszuschnitt</h2>
      <p>
        Themen und Projekte sind nicht losgelöst, sondern klar an federführende Ressorts und
        Kabinettsstrukturen angebunden.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {topicHighlights.map((topic) => (
        <TopicCard
          topic={topic}
          ministryName={ministryLookup.get(topic.federfuehrendesRessort)?.kurzname}
        />
      ))}
    </div>
  </section>
</BaseLayout>
