---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import { siteConfig } from '../../../config/site.ts';
import {
  getCabinetUrl,
  getGovernmentUrl,
  getHomeUrl,
  getPreviousCabinetsUrl,
} from '../../../lib/portal/index.ts';

import archive from '../../../../content/regierung/archiv/kabinett-honecker-i.json';
---

<BaseLayout
  title="Frühere Kabinette"
  description="Archiv früherer Staatsregierungen des Ostdeutschen Freistaates."
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsregierung', href: getGovernmentUrl() },
      { label: 'Frühere Kabinette' },
    ]}
  />

  <SectionHero
    eyebrow="Regierungsarchiv"
    title="Frühere Kabinette"
    lead="Abgeschlossene Staatsregierungen mit Amtszeit, Zusammensetzung und politischen Schwerpunkten."
    variant="government"
    facts={[
      { label: 'Aktuelles Kabinett', value: siteConfig.currentGovernment.cabinetName, href: getCabinetUrl() },
      { label: 'Archivierter Bestand', value: archive.cabinetName },
      { label: 'Amtszeit', value: `${siteConfig.date.formatLong(archive.formedOn)} bis ${siteConfig.date.formatLong(archive.endedOn)}` },
    ]}
    actions={[{ label: archive.cabinetName, href: `${getPreviousCabinetsUrl()}honecker-i/`, primary: true }]}
  />
  <GovernmentNavigation />

  <section class="section section-muted">
    <div class="section-header">
      <h2>Archivierte Staatsregierungen</h2>
      <p>
        Historische Kabinettsseiten zeigen frühere Koalitionen, Mitglieder, Ressorts und
        Programmstände ohne sie mit der aktuellen Regierungsarbeit zu vermischen.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      <article class="panel">
        <h3>{archive.cabinetName}</h3>
        <p>{archive.summary}</p>
        <p class="detail-line">
          <time datetime={archive.formedOn}>{siteConfig.date.formatLong(archive.formedOn)}</time> bis <time datetime={archive.endedOn}>{siteConfig.date.formatLong(archive.endedOn)}</time>
        </p>
        <p><a class="inline-link" href={`${getPreviousCabinetsUrl()}honecker-i/`}>Zum Archivstand</a></p>
      </article>
    </div>
  </section>
</BaseLayout>
