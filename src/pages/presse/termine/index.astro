---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import EventCard from '../../../components/portal/EventCard.astro';
import { splitEventsByDate } from '../../../lib/portal/dates.ts';
import { loadEvents } from '../../../lib/portal/content.ts';
import { getEventIndexUrl, getHomeUrl, getPressUrl } from '../../../lib/portal/index.ts';

const { upcoming, past } = splitEventsByDate(await loadEvents());
---

<BaseLayout
  title="Termine"
  description="Zukünftige öffentliche Termine und das Terminarchiv der fiktiven Staatsregierung des Ostdeutschen Freistaates."
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Presse & Aktuelles', href: getPressUrl() }, { label: 'Termine' }]} />

  <section class="section page-header">
    <p class="eyebrow">Presse &amp; Aktuelles</p>
    <h1>Termine</h1>
    <p class="lead">Öffentliche Termine, Pressekonferenzen und Veranstaltungen der Staatsregierung.</p>
    <nav class="hero-actions" aria-label="Terminangebote">
      <a class="button-link button-link--secondary" href={`${getEventIndexUrl()}kalender.ics`}>Kalender abonnieren</a>
    </nav>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Anstehende Termine</h2>
      <p>Ort, Datum und Kurzbeschreibung finden Sie auf der jeweiligen Detailseite.</p>
    </div>
    {upcoming.length > 0 ? (
      <div class="content-stack">{upcoming.map((event) => <EventCard event={event} />)}</div>
    ) : (
      <p class="search-feedback">Derzeit sind keine zukünftigen öffentlichen Termine hinterlegt.</p>
    )}
  </section>

  {past.length > 0 ? (
    <section class="section section-muted">
      <div class="section-header">
        <h2>Vergangene Termine</h2>
        <p>Diese Veranstaltungen sind abgeschlossen und bleiben zur Dokumentation erreichbar.</p>
      </div>
      <div class="content-stack">{past.map((event) => <EventCard event={event} />)}</div>
    </section>
  ) : null}
</BaseLayout>
