---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import EventCard from '../../components/portal/EventCard.astro';
import PressReleaseCard from '../../components/portal/PressReleaseCard.astro';
import SpeechCard from '../../components/portal/SpeechCard.astro';
import { siteConfig } from '../../config/site.ts';
import { splitEventsByDate } from '../../lib/portal/dates.ts';
import { loadEvents, loadPressReleases, loadSpeeches } from '../../lib/portal/content.ts';
import {
  getContactUrl,
  getEventIndexUrl,
  getHomeUrl,
  getPressReleaseIndexUrl,
  getPressReleaseUrl,
  getSpeechIndexUrl,
  getEventUrl,
} from '../../lib/portal/index.ts';

const [releases, events, speeches] = await Promise.all([
  loadPressReleases(),
  loadEvents(),
  loadSpeeches(),
]);
const leadRelease = releases[0];
const latestSpeech = speeches[0];
const { upcoming: nextEvents } = splitEventsByDate(events);
const calendarUrl = `${getEventIndexUrl()}kalender.ics`;
const rssUrl = `${getPressReleaseIndexUrl().replace(/pressemitteilungen\/$/u, '')}rss.xml`;
---

<BaseLayout
  title="Presse & Aktuelles"
  description="Pressemitteilungen, Reden, Termine und Pressekontakt der Staatsregierung des Ostdeutschen Freistaates."
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Presse & Aktuelles' }]} />

  <section class="section page-header">
    <p class="eyebrow">Presse &amp; Aktuelles</p>
    <h1>Presse &amp; Aktuelles</h1>
    <p class="lead">Aktuelle Mitteilungen, Reden, Termine und Pressekontakt der Staatsregierung.</p>
  </section>

  <section class="section" aria-labelledby="presse-ueberblick">
    <div class="section-header">
      <h2 id="presse-ueberblick">Auf einen Blick</h2>
    </div>
    <div class="card-grid card-grid--four press-overview-grid">
      <article class="panel">
        <h3>Neueste Pressemitteilung</h3>
        {leadRelease ? (
          <>
            <p><a class="inline-link" href={getPressReleaseUrl(leadRelease.slug)}>{leadRelease.title}</a></p>
            <p class="detail-line">{siteConfig.date.formatLong(leadRelease.date)}</p>
          </>
        ) : <p>Derzeit liegt keine Pressemitteilung vor.</p>}
      </article>
      <article class="panel">
        <h3>Nächster Termin</h3>
        {nextEvents[0] ? (
          <>
            <p><a class="inline-link" href={getEventUrl(nextEvents[0].slug)}>{nextEvents[0].title}</a></p>
            <p class="detail-line">{siteConfig.date.formatLong(nextEvents[0].date)} · {nextEvents[0].location}</p>
          </>
        ) : <p>Derzeit sind keine zukünftigen öffentlichen Termine angekündigt.</p>}
      </article>
      <article class="panel">
        <h3>Pressekontakt</h3>
        <p>{siteConfig.contact.pressOffice.label}</p>
        <p class="detail-line"><a class="inline-link" href={`mailto:${siteConfig.contact.pressOffice.email}`}>{siteConfig.contact.pressOffice.email}</a><br /><a class="inline-link" href={`tel:${siteConfig.contact.pressOffice.phone.replace(/\s+/gu, '')}`}>{siteConfig.contact.pressOffice.phone}</a></p>
      </article>
      <article class="panel">
        <h3>RSS &amp; Kalender</h3>
        <p>Abonnieren Sie Mitteilungen per RSS oder zukünftige Termine als Kalender.</p>
        <p><a class="inline-link" href={rssUrl}>RSS öffnen</a></p>
        <p><a class="inline-link" href={calendarUrl}>Kalender abonnieren</a></p>
      </article>
    </div>
  </section>

  {leadRelease ? (
    <section class="section section-muted">
      <div class="section-header">
        <h2>Neueste Mitteilung</h2>
        <p>Die zuletzt veröffentlichte Mitteilung der Staatsregierung.</p>
      </div>
      <PressReleaseCard release={leadRelease} variant="featured" />
    </section>
  ) : null}

  <section class="section">
    <div class="section-header">
      <h2>Bereiche für Medien und Öffentlichkeit</h2>
      <p>Alle Inhalte bleiben dauerhaft nach Veröffentlichungsart und Datum erreichbar.</p>
    </div>
    <div class="card-grid card-grid--three">
      <article class="panel">
        <h3>Pressemitteilungen</h3>
        <p>Mit Datum, Ressort, Kurztext und eigener Detailseite.</p>
        <p><a class="inline-link" href={getPressReleaseIndexUrl()}>Zu den Pressemitteilungen</a></p>
      </article>
      <article class="panel">
        <h3>Reden &amp; Erklärungen</h3>
        <p>Redetexte und Erklärungen der Staatsregierung.</p>
        <p><a class="inline-link" href={getSpeechIndexUrl()}>Zu den Reden</a></p>
      </article>
      <article class="panel">
        <h3>Termine &amp; Archiv</h3>
        <p>Zukünftige Termine und klar gekennzeichnete vergangene Veranstaltungen.</p>
        <p><a class="inline-link" href={getEventIndexUrl()}>Zur Terminübersicht</a></p>
      </article>
      <article class="panel">
        <h3>Kontakt für Medien</h3>
        <p>Für Fragen zur Pressearbeit steht die Pressestelle zur Verfügung.</p>
        <p><a class="inline-link" href={getContactUrl()}>Zu den Kontaktwegen</a></p>
      </article>
    </div>
  </section>

  <section class="section section-muted">
    <div class="content-grid">
      <section class="section">
        <div class="section-header"><h2>Neueste Rede</h2></div>
        {latestSpeech ? <SpeechCard speech={latestSpeech} /> : <p class="search-feedback">Noch keine Reden im Bestand.</p>}
      </section>
      <aside class="section meta-panel">
        <div class="section-header section-header--compact"><h2>Nächste Termine</h2></div>
        {nextEvents.length > 0 ? (
          <div class="content-stack">
            {nextEvents.slice(0, 3).map((event) => <EventCard event={event} variant="compact" />)}
          </div>
        ) : <p class="search-feedback">Derzeit sind keine zukünftigen Termine angekündigt.</p>}
      </aside>
    </div>
  </section>
</BaseLayout>
