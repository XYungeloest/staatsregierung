---
import {
  getContactUrl,
  getLawHomeUrl,
  getMinistriesUrl,
  getPressUrl,
  getSiteUrl,
} from '../../lib/portal/index.ts';
import { siteConfig } from '../../config/site.ts';
import PortalIcon from './PortalIcon.astro';

const authorityNumber = siteConfig.contact.authorityNumber;
const authorityNumberHref = authorityNumber.directPhoneLink
  ? `tel:${authorityNumber.number.replace(/\s+/gu, '')}`
  : getSiteUrl(authorityNumber.pathKey);

const services = [
  {
    title: `${authorityNumber.label} ${authorityNumber.number}`,
    text: 'Informationen und Kontaktwege',
    href: authorityNumberHref,
    icon: 'phone' as const,
  },
  {
    title: 'Kontakt',
    text: 'Telefon, E-Mail und Kontaktformular',
    href: getContactUrl(),
    icon: 'contact' as const,
  },
  {
    title: 'Ressort finden',
    text: 'Staatssekretariate und Zuständigkeiten',
    href: getMinistriesUrl(),
    icon: 'ministry' as const,
  },
  {
    title: 'Rechtsportal',
    text: 'Gesetze und Vorschriften durchsuchen',
    href: getLawHomeUrl(),
    icon: 'law' as const,
  },
  {
    title: 'RSS & Kalender',
    text: 'Mitteilungen und Termine verfolgen',
    href: getPressUrl(),
    icon: 'rss' as const,
  },
];
---

<aside class="service-band" aria-label="Schnelleinstiege zu Kontakt und Service" data-visual-section="global-service-band">
  <div class="container service-band__grid">
    {services.map((service) => (
      <a class="service-band__item" href={service.href}>
        <span class="service-band__icon"><PortalIcon name={service.icon} /></span>
        <span>
          <strong>{service.title}</strong>
          <small>{service.text}</small>
        </span>
      </a>
    ))}
  </div>
</aside>
