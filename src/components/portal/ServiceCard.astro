---
import PortalIcon from './PortalIcon.astro';

interface Props {
  title: string;
  body: string;
  href?: string;
  links?: Array<{ href: string; label: string }>;
  icon?: 'contact' | 'phone' | 'ministry' | 'government' | 'press' | 'topics' | 'easy-language' | 'sign-language' | 'accessibility' | 'law';
  emphasis?: boolean;
}

const { title, body, href, links = [], icon, emphasis = false } = Astro.props as Props;
---

<article class:list={['service-card', emphasis && 'service-card--emphasis']}>
  {icon ? <div class="service-card__icon" aria-hidden="true"><PortalIcon name={icon} /></div> : null}
  <div class="service-card__body">
  <h3>{href ? <a href={href}>{title}</a> : title}</h3>
  <p>{body}</p>
  {links.length > 0 ? (
    <p class="section-link-row">
      {links.map((link, index) => (
        <Fragment>
          {index > 0 ? <span aria-hidden="true"> · </span> : null}
          <a class="inline-link" href={link.href}>{link.label}</a>
        </Fragment>
      ))}
    </p>
  ) : null}
  </div>
</article>
