---
import {
  schoolSystemChart,
  schoolSystemGrades,
  type SchoolSystemChartBlock,
  type SchoolSystemChartTextLine,
} from '../../data/school-system.ts';
import SchoolSystemLegend from './SchoolSystemLegend.astro';

const chart = schoolSystemChart;

function gradeY(grade: number): number {
  return chart.gridY + (14 - grade) * chart.gradeHeight;
}

function labelText(block: SchoolSystemChartBlock): string {
  return block.lines?.map((line) => line.text).join(' ') ?? '';
}

function lineClass(line: SchoolSystemChartTextLine): string {
  return `school-system-chart-text__line school-system-chart-text__line--${line.kind ?? 'small'}`;
}

function textX(block: SchoolSystemChartBlock): number {
  if (block.textX) {
    return block.textX;
  }

  return block.anchor === 'start' ? block.x + 8 : block.x + block.width / 2;
}

function textY(block: SchoolSystemChartBlock): number {
  if (block.textY) {
    return block.textY;
  }

  const lines = block.lines ?? [];
  const lineHeight = block.lineHeight ?? 18;
  return block.y + block.height / 2 - ((lines.length - 1) * lineHeight) / 2 + 6;
}

function textTransform(block: SchoolSystemChartBlock): string | undefined {
  if (!block.rotate) {
    return undefined;
  }

  return `rotate(${block.rotate} ${block.x + block.width / 2} ${block.y + block.height / 2})`;
}

function hasText(block: SchoolSystemChartBlock): boolean {
  return Boolean(block.lines?.length);
}
---

<figure
  class="school-system-figure"
  aria-labelledby="school-system-chart-title"
  aria-describedby="school-system-chart-description"
>
  <div class="section-header section-header--compact">
    <h2 id="school-system-chart-title">Grafik zum Schulsystem</h2>
    <p>Die Übersicht zeigt Schularten, Abschlüsse und Anschlusswege in vereinfachter Form.</p>
  </div>

  <SchoolSystemLegend />

  <p id="school-system-chart-description" class="school-system-chart__summary">
    Die Grafik zeigt die Bildungswege von der Primarstufe über Sekundarstufe I und II bis zu
    beruflicher Bildung, Hochschulzugang und Weiterbildung.
  </p>

  <p class="school-system-chart__scroll-hint">
    Auf kleinen Bildschirmen kann die Grafik seitlich verschoben werden. Die tabellarische Alternative folgt direkt darunter.
  </p>

  <div class="school-system-chart__scroll" tabindex="0" aria-label="Horizontal verschiebbare Schulsystem-Grafik">
    <svg
      class="school-system-svg"
      viewBox={`0 0 ${chart.width} ${chart.height}`}
      aria-labelledby="school-system-chart-title"
      aria-describedby="school-system-chart-description"
    >
      <defs>
        <linearGradient id="school-system-grey-gradient" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#c8cfcc" />
          <stop offset="50%" stop-color="#e4e7e5" />
          <stop offset="100%" stop-color="#c8cfcc" />
        </linearGradient>
        <linearGradient id="school-system-primary-gradient" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#3cae18" />
          <stop offset="52%" stop-color="#43b51d" />
          <stop offset="100%" stop-color="#3cad18" />
        </linearGradient>
        <linearGradient id="school-system-secondary-gradient" x1="0" x2="1" y1="0" y2="1">
          <stop offset="0%" stop-color="#cbe9bc" />
          <stop offset="50%" stop-color="#acd78b" />
          <stop offset="100%" stop-color="#cfeac4" />
        </linearGradient>
        <linearGradient id="school-system-vocational-gradient" x1="0" x2="1" y1="0" y2="0">
          <stop offset="0%" stop-color="#ee8400" />
          <stop offset="48%" stop-color="#f08900" />
          <stop offset="100%" stop-color="#ed8200" />
        </linearGradient>
        <linearGradient id="school-system-study-gradient" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#f9aa48" />
          <stop offset="100%" stop-color="#f2942c" />
        </linearGradient>
        <linearGradient id="school-system-advanced-gradient" x1="0" x2="0" y1="0" y2="1">
          <stop offset="0%" stop-color="#ffd08d" />
          <stop offset="100%" stop-color="#f7a542" />
        </linearGradient>
      </defs>
      <rect class="school-system-svg__grid-base" x={chart.plotX} y={chart.topBandHeight} width={chart.plotWidth} height={chart.footerY - chart.topBandHeight} />
      <rect class="school-system-svg__top-band" x={chart.plotX} y="0" width={chart.plotWidth} height={chart.topBandHeight} />
      <rect class="school-system-svg__axis-cell" x="0" y="0" width={chart.axisWidth} height={chart.gridY - 4} />
      <text
        class="school-system-svg__axis-title"
        x={chart.axisWidth / 2}
        y={(chart.gridY - 4) / 2}
        text-anchor="middle"
        dominant-baseline="middle"
        transform={`rotate(-90 ${chart.axisWidth / 2} ${(chart.gridY - 4) / 2})`}
      >
        SCHULBESUCHSJAHRE
      </text>

      {schoolSystemGrades.map((grade) => (
        <g aria-hidden="true">
          <rect
            class="school-system-svg__axis-cell"
            x="0"
            y={gradeY(grade)}
            width={chart.axisWidth}
            height={chart.gradeHeight - 4}
          />
          <text
            class="school-system-svg__grade"
            x={chart.axisWidth / 2}
            y={gradeY(grade) + chart.gradeHeight / 2 - 1}
            text-anchor="middle"
            dominant-baseline="middle"
          >
            {grade}
          </text>
        </g>
      ))}

      {chart.zones.map((zone) => (
        <rect
          class:list={['school-system-svg__zone', `school-system-fill--${zone.category}`]}
          x={zone.x}
          y={zone.y}
          width={zone.width}
          height={zone.height}
        />
      ))}

      {chart.connectors.map((connector) => (
        <rect
          class:list={['school-system-svg__connector', `school-system-fill--${connector.category}`]}
          x={connector.x}
          y={connector.y}
          width={connector.width}
          height={connector.height}
        />
      ))}

      {chart.blocks.map((block) => (
        block.noBox ? null : (
            <rect
              class:list={[
                'school-system-svg__block',
                `school-system-fill--${block.category}`,
              ]}
              x={block.x}
              y={block.y}
              width={block.width}
              height={block.height}
            />
        )
      ))}

      {chart.guides.map((guide) => (
        <line
          class="school-system-svg__guide"
          x1={guide.x1}
          y1={guide.y1}
          x2={guide.x2}
          y2={guide.y2}
        />
      ))}

      {chart.blocks.map((block) => (
        hasText(block) ? (
          <g transform={textTransform(block)} aria-label={labelText(block)}>
            <text
              class="school-system-chart-text"
              text-anchor={block.anchor ?? 'middle'}
              dominant-baseline="alphabetic"
            >
              {block.lines?.map((line, index) => (
                <tspan
                  class={lineClass(line)}
                  x={textX(block)}
                  y={textY(block) + index * (block.lineHeight ?? 18)}
                >
                  {line.text}
                </tspan>
              ))}
            </text>
          </g>
        ) : null
      ))}

      <rect class="school-system-svg__footer" x={chart.plotX} y={chart.footerY} width={chart.plotWidth} height={chart.footerHeight} />
      <rect class="school-system-svg__axis-cell" x="0" y={chart.footerY} width={chart.axisWidth} height={chart.footerHeight} />
      <text
        class="school-system-svg__footer-text"
        x={chart.plotX + chart.plotWidth / 2}
        y={chart.footerY + chart.footerHeight / 2}
        text-anchor="middle"
        dominant-baseline="middle"
      >
        Frühkindliche Bildung, Erziehung und Betreuung
      </text>
    </svg>
  </div>
</figure>
