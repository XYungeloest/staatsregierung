---
import {
  formatEuroCompact,
  formatPercent,
  type BudgetExplorerEntry,
  type BudgetSummaryRow,
} from '../../lib/portal/modules.ts';

interface Props {
  entries: BudgetExplorerEntry[];
  summaryRows: BudgetSummaryRow[];
}

const { entries, summaryRows } = Astro.props as Props;
const years = ['2025', '2026'] as const;
const summaryByYear = new Map(summaryRows.map((row) => [row.year, row]));

function getScale(entriesForYear: BudgetExplorerEntry[], total: number): number {
  const maximumShare = Math.max(...entriesForYear.map((entry) => entry.amount / total));
  return Math.max(10, Math.ceil(maximumShare * 100 / 10) * 10);
}
---

<section class="budget-view" aria-labelledby="verteilung-einzelplaene">
  <div class="section-header section-header--compact">
    <h3 id="verteilung-einzelplaene">Verteilung nach Einzelplänen</h3>
    <p>Die Balken zeigen den Anteil am Gesamtvolumen. Sie bewerten nicht, ob ein Bereich ausreichend finanziert ist.</p>
  </div>
  <p class="detail-line">Eine vollständige Tabelle steht in der Ansicht <a class="inline-link" href="#haushaltsdaten">Datentabelle</a> bereit.</p>

  {years.map((year) => {
    const summary = summaryByYear.get(year);
    const entriesForYear = entries
      .filter((entry) => entry.year === year)
      .sort((left, right) => right.amount - left.amount);
    const scale = summary ? getScale(entriesForYear, summary.totalExpense) : 10;
    const ticks = [0, scale / 2, scale];

    return summary ? (
      <div class="budget-chart" data-budget-year-panel data-year={year} hidden={year !== '2025'}>
        <p class="budget-chart__summary">
          {year}: {entriesForYear.length} Einzelpläne, bezogen auf {formatEuroCompact(summary.totalExpense)} Gesamtausgaben.
        </p>
        <div class="budget-chart__axis" aria-hidden="true">
          {ticks.map((tick) => <span>{formatPercent(tick / 100, 0)}</span>)}
        </div>
        <ol class="budget-chart__items">
          {entriesForYear.map((entry) => {
            const share = entry.amount / summary.totalExpense;
            const width = Math.min(100, (share * 100 / scale) * 100);

            return (
              <li
                class="budget-chart__item"
                data-budget-entry
                data-year={entry.year}
                data-state={entry.state}
                data-category={entry.category}
                data-label={`${entry.plan} ${entry.label}`.toLocaleLowerCase('de-DE')}
              >
                <div class="budget-chart__label">
                  <span><strong>Einzelplan {entry.plan}</strong> · {entry.label}</span>
                  <span>{formatEuroCompact(entry.amount)} · {formatPercent(share)}</span>
                </div>
                <div class="budget-chart__plot" aria-hidden="true">
                  <span class="budget-chart__bar" style={`width: ${width.toFixed(2)}%`}></span>
                </div>
              </li>
            );
          })}
        </ol>
      </div>
    ) : null;
  })}
</section>
