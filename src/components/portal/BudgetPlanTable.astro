---
import {
  budgetTotals,
  getBudgetChange,
  getBudgetShare,
  type BudgetPlan,
  type BudgetYear,
} from '../../data/haushalt.ts';
import { formatEuroAmount, formatPercent } from '../../lib/portal/modules.ts';
import { getBudgetPlanUrl } from '../../lib/portal/routes.ts';

interface Props {
  plans: BudgetPlan[];
  mode: BudgetYear | 'vergleich';
}

const { plans, mode } = Astro.props as Props;
const categories = [...new Set(plans.map((plan) => plan.category))].sort((left, right) => left.localeCompare(right, 'de'));
const isComparison = mode === 'vergleich';
const title = isComparison ? 'Vergleich der Einzelpläne 2025/2026' : `Einzelpläne ${mode}`;
---

<section class="budget-plan-table" data-budget-plan-table aria-labelledby={`einzelplan-tabelle-${mode}`}>
  <div class="budget-plan-table__tools">
    <div>
      <h3 id={`einzelplan-tabelle-${mode}`}>{title}</h3>
      <p>Filter und Sortierung ändern nur die Darstellung, nicht die zugrunde liegenden Haushaltsdaten.</p>
    </div>
    <div class="budget-plan-table__filters" aria-label="Einzelpläne filtern und sortieren">
      <label class="search-field"><span>Bereich</span><select data-budget-plan-filter="category"><option value="">Alle Bereiche</option>{categories.map((category) => <option value={category}>{category}</option>)}</select></label>
      <label class="search-field"><span>Sortierung</span><select data-budget-plan-filter="sort"><option value="number">Einzelplan-Nummer</option><option value="expenses">Ausgabenhöhe</option>{isComparison ? <option value="change">Veränderung 2025/2026</option> : null}<option value="category">Kategorie</option></select></label>
      <label class="search-field"><span>Suche</span><input type="search" placeholder="Ressort oder Einzelplan" data-budget-plan-filter="query" /></label>
    </div>
  </div>
  <p class="search-feedback" data-budget-plan-status role="status" aria-live="polite"></p>
  <div class="table-wrap" tabindex="0" role="region" aria-label={title}>
    <table class="data-table budget-plan-data-table">
      <caption>{title}</caption>
      {isComparison ? (
        <thead><tr><th scope="col">Nr.</th><th scope="col">Einzelplan</th><th scope="col">Kategorie</th><th scope="col">Ausgaben 2025</th><th scope="col">Ausgaben 2026</th><th scope="col">Veränderung</th><th scope="col">Anteil 2026</th><th scope="col">Details</th></tr></thead>
      ) : (
        <thead><tr><th scope="col">Nr.</th><th scope="col">Einzelplan</th><th scope="col">Kategorie</th><th scope="col">Ausgaben</th><th scope="col">Anteil am Gesamthaushalt</th><th scope="col">Investitionsanteil</th><th scope="col">Personalanteil</th><th scope="col">Details</th></tr></thead>
      )}
      <tbody>
        {plans.map((plan) => {
          const compare = getBudgetChange(plan);
          const amount = isComparison ? plan.amounts['2026'].expenses : plan.amounts[mode].expenses;
          const currentYear = isComparison ? '2026' : mode;
          const share = getBudgetShare(amount, budgetTotals[currentYear].expenses);
          const search = `${plan.number} ${plan.title} ${plan.responsibility} ${plan.category}`.toLocaleLowerCase('de-DE');
          return (
            <tr
              data-budget-plan-row
              data-number={Number(plan.number)}
              data-category={plan.category}
              data-search={search}
              data-expenses={amount}
              data-change={compare.absolute}
            >
              <td>{plan.number}</td>
              <th scope="row"><a class="inline-link" href={getBudgetPlanUrl(plan.number)}>{plan.title}</a><span>{plan.responsibility}</span></th>
              <td>{plan.category}</td>
              {isComparison ? (
                <>
                  <td>{formatEuroAmount(plan.amounts['2025'].expenses)}</td>
                  <td>{formatEuroAmount(plan.amounts['2026'].expenses)}</td>
                  <td>{formatEuroAmount(compare.absolute)}<span>{compare.percent === null ? '–' : formatPercent(compare.percent)}</span></td>
                  <td>{share === null ? '–' : formatPercent(share)}</td>
                </>
              ) : (
                <>
                  <td>{formatEuroAmount(amount)}</td>
                  <td>{share === null ? '–' : formatPercent(share)}</td>
                  <td>{formatPercent(getBudgetShare(plan.amounts[mode].investments, amount) ?? 0)}</td>
                  <td>{formatPercent(getBudgetShare(plan.amounts[mode].personnel, amount) ?? 0)}</td>
                </>
              )}
              <td><a class="inline-link" href={getBudgetPlanUrl(plan.number)}>Öffnen</a></td>
            </tr>
          );
        })}
      </tbody>
    </table>
  </div>
  <p class="module-empty" data-budget-plan-empty hidden>Für diese Filterkombination sind keine Einzelpläne sichtbar.</p>
</section>
