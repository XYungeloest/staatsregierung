---
import BudgetDataTable from './BudgetDataTable.astro';
import BudgetDistributionChart from './BudgetDistributionChart.astro';
import BudgetInvestmentSection from './BudgetInvestmentSection.astro';
import BudgetRevenueExpenseOverview from './BudgetRevenueExpenseOverview.astro';
import BudgetSpecialFunds from './BudgetSpecialFunds.astro';
import BudgetYearComparison from './BudgetYearComparison.astro';
import {
  formatEuroCompact,
  formatPercent,
  type BudgetExplorerEntry,
  type BudgetSpecialFund,
  type BudgetSummaryRow,
} from '../../lib/portal/modules.ts';

interface Props {
  summaryRows: BudgetSummaryRow[];
  entries: BudgetExplorerEntry[];
  specialFunds: BudgetSpecialFund[];
}

const { summaryRows, entries, specialFunds } = Astro.props as Props;
const categories = [...new Set(entries.map((entry) => entry.category))].sort((left, right) => left.localeCompare(right, 'de'));
const years = ['2025', '2026'] as const;
---

<section class="budget-explorer" data-budget-root aria-labelledby="haushalt-explorer">
  <div class="section-header">
    <h2 id="haushalt-explorer">Haushalt-Explorer</h2>
    <p>Filtern Sie die Einzelpläne und wählen Sie eine Ansicht. Alle Diagramme werden durch verständliche Tabellen ergänzt.</p>
  </div>

  <fieldset class="budget-filters">
    <legend>Auswahl eingrenzen</legend>
    <div class="budget-filters__grid">
      <div class="budget-filter-group">
        <span id="budget-year-label" class="search-field__label">Haushaltsjahr</span>
        <div class="segmented-control" role="group" aria-labelledby="budget-year-label">
          {years.map((year) => (
            <button
              type="button"
              class:list={['segmented-control__button', year === '2025' && 'is-active']}
              data-budget-year={year}
              aria-pressed={year === '2025' ? 'true' : 'false'}
            >
              {year}
            </button>
          ))}
        </div>
      </div>
      <label class="search-field">
        <span>Haushaltsstand</span>
        <select data-budget-filter="state">
          <option value="Haushaltsgesetz">Haushaltsgesetz</option>
        </select>
      </label>
      <label class="search-field">
        <span>Kategorie</span>
        <select data-budget-filter="category">
          <option value="">Alle Kategorien</option>
          {categories.map((category) => <option value={category}>{category}</option>)}
        </select>
      </label>
      <label class="search-field">
        <span>Einzelplan oder Bereich</span>
        <input
          type="search"
          placeholder="z. B. Bildung, 04 oder Finanzverwaltung"
          data-budget-filter="query"
        />
      </label>
    </div>
  </fieldset>

  <p class="search-feedback" data-budget-status role="status" aria-live="polite">
    Die Übersicht zeigt die Einzelpläne des Haushaltsjahres 2025.
  </p>

  <div class="budget-view-tabs" role="tablist" aria-label="Ansichten des Haushalt-Explorers">
    <button type="button" role="tab" id="budget-tab-overview" aria-controls="budget-panel-overview" aria-selected="true" data-budget-view="overview">Übersicht</button>
    <button type="button" role="tab" id="budget-tab-distribution" aria-controls="budget-panel-distribution" aria-selected="false" tabindex="-1" data-budget-view="distribution">Ausgaben nach Einzelplänen</button>
    <button type="button" role="tab" id="budget-tab-comparison" aria-controls="budget-panel-comparison" aria-selected="false" tabindex="-1" data-budget-view="comparison">Veränderung zum Vorjahr</button>
    <button type="button" role="tab" id="budget-tab-revenue" aria-controls="budget-panel-revenue" aria-selected="false" tabindex="-1" data-budget-view="revenue">Einnahmen und Ausgaben</button>
    <button type="button" role="tab" id="budget-tab-investment" aria-controls="budget-panel-investment" aria-selected="false" tabindex="-1" data-budget-view="investment">Investitionen</button>
    <button type="button" role="tab" id="budget-tab-funds" aria-controls="budget-panel-funds" aria-selected="false" tabindex="-1" data-budget-view="funds">Sondervermögen und Fonds</button>
    <button type="button" role="tab" id="budget-tab-table" aria-controls="budget-panel-table" aria-selected="false" tabindex="-1" data-budget-view="table">Datentabelle</button>
  </div>

  <section id="budget-panel-overview" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-overview" data-budget-panel="overview">
    <div class="section-header section-header--compact">
      <h3>Gesamtüberblick</h3>
      <p>Die Kennzahlen ordnen das ausgewählte Haushaltsjahr ein. Größere Werte bedeuten ein höheres Volumen, nicht eine höhere Priorität oder Qualität.</p>
    </div>
    {summaryRows.map((summary) => (
      <div class="budget-overview" data-budget-year-panel data-year={summary.year} hidden={summary.year !== '2025'}>
        <article class="meta-card budget-overview__total">
          <span class="meta-label">Gesamtausgaben {summary.year}</span>
          <strong>{formatEuroCompact(summary.totalExpense)}</strong>
          <span class="detail-line">{summary.state}</span>
        </article>
        <div class="meta-grid meta-grid--compact">
          <article class="meta-card">
            <span class="meta-label">Steuereinnahmen</span>
            <strong>{formatEuroCompact(summary.taxRevenue)}</strong>
            <span class="detail-line">{formatPercent(summary.taxRevenue / summary.totalRevenue)} der Gesamteinnahmen</span>
          </article>
          <article class="meta-card">
            <span class="meta-label">Investitionen</span>
            <strong>{formatEuroCompact(summary.investments)}</strong>
            <span class="detail-line">{formatPercent(summary.investments / summary.totalExpense)} der Gesamtausgaben</span>
          </article>
          <article class="meta-card">
            <span class="meta-label">Zuweisungen und Zuschüsse</span>
            <strong>{formatEuroCompact(summary.transfers)}</strong>
            <span class="detail-line">{formatPercent(summary.transfers / summary.totalExpense)} der Gesamtausgaben</span>
          </article>
        </div>
      </div>
    ))}
  </section>

  <section id="budget-panel-distribution" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-distribution" data-budget-panel="distribution" hidden>
    <BudgetDistributionChart entries={entries} summaryRows={summaryRows} />
  </section>

  <section id="budget-panel-comparison" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-comparison" data-budget-panel="comparison" hidden>
    <BudgetYearComparison entries={entries} />
  </section>

  <section id="budget-panel-revenue" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-revenue" data-budget-panel="revenue" hidden>
    <BudgetRevenueExpenseOverview summaryRows={summaryRows} />
  </section>

  <section id="budget-panel-investment" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-investment" data-budget-panel="investment" hidden>
    <BudgetInvestmentSection entries={entries} summaryRows={summaryRows} />
  </section>

  <section id="budget-panel-funds" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-funds" data-budget-panel="funds" hidden>
    <BudgetSpecialFunds funds={specialFunds} />
  </section>

  <section id="budget-panel-table" class="budget-view-panel" role="tabpanel" aria-labelledby="budget-tab-table" data-budget-panel="table" hidden>
    <BudgetDataTable entries={entries} summaryRows={summaryRows} />
  </section>

  <p class="module-empty" data-budget-empty hidden>
    Für diese Auswahl sind keine Einzelpläne sichtbar. Passen Sie die Filter an.
  </p>
</section>
