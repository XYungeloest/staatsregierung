---
import SectionNavigation from './SectionNavigation.astro';
import {
  getIndexUrl,
  getLawPortalUrl,
  getPublicationsUrl,
  getReferencesUrl,
  getSearchUrl,
  getSubjectsUrl,
} from '../../lib/norms/index.ts';
---

<SectionNavigation
  label="Rechtsportal"
  variant="law"
  items={[
    { label: 'Überblick', href: getLawPortalUrl() },
    { label: 'Suche', href: getSearchUrl() },
    { label: 'Sachgebiete', href: getSubjectsUrl() },
    { label: 'A–Z', href: getIndexUrl() },
    { label: 'Verkündungen', href: getPublicationsUrl() },
    { label: 'Fundstellen', href: getReferencesUrl() },
  ]}
/>
