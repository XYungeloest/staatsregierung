---
import PortalIcon from './PortalIcon.astro';

type AccessIconName = 'law' | 'topics' | 'map' | 'budget' | 'government' | 'ministry' | 'press';

interface Props {
  title: string;
  description: string;
  href: string;
  icon: AccessIconName;
}

const { title, description, href, icon } = Astro.props as Props;
---

<a class="portal-access-card" href={href}>
  <span class="portal-access-card__icon"><PortalIcon name={icon} /></span>
  <span class="portal-access-card__title">{title}</span>
  <span class="portal-access-card__description">{description}</span>
  <span class="portal-access-card__arrow"><PortalIcon name="arrow" /></span>
</a>
