---
import { schoolSystemLegendItems } from '../../data/school-system.ts';

const groups = [...new Set(schoolSystemLegendItems.map((item) => item.group))];
---

<div class="school-system-legend" aria-label="Legende zur Schulsystem-Grafik">
  {groups.map((group) => (
    <section class="school-system-legend__group" aria-labelledby={`legend-${group.replace(/\s+/gu, '-').toLowerCase()}`}>
      <h3 id={`legend-${group.replace(/\s+/gu, '-').toLowerCase()}`}>{group}</h3>
      <ul>
        {schoolSystemLegendItems.filter((item) => item.group === group).map((item) => (
          <li>
            <span class:list={['school-system-legend__swatch', `school-system-fill--${item.id}`]} aria-hidden="true"></span>
            <span>{item.label}</span>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>
