---
import {
  formatEuroCompact,
  formatPercent,
  type BudgetExplorerEntry,
} from '../../lib/portal/modules.ts';

interface Props {
  entries: BudgetExplorerEntry[];
}

const { entries } = Astro.props as Props;
const entries2025 = new Map(entries.filter((entry) => entry.year === '2025').map((entry) => [entry.plan, entry]));
const entries2026 = new Map(entries.filter((entry) => entry.year === '2026').map((entry) => [entry.plan, entry]));
const comparisonRows = [...entries2026.values()]
  .map((entry2026) => {
    const entry2025 = entries2025.get(entry2026.plan);
    const change = entry2025 ? entry2026.amount - entry2025.amount : undefined;
    const changeRatio = entry2025 && entry2025.amount !== 0 ? change! / entry2025.amount : undefined;

    return { entry2025, entry2026, change, changeRatio };
  })
  .sort((left, right) => right.entry2026.amount - left.entry2026.amount);
---

<section class="budget-view" aria-labelledby="jahresvergleich">
  <div class="section-header section-header--compact">
    <h3 id="jahresvergleich">Jahresvergleich 2025 und 2026</h3>
    <p>Die Tabelle zeigt Haushaltswerte beider Jahre sowie die rechnerische Veränderung. Sie ist keine Bewertung einzelner Einzelpläne.</p>
  </div>
  <div class="table-wrap" tabindex="0" role="region" aria-label="Vergleich der Einzelpläne 2025 und 2026">
    <table class="data-table budget-comparison-table">
      <caption>Ausgaben nach Einzelplan im Jahresvergleich</caption>
      <thead>
        <tr>
          <th scope="col">Einzelplan</th>
          <th scope="col">Kategorie</th>
          <th scope="col">2025</th>
          <th scope="col">2026</th>
          <th scope="col">Veränderung</th>
        </tr>
      </thead>
      <tbody>
        {comparisonRows.map(({ entry2025, entry2026, change, changeRatio }) => (
          <tr
            data-budget-comparison
            data-state={entry2026.state}
            data-category={entry2026.category}
            data-label={`${entry2026.plan} ${entry2026.label}`.toLocaleLowerCase('de-DE')}
          >
            <th scope="row">{entry2026.plan} · {entry2026.label}</th>
            <td>{entry2026.category}</td>
            <td>{entry2025 ? formatEuroCompact(entry2025.amount) : '–'}</td>
            <td>{formatEuroCompact(entry2026.amount)}</td>
            <td>
              {change === undefined ? '–' : `${change < 0 ? '−' : '+'}${formatEuroCompact(Math.abs(change))}`}
              {changeRatio === undefined ? null : <span>{formatPercent(changeRatio)}</span>}
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>
