---
import SectionNavigation from './SectionNavigation.astro';
import { getFreestatePageUrl, getFreestateUrl } from '../../lib/portal/index.ts';
---

<SectionNavigation
  label="Freistaat"
  variant="freestate"
  items={[
    { label: 'Überblick', href: getFreestateUrl() },
    { label: 'Land & Leute', href: getFreestatePageUrl('land-und-leute') },
    { label: 'Staatsaufbau', href: getFreestatePageUrl('staatsaufbau') },
    { label: 'Staatsreform', href: getFreestatePageUrl('grosse-staatsreform') },
    { label: 'Verfassung', href: getFreestatePageUrl('verfassung-und-staatsziele') },
    { label: 'Bezirke', href: getFreestatePageUrl('bezirke') },
    { label: 'Hoheitszeichen', href: getFreestatePageUrl('landesfarben-und-hoheitszeichen') },
    { label: 'Hauptstädte', href: getFreestatePageUrl('hauptstaedte') },
    { label: 'Geschichte', href: getFreestatePageUrl('geschichte') },
  ]}
/>
