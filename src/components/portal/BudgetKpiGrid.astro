---
import {
  formatEuroCompact,
  formatPercent,
  type BudgetSpecialFund,
  type BudgetSummaryRow,
} from '../../lib/portal/modules.ts';

interface Props {
  summaryRows: BudgetSummaryRow[];
  specialFunds: BudgetSpecialFund[];
}

const { summaryRows, specialFunds } = Astro.props as Props;
const summary2025 = summaryRows.find((row) => row.year === '2025');
const summary2026 = summaryRows.find((row) => row.year === '2026');
const expenseChange = summary2025 && summary2026
  ? (summary2026.totalExpense - summary2025.totalExpense) / summary2025.totalExpense
  : 0;
const investmentShare = summary2026 ? summary2026.investments / summary2026.totalExpense : 0;
---

<section class="section budget-kpis" aria-labelledby="haushaltskennzahlen">
  <div class="section-header">
    <h2 id="haushaltskennzahlen">Haushaltskennzahlen</h2>
    <p>Alle Beträge beziehen sich auf das Haushaltsgesetz des jeweiligen Jahres.</p>
  </div>
  <div class="meta-grid budget-kpi-grid">
    {summary2025 ? (
      <article class="meta-card budget-kpi-card">
        <span class="meta-label">Gesamtausgaben 2025</span>
        <strong>{formatEuroCompact(summary2025.totalExpense)}</strong>
        <span class="detail-line">Haushaltsgesetz 2025</span>
      </article>
    ) : null}
    {summary2026 ? (
      <article class="meta-card budget-kpi-card">
        <span class="meta-label">Gesamtausgaben 2026</span>
        <strong>{formatEuroCompact(summary2026.totalExpense)}</strong>
        <span class="detail-line">Haushaltsgesetz 2026</span>
      </article>
    ) : null}
    <article class="meta-card budget-kpi-card">
      <span class="meta-label">Veränderung 2025 zu 2026</span>
      <strong>{formatPercent(expenseChange)}</strong>
      <span class="detail-line">Ausgabenvolumen, ohne Bewertung</span>
    </article>
    {summary2026 ? (
      <article class="meta-card budget-kpi-card">
        <span class="meta-label">Steuereinnahmen 2026</span>
        <strong>{formatEuroCompact(summary2026.taxRevenue)}</strong>
        <span class="detail-line">Steuern und steuerähnliche Abgaben</span>
      </article>
    ) : null}
    {summary2026 ? (
      <article class="meta-card budget-kpi-card">
        <span class="meta-label">Investitionen 2026</span>
        <strong>{formatEuroCompact(summary2026.investments)}</strong>
        <span class="detail-line">Investitionen und Investitionsförderung</span>
      </article>
    ) : null}
    <article class="meta-card budget-kpi-card">
      <span class="meta-label">Investitionsanteil 2026</span>
      <strong>{formatPercent(investmentShare)}</strong>
      <span class="detail-line">Anteil an den Gesamtausgaben 2026</span>
    </article>
    <article class="meta-card budget-kpi-card">
      <span class="meta-label">Sondervermögen und Fonds</span>
      <strong>{specialFunds.length}</strong>
      <span class="detail-line">Zweckgebundene Instrumente mit Rechtsbezug</span>
    </article>
  </div>
</section>
