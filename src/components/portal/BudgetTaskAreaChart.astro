---
import {
  budgetTotals,
  getBudgetShare,
  type BudgetTaskArea,
  type BudgetYear,
} from '../../data/haushalt.ts';
import { formatEuroAmount, formatEuroCompact, formatPercent } from '../../lib/portal/modules.ts';

interface Props {
  areas: BudgetTaskArea[];
  year: BudgetYear;
}

const { areas, year } = Astro.props as Props;
const total = budgetTotals[year].expenses;
---

<section class="budget-task-areas" aria-labelledby={`aufgabenbereiche-${year}`}>
  <div class="section-header section-header--compact">
    <h3 id={`aufgabenbereiche-${year}`}>Wofür werden Mittel veranschlagt?</h3>
    <p>Ausgaben nach zusammengefassten Aufgabenbereichen. Die Zuordnung dient der Orientierung und ist keine politische Rangfolge oder Bewertung der Mittelversorgung.</p>
  </div>
  <div class="budget-task-areas__chart">
    {areas.map((area) => {
      const share = getBudgetShare(area.amounts[year], total) ?? 0;
      return (
        <article class="budget-task-areas__item">
          <div class="budget-task-areas__label">
            <strong>{area.label}</strong>
            <span>{formatEuroCompact(area.amounts[year])} · {formatPercent(share)} der Gesamtausgaben</span>
          </div>
          <div class="budget-task-areas__bar" aria-hidden="true"><span style={`width: ${Math.max(share * 100, 1)}%`}></span></div>
          <p>{area.description}</p>
        </article>
      );
    })}
  </div>
  <div class="table-wrap" tabindex="0" role="region" aria-label={`Aufgabenbereiche des Haushalts ${year} als Tabelle`}>
    <table class="data-table">
      <caption>Aufgabenbereiche im Haushalt {year}</caption>
      <thead><tr><th scope="col">Aufgabenbereich</th><th scope="col">Ausgaben</th><th scope="col">Anteil am Gesamthaushalt</th><th scope="col">Zugeordnete Einzelpläne</th></tr></thead>
      <tbody>
        {areas.map((area) => (
          <tr>
            <th scope="row">{area.label}</th>
            <td>{formatEuroAmount(area.amounts[year])}</td>
            <td>{formatPercent(getBudgetShare(area.amounts[year], total) ?? 0)}</td>
            <td>{area.planNumbers.join(', ')}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .budget-task-areas { display: grid; gap: 1.25rem; }
  .budget-task-areas__chart { display: grid; gap: .85rem; }
  .budget-task-areas__item { display: grid; gap: .4rem; padding: .85rem 1rem; border: 1px solid var(--color-border); border-radius: var(--radius-sm); background: var(--color-surface); }
  .budget-task-areas__label { display: flex; gap: 1rem; justify-content: space-between; align-items: baseline; }
  .budget-task-areas__label span { color: var(--color-text-muted); text-align: right; }
  .budget-task-areas__bar { height: .7rem; overflow: hidden; border-radius: 999px; background: var(--color-surface-muted); }
  .budget-task-areas__bar span { display: block; height: 100%; border-radius: inherit; background: var(--color-primary); }
  .budget-task-areas__item p { margin: 0; color: var(--color-text-muted); }
  @media (max-width: 40rem) { .budget-task-areas__label { display: grid; gap: .15rem; } .budget-task-areas__label span { text-align: left; } }
</style>
