---
import type { BudgetSpecialFund } from '../../lib/portal/modules.ts';

interface Props {
  funds: BudgetSpecialFund[];
}

const { funds } = Astro.props as Props;
---

<section class="budget-view" aria-labelledby="sondervermoegen-fonds">
  <div class="section-header section-header--compact">
    <h3 id="sondervermoegen-fonds">Sondervermögen und Fonds</h3>
    <p>Sondervermögen und Fonds ergänzen den Kernhaushalt zweckgebunden. Sie sind nicht mit den Einzelplänen gleichzusetzen.</p>
  </div>
  <div class="card-grid card-grid--three">
    {funds.map((fund) => (
      <article class="panel budget-fund-card">
        <h4>{fund.href ? <a class="inline-link" href={fund.href}>{fund.label}</a> : fund.label}</h4>
        <p><strong>Zweck:</strong> {fund.purpose}</p>
        <p>{fund.description}</p>
      </article>
    ))}
  </div>
</section>
