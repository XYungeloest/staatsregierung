---
import { loadCurrentGovernment } from '../../lib/portal/content.ts';
import { getFreestateUrl } from '../../lib/portal/index.ts';
import PortalIcon from './PortalIcon.astro';

const currentGovernment = await loadCurrentGovernment();
---

<section class="home-info-card home-freestate-card" aria-labelledby="home-freestate-title">
  <header class="home-info-card__header">
    <div>
      <p class="eyebrow">Orientierung</p>
      <h2 id="home-freestate-title">Freistaat Ostdeutschland</h2>
    </div>
  </header>
  <div class="home-freestate-card__mark" aria-hidden="true">
    <span></span><span></span><span></span>
  </div>
  <dl class="home-freestate-facts">
    <div><PortalIcon name="government" /><dt>Sitz des Staatsrates</dt><dd>{currentGovernment.seatOfGovernment}</dd></div>
    <div><PortalIcon name="ministry" /><dt>Staatsorgan</dt><dd>{currentGovernment.title}</dd></div>
    <div><PortalIcon name="law" /><dt>Volksvertretung</dt><dd>{currentGovernment.legislature}</dd></div>
    <div><PortalIcon name="topics" /><dt>Regierungskoalition</dt><dd>{currentGovernment.coalitionShort}</dd></div>
  </dl>
  <a class="button-link button-link--secondary home-freestate-card__link" href={getFreestateUrl()}>
    Mehr über den Freistaat <PortalIcon name="arrow" />
  </a>
</section>
