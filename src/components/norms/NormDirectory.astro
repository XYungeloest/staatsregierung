---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '../Breadcrumbs.astro';
import SectionHero from '../portal/SectionHero.astro';
import {
  formatDate,
  formatNormStatus,
  formatNormType,
  getIndexGroups,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionIdentity,
  getSearchUrl,
  toDisplayText,
  type NormRecord,
} from '../../lib/norms/index.ts';
import { getCurrentVersion } from '../../lib/norms/content.ts';

interface Props {
  title: string;
  lead: string;
  href: string;
  norms: NormRecord[];
}

const { title, lead, href, norms } = Astro.props;
const groups = getIndexGroups(norms);
const groupLookup = new Map(groups.map((group) => [group.letter, group]));
const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
const subjects = [...new Set(norms.flatMap((norm) => norm.meta.subjects.map(toDisplayText)))].sort((left, right) => left.localeCompare(right, 'de'));
---

<LawLayout
  title={title}
  description={`${title} des Ostdeutschen Freistaates alphabetisch und nach Sachgebiet recherchieren.`}
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: title, href }]}
>
  <Breadcrumbs items={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: title }]} />
  <SectionHero eyebrow="Rechtsportal" title={title} lead={lead} variant="law" facts={[{ label: 'Vorschriften', value: String(norms.length) }]}>
    <form class="law-directory-search" action={getSearchUrl()} method="get">
      <input type="hidden" name="type" value={norms[0]?.meta.type ?? ''} />
      <label class="search-field"><span>Volltextsuche in diesem Normtyp</span><input type="search" name="q" placeholder={`${title} durchsuchen`} autocomplete="off" data-law-norm-autocomplete data-law-suggestions-url={`${import.meta.env.BASE_URL}search-suggestions.json`} /></label>
      <button class="button-link" type="submit">Suchen</button>
    </form>
  </SectionHero>

  <div data-law-list-filter>
    <section class="law-directory-tools" aria-labelledby="directory-filter-title">
      <div>
        <h2 id="directory-filter-title">Alphabet und Filter</h2>
        <nav class="letter-nav" aria-label="Buchstaben-Navigation">
          {alphabet.map((letter) => groupLookup.has(letter)
            ? <a href={`#directory-${letter}`} data-law-filter-letter={letter}>{letter}</a>
            : <span aria-disabled="true" data-law-filter-letter={letter}>{letter}</span>)}
        </nav>
      </div>
      <form class="law-directory-filters" data-law-filter-form>
        <label class="search-field"><span>Titel oder Abkürzung</span><input type="search" name="q" /></label>
        <label class="search-field"><span>Sachgebiet</span><select name="subject"><option value="">Alle Sachgebiete</option>{subjects.map((subject) => <option value={subject}>{subject}</option>)}</select></label>
        <label class="search-field"><span>Rechtsstand</span><select name="status"><option value="">Alle Rechtsstände</option><option value="in-force">Geltend</option><option value="future-effective">Zukünftig</option><option value="historical|repealed">Historisch oder aufgehoben</option></select></label>
        <button class="button-link" type="submit">Filtern</button>
      </form>
      <p class="search-feedback" aria-live="polite" data-law-filter-summary></p>
    </section>

    <div class="law-directory-list">
      {groups.map((group) => (
        <section id={`directory-${group.letter}`} class="law-directory-group" data-law-filter-group={group.letter}>
          <h2>{group.letter}</h2>
          <ol>
            {group.norms.map((norm) => {
              const version = getCurrentVersion(norm);
              const identity = getNormVersionIdentity(norm, version);
              return (
                <li
                  data-law-filter-entry
                  data-q={`${identity.title} ${identity.shortTitle} ${identity.abbr ?? ''}`}
                  data-subject={norm.meta.subjects.join(' ')}
                  data-status={norm.meta.status}
                >
                  <div>
                    <span class="law-type-label">{formatNormType(norm.meta.type)}</span>
                    <h3><a href={getNormUrl(norm.meta.slug)}>{toDisplayText(identity.title)}</a></h3>
                    {identity.abbr ? <p class="law-directory-group__abbr">{toDisplayText(identity.abbr)}</p> : null}
                    <p>{toDisplayText(identity.summary)}</p>
                  </div>
                  <dl>
                    <div><dt>Rechtsstand</dt><dd>{formatNormStatus(norm.meta.status)}</dd></div>
                    <div><dt>Fassung seit</dt><dd><time datetime={version.validFrom}>{formatDate(version.validFrom)}</time></dd></div>
                  </dl>
                </li>
              );
            })}
          </ol>
        </section>
      ))}
    </div>
  </div>
  <script>import '../../scripts/law-list-filter.ts';</script>
</LawLayout>
