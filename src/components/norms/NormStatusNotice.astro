---
import { formatDate, toDisplayText } from '../../lib/norms/presentation.ts';
import { getNormHistoryUrl, getNormUrl, getNormVersionUrl } from '../../lib/norms/routes.ts';
import type { NormRecord, NormVersion } from '../../lib/norms/schema.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  historical?: boolean;
}

const { norm, version, historical = false } = Astro.props;
const historicalVersions = norm.versions.filter((entry) => !entry.isCurrent);
const status = norm.meta.status;
const effectiveDate = norm.meta.effectiveDate ?? version.validFrom;
const expiryDate = norm.meta.expiryDate ?? version.validTo;
---

<aside class:list={['status-notice', historical ? 'status-notice--historical' : 'status-notice--current']} data-visual-section="norm-legal-status">
  <h2>{historical ? 'Hinweis zur historischen Fassung' : 'Rechtsstand'}</h2>
  {historical ? (
    <p>
      Dies ist eine historische Fassung. Sie galt vom <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time> bis{' '}
      {version.validTo ? <time datetime={version.validTo}>{formatDate(version.validTo)}</time> : 'heute'}.
    </p>
  ) : status === 'future-effective' ? (
    <p>
      Diese Vorschrift ist verkündet und tritt am{' '}
      <time datetime={effectiveDate}>{formatDate(effectiveDate)}</time> in Kraft. Bis dahin gehört sie
      noch nicht zum geltenden Rechtsstand.
    </p>
  ) : status === 'repealed' || status === 'historical' ? (
    <p>
      Diese Vorschrift ist außer Kraft
      {expiryDate ? <> seit <time datetime={expiryDate}>{formatDate(expiryDate)}</time></> : null}.
      Die zuletzt veröffentlichte Fassung bleibt zu Dokumentationszwecken verfügbar.
    </p>
  ) : status === 'one-time-act' ? (
    <p>Dieser einmalige Rechtsakt ist abgeschlossen und bleibt zu Dokumentationszwecken verfügbar.</p>
  ) : (
    <p>Dies ist die aktuelle Fassung mit Rechtsstand vom <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time>.</p>
  )}
  <p>{toDisplayText(version.changeNote)}</p>
  <nav class="link-list link-list--inline" aria-label="Rechtsstandslinks">
    {historical ? <a href={getNormUrl(norm.meta.slug)}>Zur aktuellen Fassung</a> : null}
    <a href={getNormHistoryUrl(norm.meta.slug)}>Zur Historie</a>
    {!historical &&
      historicalVersions.map((entry) => (
        <a href={getNormVersionUrl(norm.meta.slug, entry.versionId)}>
          Historische Fassung vom <time datetime={entry.validFrom}>{formatDate(entry.validFrom)}</time>
        </a>
      ))}
  </nav>
</aside>
