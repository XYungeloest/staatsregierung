---
import {
  getBlockAnchorId,
  getHeadingTag,
  getLegacyBlockAnchorId,
  renderLinkedDisplayText,
  toDisplayText,
} from '../../lib/norms/presentation.ts';
import type { TextLinkReference } from '../../lib/norms/presentation.ts';
import type { NormBodyBlock } from '../../lib/norms/schema.ts';

interface Props {
  blocks: NormBodyBlock[];
  path?: number[];
  references?: TextLinkReference[];
  headingLevel?: number;
  quoted?: boolean;
}

type BlockRun =
  | { kind: 'block'; block: NormBodyBlock; index: number }
  | { kind: 'list'; items: Array<{ block: NormBodyBlock; index: number }> };

const { blocks, path = [], references = [], headingLevel = 2, quoted = false } = Astro.props;

function groupBlocks(entries: NormBodyBlock[]): BlockRun[] {
  const runs: BlockRun[] = [];
  let listBuffer: Array<{ block: NormBodyBlock; index: number }> = [];

  function flushList() {
    if (listBuffer.length > 0) {
      runs.push({ kind: 'list', items: listBuffer });
      listBuffer = [];
    }
  }

  entries.forEach((block, index) => {
    if (block.type === 'item' || block.type === 'subitem') {
      listBuffer.push({ block, index });
      return;
    }

    flushList();
    runs.push({ kind: 'block', block, index });
  });

  flushList();
  return runs;
}
---

{groupBlocks(blocks).map((run) => (
  <Fragment>
    {run.kind === 'block'
      ? (() => {
          const block = run.block;
          const currentPath = [...path, run.index];
          const HeadingTag = getHeadingTag(headingLevel);
          const anchorId = getBlockAnchorId(currentPath, block, quoted ? 'zitat' : '');
          const legacyAnchorId = getLegacyBlockAnchorId(currentPath, block);
          const headingId = block.title || block.label ? `${anchorId}-heading` : undefined;
          const childHeadingLevel = block.title
            ? Number.parseInt(HeadingTag.slice(1), 10)
            : headingLevel;

          return (
            <Fragment>
              {block.type === 'part' ||
              block.type === 'chapter' ||
              block.type === 'section' ||
              block.type === 'subsection' ? (
                <section id={anchorId} class={`norm-division norm-division--${block.type}`} aria-labelledby={headingId}>
                  {legacyAnchorId !== anchorId ? <span id={legacyAnchorId} class="legacy-anchor" aria-hidden="true"></span> : null}
                  <header class="norm-division__header">
                    {block.label ? <p id={block.title ? undefined : headingId} class="norm-label">{toDisplayText(block.label)}</p> : null}
                    {block.title ? <HeadingTag id={headingId}>{toDisplayText(block.title)}</HeadingTag> : null}
                  </header>
                  {block.children && block.children.length > 0 ? (
                    <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={childHeadingLevel} quoted={quoted} />
                  ) : null}
                </section>
              ) : null}

              {block.type === 'paragraph' || block.type === 'article' ? (
                quoted ? (
                  <section id={anchorId} class={`norm-quoted-unit norm-quoted-unit--${block.type}`} aria-labelledby={headingId}>
                    <header class="norm-quoted-unit__header">
                      {block.label ? <p id={block.title ? undefined : headingId} class="norm-quoted-unit__label">{toDisplayText(block.label)}</p> : null}
                      {block.title ? <HeadingTag id={headingId}>{toDisplayText(block.title)}</HeadingTag> : null}
                    </header>
                    {block.children && block.children.length > 0 ? (
                      <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={childHeadingLevel} quoted={true} />
                    ) : null}
                  </section>
                ) : (
                  <details id={anchorId} class={`norm-unit norm-unit--${block.type}`} open>
                    {legacyAnchorId !== anchorId ? <span id={legacyAnchorId} class="legacy-anchor" aria-hidden="true"></span> : null}
                    <summary class="norm-unit__summary">
                      {block.label ? <p class="norm-unit__label">{toDisplayText(block.label)}</p> : null}
                      {block.title ? <HeadingTag>{toDisplayText(block.title)}</HeadingTag> : null}
                    </summary>
                    <nav class="norm-unit__tools" aria-label={`Werkzeuge für ${toDisplayText([block.label, block.title].filter(Boolean).join(' '))}`}>
                      <button type="button" data-print-unit={anchorId}>Einzeldruck</button>
                      <a href={`#${anchorId}`}>Link zu dieser Stelle</a>
                      <button type="button" data-copy-anchor={anchorId}>Link kopieren</button>
                    </nav>
                    {block.children && block.children.length > 0 ? (
                      <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={childHeadingLevel} />
                    ) : null}
                  </details>
                )
              ) : null}

              {block.type === 'quotedProvision' ? (
                <blockquote class="norm-quoted-provision">
                  {block.children && block.children.length > 0 ? (
                    <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={headingLevel} quoted={true} />
                  ) : null}
                </blockquote>
              ) : null}

              {block.type === 'annex' ? (
                <section id={anchorId} class="norm-annex" aria-labelledby={headingId}>
                  {legacyAnchorId !== anchorId ? <span id={legacyAnchorId} class="legacy-anchor" aria-hidden="true"></span> : null}
                  <header class="norm-division__header">
                    {block.label ? <p id={block.title ? undefined : headingId} class="norm-label">{toDisplayText(block.label)}</p> : null}
                    {block.title ? <HeadingTag id={headingId}>{toDisplayText(block.title)}</HeadingTag> : null}
                  </header>
                  {block.children && block.children.length > 0 ? (
                    <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={childHeadingLevel} quoted={quoted} />
                  ) : null}
                </section>
              ) : null}

              {block.type === 'paragraphText' ? (
                <Fragment>
                  <p class="norm-text" set:html={renderLinkedDisplayText(block.text, references)} />
                  {block.children && block.children.length > 0 ? (
                    <div class="norm-text__children">
                      <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={headingLevel} quoted={quoted} />
                    </div>
                  ) : null}
                </Fragment>
              ) : null}

              {block.type === 'subparagraph' ? (
                <div class="norm-subparagraph-wrap">
                  <p class="norm-subparagraph">
                    {block.label ? <span class="norm-subparagraph__label">{toDisplayText(block.label)}</span> : null}
                    <span set:html={renderLinkedDisplayText(block.text, references)} />
                  </p>
                  {block.children && block.children.length > 0 ? (
                    <div class="norm-subparagraph__children">
                      <Astro.self blocks={block.children} path={currentPath} references={references} headingLevel={headingLevel} quoted={quoted} />
                    </div>
                  ) : null}
                </div>
              ) : null}

              {block.type === 'table' ? (
                <div class="table-wrap norm-table-wrap" tabindex="0" role="region" aria-label={block.title ?? 'Tabelle im Normtext'}>
                  <table class="norm-table">
                    <caption class="visually-hidden">{block.title ?? 'Tabelle im Normtext'}</caption>
                    {block.children?.map((row) => (
                      <tr>
                        {row.children?.map((cell) => (
                          cell.type === 'tableHeaderCell' ? (
                            <th scope={cell.scope} rowspan={cell.rowspan} colspan={cell.colspan}>
                              {cell.children?.length ? (
                                <Astro.self blocks={cell.children} path={currentPath} references={references} headingLevel={headingLevel} quoted={quoted} />
                              ) : <span set:html={renderLinkedDisplayText(cell.text ?? '', references)} />}
                            </th>
                          ) : (
                            <td rowspan={cell.rowspan} colspan={cell.colspan}>
                              {cell.children?.length ? (
                                <Astro.self blocks={cell.children} path={currentPath} references={references} headingLevel={headingLevel} quoted={quoted} />
                              ) : <span set:html={renderLinkedDisplayText(cell.text ?? '', references)} />}
                            </td>
                          )
                        ))}
                      </tr>
                    ))}
                  </table>
                </div>
              ) : null}
            </Fragment>
          );
        })()
      : null}

    {run.kind === 'list' ? (
      <ol class:list={['norm-amendment-list', quoted ? 'norm-amendment-list--quoted' : undefined]}>
        {run.items.map(({ block, index }) => (
          <li class="norm-amendment-item">
            {block.label ? <span class="norm-amendment-item__label">{toDisplayText(block.label)}</span> : null}
            <div class="norm-amendment-item__content">
              <span set:html={renderLinkedDisplayText(block.text, references)} />
              {block.children && block.children.length > 0 ? (
                <div class="norm-amendment-item__children">
                  <Astro.self blocks={block.children} path={[...path, index]} references={references} headingLevel={headingLevel} quoted={quoted} />
                </div>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
    ) : null}
  </Fragment>
))}
