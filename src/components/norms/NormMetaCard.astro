---
import {
  getHelpUrl,
  getNormCompareUrl,
  getNormHistoryUrl,
  getNormUrl,
  getNormVersionUrl,
  getPublicationUrl,
  getSubjectUrl,
} from '../../lib/norms/routes.ts';
import {
  formatDate,
  formatNormStatus,
  formatNormType,
  parseCitation,
  toDisplayText,
} from '../../lib/norms/presentation.ts';
import type { NormRecord, NormVersion } from '../../lib/norms/schema.ts';
import type { NormPublicationReference } from '../../lib/norms/publications.ts';
import type { RelatedNormRecommendation } from '../../lib/norms/references.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  historical?: boolean;
  relatedNorms?: RelatedNormRecommendation[];
  publicationReference?: NormPublicationReference;
}

const { norm, version, historical = false, relatedNorms = [], publicationReference } = Astro.props;
const historicalVersions = norm.versions.filter((entry) => !entry.isCurrent);
const citation = parseCitation(version.citation);
const initialCitation = parseCitation(norm.meta.initialCitation);
const canCompareVersions = norm.versions.length > 1;
const effectiveFrom = norm.meta.effectiveDate ?? version.validFrom;
const effectiveUntil = norm.meta.expiryDate ?? version.validTo;
---

<aside id="normdaten" class="section meta-panel">
  <div class="section-header section-header--compact">
    <h2>Vorschriftendaten</h2>
  </div>
  <h3>Bezeichnung</h3>
  <dl class="meta-list">
    <div>
      <dt>Kurztitel</dt>
      <dd>{toDisplayText(norm.meta.shortTitle)}</dd>
    </div>
    {norm.meta.abbr ? (
      <div>
        <dt>Abkürzung</dt>
        <dd>{norm.meta.abbr}</dd>
      </div>
    ) : null}
    <div>
      <dt>Normtyp</dt>
      <dd>{formatNormType(norm.meta.type)}</dd>
    </div>
    {norm.meta.enactingBody ? (
      <div>
        <dt>Erlassendes Organ</dt>
        <dd>{toDisplayText(norm.meta.enactingBody)}</dd>
      </div>
    ) : null}
    {norm.meta.responsibleMinistry || norm.meta.ministry ? (
      <div>
        <dt>Zuständiger Geschäftsbereich</dt>
        <dd>{toDisplayText(norm.meta.responsibleMinistry ?? norm.meta.ministry)}</dd>
      </div>
    ) : null}
  </dl>

  <h3>Fundstelle</h3>
  <dl class="meta-list">
    <div>
      <dt>Vollzitat</dt>
      <dd>{toDisplayText(version.citation)}</dd>
    </div>
    {citation ? (
      <div>
        <dt>Fundstelle</dt>
        <dd>
          {citation.source} {citation.year} Nr. {citation.issue}{citation.page ? ` S. ${citation.page}` : ''}
        </dd>
      </div>
    ) : null}
    <div>
      <dt>Stammfundstelle</dt>
      <dd>{toDisplayText(norm.meta.initialCitation)}</dd>
    </div>
    {initialCitation ? (
      <div>
        <dt>Stammausgabe</dt>
        <dd>
          {initialCitation.source} {initialCitation.year} Nr. {initialCitation.issue}{initialCitation.page ? ` S. ${initialCitation.page}` : ''}
        </dd>
      </div>
    ) : null}
    {publicationReference ? (
      <div>
        <dt>Verkündung</dt>
        <dd>
          <a class="inline-link" href={getPublicationUrl(publicationReference.publicationSlug)}>
            {toDisplayText(publicationReference.publicationTitle)}
          </a>
          <br />
          <span>
            <time datetime={publicationReference.publicationDate}>{formatDate(publicationReference.publicationDate)}</time>
            {publicationReference.pages
              ? ` · Seiten ${publicationReference.pages}`
              : publicationReference.startPage
                ? ` · Beginn auf Seite ${publicationReference.startPage}`
                : ''}
          </span>
        </dd>
      </div>
    ) : null}
  </dl>

  <h3>Gültigkeit</h3>
  <dl class="meta-list">
    {norm.meta.documentDate ? (
      <div>
        <dt>Normdatum</dt>
        <dd><time datetime={norm.meta.documentDate}>{formatDate(norm.meta.documentDate)}</time></dd>
      </div>
    ) : null}
    {norm.meta.publicationDate ? (
      <div>
        <dt>Veröffentlicht</dt>
        <dd><time datetime={norm.meta.publicationDate}>{formatDate(norm.meta.publicationDate)}</time></dd>
      </div>
    ) : null}
    <div>
      <dt>In Kraft ab</dt>
      <dd><time datetime={effectiveFrom}>{formatDate(effectiveFrom)}</time></dd>
    </div>
    <div>
      <dt>In Kraft bis</dt>
      <dd>{effectiveUntil ? <time datetime={effectiveUntil}>{formatDate(effectiveUntil)}</time> : 'unbefristet'}</dd>
    </div>
    <div>
      <dt>Status</dt>
      <dd>{formatNormStatus(norm.meta.status)}</dd>
    </div>
    {norm.meta.dateNote ? (
      <div>
        <dt>Datierungshinweis</dt>
        <dd>{toDisplayText(norm.meta.dateNote)}</dd>
      </div>
    ) : null}
  </dl>

  <h3>Sachgebiete</h3>
  <div class="tag-list">
    {norm.meta.subjects.map((subject) => (
      <a class="tag" href={getSubjectUrl(subject)}>{toDisplayText(subject)}</a>
    ))}
  </div>

  <h3 id="normhistorie">Fassungen und Historie</h3>
  <nav class="link-list" aria-label="Fassungen und Historie">
    {!historical ? <a href={getNormUrl(norm.meta.slug)}>Aktuelle Fassung</a> : null}
    {historical ? <a href={getNormUrl(norm.meta.slug)}>Zur aktuellen Fassung</a> : null}
    <a href={getNormHistoryUrl(norm.meta.slug)}>Normenhistorie</a>
    {historicalVersions.map((entry) => (
      <a href={getNormVersionUrl(norm.meta.slug, entry.versionId)}>
        Historische Fassung vom <time datetime={entry.validFrom}>{formatDate(entry.validFrom)}</time>
      </a>
    ))}
    {canCompareVersions ? <a href={getNormCompareUrl(norm.meta.slug)}>Fassungen vergleichen</a> : null}
    {historicalVersions.length === 0 ? <span>Keine historischen Fassungen gespeichert</span> : null}
  </nav>

  {relatedNorms.length > 0 ? (
    <>
      <h3 id="normverwandt">Verwandte Vorschriften</h3>
      <nav class="link-list" aria-label="Verwandte Vorschriften">
        {relatedNorms.map(({ norm: entry, relation }) => (
          <a href={getNormUrl(entry.meta.slug)}>
            <span>{toDisplayText(entry.meta.shortTitle || entry.meta.title)}</span>
            <small>{relation}</small>
          </a>
        ))}
      </nav>
    </>
  ) : null}

  <h3>Ausgabe</h3>
  <div class="link-list">
    <button class="text-link-button" type="button" data-print-page>Seite drucken</button>
    <a href={getHelpUrl()}>Hilfe zum Rechtsbereich</a>
  </div>
</aside>
