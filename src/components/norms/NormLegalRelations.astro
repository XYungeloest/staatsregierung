---
import { formatDate, toDisplayText } from '../../lib/norms/presentation.ts';
import { getNormUrl, getNormVersionUrl } from '../../lib/norms/routes.ts';
import { classifyNormVersion } from '../../lib/norms/versions.ts';
import { getApplicableVersion } from '../../lib/norms/versions.ts';
import { getNormVersionIdentity } from '../../lib/norms/identity.ts';
import type { NormRecord } from '../../lib/norms/schema.ts';
import type { NormRelation, NormRelationKind } from '../../lib/norms/relations.ts';

interface Props {
  norm: NormRecord;
  relations: NormRelation[];
}

const { norm, relations } = Astro.props;
const sections: Array<{ kind: NormRelationKind; heading: string; empty?: string }> = [
  { kind: 'amended-by', heading: 'Geändert durch' },
  { kind: 'amends', heading: 'Ändert' },
  { kind: 'enacted-by', heading: 'Erlassen durch' },
  { kind: 'enacts', heading: 'Führt ein' },
  { kind: 'repealed-by', heading: 'Aufgehoben durch' },
  { kind: 'repeals', heading: 'Hebt auf' },
  { kind: 'predecessor', heading: 'Vorgänger' },
  { kind: 'successor', heading: 'Nachfolger' },
];
const visibleSections = sections
  .map((section) => ({ ...section, entries: relations.filter((entry) => entry.kind === section.kind) }))
  .filter((section) => section.entries.length > 0);

function resultingVersionUrl(relation: NormRelation): string | undefined {
  if (!relation.resultingNorm || !relation.resultingVersionId) return undefined;
  const version = relation.resultingNorm.versions.find((entry) => entry.versionId === relation.resultingVersionId);
  if (!version) return undefined;
  return classifyNormVersion(relation.resultingNorm, version) === 'current'
    ? getNormUrl(relation.resultingNorm.meta.slug)
    : getNormVersionUrl(relation.resultingNorm.meta.slug, version.versionId);
}
---

{visibleSections.length > 0 ? (
  <section class="section norm-relations" id="normrelationen" aria-labelledby={`norm-relations-${norm.meta.slug}`}>
    <div class="section-header section-header--compact">
      <h2 id={`norm-relations-${norm.meta.slug}`}>Rechtsbeziehungen</h2>
      <p>Belegte Beziehungen zwischen Stammnormen, Änderungsakten und entstandenen Fassungen.</p>
    </div>
    <div class="norm-relations__groups">
      {visibleSections.map((section) => (
        <section aria-labelledby={`norm-relation-${norm.meta.slug}-${section.kind}`}>
          <h3 id={`norm-relation-${norm.meta.slug}-${section.kind}`}>{section.heading}</h3>
          <ul class="timeline-list">
            {section.entries.map((relation) => {
              const relationIdentity = getNormVersionIdentity(relation.norm, getApplicableVersion(relation.norm));
              const versionUrl = resultingVersionUrl(relation);
              const resultingVersion = relation.resultingNorm?.versions.find((entry) => entry.versionId === relation.resultingVersionId);
              return (
                <li>
                  <strong><a class="inline-link" href={getNormUrl(relation.norm.meta.slug)}>{toDisplayText(relationIdentity.shortTitle)}</a></strong>
                  {relation.date ? <span>Rechtsänderung am <time datetime={relation.date}>{formatDate(relation.date)}</time></span> : null}
                  {relation.citation ? <span>Fundstelle: {toDisplayText(relation.citation)}</span> : null}
                  {versionUrl && resultingVersion ? (
                    <span>Entstandene Fassung: <a class="inline-link" href={versionUrl}><time datetime={resultingVersion.validFrom}>{formatDate(resultingVersion.validFrom)}</time></a></span>
                  ) : null}
                </li>
              );
            })}
          </ul>
        </section>
      ))}
    </div>
  </section>
) : null}
