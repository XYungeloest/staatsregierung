---
import { formatDate, getNormHistoryUrl, toDisplayText, type NormRecord } from '../../lib/norms/index.ts';

interface Props { norm: NormRecord; }
const { norm } = Astro.props;
const entries = [...norm.history.entries].sort((left, right) => right.date.localeCompare(left.date)).slice(0, 4);
---

{entries.length > 0 ? (
  <section class="norm-side-card" data-visual-section="norm-history-summary">
    <h2>Änderungshistorie</h2>
    <ol class="norm-side-history">
      {entries.map((entry) => (
        <li>
          <time datetime={entry.date}>{formatDate(entry.date)}</time>
          <span>{toDisplayText(entry.title)}</span>
          {entry.relatedNorm ? <span>Bezug: {toDisplayText(entry.relatedNorm)}</span> : null}
        </li>
      ))}
    </ol>
    <a class="law-card-footer-link" href={getNormHistoryUrl(norm.meta.slug)}>Alle Änderungen anzeigen</a>
  </section>
) : null}
