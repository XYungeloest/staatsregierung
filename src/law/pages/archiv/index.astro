---
import LawLayout from '../../../layouts/LawLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import {
  formatNormType,
  getGermanIndexLetter,
  getIndexGroups,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionIdentity,
  toDisplayText,
} from '../../../lib/norms/index.ts';
import { getCurrentVersion, loadAllNorms } from '../../../lib/norms/content.ts';

const norms = await loadAllNorms();
const groups = getIndexGroups(norms);
const keywordEntries = new Map<string, typeof norms>();

for (const norm of norms) {
  const identity = getNormVersionIdentity(norm, getCurrentVersion(norm));
  for (const rawKeyword of [identity.abbr, identity.shortTitle, ...norm.meta.keywords].filter(Boolean)) {
    const keyword = toDisplayText(rawKeyword).trim();
    if (!keyword || keyword.length < 2) {
      continue;
    }

    const existing = keywordEntries.get(keyword) ?? [];
    if (!existing.some((entry) => entry.meta.slug === norm.meta.slug)) {
      keywordEntries.set(keyword, [...existing, norm]);
    }
  }
}

const keywordGroups = [...keywordEntries.entries()]
  .sort(([left], [right]) => left.localeCompare(right, 'de'))
  .reduce<Array<{ letter: string; entries: Array<{ keyword: string; norms: typeof norms }> }>>(
    (result, [keyword, keywordNorms]) => {
      const key = getGermanIndexLetter(keyword);
      const group = result.find((entry) => entry.letter === key);
      const entry = { keyword, norms: keywordNorms.sort((left, right) => {
        const leftTitle = getNormVersionIdentity(left, getCurrentVersion(left)).title;
        const rightTitle = getNormVersionIdentity(right, getCurrentVersion(right)).title;
        return leftTitle.localeCompare(rightTitle, 'de');
      }) };

      if (group) {
        group.entries.push(entry);
      } else {
        result.push({ letter: key, entries: [entry] });
      }

      return result;
    },
    [],
  );
const availableLetters = [...new Set([...groups.map((group) => group.letter), ...keywordGroups.map((group) => group.letter)])]
  .sort((left, right) => left.localeCompare(right, 'de'));
---

<LawLayout
  title="Alphabetischer Index"
  description="Alphabetischer Zugang zu den im Rechtsbereich des Freistaates Ostdeutschland geführten Normen."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Alphabetischer Index', href: getLawPortalUrl() + 'archiv/' },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Alphabetischer Index' },
    ]}
  />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Alphabetischer Index"
    lead="Alle Vorschriften, Abkürzungen, Kurztitel und Stichwörter von A bis Z."
    variant="law"
    facts={[{ label: 'Normen', value: String(norms.length) }, { label: 'Buchstabengruppen', value: String(groups.length) }]}
  />
  <section class="section" aria-label="Buchstabenauswahl">
    <nav class="letter-nav" aria-label="Buchstaben-Navigation">
      {availableLetters.map((letter) => (
        <a href={`#${encodeURIComponent(letter)}`} data-index-letter={letter}>{letter}</a>
      ))}
    </nav>
  </section>

  {groups.map((group) => (
    <section class="section" id={group.letter}>
      <div class="section-header">
        <h2>{group.letter}</h2>
      </div>
      <ul class="record-list">
        {group.norms.map((norm) => {
          const identity = getNormVersionIdentity(norm, getCurrentVersion(norm));
          return (
          <li class="record-list__item">
            <a class="inline-link" href={getNormUrl(norm.meta.slug)}>{toDisplayText(identity.title)}</a>
            <span>{[identity.abbr, formatNormType(norm.meta.type)].filter(Boolean).join(' · ')}</span>
          </li>
          );
        })}
      </ul>
    </section>
  ))}

  <section class="section section-muted">
    <div class="section-header">
      <h2>Stichwortindex</h2>
      <p>Abkürzungen, Kurztitel und redaktionelle Stichwörter führen zusätzlich in den Normenbestand.</p>
    </div>
    <label class="search-field law-index-filter">
      <span>Stichwörter lokal filtern</span>
      <input type="search" autocomplete="off" data-index-filter placeholder="z. B. Kultur, Energie, Verwaltung" />
    </label>
    <p class="search-feedback" aria-live="polite" data-index-filter-status></p>
    <div class="content-grid content-grid--wide">
      {keywordGroups.map((group) => (
        <section class="panel" id={groups.some((entry) => entry.letter === group.letter) ? undefined : group.letter} data-index-group={group.letter}>
          <h3>{group.letter}</h3>
          <ul class="record-list">
            {group.entries.map((entry) => (
              <li class="record-list__item" data-index-entry={entry.keyword.toLocaleLowerCase('de-DE')}>
                <strong>{entry.keyword}</strong>
                <span>
                  {entry.norms.map((norm, index) => (
                    <Fragment>
                      {index > 0 ? ', ' : ''}
                      <a class="inline-link" href={getNormUrl(norm.meta.slug)}>
                        {toDisplayText(getNormVersionIdentity(norm, getCurrentVersion(norm)).shortTitle)}
                      </a>
                    </Fragment>
                  ))}
                </span>
              </li>
            ))}
          </ul>
        </section>
      ))}
    </div>
  </section>
  <script>
    const input = document.querySelector<HTMLInputElement>('[data-index-filter]');
    const status = document.querySelector<HTMLElement>('[data-index-filter-status]');
    const entries = Array.from(document.querySelectorAll<HTMLElement>('[data-index-entry]'));
    const groups = Array.from(document.querySelectorAll<HTMLElement>('[data-index-group]'));
    const letters = Array.from(document.querySelectorAll<HTMLElement>('[data-index-letter]'));
    input?.addEventListener('input', () => {
      const query = input.value.trim().toLocaleLowerCase('de-DE');
      let visible = 0;
      entries.forEach((entry) => {
        entry.hidden = Boolean(query) && !(entry.dataset.indexEntry ?? '').includes(query);
        if (!entry.hidden) visible += 1;
      });
      const visibleLetters = new Set<string>();
      groups.forEach((group) => {
        const hasVisibleEntry = Array.from(group.querySelectorAll<HTMLElement>('[data-index-entry]')).some((entry) => !entry.hidden);
        group.hidden = !hasVisibleEntry;
        if (hasVisibleEntry && group.dataset.indexGroup) visibleLetters.add(group.dataset.indexGroup);
      });
      letters.forEach((letter) => {
        const value = letter.dataset.indexLetter ?? '';
        const belongsToNormGroup = document.getElementById(value)?.matches('.section');
        letter.hidden = !belongsToNormGroup && !visibleLetters.has(value);
      });
      if (status) status.textContent = query ? `${visible} Stichwörter passen zum Filter.` : '';
    });
  </script>
</LawLayout>
