---
import LawLayout from '../../../../layouts/LawLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import SectionHero from '../../../../components/portal/SectionHero.astro';
import SectionNavigation from '../../../../components/portal/SectionNavigation.astro';
import NormVersionNavigation from '../../../../components/norms/NormVersionNavigation.astro';
import NormOriginNotice from '../../../../components/norms/NormOriginNotice.astro';
import { formatDate, toDisplayText } from '../../../../lib/norms/presentation.ts';
import {
  buildNormFullCitation,
  buildNormRecordLookup,
  classifyNormVersion,
  getNormCompareUrl,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionUrl,
  getNormOriginInfo,
} from '../../../../lib/norms/index.ts';
import { getCurrentVersion, getVersionById, loadAllNorms } from '../../../../lib/norms/content.ts';

export async function getStaticPaths() {
  const norms = await loadAllNorms();
  const normLookup = buildNormRecordLookup(norms);
  const relatedNormLabels = Object.fromEntries(
    norms.map((entry) => [entry.meta.slug, toDisplayText(entry.meta.title)]),
  );

  return norms.map((norm) => ({
    params: { slug: norm.meta.slug },
    props: {
      norm,
      currentVersion: getCurrentVersion(norm),
      relatedNormLabels,
      origin: getNormOriginInfo(norm, norms),
      fullCitations: Object.fromEntries(
        norm.versions.map((version) => [
          version.versionId,
          buildNormFullCitation(norm, version, normLookup),
        ]),
      ),
    },
  }));
}

const { norm, currentVersion, relatedNormLabels, fullCitations, origin } = Astro.props;
const initialVersion = norm.history.initialVersionId
  ? getVersionById(norm, norm.history.initialVersionId)
  : undefined;
const initialVersionLabel = initialVersion
  ? formatDate(initialVersion.validFrom)
  : norm.history.initialVersionId ?? 'Stammfassung nicht als Volltext gespeichert';
const initialVersionUrl = initialVersion
  ? classifyNormVersion(norm, initialVersion) === 'current'
    ? getNormUrl(norm.meta.slug)
    : getNormVersionUrl(norm.meta.slug, initialVersion.versionId)
  : undefined;
const normTitle = toDisplayText(norm.meta.title);
const normSeoTitle = norm.meta.abbr ? `${normTitle} (${toDisplayText(norm.meta.abbr)})` : normTitle;
const historyDescription = `Historienseite zu ${normTitle} mit Stammfassung, gespeicherten Fassungen und Änderungshinweisen im Rechtsbereich des Freistaates Ostdeutschland.`;
const historyTypeLabels: Record<string, string> = {
  initial: 'Stammfassung',
  amendment: 'Änderung',
  repeal: 'Aufhebung',
  notice: 'Hinweis',
};
const amendmentEntries = norm.history.entries.filter((entry) => entry.type === 'amendment');
const repealEntries = norm.history.entries.filter((entry) => entry.type === 'repeal');
const noticeEntries = norm.history.entries.filter((entry) => entry.type === 'notice');
const predecessorSlug = norm.meta.predecessorSlug;
const successorSlug = norm.meta.successorSlug;
---

<LawLayout
  title={`${normSeoTitle} Historie`}
  description={historyDescription}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
    { label: 'Historie' },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: toDisplayText(norm.meta.shortTitle || norm.meta.title), href: getNormUrl(norm.meta.slug) },
      { label: 'Historie' },
    ]}
  />

  <SectionHero
    eyebrow="Normenhistorie"
    title={toDisplayText(norm.meta.title)}
    titleSize="long"
    lead="Stammfassung, Änderungsbezüge, Fundstellen und alle gespeicherten Fassungen."
    variant="law"
    facts={[
      { label: 'Gespeicherte Fassungen', value: String(norm.versions.length) },
      { label: 'Historieneinträge', value: String(norm.history.entries.length) },
      { label: 'Aktueller Rechtsstand', value: formatDate(currentVersion.validFrom) },
    ]}
    actions={[
      { label: 'Vorschrift öffnen', href: getNormUrl(norm.meta.slug), primary: true },
      ...(norm.versions.length >= 2 ? [{ label: 'Fassungen vergleichen', href: getNormCompareUrl(norm.meta.slug) }] : []),
    ]}
  />
  <NormVersionNavigation norm={norm} currentPage="history" />
  <NormOriginNotice norm={norm} version={currentVersion} origin={origin} />
  <SectionNavigation
    label="Normenhistorie"
    variant="law"
    items={[
      { label: 'Fassungen', href: '#fassungen' },
      { label: 'Historieneinträge', href: '#historieneintraege' },
      { label: 'Stammdaten', href: '#stammdaten' },
    ]}
  />

  <div class="content-grid content-grid--wide">
    <section id="fassungen" class="section">
      <div class="section-header">
        <h2>Fassungen</h2>
      </div>
      <ul class="timeline-list">
        {norm.versions.map((version) => (
          <li>
            <strong>
              {classifyNormVersion(norm, version) === 'current' ? (
                <a class="inline-link" href={getNormUrl(norm.meta.slug)}><time datetime={version.validFrom}>{formatDate(version.validFrom)}</time></a>
              ) : (
                <a class="inline-link" href={getNormVersionUrl(norm.meta.slug, version.versionId)}><time datetime={version.validFrom}>{formatDate(version.validFrom)}</time></a>
              )}
            </strong>
            <span>
              {classifyNormVersion(norm, version) === 'current'
                ? 'Zum redaktionellen Stichtag geltende Fassung'
                : classifyNormVersion(norm, version) === 'future'
                  ? 'Zukünftige Fassung'
                  : classifyNormVersion(norm, version) === 'historical'
                    ? 'Historische Fassung'
                    : 'Inkrafttreten nicht belegt'}
            </span>
            <span>
              Gültig ab <time datetime={version.validFrom}>{formatDate(version.validFrom)}</time>
              {version.validTo
                ? <> bis <time datetime={version.validTo}>{formatDate(version.validTo)}</time></>
                : classifyNormVersion(norm, version) === 'historical'
                  ? '; Gültigkeitsende nicht gespeichert'
                  : '; Gültigkeitsende offen'}
            </span>
            <span>Vollzitat: {toDisplayText(fullCitations[version.versionId])}</span>
            <span>{toDisplayText(version.changeNote)}</span>
          </li>
        ))}
      </ul>
    </section>

    <section id="historieneintraege" class="section">
      <div class="section-header">
        <h2>Historieneinträge</h2>
      </div>
      <h3>Stammfassung</h3>
      <ul class="timeline-list">
        {norm.history.entries.filter((entry) => entry.type === 'initial').map((entry) => (
          <li>
            <strong><time datetime={entry.date}>{formatDate(entry.date)}</time> · {historyTypeLabels[entry.type] ?? entry.type}</strong>
            <span>{toDisplayText(entry.title)}</span>
            <span>Fundstelle: {toDisplayText(entry.citation)}</span>
            {entry.note ? <span>{toDisplayText(entry.note)}</span> : null}
            {entry.affectingVersionId ? (
              <span>
                Fassung:{' '}
                {getVersionById(norm, entry.affectingVersionId) && classifyNormVersion(norm, getVersionById(norm, entry.affectingVersionId)!) === 'current' ? (
                  <a class="inline-link" href={getNormUrl(norm.meta.slug)}>
                    <time datetime={getVersionById(norm, entry.affectingVersionId)!.validFrom}>{formatDate(getVersionById(norm, entry.affectingVersionId)!.validFrom)}</time>
                  </a>
                ) : getVersionById(norm, entry.affectingVersionId) ? (
                  <a class="inline-link" href={getNormVersionUrl(norm.meta.slug, entry.affectingVersionId)}>
                    <time datetime={getVersionById(norm, entry.affectingVersionId)!.validFrom}>{formatDate(getVersionById(norm, entry.affectingVersionId)!.validFrom)}</time>
                  </a>
                ) : (
                  toDisplayText(entry.affectingVersionId)
                )}
              </span>
            ) : null}
            {entry.relatedNorm ? (
              relatedNormLabels[entry.relatedNorm] ? (
                <span>
                  Bezug:{' '}
                  <a class="inline-link" href={getNormUrl(entry.relatedNorm)}>
                    {relatedNormLabels[entry.relatedNorm]}
                  </a>
                </span>
              ) : (
                <span>Bezug: {toDisplayText(entry.relatedNorm)}</span>
              )
            ) : null}
          </li>
        ))}
      </ul>
      <h3>Änderungsvorschriften</h3>
      {amendmentEntries.length > 0 ? (
        <ul class="timeline-list">
          {amendmentEntries.map((entry) => (
            <li>
              <strong><time datetime={entry.date}>{formatDate(entry.date)}</time> · Änderung</strong>
              <span>{toDisplayText(entry.title)}</span>
              <span>Fundstelle: {toDisplayText(entry.citation)}</span>
              {entry.relatedNorm && relatedNormLabels[entry.relatedNorm] ? (
                <span>Änderungsvorschrift: <a class="inline-link" href={getNormUrl(entry.relatedNorm)}>{relatedNormLabels[entry.relatedNorm]}</a></span>
              ) : entry.relatedNorm ? <span>Bezug: {toDisplayText(entry.relatedNorm)}</span> : null}
              {entry.affectingVersionId && getVersionById(norm, entry.affectingVersionId) ? (
                <span>
                  Entstandene Fassung:{' '}
                  <a
                    class="inline-link"
                    href={classifyNormVersion(norm, getVersionById(norm, entry.affectingVersionId)!) === 'current'
                      ? getNormUrl(norm.meta.slug)
                      : getNormVersionUrl(norm.meta.slug, entry.affectingVersionId)}
                  >
                    <time datetime={getVersionById(norm, entry.affectingVersionId)!.validFrom}>{formatDate(getVersionById(norm, entry.affectingVersionId)!.validFrom)}</time>
                  </a>
                </span>
              ) : null}
            </li>
          ))}
        </ul>
      ) : <p>Keine Änderungsvorschrift ist im Datenbestand nachgewiesen.</p>}
      <h3>Aufhebung</h3>
      {repealEntries.length > 0 ? (
        <ul class="timeline-list">
          {repealEntries.map((entry) => (
            <li>
              <strong><time datetime={entry.date}>{formatDate(entry.date)}</time> · Aufhebung</strong>
              <span>{toDisplayText(entry.title)}</span>
              <span>Fundstelle: {toDisplayText(entry.citation)}</span>
            </li>
          ))}
        </ul>
      ) : <p>Keine Aufhebung ist im Datenbestand nachgewiesen.</p>}
      {noticeEntries.length > 0 ? (
        <>
          <h3>Weitere Hinweise</h3>
          <ul class="timeline-list">
            {noticeEntries.map((entry) => (
              <li>
                <strong><time datetime={entry.date}>{formatDate(entry.date)}</time></strong>
                <span>{toDisplayText(entry.title)}</span>
                {entry.note ? <span>{toDisplayText(entry.note)}</span> : null}
              </li>
            ))}
          </ul>
        </>
      ) : null}
    </section>

    <section id="stammdaten" class="section">
      <div class="section-header">
        <h2>Stammdaten</h2>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Stammfassung</dt>
          <dd>
            {initialVersionUrl && initialVersion ? (
              <a class="inline-link" href={initialVersionUrl}><time datetime={initialVersion.validFrom}>{initialVersionLabel}</time></a>
            ) : (
              initialVersionLabel
            )}
          </dd>
        </div>
        <div>
          <dt>Aktueller Rechtsstand</dt>
          <dd><time datetime={currentVersion.validFrom}>{formatDate(currentVersion.validFrom)}</time></dd>
        </div>
        <div>
          <dt>Gespeicherte Fassungen</dt>
          <dd>{norm.versions.length}</dd>
        </div>
        <div>
          <dt>Historieneinträge</dt>
          <dd>{norm.history.entries.length}</dd>
        </div>
        <div>
          <dt>Vorgänger</dt>
          <dd>{predecessorSlug ? <a class="inline-link" href={getNormUrl(predecessorSlug)}>{toDisplayText(norm.meta.predecessor ?? relatedNormLabels[predecessorSlug] ?? predecessorSlug)}</a> : norm.meta.predecessor ? toDisplayText(norm.meta.predecessor) : 'keiner'}</dd>
        </div>
        <div>
          <dt>Nachfolger</dt>
          <dd>{successorSlug ? <a class="inline-link" href={getNormUrl(successorSlug)}>{toDisplayText(norm.meta.successor ?? relatedNormLabels[successorSlug] ?? successorSlug)}</a> : norm.meta.successor ? toDisplayText(norm.meta.successor) : 'keiner'}</dd>
        </div>
      </dl>
    </section>
  </div>
</LawLayout>
