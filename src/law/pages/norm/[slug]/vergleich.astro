---
import LawLayout from '../../../../layouts/LawLayout.astro';
import Breadcrumbs from '../../../../components/Breadcrumbs.astro';
import NormVersionNavigation from '../../../../components/norms/NormVersionNavigation.astro';
import { buildProvisionVersionDiff, type NormProvisionDiff } from '../../../../lib/norms/diff.ts';
import {
  formatDate,
  getLawPortalUrl,
  getNormCompareDataUrl,
  getNormCompareUrl,
  getNormVersionIdentity,
  getNormUrl,
  toDisplayText,
} from '../../../../lib/norms/index.ts';
import { getCurrentVersion, loadAllNorms } from '../../../../lib/norms/content.ts';

export async function getStaticPaths() {
  const norms = await loadAllNorms();
  return norms.filter((norm) => norm.versions.length > 1).map((norm) => {
    const versions = [...norm.versions].sort((left, right) => left.validFrom.localeCompare(right.validFrom));
    const defaultTo = getCurrentVersion(norm);
    const defaultToIndex = versions.findIndex((version) => version.versionId === defaultTo.versionId);
    const defaultFrom = versions[Math.max(0, defaultToIndex - 1)] ?? versions[0];
    return {
      params: { slug: norm.meta.slug },
      props: {
        norm,
        versions,
        defaultFrom,
        defaultTo,
        defaultProvisions: buildProvisionVersionDiff(defaultFrom, defaultTo),
      },
    };
  });
}

const { norm, versions, defaultFrom, defaultTo, defaultProvisions } = Astro.props;
const currentIdentity = getNormVersionIdentity(norm, defaultTo);
const normTitle = toDisplayText(currentIdentity.title);
const normShortTitle = toDisplayText(currentIdentity.shortTitle || currentIdentity.title);
const normSeoTitle = currentIdentity.abbr ? `${normTitle} (${toDisplayText(currentIdentity.abbr)})` : normTitle;
const defaultPairKey = `${defaultFrom.versionId}::${defaultTo.versionId}`;

function renderProvisionSide(provision: NormProvisionDiff, side: 'before' | 'after'): NonNullable<NormProvisionDiff['textDiff']> {
  return (provision.textDiff ?? []).filter((chunk) =>
    chunk.kind === 'same' || (side === 'before' ? chunk.kind === 'delete' : chunk.kind === 'insert'));
}
---

<LawLayout
  title={`${normSeoTitle} vergleichen`}
  description={`Gespeicherte Fassungen von ${normTitle} paragraphenweise vergleichen.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: normShortTitle, href: getNormUrl(norm.meta.slug) },
    { label: 'Fassungsvergleich' },
  ]}
>
  <Breadcrumbs items={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: normShortTitle, href: getNormUrl(norm.meta.slug) },
    { label: 'Fassungsvergleich' },
  ]} />

  <header class="norm-tool-heading">
    <p class="eyebrow">Fassungsvergleich</p>
    <h1>{normShortTitle}</h1>
  </header>
  <NormVersionNavigation norm={norm} currentPage="compare" showPicker={false} />

  <section class="norm-compare" data-version-compare>
    <form class="norm-compare__form" action={getNormCompareUrl(norm.meta.slug)} method="get" data-compare-form aria-label="Zu vergleichende Fassungen">
      <label class="norm-compare__field">
        <span>Ausgangsfassung</span>
        <select name="von" data-compare-from>
          {versions.map((version) => (
            <option value={version.versionId} selected={version.versionId === defaultFrom.versionId} data-diff-prefix={getNormCompareDataUrl(norm.meta.slug, version.versionId, '__TO__')}>
              {formatDate(version.validFrom)} · {toDisplayText(getNormVersionIdentity(norm, version).shortTitle)}
            </option>
          ))}
        </select>
      </label>
      <span class="norm-compare__direction" aria-hidden="true">→</span>
      <label class="norm-compare__field">
        <span>Vergleichsfassung</span>
        <select name="bis" data-compare-to>
          {versions.map((version) => (
            <option value={version.versionId} selected={version.versionId === defaultTo.versionId}>
              {formatDate(version.validFrom)} · {toDisplayText(getNormVersionIdentity(norm, version).shortTitle)}
            </option>
          ))}
        </select>
      </label>
      <button class="button-link norm-compare__submit" type="submit">Anzeigen</button>
    </form>

    <p class="status-line" data-compare-feedback aria-live="polite"></p>

    <section class="norm-diff" data-compare-output data-compare-pair={defaultPairKey} aria-label={`Vergleich ${formatDate(defaultFrom.validFrom)} mit ${formatDate(defaultTo.validFrom)}`}>
      <header class="norm-diff__header">
        <h2><time datetime={defaultFrom.validFrom}>{formatDate(defaultFrom.validFrom)}</time><span aria-hidden="true"> → </span><span class="visually-hidden">verglichen mit </span><time datetime={defaultTo.validFrom}>{formatDate(defaultTo.validFrom)}</time></h2>
        <p>{defaultProvisions.length} geänderte {defaultProvisions.length === 1 ? 'Vorschrift' : 'Vorschriften'}</p>
      </header>
      <ol class="norm-diff__list">
        {defaultProvisions.map((provision) => (
          <li class:list={['norm-diff__provision', `norm-diff__provision--${provision.kind}`]}>
            <span class="norm-diff__status">{provision.kind === 'added' ? 'Neu' : provision.kind === 'removed' ? 'Entfallen' : 'Geändert'}</span>
            <div class="norm-diff__provision-columns">
              {provision.beforeText ? (
                <section class="norm-diff__side norm-diff__side--before">
                  <h3>Fassung vom {formatDate(defaultFrom.validFrom)}</h3>
                  <p>{provision.textDiff ? renderProvisionSide(provision, 'before').map((chunk) => chunk.kind === 'delete' ? <del>{chunk.text}</del> : chunk.text) : <del>{provision.beforeText}</del>}</p>
                </section>
              ) : null}
              {provision.afterText ? (
                <section class="norm-diff__side norm-diff__side--after">
                  <h3>Fassung vom {formatDate(defaultTo.validFrom)}</h3>
                  <p>{provision.textDiff ? renderProvisionSide(provision, 'after').map((chunk) => chunk.kind === 'insert' ? <ins>{chunk.text}</ins> : chunk.text) : <ins>{provision.afterText}</ins>}</p>
                </section>
              ) : null}
            </div>
          </li>
        ))}
      </ol>
      {defaultProvisions.length === 0 ? <p>Zwischen diesen Fassungen wurden keine Textänderungen erkannt.</p> : null}
    </section>
  </section>

  <script>
    type DiffChunk = { kind: 'same' | 'insert' | 'delete'; text: string };
    type ProvisionDiff = { key: string; kind: 'added' | 'removed' | 'changed'; beforeText?: string; afterText?: string; textDiff?: DiffChunk[] };
    type DiffPayload = { fromVersion: { versionId: string; validFrom: string }; toVersion: { versionId: string; validFrom: string }; provisions: ProvisionDiff[] };
    const root = document.querySelector<HTMLElement>('[data-version-compare]');
    const form = root?.querySelector<HTMLFormElement>('[data-compare-form]');
    const fromSelect = root?.querySelector<HTMLSelectElement>('[data-compare-from]');
    const toSelect = root?.querySelector<HTMLSelectElement>('[data-compare-to]');
    const feedback = root?.querySelector<HTMLElement>('[data-compare-feedback]');
    const output = root?.querySelector<HTMLElement>('[data-compare-output]');
    const dateFormatter = new Intl.DateTimeFormat('de-DE', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' });
    const escapeHtml = (value = '') => value.replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;');
    const formatClientDate = (value: string) => {
      const [year, month, day] = value.split('-').map(Number);
      return dateFormatter.format(new Date(Date.UTC(year, month - 1, day)));
    };
    const renderSide = (provision: ProvisionDiff, side: 'before' | 'after') => {
      if (!provision.textDiff) {
        const text = escapeHtml(side === 'before' ? provision.beforeText : provision.afterText);
        return side === 'before' ? `<del>${text}</del>` : `<ins>${text}</ins>`;
      }
      return provision.textDiff.filter((chunk) => chunk.kind === 'same' || (side === 'before' ? chunk.kind === 'delete' : chunk.kind === 'insert')).map((chunk) => {
        const text = escapeHtml(chunk.text);
        return chunk.kind === 'delete' ? `<del>${text}</del>` : chunk.kind === 'insert' ? `<ins>${text}</ins>` : text;
      }).join('');
    };
    const renderProvision = (provision: ProvisionDiff, fromDate: string, toDate: string) => {
      const status = provision.kind === 'added' ? 'Neu' : provision.kind === 'removed' ? 'Entfallen' : 'Geändert';
      const before = provision.beforeText ? `<section class="norm-diff__side norm-diff__side--before"><h3>Fassung vom ${escapeHtml(formatClientDate(fromDate))}</h3><p>${renderSide(provision, 'before')}</p></section>` : '';
      const after = provision.afterText ? `<section class="norm-diff__side norm-diff__side--after"><h3>Fassung vom ${escapeHtml(formatClientDate(toDate))}</h3><p>${renderSide(provision, 'after')}</p></section>` : '';
      return `<li class="norm-diff__provision norm-diff__provision--${provision.kind}"><span class="norm-diff__status">${status}</span><div class="norm-diff__provision-columns">${before}${after}</div></li>`;
    };
    const renderPayload = (payload: DiffPayload) => {
      if (!output) return;
      const count = payload.provisions.length;
      output.dataset.comparePair = `${payload.fromVersion.versionId}::${payload.toVersion.versionId}`;
      output.setAttribute('aria-label', `Vergleich ${formatClientDate(payload.fromVersion.validFrom)} mit ${formatClientDate(payload.toVersion.validFrom)}`);
      output.innerHTML = `<header class="norm-diff__header"><h2><time datetime="${escapeHtml(payload.fromVersion.validFrom)}">${escapeHtml(formatClientDate(payload.fromVersion.validFrom))}</time><span aria-hidden="true"> → </span><span class="visually-hidden">verglichen mit </span><time datetime="${escapeHtml(payload.toVersion.validFrom)}">${escapeHtml(formatClientDate(payload.toVersion.validFrom))}</time></h2><p>${count} geänderte ${count === 1 ? 'Vorschrift' : 'Vorschriften'}</p></header><ol class="norm-diff__list">${payload.provisions.map((provision) => renderProvision(provision, payload.fromVersion.validFrom, payload.toVersion.validFrom)).join('')}</ol>${count === 0 ? '<p>Zwischen diesen Fassungen wurden keine Textänderungen erkannt.</p>' : ''}`;
    };
    const loadPair = async (updateUrl = false) => {
      if (!fromSelect || !toSelect || !output) return;
      if (fromSelect.value === toSelect.value) { if (feedback) feedback.textContent = 'Bitte wählen Sie zwei unterschiedliche Fassungen.'; return; }
      if (feedback) feedback.textContent = 'Vergleich wird geladen.';
      try {
        const pairKey = `${fromSelect.value}::${toSelect.value}`;
        if (output.dataset.comparePair !== pairKey) {
          const prefix = fromSelect.selectedOptions[0]?.dataset.diffPrefix ?? '';
          const response = await fetch(prefix.replace('__TO__', encodeURIComponent(toSelect.value)));
          if (!response.ok) throw new Error(`HTTP ${response.status}`);
          renderPayload(await response.json() as DiffPayload);
        }
        if (feedback) feedback.textContent = '';
        if (updateUrl) {
          const url = new URL(window.location.href);
          url.searchParams.set('von', fromSelect.value);
          url.searchParams.set('bis', toSelect.value);
          window.history.pushState({}, '', url);
        }
      } catch { if (feedback) feedback.textContent = 'Der ausgewählte Vergleich konnte nicht geladen werden.'; }
    };
    const applyUrlSelection = () => {
      if (!fromSelect || !toSelect) return;
      const params = new URLSearchParams(window.location.search);
      const from = params.get('von');
      const to = params.get('bis');
      if (from && Array.from(fromSelect.options).some((option) => option.value === from)) fromSelect.value = from;
      if (to && Array.from(toSelect.options).some((option) => option.value === to)) toSelect.value = to;
    };
    if (form && fromSelect && toSelect) {
      applyUrlSelection(); void loadPair();
      form.addEventListener('submit', (event) => { event.preventDefault(); void loadPair(true); });
      window.addEventListener('popstate', () => { applyUrlSelection(); void loadPair(); });
    }
  </script>
</LawLayout>
