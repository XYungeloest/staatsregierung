---
import LawLayout from '../../../layouts/LawLayout.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import SectionHero from '../../../components/portal/SectionHero.astro';
import {
  formatDate,
  formatPublicationEntryType,
  getLawPortalUrl,
  getPublicationLabel,
  getPublicationSearchAliases,
  getPublicationUrl,
  getPublicationsUrl,
  loadAllVerkuendungen,
  toDisplayText,
} from '../../../lib/norms/index.ts';

const publications = await loadAllVerkuendungen();
const entryCount = publications.reduce((sum, publication) => sum + publication.entries.length, 0);
const years = [...new Set(publications.map((publication) => publication.year))].sort((left, right) => right - left);
const publicationNames = [...new Set(publications.map((publication) => publication.publication))].sort((left, right) => left.localeCompare(right, 'de'));
const entryTypes = [...new Set(publications.flatMap((publication) => publication.entries.map((entry) => entry.type)))].sort();
---

<LawLayout
  title="Verkündungen"
  description="Verkündungsblätter, Ausgaben und Einträge des Rechtsbereichs."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Verkündungen', href: getPublicationsUrl() },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Verkündungen' },
    ]}
  />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Verkündungen"
    lead="Ausgaben der Verkündungsblätter mit Datum, Fundstellen und verknüpften Normfassungen."
    variant="law"
    facts={[
      { label: 'Ausgaben', value: String(publications.length) },
      { label: 'Einträge', value: String(entryCount) },
      { label: 'Jahre', value: String(years.length) },
    ]}
  />

  <div data-law-list-filter>
    <section class="section law-list-filter" aria-labelledby="verkuendungen-filter">
      <div class="section-header section-header--compact">
        <h2 id="verkuendungen-filter">Ausgaben filtern</h2>
      </div>
      <form class="search-form__filters" data-law-filter-form>
        <label class="search-field"><span>Verkündungsblatt</span><select name="publication"><option value="">Alle</option>{publicationNames.map((entry) => <option value={entry}>{entry}</option>)}</select></label>
        <label class="search-field"><span>Jahr</span><select name="year"><option value="">Alle</option>{years.map((entry) => <option value={String(entry)}>{entry}</option>)}</select></label>
        <label class="search-field"><span>Ausgabennummer</span><input name="issue" inputmode="numeric" /></label>
        <label class="search-field"><span>Normtyp</span><select name="type"><option value="">Alle</option>{entryTypes.map((entry) => <option value={entry}>{formatPublicationEntryType(entry)}</option>)}</select></label>
        <label class="search-field"><span>Titel oder Suchbegriff</span><input type="search" name="q" /></label>
        <button class="button-link" type="submit">Filtern</button>
      </form>
      <p class="search-feedback" aria-live="polite" data-law-filter-summary></p>
    </section>

  {years.map((year) => {
    const yearPublications = publications.filter((publication) => publication.year === year);

    return (
      <section class="section">
        <div class="section-header">
          <h2>{year}</h2>
          <p>Ausgaben des Jahres {year} in absteigender Veröffentlichungsfolge.</p>
        </div>
        <ul class="record-list">
          {yearPublications.map((publication) => (
            <li
              class="record-list__item"
              data-law-filter-entry
              data-publication={publication.publication}
              data-year={String(publication.year)}
              data-issue={publication.issue}
              data-type={publication.entries.map((entry) => entry.type).join(' ')}
              data-q={`${publication.title} ${getPublicationSearchAliases(publication).join(' ')} ${publication.entries.map((entry) => entry.title).join(' ')}`}
            >
              <strong>
                <a class="inline-link" href={getPublicationUrl(publication.slug)}>
                  {toDisplayText(publication.title)}
                </a>
              </strong>
              <span>
                {getPublicationLabel(publication)} · <time datetime={publication.date}>{formatDate(publication.date)}</time> · {publication.entries.length}{' '}
                {publication.entries.length === 1 ? 'Eintrag' : 'Einträge'}
              </span>
              <span>
                {publication.entries.slice(0, 3).map((entry, index) => (
                  <Fragment>
                    {index > 0 ? '; ' : ''}
                    {toDisplayText(entry.title)} ({formatPublicationEntryType(entry.type)})
                  </Fragment>
                ))}
                {publication.entries.length > 3 ? ' …' : ''}
              </span>
            </li>
          ))}
        </ul>
      </section>
    );
  })}
  </div>
  <script>
    import "../../../scripts/law-list-filter.ts";
  </script>
</LawLayout>
