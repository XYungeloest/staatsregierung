{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://freistaat-ostdeutschland.de/internal/knowledge/schema.json",
  "title": "Interner Wissenshub des Freistaates Ostdeutschland",
  "description": "Gemeinsames Schema für provenienzbasierte Wissenseinträge. Dateispezifische Zusatzfelder werden durch knowledge:check geprüft.",
  "$defs": {
    "dateOrNull": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "confirmed-primary",
        "confirmed-official",
        "editorially-confirmed",
        "derived",
        "planned",
        "historical",
        "superseded",
        "disputed",
        "unverified",
        "unresolved"
      ]
    },
    "sourceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "locator",
        "role"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^source-[a-z0-9-]+$"
        },
        "locator": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "enum": [
            "primary",
            "corroborating",
            "conflicting",
            "context"
          ]
        }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "validFrom",
        "validTo",
        "asOf",
        "summary",
        "sourceRefs",
        "relatedIds",
        "tags",
        "notes"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "$ref": "#/$defs/status"
        },
        "validFrom": {
          "$ref": "#/$defs/dateOrNull"
        },
        "validTo": {
          "$ref": "#/$defs/dateOrNull"
        },
        "asOf": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "summary": {
          "type": "string"
        },
        "sourceRefs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourceRef"
          }
        },
        "relatedIds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "role": {
      "type": "object",
      "required": [
        "institutionId",
        "officeTitle",
        "validFrom",
        "validTo",
        "appointmentSource",
        "terminationSource",
        "acting",
        "permanent",
        "predecessor",
        "successor",
        "notes"
      ],
      "properties": {
        "institutionId": {
          "type": "string",
          "pattern": "^inst-[a-z0-9-]+$"
        },
        "officeTitle": {
          "type": "string",
          "minLength": 1
        },
        "validFrom": {
          "$ref": "#/$defs/dateOrNull"
        },
        "validTo": {
          "$ref": "#/$defs/dateOrNull"
        },
        "appointmentSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "terminationSource": {
          "anyOf": [
            {
              "$ref": "#/$defs/sourceRef"
            },
            {
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "acting": {
          "type": "boolean"
        },
        "permanent": {
          "type": "boolean"
        },
        "predecessor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "successor": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "type": "object",
  "additionalProperties": true
}
