---
import { portalIcons, type PortalIconName } from '@ostrecht/shared/config/portal-icons.ts';

interface Props {
  name: PortalIconName;
  className?: string;
  label?: string;
}

const { name, className, label } = Astro.props;
const Icon = portalIcons[name];
---

<Icon class:list={['portal-icon', className]} size={24} stroke-width={1.75}
  role={label ? 'img' : undefined} aria-label={label} aria-hidden={label ? undefined : 'true'} focusable="false" />
