---
import ResponsivePicture from '@ostrecht/shared/components/portal/ResponsivePicture.astro';

type Variant =
  | 'government'
  | 'topics'
  | 'law'
  | 'budget'
  | 'reform'
  | 'press'
  | 'service'
  | 'freestate'
  | 'plain';

interface Fact {
  label: string;
  value: string;
  href?: string;
}

interface Action {
  label: string;
  href: string;
  primary?: boolean;
}

interface HeroImage {
  src: string;
  alt: string;
  credit?: string;
  width: number;
  height: number;
  widths: number[];
  sizes?: string;
  kind?: 'landscape' | 'portrait' | 'mark';
  position?: string;
}

interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  variant?: Variant;
  facts?: Fact[];
  actions?: Action[];
  image?: HeroImage;
  titleSize?: 'default' | 'long';
  status?: string;
}

const {
  eyebrow,
  title,
  lead,
  variant = 'plain',
  facts = [],
  actions = [],
  image,
  titleSize = 'default',
  status,
} = Astro.props as Props;
const hasExtra = Astro.slots.has('default');
const primaryActionIndex = actions.findIndex((action) => action.primary);
---

<header
  class:list={[
    'section-hero',
    `section-hero--${variant}`,
    image && 'section-hero--with-media',
    image?.kind === 'portrait' && 'section-hero--profile',
  ]}
>
  <div class="section-hero__inner">
    <div class="section-hero__copy">
      <p class="eyebrow">{eyebrow}</p>
      {status ? <p class="section-hero__status">{status}</p> : null}
      <h1 class:list={[titleSize === 'long' && 'section-hero__title--long']}>{title}</h1>
      {lead ? <p class="lead">{lead}</p> : null}

      {hasExtra ? <div class="section-hero__extra"><slot /></div> : null}

      {facts.length > 0 ? (
        <dl class="section-hero__facts">
          {facts.map((fact) => (
            <div>
              <dt>{fact.label}</dt>
              <dd>{fact.href ? <a href={fact.href}>{fact.value}</a> : fact.value}</dd>
            </div>
          ))}
        </dl>
      ) : null}

      {actions.length > 0 ? (
        <nav class="section-hero__actions" aria-label="Direkteinstiege">
          {actions.map((action, index) => (
            <a
              class:list={[
                'button-link',
                !action.primary && index !== primaryActionIndex && 'button-link--secondary',
              ]}
              href={action.href}
            >
              {action.label}
            </a>
          ))}
        </nav>
      ) : null}

    </div>

    {image ? (
      <figure class:list={['section-hero__media', `section-hero__media--${image.kind ?? 'landscape'}`]} style={`--hero-image-position: ${image.position ?? 'center'};`}>
        <ResponsivePicture
          className="section-hero__image"
          src={image.src}
          alt={image.alt}
          width={image.width}
          height={image.height}
          widths={image.widths}
          sizes={image.sizes ?? '(max-width: 760px) calc(100vw - 2rem), 34vw'}
          loading="eager"
          fetchpriority="high"
        />
        {image.credit ? <figcaption class="section-hero__credit">Bildnachweis: {image.credit}</figcaption> : null}
      </figure>
    ) : null}
  </div>
</header>
