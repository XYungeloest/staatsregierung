---
import { activeSiteConfig } from '@ostrecht/shared/config/site.ts';
import {
  buildBreadcrumbJsonLd,
  buildCanonicalUrl,
  buildPageTitle,
  type SeoBreadcrumbItem,
  type SeoImage,
  type StructuredData,
  toAbsoluteUrl,
} from '@ostrecht/shared/lib/seo/index.ts';

interface Props {
  title: string;
  description?: string;
  breadcrumbs?: SeoBreadcrumbItem[];
  structuredData?: StructuredData | StructuredData[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: SeoImage;
}

const {
  title,
  description = activeSiteConfig.seo.defaultDescription,
  breadcrumbs = [],
  structuredData,
  noindex = false,
  ogType = 'website',
  ogImage = activeSiteConfig.seo.defaultSocialImage,
} = Astro.props;

const pageTitle = buildPageTitle(title);
const canonicalUrl = buildCanonicalUrl(Astro.url, Astro.site);
const breadcrumbJsonLd = buildBreadcrumbJsonLd(breadcrumbs, Astro.url.pathname, Astro.site);
const structuredDataItems = [
  ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
  ...(breadcrumbJsonLd ? [breadcrumbJsonLd] : []),
];
const ogImageUrl = ogImage ? toAbsoluteUrl(ogImage.url, Astro.site) : undefined;
---

<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<meta name="build-commit" content={import.meta.env.PORTAL_BUILD_COMMIT} />
<meta name="description" content={description} />
<meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow'} />
<link rel="canonical" href={canonicalUrl} />
<meta property="og:locale" content={activeSiteConfig.seo.locale} />
<meta property="og:site_name" content={activeSiteConfig.seo.siteName} />
<meta property="og:type" content={ogType} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalUrl} />
<meta name="twitter:card" content={ogImageUrl ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{ogImageUrl ? (
  <>
    <meta property="og:image" content={ogImageUrl} />
    <meta name="twitter:image" content={ogImageUrl} />
    {ogImage?.width ? <meta property="og:image:width" content={String(ogImage.width)} /> : null}
    {ogImage?.height ? <meta property="og:image:height" content={String(ogImage.height)} /> : null}
    {ogImage?.type ? <meta property="og:image:type" content={ogImage.type} /> : null}
    {ogImage?.alt ? (
      <>
        <meta property="og:image:alt" content={ogImage.alt} />
        <meta name="twitter:image:alt" content={ogImage.alt} />
      </>
    ) : null}
  </>
) : null}
<link rel="icon" type="image/svg+xml" sizes="any" href={`${import.meta.env.BASE_URL}favicon.svg`} />
<link rel="alternate icon" type="image/x-icon" href={`${import.meta.env.BASE_URL}favicon.ico`} />
<title>{pageTitle}</title>
{structuredDataItems.map((entry) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(entry)} />
))}
