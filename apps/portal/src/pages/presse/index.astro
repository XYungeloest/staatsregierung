---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import EventCard from '../../components/portal/EventCard.astro';
import PressReleaseCard from '../../components/portal/PressReleaseCard.astro';
import SpeechCard from '../../components/portal/SpeechCard.astro';
import PressNavigation from '../../components/portal/PressNavigation.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import ServiceCard from '../../components/portal/ServiceCard.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { splitEventsByDate } from '@ostrecht/shared/lib/portal/dates.ts';
import { loadEvents, loadPressReleases, loadSpeeches } from '@ostrecht/shared/lib/portal/content.ts';
import {
  getContactUrl,
  getEventIndexUrl,
  getHomeUrl,
  getPressReleaseIndexUrl,
  getPressReleaseUrl,
  getSpeechIndexUrl,
} from '@ostrecht/shared/lib/portal/index.ts';

const [releases, events, speeches] = await Promise.all([
  loadPressReleases(),
  loadEvents(),
  loadSpeeches(),
]);
const leadRelease = releases[0];
const additionalReleases = releases.slice(1, 4);
const latestSpeech = speeches[0];
const { upcoming: nextEvents } = splitEventsByDate(events);
const calendarUrl = `${getEventIndexUrl()}kalender.ics`;
const rssUrl = `${getPressReleaseIndexUrl().replace(/pressemitteilungen\/$/u, '')}rss.xml`;
---

<BaseLayout
  title="Presse & Aktuelles"
  description="Pressemitteilungen, Reden, Termine und Pressekontakt des Staatsrates des Ostdeutschen Freistaates."
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Presse & Aktuelles' }]} />

  <SectionHero
    eyebrow="Presse & Aktuelles"
    title="Presse & Aktuelles"
    lead="Pressemitteilungen, Reden, öffentliche Termine und Medienkontakt des Staatsrates."
    variant="press"
    facts={[
      { label: 'Pressemitteilungen', value: String(releases.length) },
      { label: 'Künftige Termine', value: String(nextEvents.length) },
      { label: 'Reden', value: String(speeches.length) },
    ]}
    actions={leadRelease ? [{ label: 'Neueste Pressemitteilung', href: getPressReleaseUrl(leadRelease.slug), primary: true }] : []}
  />
  <PressNavigation />

  {leadRelease ? (
    <section class="section">
      <div class="section-header">
        <h2>Neueste Mitteilung</h2>
        <p>Die zuletzt veröffentlichte Mitteilung des Staatsrates.</p>
      </div>
      <PressReleaseCard release={leadRelease} variant="featured" />
    </section>
  ) : null}

  {additionalReleases.length > 0 ? (
    <section class="section" data-visual-section="press-additional-releases">
      <div class="section-header">
        <h2>Weitere Meldungen</h2>
        <p>Weitere aktuelle Mitteilungen des Staatsrates.</p>
      </div>
      <div class="content-stack">
        {additionalReleases.map((release) => <PressReleaseCard release={release} variant="compact" />)}
      </div>
      <p class="section-link-row"><a class="inline-link" href={getPressReleaseIndexUrl()}>Alle Pressemitteilungen</a></p>
    </section>
  ) : null}

  <section class="section section-muted" aria-labelledby="presse-service" data-visual-section="press-contact">
    <div class="section-header">
      <h2 id="presse-service">Kontakt und Abonnements</h2>
    </div>
    <div class="press-service-grid">
      <aside class="press-contact-module">
        <h3>{siteConfig.contact.pressOffice.label}</h3>
        <p>Kontaktstelle für Medienanfragen zur Arbeit des Staatsrates.</p>
        <p><a class="inline-link" href={`mailto:${siteConfig.contact.pressOffice.email}`}>{siteConfig.contact.pressOffice.email}</a><br /><a class="inline-link" href={`tel:${siteConfig.contact.pressOffice.phone.replace(/\s+/gu, '')}`}>{siteConfig.contact.pressOffice.phone}</a></p>
        <p><a class="inline-link" href={getContactUrl()}>Weitere Kontaktwege</a></p>
      </aside>
      <div class="service-entry-grid">
        <ServiceCard title="RSS-Feed" body="Neue Pressemitteilungen im Feed abonnieren." href={rssUrl} icon="press" />
        <ServiceCard title="Terminkalender" body="Öffentliche Termine als Kalender abonnieren." href={calendarUrl} icon="topics" />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Bereiche für Medien und Öffentlichkeit</h2>
      <p>Alle Inhalte bleiben dauerhaft nach Veröffentlichungsart und Datum erreichbar.</p>
    </div>
    <ul class="direct-entry-list">
      <li><strong>Pressemitteilungen</strong><span><a class="inline-link" href={getPressReleaseIndexUrl()}>Alle Meldungen nach Datum und Ressort</a></span></li>
      <li><strong>Reden & Erklärungen</strong><span><a class="inline-link" href={getSpeechIndexUrl()}>Redetexte und Erklärungen des Staatsrates</a></span></li>
      <li><strong>Termine & Archiv</strong><span><a class="inline-link" href={getEventIndexUrl()}>Künftige und vergangene Veranstaltungen</a></span></li>
    </ul>
  </section>

  <section class="section section-muted" data-visual-section="press-dates">
    <div class="content-grid">
      <section class="section">
        <div class="section-header"><h2>Neueste Rede</h2></div>
        {latestSpeech ? <SpeechCard speech={latestSpeech} /> : <p class="search-feedback">Noch keine Reden im Bestand.</p>}
      </section>
      <aside class="section meta-panel">
        <div class="section-header section-header--compact"><h2>Nächste Termine</h2></div>
        {nextEvents.length > 0 ? (
          <div class="content-stack">
            {nextEvents.slice(0, 3).map((event) => <EventCard event={event} variant="compact" />)}
          </div>
        ) : <p class="search-feedback">Derzeit sind keine zukünftigen Termine angekündigt.</p>}
      </aside>
    </div>
  </section>
</BaseLayout>
