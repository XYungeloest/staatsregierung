---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import { legacyRouteHelpLinks } from '../config/legacy-routes.mjs';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getHomeUrl, getPortalSearchUrl, resolvePortalPath } from '@ostrecht/shared/lib/portal/index.ts';

const sections = siteConfig.sections.filter((section) => section.key !== 'home');
---

<BaseLayout
  title="Seite nicht gefunden"
  description="Die angeforderte Seite wurde im Staatsportal nicht gefunden."
  breadcrumbs={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Seite nicht gefunden' }]}
  noindex={true}
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Seite nicht gefunden' }]} />

  <section class="section page-header error-page">
    <p class="eyebrow">Fehler 404</p>
    <h1>Seite nicht gefunden</h1>
    <p class="lead">
      Die angeforderte Adresse ist nicht vorhanden oder wurde verschoben. Suchen Sie hier direkt
      oder wählen Sie einen Bereich des Staatsportals.
    </p>
    <form class="filter-bar" method="get" action={getPortalSearchUrl()} role="search">
      <div class="filter-bar__fields">
        <label class="filter-field filter-field--wide" for="error-search">
          <span>{siteConfig.searchLabel}</span>
          <input
            id="error-search"
            type="search"
            name="q"
            autocomplete="off"
            placeholder={siteConfig.searchPlaceholder}
          />
        </label>
      </div>
      <div class="filter-bar__actions">
        <button class="button-link" type="submit">Suchen</button>
        <a class="button-link button-link--secondary" href={getHomeUrl()}>Zur Startseite</a>
      </div>
    </form>
  </section>

  <section class="section section-muted error-page" aria-labelledby="error-sections-title">
    <div class="section-header section-header--compact">
      <p class="eyebrow">Bereiche</p>
      <h2 id="error-sections-title">Bereiche des Staatsportals</h2>
      <p>Jeder Bereich führt auf seinen Einstieg mit allen zugehörigen Seiten.</p>
    </div>
    <ul class="record-list">
      {sections.map((section) => (
        <li class="record-list__item">
          <strong><a class="inline-link" href={section.path}>{section.label}</a></strong>
          <span>{section.description}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="section error-page" aria-labelledby="former-addresses-title">
    <div class="section-header section-header--compact">
      <p class="eyebrow">Geänderte Adressen</p>
      <h2 id="former-addresses-title">Frühere Portaladressen</h2>
      <p>Einige frühere Adressen führen heute in neu geordnete Bereiche.</p>
    </div>
    <ul class="record-list">
      {legacyRouteHelpLinks.map((route) => (
        <li class="record-list__item">
          <a class="inline-link" href={resolvePortalPath(route.target)}>{route.label}</a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>
