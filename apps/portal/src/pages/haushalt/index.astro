---
/**
 * Einstieg des Haushaltsbereichs (/haushalt/), periodenübergreifend.
 *
 * Zeigt alle im Build sichtbaren Haushaltsperioden (lib/haushalt/perioden.ts) mit
 * Statuskennzeichnung, die Eckwerte aller sichtbaren Haushaltsjahre mit Jahreswahl und
 * Vergleichen, die Schwerpunkte jeder Periode und die Wege in alle Bereiche. Nicht freigegebene
 * Perioden erscheinen nur im Vorschau-Build; die Seite trägt dann `noindex` und den
 * Vorschauhinweis. Alle Beträge stammen aus dem Haushaltsbestand der jeweiligen Periode; hier
 * entstehen nur Anteile, Veränderungen und die definierten Sammelgrößen aus kennzahlen.ts.
 * Periodenvergleiche bleiben auf Gesamt- und Hauptgruppenebene.
 */
import HaushaltLayout from '../../layouts/HaushaltLayout.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import Amount from '../../components/haushalt/Amount.astro';
import BarChart from '../../components/haushalt/BarChart.astro';
import DataTableFrame from '../../components/haushalt/DataTableFrame.astro';
import DefinitionNote from '../../components/haushalt/DefinitionNote.astro';
import EntryCards from '../../components/haushalt/EntryCards.astro';
import GroupedBarChart from '../../components/haushalt/GroupedBarChart.astro';
import KpiGrid from '../../components/haushalt/KpiGrid.astro';
import SourceNote from '../../components/haushalt/SourceNote.astro';
import StatusBadge from '../../components/haushalt/StatusBadge.astro';
import { formatShare, type StatusTone } from '../../components/haushalt/format.ts';
import {
  formatPeriodenjahre,
  getMassgeblichePeriode,
  getPeriodeStatusInfo,
  getRedaktionellerStichtag,
  getVisiblePeriods,
  isPeriodePublic,
  isPreviewOnly,
  type Haushaltsperiode,
} from '../../lib/haushalt/perioden.ts';
import { loadEinzelplaene, loadGesamtplan, loadImportManifest, loadPeriodMeta, loadProjekte } from '../../lib/haushalt/snapshot.ts';
import {
  AUSGABE_HAUPTGRUPPEN,
  DEFINITION_INVESTITIONEN,
  EINNAHME_HAUPTGRUPPEN,
  HAUPTGRUPPEN,
  getAnteil,
  getInvestitionen,
  getJahre,
  getKennzahlen,
  getPeriodenvergleich,
  getVeraenderung,
  legacyAmountsToHauptgruppen,
  type Kennzahl,
  type Kennzahlenblock,
} from '../../lib/haushalt/kennzahlen.ts';
import { PROJEKT_STATUS_LABELS, hasProjektseite, loadProjektOverlays } from '../../lib/haushalt/oeffentlich.ts';
import {
  budgetPlans,
  budgetTotals,
  getBudgetTaskAreas,
  type BudgetYear,
} from '../../lib/haushalt/legacy-2025-2026.ts';
import type { Gesamtplan, Hauptgruppen, HauptgruppenSchluessel } from '../../lib/haushalt/types.ts';
import { formatEuroCompact } from '@ostrecht/shared/lib/portal/modules.ts';
import { getNormUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import {
  getBudgetPageUrl,
  getBudgetPeriodPageUrl,
  getBudgetPeriodUrl,
  getBudgetProjectUrl,
  getBudgetSearchUrl,
  getBudgetUrl,
  getHomeUrl,
  getPortalSearchUrl,
} from '@ostrecht/shared/lib/portal/routes.ts';
import { buildDatasetJsonLd } from '@ostrecht/shared/lib/seo/index.ts';
import { getHaushaltNavItems, getPeriodenKurzname } from '../../lib/haushalt/seite.ts';

interface Weg {
  label: string;
  href: string;
}

interface JahrDaten {
  jahr: string;
  einnahmen: number;
  ausgaben: number;
  hauptgruppen: Hauptgruppen;
  /** Kennzahlen des Gesamtplans (nur Perioden mit vollständigem Gesamtplan). */
  block?: Kennzahlenblock;
}

interface PeriodenDaten {
  periode: Haushaltsperiode;
  kurzname: string;
  statusLabel: string;
  statusTone: StatusTone;
  statusText: string;
  nachtrag?: { label: string; text: string; tone: StatusTone };
  preview: boolean;
  jahre: JahrDaten[];
  bezugsjahr: string;
  einzelplaene: number;
  datenstand?: string;
  datenversion?: string;
  quelle: string;
  wege: Weg[];
  gesamtplan?: Gesamtplan;
}

const stichtag = getRedaktionellerStichtag();
const stichtagJahr = Number(stichtag.slice(0, 4));

/** Bezugsjahr einer Periode: das Jahr des Stichtags, sonst das nächstliegende Haushaltsjahr. */
function bezugsjahr(periode: Haushaltsperiode): string {
  const jahre = [...periode.jahre].sort();
  if (jahre.includes(stichtagJahr)) return String(stichtagJahr);
  return String(stichtagJahr < jahre[0] ? jahre[0] : jahre[jahre.length - 1]);
}

function pruefeJahre(periode: Haushaltsperiode, jahre: string[]): void {
  const erwartet = periode.jahre.map(String).sort().join(',');
  if (jahre.join(',') !== erwartet) {
    throw new Error(`Haushaltseinstieg: Jahre der Periode ${periode.id} (${erwartet}) passen nicht zu den Haushaltsdaten (${jahre.join(',')}).`);
  }
}

function legacyDaten(periode: Haushaltsperiode): PeriodenDaten {
  const jahre = (Object.keys(budgetTotals) as BudgetYear[]).sort();
  pruefeJahre(periode, jahre);
  const status = getPeriodeStatusInfo(periode);
  const start = getBudgetPeriodUrl(periode.id);
  return {
    periode,
    kurzname: getPeriodenKurzname(periode),
    statusLabel: status.label,
    statusTone: status.tone,
    statusText: status.text,
    nachtrag: status.nachtrag,
    preview: isPreviewOnly(periode),
    jahre: jahre.map((jahr) => ({
      jahr,
      einnahmen: budgetTotals[jahr].revenue,
      ausgaben: budgetTotals[jahr].expenses,
      hauptgruppen: legacyAmountsToHauptgruppen(budgetTotals[jahr]),
    })),
    bezugsjahr: bezugsjahr(periode),
    einzelplaene: budgetPlans.length,
    datenstand: periode.freigabe.datum ?? undefined,
    quelle: periode.freigabe.grundlage ?? periode.bezeichnung,
    wege: [
      { label: 'Überblick', href: start },
      { label: 'Gesamtplan', href: getBudgetPeriodPageUrl(periode.id, 'gesamtplan') },
      { label: 'Einzelpläne', href: getBudgetPeriodPageUrl(periode.id, 'einzelplaene') },
      { label: 'Haushaltsdaten als CSV', href: `${start}daten.csv` },
      ...(periode.rechtsgrundlage ? [{ label: periode.freigabe.grundlage ?? 'Haushaltsgesetz', href: getNormUrl(periode.rechtsgrundlage.normSlug) }] : []),
    ],
  };
}

function snapshotDaten(periode: Haushaltsperiode): PeriodenDaten {
  const gesamtplan = loadGesamtplan(periode.id);
  const meta = loadPeriodMeta(periode.id);
  const manifest = loadImportManifest(periode.id);
  const jahre = getJahre(gesamtplan);
  pruefeJahre(periode, jahre);
  const status = getPeriodeStatusInfo(periode);
  const seite = (slug: string) => getBudgetPeriodPageUrl(periode.id, slug);
  return {
    periode,
    kurzname: getPeriodenKurzname(periode),
    statusLabel: status.label,
    statusTone: status.tone,
    statusText: status.text,
    nachtrag: status.nachtrag,
    preview: isPreviewOnly(periode),
    jahre: jahre.map((jahr) => {
      const daten = gesamtplan.jahre[jahr as `${number}`];
      return { jahr, einnahmen: daten.einnahmen, ausgaben: daten.ausgaben, hauptgruppen: daten.hauptgruppen, block: getKennzahlen(gesamtplan, jahr) };
    }),
    bezugsjahr: bezugsjahr(periode),
    einzelplaene: loadEinzelplaene(periode.id).length,
    datenstand: meta.stand,
    datenversion: manifest.quelle.commit_kurz,
    quelle: `${periode.bezeichnung} (${status.label})`,
    wege: [
      { label: 'Überblick', href: getBudgetPeriodUrl(periode.id) },
      { label: 'Gesamtplan', href: seite('gesamtplan') },
      { label: 'Einzelpläne', href: seite('einzelplaene') },
      { label: 'Vorhaben und Projekte', href: seite('projekte') },
      { label: 'Personal', href: seite('personal') },
      { label: 'Finanzierung', href: seite('finanzierung') },
      { label: 'Rücklagen, Fonds und Landesunternehmen', href: seite('ruecklagen') },
      { label: 'Finanzplanung', href: seite('finanzplanung') },
      { label: 'Downloads', href: seite('downloads') },
      { label: 'Haushaltssuche', href: getBudgetSearchUrl(periode.id) },
    ],
    gesamtplan,
  };
}

const sichtbar = getVisiblePeriods();
const perioden: PeriodenDaten[] = sichtbar.map((periode) =>
  periode.datenquelle === 'legacy-2025-2026' ? legacyDaten(periode) : snapshotDaten(periode),
);
const chronologisch = [...perioden].sort((left, right) => left.periode.jahre[0] - right.periode.jahre[0]);
const legacy = perioden.find((entry) => entry.periode.datenquelle === 'legacy-2025-2026');
const snapshotPerioden = perioden.filter((entry) => entry.gesamtplan);

// Statuskopf: die maßgebliche Periode, sonst die neueste öffentliche, sonst die neueste sichtbare.
const massgeblich = getMassgeblichePeriode();
const kopf =
  perioden.find((entry) => entry.periode.id === massgeblich?.id) ??
  perioden.find((entry) => isPeriodePublic(entry.periode)) ??
  perioden[0];
if (!kopf) throw new Error('Haushaltseinstieg: Es ist keine Haushaltsperiode sichtbar.');
const vorschau = perioden.some((entry) => entry.preview);

const alleJahre = chronologisch.flatMap((entry) => entry.jahre.map((jahr) => ({ ...jahr, daten: entry })));
const startAnsicht = kopf.bezugsjahr;

function eckwerte(jahr: JahrDaten) {
  const investitionen = getInvestitionen(jahr.hauptgruppen);
  return {
    einnahmen: jahr.einnahmen,
    ausgaben: jahr.ausgaben,
    steuern: jahr.hauptgruppen['0'],
    personal: jahr.hauptgruppen['4'],
    investitionen: investitionen.betrag,
    bestandteile: investitionen.bestandteile ?? [],
    zuweisungen: jahr.hauptgruppen['6'],
  };
}

const anteilText = (teil: number, ganzes: number, bezug: string) => {
  const anteil = getAnteil(teil, ganzes);
  return anteil === null ? undefined : `${formatShare(anteil)} ${bezug}`;
};

function kennzahlKarten(jahr: JahrDaten, vorjahr: JahrDaten | undefined) {
  const werte = eckwerte(jahr);
  const vorher = vorjahr ? eckwerte(vorjahr) : undefined;
  const veraenderung = (feld: keyof Omit<ReturnType<typeof eckwerte>, 'bestandteile'>) =>
    vorher && vorjahr ? { value: getVeraenderung(vorher[feld], werte[feld]).absolut, label: `gegenüber ${vorjahr.jahr}` } : undefined;
  return [
    { label: `Ausgaben ${jahr.jahr}`, value: werte.ausgaben, change: veraenderung('ausgaben') },
    { label: `Einnahmen ${jahr.jahr}`, value: werte.einnahmen, change: veraenderung('einnahmen') },
    { label: 'Steuern und steuerähnliche Abgaben', value: werte.steuern, hint: anteilText(werte.steuern, werte.einnahmen, 'der Einnahmen'), change: veraenderung('steuern') },
    { label: 'Personalausgaben', value: werte.personal, hint: anteilText(werte.personal, werte.ausgaben, 'der Ausgaben'), change: veraenderung('personal') },
    { label: 'Investitionen', value: werte.investitionen, hint: anteilText(werte.investitionen, werte.ausgaben, 'der Ausgaben'), change: veraenderung('investitionen') },
    { label: 'Zuweisungen und Zuschüsse', value: werte.zuweisungen, hint: anteilText(werte.zuweisungen, werte.ausgaben, 'der Ausgaben'), change: veraenderung('zuweisungen') },
  ];
}

function hauptgruppenBalken(jahr: JahrDaten, schluessel: readonly HauptgruppenSchluessel[]) {
  return schluessel.map((hg) => ({ label: HAUPTGRUPPEN[hg].kurz, value: jahr.hauptgruppen[hg], note: `Hauptgruppe ${hg}` }));
}

/** Finanzierungskennzahlen des Gesamtplans (ohne leere Angaben). */
function finanzierungsKennzahlen(block: Kennzahlenblock): Kennzahl[] {
  return [
    block.ruecklagenentnahme,
    block.kreditaufnahmeBrutto,
    block.nettotilgung,
    block.zinsen,
    block.zufuehrungLiquiditaetsruecklage,
    block.strukturelleNettokreditaufnahme,
  ].filter((kennzahl): kennzahl is Kennzahl => kennzahl !== null);
}

const VERGLEICH_FELDER = [
  ['einnahmen', 'Einnahmen'],
  ['ausgaben', 'Ausgaben'],
  ['steuern', 'Steuern und steuerähnliche Abgaben'],
  ['personal', 'Personalausgaben'],
  ['investitionen', 'Investitionen'],
  ['zuweisungen', 'Zuweisungen und Zuschüsse'],
] as const;

interface Ansicht {
  id: string;
  label: string;
  versteckt?: string;
  meldung: string;
}

interface AnsichtsGruppe {
  id: string;
  label: string;
  ansichten: Ansicht[];
}

const vergleichId = (entry: PeriodenDaten) => `vergleich-${entry.periode.id}`;
const periodenvergleiche = legacy
  ? snapshotPerioden.map((neu) => ({
      id: `periodenvergleich-${legacy.periode.id}-${neu.periode.id}`,
      alt: legacy,
      neu,
      vergleich: getPeriodenvergleich(budgetTotals, neu.gesamtplan!),
    }))
  : [];

const ansichtsGruppen: AnsichtsGruppe[] = [
  ...chronologisch.map((entry) => ({
    id: `jahreswahl-${entry.periode.id}`,
    label: entry.kurzname,
    ansichten: [
      ...entry.jahre.map((jahr) => ({
        id: jahr.jahr,
        label: jahr.jahr,
        meldung: `Angezeigt: Haushaltsjahr ${jahr.jahr} (${entry.kurzname}, ${entry.statusLabel}).`,
      })),
      ...(entry.jahre.length >= 2
        ? [{
            id: vergleichId(entry),
            label: 'Vergleich',
            versteckt: ` ${entry.jahre.map((jahr) => jahr.jahr).join(' und ')}`,
            meldung: `Angezeigt: Vergleich der Haushaltsjahre ${entry.jahre.map((jahr) => jahr.jahr).join(' und ')}.`,
          }]
        : []),
    ],
  })),
  ...(periodenvergleiche.length > 0
    ? [{
        id: 'jahreswahl-perioden',
        label: 'Perioden',
        ansichten: periodenvergleiche.map((entry) => ({
          id: entry.id,
          label: periodenvergleiche.length > 1 ? `${formatPeriodenjahre(entry.alt.periode)} und ${formatPeriodenjahre(entry.neu.periode)}` : 'Periodenvergleich',
          versteckt: periodenvergleiche.length > 1 ? ' im Periodenvergleich' : ` ${formatPeriodenjahre(entry.alt.periode)} und ${formatPeriodenjahre(entry.neu.periode)}`,
          meldung: `Angezeigt: Vergleich der Perioden ${formatPeriodenjahre(entry.alt.periode)} und ${formatPeriodenjahre(entry.neu.periode)} nach Hauptgruppen.`,
        })),
      }]
    : []),
];

// Schwerpunkte: Aufgabenbereiche der Periode 2025/2026, Vorhaben der Snapshot-Perioden.
const aufgabenbereiche = legacy ? getBudgetTaskAreas() : [];

function groessteVorhaben(entry: PeriodenDaten) {
  const overlays = loadProjektOverlays(entry.periode.id);
  const [erstesJahr] = entry.jahre.map((jahr) => jahr.jahr);
  return loadProjekte(entry.periode.id)
    .map((projekt) => ({ projekt, overlay: overlays[projekt.id] }))
    .filter(({ projekt, overlay }) =>
      overlay &&
      hasProjektseite(projekt, overlay) &&
      !overlay.ohneSumme &&
      overlay.status !== 'optional' &&
      overlay.status !== 'nicht-finanziert' &&
      (projekt.jahre[erstesJahr as `${number}`]?.kernhaushalt ?? 0) > 0,
    )
    .sort((left, right) =>
      (right.projekt.jahre[erstesJahr as `${number}`]?.kernhaushalt ?? 0) - (left.projekt.jahre[erstesJahr as `${number}`]?.kernhaushalt ?? 0) ||
      left.overlay!.titel.localeCompare(right.overlay!.titel, 'de'),
    )
    .slice(0, 6)
    .map(({ projekt, overlay }) => ({
      label: overlay!.titel,
      href: getBudgetProjectUrl(entry.periode.id, overlay!.slug),
      note: [PROJEKT_STATUS_LABELS[overlay!.status], overlay!.betragshinweis].filter(Boolean).join(' · '),
      values: entry.jahre.map((jahr) => projekt.jahre[jahr.jahr as `${number}`]?.kernhaushalt ?? null),
    }));
}

const vorhabenJePeriode = snapshotPerioden.map((entry) => ({ entry, vorhaben: groessteVorhaben(entry) }));

const weitereWege = [
  {
    title: 'Sondervermögen und Fonds',
    text: 'Zweck, Rechtsgrundlage, Zuständigkeit und Bezug zum Kernhaushalt.',
    href: getBudgetPageUrl('sondervermoegen'),
  },
  ...perioden.map((entry) => entry.gesamtplan
    ? { title: `Downloads ${formatPeriodenjahre(entry.periode)}`, text: `Haushaltsdaten des ${entry.statusLabel === 'Regierungsentwurf' ? 'Regierungsentwurfs' : 'Haushalts'} als Tabellen.`, href: getBudgetPeriodPageUrl(entry.periode.id, 'downloads'), meta: entry.statusLabel }
    : { title: `Haushaltsdaten ${formatPeriodenjahre(entry.periode)}`, text: 'Einzelpläne mit Einnahmen, Ausgaben und Ausgabearten als CSV-Datei.', href: `${getBudgetPeriodUrl(entry.periode.id)}daten.csv`, meta: entry.statusLabel }),
  ...snapshotPerioden.map((entry) => ({
    title: `Haushaltssuche ${formatPeriodenjahre(entry.periode)}`,
    text: 'Einzelpläne, Kapitel, Titel und Vorhaben nach Begriffen und Nummern durchsuchen.',
    href: getBudgetSearchUrl(entry.periode.id),
    meta: entry.statusLabel,
  })),
  {
    title: 'Suche im Portal',
    text: 'Haushaltsseiten, Ressorts, Themen und Rechtsvorschriften durchsuchen.',
    href: `${getPortalSearchUrl()}?q=${encodeURIComponent('Haushalt')}`,
  },
];

const heroFacts = [
  ...perioden.map((entry) => {
    const jahr = entry.jahre.find((item) => item.jahr === entry.bezugsjahr) ?? entry.jahre[0];
    const zusatz = entry.statusTone === 'geltend' ? '' : ` (${entry.statusLabel})`;
    return { label: `Ausgaben ${jahr.jahr}${zusatz}`, value: formatEuroCompact(jahr.ausgaben) };
  }),
  { label: 'Einzelpläne', value: String(kopf.einzelplaene) },
];

const navItems = getHaushaltNavItems('ueberblick');
const weiterePerioden = perioden
  .filter((entry) => entry !== kopf)
  .map((entry) => ({ label: entry.kurzname, href: getBudgetPeriodUrl(entry.periode.id) }));

const lead = perioden.length > 1
  ? `Einnahmen, Ausgaben und Finanzierung des Ostdeutschen Freistaates: ${chronologisch.map((entry) => `${entry.periode.bezeichnung} (${entry.statusLabel})`).join(' und ')}.`
  : `Einnahmen, Ausgaben und Finanzierung des Ostdeutschen Freistaates im ${kopf.periode.bezeichnung}.`;
const strukturHinweis = periodenvergleiche[0]?.vergleich.hinweis;
---

<HaushaltLayout
  title="Haushalt"
  description="Der Haushalt des Ostdeutschen Freistaates: Haushaltsperioden mit Status, Eckwerte je Haushaltsjahr, Einnahmen, Ausgaben, Finanzierung und Schwerpunkte."
  breadcrumbs={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Haushalt' }]}
  structuredData={legacy
    ? buildDatasetJsonLd({
        name: 'Haushalt des Ostdeutschen Freistaates',
        description: 'Einnahmen, Ausgaben, Investitionen und Einzelpläne der Haushaltsperioden des Ostdeutschen Freistaates.',
        url: getBudgetUrl(),
        distributionUrl: '/haushalt/daten.csv',
      }, Astro.site)
    : undefined}
  periodLabel={kopf.periode.bezeichnung}
  statusLabel={kopf.statusLabel}
  statusTone={kopf.statusTone}
  statusText={kopf.statusText}
  datenstand={kopf.datenstand}
  datenversion={kopf.datenversion}
  preview={vorschau}
  previewText="Vorschau – diese Seite enthält Angaben zu einer nicht freigegebenen Haushaltsperiode."
  navItems={navItems}
  navLabel="Haushalt"
  otherPeriods={weiterePerioden}
>
  <SectionHero
    slot="hero"
    eyebrow="Haushaltsportal"
    title="Haushalt des Freistaates"
    lead={lead}
    variant="budget"
    facts={heroFacts}
    actions={[{ label: kopf.statusTone === 'geltend' ? `Geltender Haushalt ${formatPeriodenjahre(kopf.periode)}` : kopf.periode.bezeichnung, href: getBudgetPeriodUrl(kopf.periode.id), primary: true }]}
  />

  <section class="section" id="perioden" aria-labelledby="perioden-titel">
    <div class="section-header">
      <h2 id="perioden-titel">Haushaltsperioden</h2>
      <p>Jeder Doppelhaushalt umfasst zwei Haushaltsjahre. Der Status zeigt, ob ein Haushalt gilt oder noch im Verfahren ist.</p>
    </div>
    <ul class="hh-einstieg-perioden">
      {perioden.map((entry) => (
        <li>
          <article class="hh-einstieg-periode" aria-labelledby={`periode-${entry.periode.id}`} data-haushalt-periode-karte={entry.periode.id}>
            <header class="hh-einstieg-periode__kopf">
              <h3 id={`periode-${entry.periode.id}`}><a href={getBudgetPeriodUrl(entry.periode.id)}>{entry.periode.bezeichnung}</a></h3>
              <StatusBadge tone={entry.statusTone} label={entry.statusLabel} />
            </header>
            <p class="hh-einstieg-periode__text">{entry.statusText}</p>
            {entry.nachtrag ? (
              <p class="hh-einstieg-periode__text" data-haushalt-nachtrag>
                <StatusBadge tone={entry.nachtrag.tone} label={entry.nachtrag.label} /> {entry.nachtrag.text}
              </p>
            ) : null}
            <dl class="hh-einstieg-periode__zahlen">
              {entry.jahre.map((jahr) => (
                <div>
                  <dt>Ausgaben {jahr.jahr}</dt>
                  <dd><Amount value={jahr.ausgaben} /></dd>
                </div>
              ))}
              <div>
                <dt>Einzelpläne</dt>
                <dd>{entry.einzelplaene}</dd>
              </div>
            </dl>
            <ul class="hh-einstieg-periode__wege" aria-label={`Bereiche: ${entry.periode.bezeichnung}`}>
              {entry.wege.map((weg) => <li><a class="inline-link" href={weg.href}>{weg.label}</a></li>)}
            </ul>
          </article>
        </li>
      ))}
    </ul>

    <div class="hh-einstieg-eckwerte" data-visual-section="budget-table">
      <h3 id="eckwerte-titel">Eckwerte nach Haushaltsjahren</h3>
      <DataTableFrame
        id="eckwerte"
        label="Eckwerte nach Haushaltsjahren"
        caption="Eckwerte nach Haushaltsjahren, Beträge in Euro"
        nomenSingular="Haushaltsjahr"
        nomenPlural="Haushaltsjahren"
        seitengroesse={false}
        breite="breit"
      >
        <table class="data-table hh-datentabelle">
          <thead>
            <tr>
              <th scope="col" class="hh-kennung" data-sort="number" aria-sort="ascending">Jahr</th>
              <th scope="col" data-sort="text">Haushalt</th>
              <th scope="col" data-sort="text">Status</th>
              <th scope="col" class="hh-zahl" data-sort="number">Einnahmen</th>
              <th scope="col" class="hh-zahl" data-sort="number">Ausgaben</th>
              <th scope="col" class="hh-zahl" data-sort="number">Investitionen</th>
              <th scope="col" class="hh-zahl" data-sort="number">Personal&shy;ausgaben</th>
            </tr>
          </thead>
          <tbody>
            {alleJahre.map((jahr) => {
              const werte = eckwerte(jahr);
              return (
                <tr data-jahr={jahr.jahr}>
                  <th scope="row" class="hh-kennung" data-sort={jahr.jahr}>{jahr.jahr}</th>
                  <td><a class="inline-link" href={getBudgetPeriodUrl(jahr.daten.periode.id)}>{jahr.daten.kurzname}</a></td>
                  <td><strong class="hh-einstieg-status">{jahr.daten.statusLabel}</strong></td>
                  <td class="hh-zahl"><Amount value={werte.einnahmen} exakt /></td>
                  <td class="hh-zahl"><Amount value={werte.ausgaben} exakt /></td>
                  <td class="hh-zahl"><Amount value={werte.investitionen} exakt /></td>
                  <td class="hh-zahl"><Amount value={werte.personal} exakt /></td>
                </tr>
              );
            })}
          </tbody>
        </table>
      </DataTableFrame>
      {strukturHinweis ? <p class="hh-einstieg-hinweis" role="note"><strong>Strukturhinweis:</strong> {strukturHinweis}</p> : null}
      <DefinitionNote begriff="Investitionen">
        <p>{DEFINITION_INVESTITIONEN}</p>
      </DefinitionNote>
    </div>
  </section>

  <section class="section section-muted" id="kennzahlen" aria-labelledby="kennzahlen-titel" data-haushalt-jahreswahl data-visual-section="budget-year-kpis">
    <noscript><style is:inline>[data-jahreswahl-ansicht][hidden]{display:grid!important}[data-jahreswahl-steuerung]{display:none!important}</style></noscript>
    <div class="section-header">
      <h2 id="kennzahlen-titel">Einnahmen, Ausgaben und Finanzierung</h2>
      <p>Zentrale Kennzahlen des gewählten Haushaltsjahres sowie die Vergleiche innerhalb und zwischen den Haushaltsperioden. Alle Angaben beziehen sich auf den Kernhaushalt.</p>
    </div>

    <div class="hh-jahreswahl" data-jahreswahl-steuerung>
      {ansichtsGruppen.map((gruppe) => (
        <div class="hh-jahreswahl__gruppe" role="group" aria-labelledby={`${gruppe.id}-label`}>
          <span class="hh-jahreswahl__label" id={`${gruppe.id}-label`}>{gruppe.label}</span>
          <div class="segmented-control">
            {gruppe.ansichten.map((ansicht) => (
              <button
                type="button"
                class:list={['segmented-control__button', ansicht.id === startAnsicht && 'is-active']}
                aria-pressed={ansicht.id === startAnsicht ? 'true' : 'false'}
                aria-controls={`ansicht-${ansicht.id}`}
                data-jahreswahl-option={ansicht.id}
                data-jahreswahl-meldung={ansicht.meldung}
              >
                {ansicht.label}{ansicht.versteckt ? <span class="visually-hidden">{ansicht.versteckt}</span> : null}
              </button>
            ))}
          </div>
        </div>
      ))}
    </div>
    <p class="visually-hidden" data-jahreswahl-status role="status" aria-live="polite"></p>

    {alleJahre.map((jahr) => {
      const entry = jahr.daten;
      const vorjahr = entry.jahre[entry.jahre.findIndex((item) => item.jahr === jahr.jahr) - 1];
      const finanzierung = jahr.block ? finanzierungsKennzahlen(jahr.block) : [];
      const ausgeglichen = jahr.einnahmen === jahr.ausgaben;
      return (
        <div
          class="hh-einstieg-ansicht"
          id={`ansicht-${jahr.jahr}`}
          data-jahreswahl-ansicht={jahr.jahr}
          hidden={jahr.jahr !== startAnsicht}
          aria-labelledby={`ansicht-${jahr.jahr}-titel`}
          role="region"
        >
          <header class="hh-einstieg-ansicht__kopf">
            <h3 id={`ansicht-${jahr.jahr}-titel`}>Haushaltsjahr {jahr.jahr}</h3>
            <p class="hh-einstieg-ansicht__periode">{entry.periode.bezeichnung}</p>
            <StatusBadge tone={entry.statusTone} label={entry.statusLabel} />
          </header>
          <KpiGrid label={`Kennzahlen ${jahr.jahr}`} items={kennzahlKarten(jahr, vorjahr)} />
          <div class="hh-einstieg-struktur">
            <div>
              <h4>Woher die Einnahmen kommen</h4>
              <BarChart
                id={`einnahmen-${jahr.jahr}`}
                caption={`Einnahmen ${jahr.jahr} nach Hauptgruppen`}
                items={hauptgruppenBalken(jahr, EINNAHME_HAUPTGRUPPEN)}
                total={jahr.einnahmen}
                totalLabel={`Einnahmen ${jahr.jahr}`}
                labelSpalte="Hauptgruppe"
                wertSpalte={`Einnahmen ${jahr.jahr}`}
              />
            </div>
            <div>
              <h4>Wofür ausgegeben wird</h4>
              <BarChart
                id={`ausgaben-${jahr.jahr}`}
                caption={`Ausgaben ${jahr.jahr} nach Hauptgruppen`}
                items={hauptgruppenBalken(jahr, AUSGABE_HAUPTGRUPPEN)}
                total={jahr.ausgaben}
                totalLabel={`Ausgaben ${jahr.jahr}`}
                labelSpalte="Hauptgruppe"
                wertSpalte={`Ausgaben ${jahr.jahr}`}
              />
            </div>
          </div>
          <div class="hh-einstieg-finanzierung">
            <h4>Wie sich der Haushalt finanziert</h4>
            {ausgeglichen ? <p>Einnahmen und Ausgaben sind im Haushaltsjahr {jahr.jahr} mit jeweils <Amount value={jahr.ausgaben} exakt /> ausgeglichen.</p> : null}
            {finanzierung.length > 0 ? (
              <>
                <KpiGrid
                  label={`Finanzierungskennzahlen ${jahr.jahr}`}
                  items={finanzierung.map((kennzahl) => ({ label: kennzahl.label, value: kennzahl.betrag }))}
                />
                <details class="hh-einstieg-abgrenzungen" data-haushalt-druck-oeffnen>
                  <summary>Abgrenzungen der Kennzahlen {jahr.jahr}</summary>
                  <dl>
                    {[jahr.block!.ausgaben, ...finanzierung].map((kennzahl) => (
                      <div>
                        <dt>{kennzahl.label}</dt>
                        <dd>{kennzahl.definition}</dd>
                      </div>
                    ))}
                  </dl>
                </details>
              </>
            ) : (
              <>
                <KpiGrid
                  label={`Finanzierungskennzahlen ${jahr.jahr}`}
                  spalten={2}
                  items={(['3', '9'] as const).map((hg) => ({ label: `Hauptgruppe ${hg}`, value: jahr.hauptgruppen[hg], hint: HAUPTGRUPPEN[hg].kurz }))}
                />
                <p class="hh-einstieg-text">Hauptgruppe 3 umfasst Schuldenaufnahmen, Entnahmen aus Rücklagen sowie Zuweisungen und Zuschüsse für Investitionen; Hauptgruppe 9 unter anderem Zuführungen an Rücklagen.</p>
              </>
            )}
          </div>
          {entry.datenstand ? (
            <SourceNote
              datenstand={entry.datenstand}
              datenversion={entry.datenversion}
              quelle={entry.quelle}
              downloadsHref={entry.gesamtplan ? getBudgetPeriodPageUrl(entry.periode.id, 'downloads') : `${getBudgetPeriodUrl(entry.periode.id)}daten.csv`}
              downloadsLabel={entry.gesamtplan ? 'Daten und Downloads' : 'Haushaltsdaten als CSV'}
            />
          ) : null}
        </div>
      );
    })}

    {chronologisch.filter((entry) => entry.jahre.length >= 2).map((entry) => {
      const [erstes, zweites] = entry.jahre;
      const werte = [eckwerte(erstes), eckwerte(zweites)];
      return (
        <div
          class="hh-einstieg-ansicht"
          id={`ansicht-${vergleichId(entry)}`}
          data-jahreswahl-ansicht={vergleichId(entry)}
          hidden={vergleichId(entry) !== startAnsicht}
          aria-labelledby={`ansicht-${vergleichId(entry)}-titel`}
          role="region"
        >
          <header class="hh-einstieg-ansicht__kopf">
            <h3 id={`ansicht-${vergleichId(entry)}-titel`}>Vergleich {erstes.jahr} und {zweites.jahr}</h3>
            <p class="hh-einstieg-ansicht__periode">{entry.periode.bezeichnung}</p>
            <StatusBadge tone={entry.statusTone} label={entry.statusLabel} />
          </header>
          <GroupedBarChart
            id={`balken-${vergleichId(entry)}`}
            caption={`Eckwerte ${erstes.jahr} und ${zweites.jahr} im Vergleich`}
            series={[{ label: erstes.jahr }, { label: zweites.jahr }]}
            categories={VERGLEICH_FELDER.map(([feld, label]) => ({ label, values: [werte[0][feld], werte[1][feld]] }))}
            kategorieSpalte="Kennzahl"
            veraenderung
            tabelle="sichtbar"
            hinweis="Der Vergleich zeigt die Ansätze beider Haushaltsjahre derselben Periode."
          />
        </div>
      );
    })}

    {periodenvergleiche.map((entry) => {
      const einnahmeZeilen = entry.vergleich.zeilen.filter((zeile) => zeile.seite === 'Einnahme');
      const ausgabeZeilen = entry.vergleich.zeilen.filter((zeile) => zeile.seite === 'Ausgabe');
      const serien = entry.vergleich.jahre.map((jahr) => ({ label: jahr }));
      const titel = `${entry.alt.kurzname} und ${entry.neu.kurzname}`;
      return (
        <div
          class="hh-einstieg-ansicht"
          id={`ansicht-${entry.id}`}
          data-jahreswahl-ansicht={entry.id}
          hidden={entry.id !== startAnsicht}
          aria-labelledby={`ansicht-${entry.id}-titel`}
          role="region"
        >
          <header class="hh-einstieg-ansicht__kopf">
            <h3 id={`ansicht-${entry.id}-titel`}>Periodenvergleich {entry.vergleich.jahre[0]} bis {entry.vergleich.jahre[entry.vergleich.jahre.length - 1]}</h3>
            <p class="hh-einstieg-ansicht__periode">{entry.alt.periode.bezeichnung} ({entry.alt.statusLabel}) und {entry.neu.periode.bezeichnung} ({entry.neu.statusLabel})</p>
          </header>
          <p class="hh-einstieg-hinweis" role="note"><strong>Strukturhinweis:</strong> {entry.vergleich.hinweis}</p>
          <GroupedBarChart
            id={`balken-${entry.id}-einnahmen`}
            caption={`Einnahmen nach Hauptgruppen: ${titel}`}
            series={serien}
            categories={[
              { label: 'Einnahmen insgesamt', values: entry.vergleich.jahre.map((jahr) => entry.vergleich.einnahmen[jahr]) },
              ...einnahmeZeilen.map((zeile) => ({ label: zeile.bezeichnung, values: entry.vergleich.jahre.map((jahr) => zeile.werte[jahr]), note: `Hauptgruppe ${zeile.hauptgruppe}` })),
            ]}
            kategorieSpalte="Hauptgruppe"
          />
          <GroupedBarChart
            id={`balken-${entry.id}-ausgaben`}
            caption={`Ausgaben nach Hauptgruppen: ${titel}`}
            series={serien}
            categories={[
              { label: 'Ausgaben insgesamt', values: entry.vergleich.jahre.map((jahr) => entry.vergleich.ausgaben[jahr]) },
              ...ausgabeZeilen.map((zeile) => ({ label: zeile.bezeichnung, values: entry.vergleich.jahre.map((jahr) => zeile.werte[jahr]), note: `Hauptgruppe ${zeile.hauptgruppe}` })),
            ]}
            kategorieSpalte="Hauptgruppe"
          />
        </div>
      );
    })}
  </section>

  <section class="section" id="schwerpunkte" aria-labelledby="schwerpunkte-titel">
    <div class="section-header">
      <h2 id="schwerpunkte-titel">Schwerpunkte</h2>
      <p>Wofür die Haushaltsperioden die größten Mittel vorsehen: nach Aufgabenbereichen und nach einzelnen Vorhaben.</p>
    </div>
    <div class="hh-einstieg-schwerpunkte">
      {vorhabenJePeriode.filter(({ vorhaben }) => vorhaben.length > 0).map(({ entry, vorhaben }) => (
        <div class="hh-einstieg-schwerpunkt">
          <header class="hh-einstieg-ansicht__kopf">
            <h3>Größte Vorhaben: {entry.periode.bezeichnung}</h3>
            <StatusBadge tone={entry.statusTone} label={entry.statusLabel} />
          </header>
          <GroupedBarChart
            id={`vorhaben-${entry.periode.id}`}
            caption={`Vorhaben mit den höchsten Ansätzen ${entry.jahre[0].jahr}`}
            series={entry.jahre.map((jahr) => ({ label: jahr.jahr }))}
            categories={vorhaben}
            kategorieSpalte="Vorhaben"
            hinweis="Vorhaben sind eine eigene Sicht auf Titel des Haushalts. Ihre Ansätze sind in den Ausgaben bereits enthalten und werden nicht hinzugerechnet."
          />
          <p><a class="inline-link" href={getBudgetPeriodPageUrl(entry.periode.id, 'projekte')}>Alle Vorhaben {formatPeriodenjahre(entry.periode)}</a></p>
        </div>
      ))}
      {legacy ? (
        <div class="hh-einstieg-schwerpunkt">
          <header class="hh-einstieg-ansicht__kopf">
            <h3>Aufgabenbereiche: {legacy.periode.bezeichnung}</h3>
            <StatusBadge tone={legacy.statusTone} label={legacy.statusLabel} />
          </header>
          <BarChart
            id={`aufgabenbereiche-${legacy.bezugsjahr}`}
            caption={`Ausgaben ${legacy.bezugsjahr} nach Aufgabenbereichen`}
