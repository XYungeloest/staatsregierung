              value: bereich.amounts[legacy.bezugsjahr as BudgetYear],
              note: `${bereich.planNumbers.length === 1 ? 'Einzelplan' : 'Einzelpläne'} ${bereich.planNumbers.join(', ')}`,
            }))}
            total={budgetTotals[legacy.bezugsjahr as BudgetYear].expenses}
            totalLabel={`Ausgaben ${legacy.bezugsjahr}`}
            labelSpalte="Aufgabenbereich"
            wertSpalte={`Ausgaben ${legacy.bezugsjahr}`}
            hinweis="Die Zuordnung der Einzelpläne zu Aufgabenbereichen dient der Orientierung; sie ist keine Rangfolge politischer Bedeutung."
          />
          <p><a class="inline-link" href={getBudgetPeriodPageUrl(legacy.periode.id, 'einzelplaene')}>Alle Einzelpläne {formatPeriodenjahre(legacy.periode)}</a></p>
        </div>
      ) : null}
    </div>
  </section>

  <section class="section section-muted" id="bereiche" aria-labelledby="bereiche-titel">
    <div class="section-header">
      <h2 id="bereiche-titel">Weitere Wege</h2>
