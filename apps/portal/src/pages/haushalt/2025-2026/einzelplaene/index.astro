---
import HaushaltLayout from '../../../../layouts/HaushaltLayout.astro';
import BudgetPlanTable from '../../../../components/portal/BudgetPlanTable.astro';
import BudgetYearSelector from '../../../../components/portal/BudgetYearSelector.astro';
import SourceNote from '../../../../components/haushalt/SourceNote.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import { budgetPlans, budgetTotals, getBudgetShare } from '../../../../lib/haushalt/legacy-2025-2026.ts';
import { formatEuroCompact, formatPercent } from '@ostrecht/shared/lib/portal/modules.ts';
import { getLegacyCsvUrl, getLegacyLayoutAngaben, getLegacyQuelle } from '../_periode.ts';

const categoryCounts = [...new Set(budgetPlans.map((plan) => plan.category))].map((category) => ({
  category,
  count: budgetPlans.filter((plan) => plan.category === category).length,
}));
const layout = getLegacyLayoutAngaben('einzelplaene', [{ label: 'Einzelpläne' }]);
---

<HaushaltLayout
  title={`Einzelpläne – ${layout.periodLabel}`}
  description="Alle Einzelpläne des Doppelhaushalts 2025/2026 mit Haushaltsanteilen, Ausgabenarten und Jahresvergleich."
  scripts={['portal-modules']}
  {...layout}
>
  <SectionHero
    slot="hero"
    eyebrow="Haushalt · Einzelpläne"
    title="Einzelpläne vergleichen"
    lead="Ressorts, Verfassungsorgane und zentrale Verwaltungsbereiche im Jahres- und Strukturvergleich."
    variant="budget"
    facts={[
      { label: 'Einzelpläne', value: String(budgetPlans.length) },
      { label: 'Kernhaushalt 2026', value: formatEuroCompact(budgetTotals['2026'].expenses) },
    ]}
  />

  <section class="section section-muted" aria-labelledby="einzelplan-einordnung">
    <div class="section-header"><h2 id="einzelplan-einordnung">So lesen Sie die Übersicht</h2><p>Der Gesamtplan enthält den Kernhaushalt. Einzelpläne untergliedern diesen nach Verwaltungsbereichen; die Summe einzelner Pläne ist nicht automatisch eine zusätzliche Ebene neben dem Gesamtplan.</p></div>
    <div class="budget-category-grid">
      {categoryCounts.map((entry) => <article><strong>{entry.count}</strong><span>{entry.category}</span></article>)}
      <article><strong>{formatEuroCompact(budgetTotals['2026'].expenses)}</strong><span>Kernhaushalt 2026</span></article>
    </div>
    <p class="detail-line">Einzelplan 20, Allgemeine Finanzverwaltung, bündelt zentrale Finanzströme. Er ist in der Vergleichstabelle enthalten, sollte aber nicht wie ein Fachressort gelesen werden.</p>
  </section>

  <section class="section" data-budget-year-switcher aria-labelledby="einzelplan-auswahl">
    <div class="section-header section-header--with-control">
      <div><h2 id="einzelplan-auswahl">Ansicht und Vergleich</h2><p>Wählen Sie ein Jahr für Anteile innerhalb dieses Jahres oder den direkten Vergleich aller Einzelpläne.</p></div>
      <BudgetYearSelector id="einzelplan-year" label="Haushaltsjahr" />
    </div>
    <p class="visually-hidden" data-budget-year-status role="status" aria-live="polite"></p>
    <div data-budget-year-content="2025" hidden><BudgetPlanTable plans={budgetPlans} mode="2025" /></div>
    <div data-budget-year-content="2026"><BudgetPlanTable plans={budgetPlans} mode="2026" /></div>
    <div data-budget-year-content="vergleich" hidden><BudgetPlanTable plans={budgetPlans} mode="vergleich" /></div>
  </section>

  <section class="section" aria-labelledby="einzelplan-hinweis">
    <div class="budget-context-note"><strong>Vergleichbare Bezugsgröße</strong><span>Der Anteil eines Einzelplans wird immer als Anteil an den Gesamtausgaben desselben Jahres ausgewiesen. Für 2026 entspricht beispielsweise {formatEuroCompact(budgetPlans.find((plan) => plan.number === '04')?.amounts['2026'].expenses ?? 0)} im Einzelplan Bildung {formatPercent(getBudgetShare(budgetPlans.find((plan) => plan.number === '04')?.amounts['2026'].expenses ?? 0, budgetTotals['2026'].expenses) ?? 0)} des Kernhaushalts.</span></div>
    {layout.datenstand ? <SourceNote datenstand={layout.datenstand} quelle={getLegacyQuelle()} downloadsHref={getLegacyCsvUrl()} downloadsLabel="Haushaltsdaten als CSV" /> : null}
  </section>
</HaushaltLayout>
