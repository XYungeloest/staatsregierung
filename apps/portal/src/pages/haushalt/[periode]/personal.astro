        </div>
      ))}
    </dl>
    <p class="hh-fliesstext">Die erwartete Änderung ergibt sich als Unterschied zwischen dem Gesetzentwurf und dem bisherigen Planniveau. Allgemeine Besoldungsanpassungen ab 2028 sind in allen Vergleichsständen gleich angesetzt.</p>

    {besoldungsBloecke.map((block) => (
      <>
        <h4 class="hh-zwischenueberschrift">{block.label}</h4>
        <TimeSeriesChart
          id={`regime-${block.block === 'Besoldung Bestandsbeamte' ? 'besoldung' : 'anwaerter'}-diagramm`}
          caption={`${block.label}: Ausgaben nach Vergleichsständen ${block.jahre[0]} bis ${block.jahre[block.jahre.length - 1]}`}
          jahre={block.jahre.map((jahr) => ({ jahr, art: jahresart(jahr, jahre) }))}
          series={(['R0', 'B', 'C'] as const).filter((code) => block.werte[code]).map((code) => ({ label: regimeLabels[code], values: block.jahre.map((jahr) => block.werte[code][jahr]) }))}
