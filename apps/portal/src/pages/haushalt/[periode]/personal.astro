                <th scope="col" class="hh-zahl" data-export-key="arbeitsverhaeltnis_kumuliert">Besetzungen im Arbeitsverhältnis, aufgelaufen</th>
              </tr>
            </thead>
            <tbody>
              {strukturJahre.map((eintrag) => {
                const projektion = !jahre.includes(eintrag.jahr);
                return (
                  <tr class:list={[projektion && 'hh-zeile--projektion']}>
                    <th scope="row" class="hh-kennung" data-export-value={eintrag.jahr}>{eintrag.jahr}{projektion ? <> <span>Finanzplanung</span></> : null}</th>
                    {[eintrag.bestandsbeamte, eintrag.ruhestandszugaenge, eintrag.wiederbesetzungBisher, eintrag.einstellungenO, eintrag.einstellungenR, eintrag.arbeitsverhaeltnis, eintrag.arbeitsverhaeltnisKumuliert].map((wert) => (
                      <td class="hh-zahl"><data value={String(wert)}>{formatNumber(wert)}</data></td>
                    ))}
                  </tr>
                );
              })}
            </tbody>
          </table>
        </DataTableFrame>
        <p class="hh-fliesstext hh-klein">Die Jahreswerte sind Summen der je Personalbereich gerundeten Schätzungen und können von den Gesamtangaben unter „Erwartete Personalbewegungen“ um wenige Köpfe abweichen.</p>
      </>
    ) : null}
  </section>

  <section class="section hh-fachabschnitt" aria-labelledby="dienstrecht">
