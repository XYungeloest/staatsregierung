                  <tr>
                    <th scope="row" class="hh-kennung">{zeile.gruppe}</th>
                    <td>{zeile.stufe === '' ? 'fest' : zeile.stufe}</td>
                    <td class="hh-zahl">{zeile.geltend === null ? '–' : <data value={(zeile.geltend / 100).toFixed(2)}>{formatCent(zeile.geltend)}</data>}</td>
                    <td class="hh-zahl">{zeile.entwurf === null ? '–' : <data value={(zeile.entwurf / 100).toFixed(2)}>{formatCent(zeile.entwurf)}</data>}</td>
                    <td class="hh-zahl">{differenz === null ? '–' : <data value={(differenz / 100).toFixed(2)}>{formatCent(differenz, true)}</data>}</td>
                    <td class="hh-zahl">{differenz === null || !zeile.geltend ? '–' : `${differenz > 0 ? '+' : ''}${formatShare(differenz / zeile.geltend)}`}</td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </DataTableFrame>
        {zuschlaege.length > 0 ? (
          <DataTableFrame
            id="besoldung-zuschlaege"
            label="Familienzuschlag und Anwärtergrundbetrag"
            caption="Familienzuschlag und Anwärtergrundbetrag, Monatsbeträge in Euro"
