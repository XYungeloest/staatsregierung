      </>
    ) : null}

    {fondsErstattung.length > 0 ? (
      <>
        <h3 class="hh-unterueberschrift">Erstattung aus dem Versorgungsfonds Ost</h3>
        <p class="hh-fliesstext">Der Versorgungsfonds Ost erstattet dem Haushalt Versorgungsausgaben für die durch ihn gedeckten Jahrgänge. Die Erstattung folgt deren tatsächlichen Versorgungsausgaben. Sie bleibt nach dem Gesetzentwurf unverändert, solange diese Ausgaben über der geplanten Erstattung liegen.</p>
        <DataTableFrame
          id="versorgungsfonds"
          label="Erstattung aus dem Versorgungsfonds Ost"
          caption="Erstattung aus dem Versorgungsfonds Ost, Beträge in Euro"
          nomenSingular="Jahr"
          nomenPlural="Jahren"
          seitengroesse={false}
          breite="mittel"
        >
          <table class="data-table hh-datentabelle">
            <thead>
              <tr>
                <th scope="col">Jahr</th>
                <th scope="col" class="hh-zahl">Bisher geplante Erstattung</th>
                <th scope="col" class="hh-zahl">Erstattung nach dem Gesetzentwurf</th>
                <th scope="col" class="hh-zahl">Minderung</th>
              </tr>
            </thead>
            <tbody>
              {fondsErstattung.map((eintrag) => {
                const projektion = !jahre.includes(String(eintrag.jahr));
                return (
                  <tr class:list={[projektion && 'hh-zeile--projektion']}>
                    <th scope="row" class="hh-kennung">{eintrag.jahr}{projektion ? <> <span>Finanzplanung</span></> : null}</th>
                    <td class="hh-zahl"><Amount value={eintrag.geplant} /></td>
                    <td class="hh-zahl"><Amount value={eintrag.tatsaechlich} /></td>
                    <td class="hh-zahl"><Amount value={eintrag.minderung} /></td>
                  </tr>
                );
              })}
            </tbody>
          </table>
        </DataTableFrame>
      </>
    ) : null}

    {rechtsstaende.B && rechtsstaende.C ? (
      <>
        <h3 class="hh-unterueberschrift">Barwert der Versorgungsverpflichtungen</h3>
        <p class="hh-fliesstext">Vereinfachte versicherungsmathematische Bewertung zum 1. Januar 2027 (Schätzung) mit einem Rechnungszins von {prozentAusDezimaltext(barwerte.rechnungszins)} und einer jährlichen Dynamik von {prozentAusDezimaltext(barwerte.dynamik)}. Erfasst sind laufende Versorgungsfälle und die bis dahin erdienten Anwartschaften der vorhandenen Beamt:innen. Ein versicherungsmathematisches Gutachten liegt nicht vor.</p>
        <DataTableFrame
          id="versorgung-barwert"
          label="Barwert der Versorgungsverpflichtungen zum 1. Januar 2027"
          caption="Barwert der Versorgungsverpflichtungen zum 1. Januar 2027, Beträge in Euro"
          nomenSingular="Position"
          nomenPlural="Positionen"
          seitengroesse={false}
          breite="mittel"
        >
          <table class="data-table hh-datentabelle">
            <thead>
              <tr>
                <th scope="col">Position</th>
                <th scope="col" class="hh-zahl">{regimeLabels.B}</th>
                <th scope="col" class="hh-zahl">{regimeLabels.C}</th>
                <th scope="col" class="hh-zahl">Unterschied</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <th scope="row">Laufende Versorgungsfälle</th>
                <td class="hh-zahl"><Amount value={barwerte.laufend_b} /></td>
                <td class="hh-zahl"><Amount value={barwerte.laufend_c} /></td>
                <td class="hh-zahl"><Amount value={barwerte.laufend_c - barwerte.laufend_b} vorzeichen /></td>
              </tr>
              <tr>
                <th scope="row">Erdiente Anwartschaften der vorhandenen Beamt:innen</th>
                <td class="hh-zahl"><Amount value={barwerte.anwartschaften_b} /></td>
                <td class="hh-zahl"><Amount value={barwerte.anwartschaften_c} /></td>
                <td class="hh-zahl"><Amount value={barwerte.anwartschaften_c - barwerte.anwartschaften_b} vorzeichen /></td>
              </tr>
            </tbody>
            <tfoot>
              <tr>
                <th scope="row">Zusammen</th>
                <td class="hh-zahl"><Amount value={barwerte.gesamt_b} /></td>
                <td class="hh-zahl"><Amount value={barwerte.gesamt_c} /></td>
                <td class="hh-zahl"><Amount value={barwerte.gesamt_c - barwerte.gesamt_b} vorzeichen /></td>
              </tr>
            </tfoot>
          </table>
        </DataTableFrame>
      </>
    ) : null}
  </section>

  <section class="section hh-fachabschnitt" aria-labelledby="rechtsgrundlagen">
    <div class="section-header"><h2 id="rechtsgrundlagen">Rechtsgrundlagen</h2></div>
    <ul class="hh-rechtsbezuege">
      {rechtsbezuege.map((bezug) => (
        <li>
          {bezug.href ? <a class="inline-link" href={bezug.href}>{bezug.label}</a> : <span class="hh-rechtsbezuege__titel">{bezug.label}</span>}
          <span class="hh-rechtsbezuege__art">{bezug.artLabel}</span>
        </li>
      ))}
    </ul>
  </section>

  <SourceNote
    datenstand={ctx.datenstand}
    datenversion={ctx.datenversion}
    quelle={ctx.quelle}
    downloadsHref={getBudgetPeriodPageUrl(id, 'downloads')}
  />
</HaushaltLayout>
