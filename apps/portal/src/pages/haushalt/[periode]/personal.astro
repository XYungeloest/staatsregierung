                    <td class="hh-zahl"><data value={(zeile.entwurf / 100).toFixed(2)}>{formatCent(zeile.entwurf)}</data></td>
                    <td class="hh-zahl"><data value={((zeile.entwurf - zeile.geltend) / 100).toFixed(2)}>{formatCent(zeile.entwurf - zeile.geltend, true)}</data></td>
                  </tr>
