                <tr>
                  <th scope="col">Bestandteil</th>
                  <th scope="col" class="hh-zahl">{tabellen.geltend.bezeichnung}</th>
                  <th scope="col" class="hh-zahl">{tabellen.entwurf.bezeichnung}</th>
                  <th scope="col" class="hh-zahl">Unterschied</th>
