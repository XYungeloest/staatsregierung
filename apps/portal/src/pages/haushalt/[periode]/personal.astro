          labels={regimeLabels}
          haushaltsjahre={jahre}
        />
      </>
    ))}

    <h3 class="hh-unterueberschrift">Änderung gegenüber dem bisherigen Planniveau nach Regelungen</h3>
    <p class="hh-fliesstext">Negative Beträge sind Minderausgaben, positive Beträge Mehrausgaben gegenüber dem bisherigen Planniveau. Die Jahre nach {letztesJahr} sind Finanzplanung und nicht bewilligt.</p>
    <DataTableFrame
      id="dienstrecht-regelungen"
      label="Änderung gegenüber dem bisherigen Planniveau nach Regelungen"
      caption="Änderung der Ausgaben gegenüber dem bisherigen Planniveau nach Regelungen des Gesetzentwurfs, Beträge in Euro"
