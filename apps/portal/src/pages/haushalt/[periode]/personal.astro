---
/**
 * Personal und Versorgung einer Snapshot-Periode: Personalausgaben (Hauptgruppe 4) nach Arten
 * und Einzelplänen, Planäquivalente nach Personalbereichen, Bestand und Wiederbesetzung bis 2035,
 * der Gesetzentwurf zur Neuordnung des öffentlichen Dienstrechts (Vergleich der Rechtsstände,
 * Änderung nach Regelungen, veranschlagte Wirkung, Besoldungstabellen) und die Versorgung.
 *
 * Alle Beträge kommen aus dem Snapshot; die Seite gruppiert, vergleicht und beschriftet nur.
 * Beschriftungen von Kennungen stammen aus content/haushalt/<periode>/personal.json (fail-closed).
 */
import HaushaltLayout from '../../../layouts/HaushaltLayout.astro';
import '../../../styles/haushalt/fachseiten.css';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import Amount from '../../../components/haushalt/Amount.astro';
import DataTableFrame from '../../../components/haushalt/DataTableFrame.astro';
import DefinitionNote from '../../../components/haushalt/DefinitionNote.astro';
import FilterBar from '../../../components/haushalt/FilterBar.astro';
import GroupedBarChart from '../../../components/haushalt/GroupedBarChart.astro';
import KpiGrid from '../../../components/haushalt/KpiGrid.astro';
import SourceNote from '../../../components/haushalt/SourceNote.astro';
import TimeSeriesChart from '../../../components/haushalt/TimeSeriesChart.astro';
import Abschnittsliste from '../../../components/haushalt/personal/Abschnittsliste.astro';
import RegimeTabelle from '../../../components/haushalt/personal/RegimeTabelle.astro';
import { formatNumber, formatShare, normalizeSearch } from '../../../components/haushalt/format.ts';
import { getFachseitenKontext, getFachseitenPfade, jahresart } from '../../../components/haushalt/personal/periodenseite.ts';
import {
  formatCent,
  getBesoldungsordnungO,
  getBesoldungsvergleich,
  getKomponenten,
  getPersonalArten,
  getPersonalausgaben,
  getPersonalNachEinzelplan,
  getPersonalstrukturJahre,
  getPlanaequivalente,
  getRegimeBloecke,
  getWirkungJahre,
  getZuschlagsvergleich,
  loadPersonal,
  loadPersonalOverlay,
  summe,
  WIRKUNG_AUSGABEN,
  WIRKUNG_EINNAHMEN,
} from '../../../components/haushalt/personal/daten.ts';
import { getNormStatus, RECHTSBEZUG_ART_LABELS } from '../../../lib/haushalt/oeffentlich.ts';
import { getBudgetPeriodPageUrl, getBudgetPeriodPlanUrl } from '@ostrecht/shared/lib/portal/routes.ts';
import { getNormUrl } from '@ostrecht/shared/lib/norms/routes.ts';

export function getStaticPaths() {
  return getFachseitenPfade();
}

const { periode: id } = Astro.params as { periode: string };
const ctx = getFachseitenKontext(id, 'personal', 'Personal und Versorgung');
const jahre = ctx.jahre;
const [erstesJahr, letztesJahr] = [jahre[0], jahre[jahre.length - 1]];
const personal = loadPersonal(id);
const overlay = loadPersonalOverlay(id);
const periodenjahre = jahre.join('/');

// Personalausgaben
const ausgaben = getPersonalausgaben(id, jahre);
const arten = getPersonalArten(id, jahre);
const plaene = getPersonalNachEinzelplan(id, jahre);
const plaeneSortiert = [...plaene].sort((left, right) => right.werte[erstesJahr] - left.werte[erstesJahr]);
const kpis = [
  ...ausgaben.map((eintrag, index) => ({
    label: `Personalausgaben ${eintrag.jahr}`,
    value: eintrag.betrag,
    hint: 'Hauptgruppe 4 des Gruppierungsplans',
    ...(index > 0 ? { change: { value: eintrag.betrag - ausgaben[index - 1].betrag, label: `gegenüber ${ausgaben[index - 1].jahr}` } } : {}),
  })),
  ...ausgaben
    .filter((eintrag) => eintrag.anteil !== null)
    .map((eintrag) => ({
      label: `Anteil an den Ausgaben ${eintrag.jahr}`,
      value: eintrag.anteil ?? 0,
      format: 'percent' as const,
      hint: 'Personalausgaben im Verhältnis zu den Gesamtausgaben',
    })),
];

// Planäquivalente
const struktur = getPlanaequivalente(personal, overlay, jahre);
const strukturSumme = Object.fromEntries(
  jahre.map((jahr) => [jahr, {
    beamte: summe(struktur.map((zeile) => zeile.jahre[jahr].beamte)),
    anwaerter: summe(struktur.map((zeile) => zeile.jahre[jahr].anwaerter)),
    arbeitnehmer: summe(struktur.map((zeile) => zeile.jahre[jahr].arbeitnehmer)),
    auszubildende: summe(struktur.map((zeile) => zeile.jahre[jahr].auszubildende)),
    summe: summe(struktur.map((zeile) => zeile.jahre[jahr].summe)),
  }]),
);
const strukturJahre = getPersonalstrukturJahre(personal);

// Dienstrecht
const rechtsstaende = overlay.rechtsstaende;
const regimeLabels = Object.fromEntries(Object.entries(rechtsstaende).map(([code, text]) => [code, text.kurz]));
const bloecke = getRegimeBloecke(personal, overlay);
const besoldungsBloecke = bloecke.filter((block) => block.block !== 'Versorgung');
const versorgungsBlock = bloecke.find((block) => block.block === 'Versorgung');
const wirkung = getWirkungJahre(personal);
const wirkungsjahre = wirkung.map((eintrag) => String(eintrag.jahr));
const planungsjahre = wirkungsjahre.filter((jahr) => !jahre.includes(jahr));
const komponenten = getKomponenten(personal, overlay, wirkungsjahre);
const komponentenSumme = Object.fromEntries(
  wirkungsjahre.map((jahr) => [jahr, summe(komponenten.flatMap((gruppe) => gruppe.zeilen.map((zeile) => zeile.werte[jahr])))]),
);
const vorbuchung = personal.versorgung.vorbuchung as Record<string, number>;
const jahrCol = (jahr: string) => (jahre.includes(jahr) ? 'haushalt' : 'planung');
const jahresansichtOptionen = [
  { value: 'haushalt', label: `${erstesJahr} und ${letztesJahr}` },
  ...(planungsjahre.length > 0 ? [{ value: 'planung', label: `${planungsjahre[0]} bis ${planungsjahre[planungsjahre.length - 1]}` }] : []),
  { value: 'alle', label: 'Alle Jahre' },
];
const wirkungsZeilen = [
  ...WIRKUNG_AUSGABEN.map((feld) => ({ feld, label: overlay.wirkungsarten[feld] ?? null, seite: 'ausgabe' })),
  ...WIRKUNG_EINNAHMEN.map((feld) => ({ feld, label: overlay.wirkungsarten[feld] ?? null, seite: 'einnahme' })),
];
const kennzahlenCodes = Object.keys(overlay.kennzahlen);
const kennzahlZeilen = kennzahlenCodes
  .map((code) => ({
    code,
    label: overlay.kennzahlen[code],
    werte: Object.fromEntries(personal.kennzahlen.filter((eintrag) => eintrag.kennzahl === code).map((eintrag) => [String(eintrag.jahr), eintrag.wert])),
  }))
  .filter((zeile) => Object.keys(zeile.werte).length > 0);
const kennzahlJahre = [...new Set(kennzahlZeilen.flatMap((zeile) => Object.keys(zeile.werte)))].sort();

const besoldung = getBesoldungsvergleich(personal, overlay);
const zuschlaege = getZuschlagsvergleich(personal, overlay);
const ordnungO = getBesoldungsordnungO(personal, overlay);
const tabellen = overlay.besoldungstabellen;

// Versorgung
const teile = Object.entries(overlay.versorgungsteile);
const teilWert = (code: string, teil: string, jahr: string) =>
  personal.versorgung.reihen.find((reihe) => reihe.rechtsstand === code && reihe.teil === teil)?.jahre[jahr as `${number}`];
const versorgungJahreAuswahl = [erstesJahr, letztesJahr, versorgungsBlock?.jahre.at(-1)].filter(
  (jahr, index, liste): jahr is string => typeof jahr === 'string' && liste.indexOf(jahr) === index,
);
const fondsErstattung = [...personal.versorgung.versorgungsfonds_erstattung].sort((left, right) => left.jahr - right.jahr);
const barwerte = personal.versorgung.barwerte;
const prozentAusDezimaltext = (text: string) => formatShare(Number(text), 1);

// Rechtsbezüge: geltende Vorschriften nur verlinken, wenn sie im Rechtsbestand vorhanden und in Kraft sind.
const rechtsbezuege = overlay.rechtsbezuege.map((bezug) => {
  const status = bezug.normSlug ? getNormStatus(bezug.normSlug) : null;
  const verlinkt = bezug.art === 'geltend' && bezug.normSlug && status === 'in-force';
  return { ...bezug, href: verlinkt && bezug.normSlug ? getNormUrl(bezug.normSlug) : null, artLabel: RECHTSBEZUG_ART_LABELS[bezug.art] };
});

const abschnitte = [
  { id: 'personalausgaben', label: 'Personalausgaben' },
  { id: 'einzelplaene', label: 'Nach Einzelplänen' },
  { id: 'personalstruktur', label: 'Personalstruktur' },
  { id: 'dienstrecht', label: 'Gesetzentwurf zum Dienstrecht' },
  { id: 'versorgung', label: 'Versorgung' },
  { id: 'rechtsgrundlagen', label: 'Rechtsgrundlagen' },
];
const seitentitel = 'Personal und Versorgung';
const exportMeta = { Periode: id, Datenstand: ctx.datenstand };
---

<HaushaltLayout
  title={`${seitentitel} – ${ctx.periode.bezeichnung}`}
  description={`Personalausgaben, Planäquivalente, Versorgung und die erwartete Wirkung des Gesetzentwurfs zur Neuordnung des öffentlichen Dienstrechts im ${ctx.periode.bezeichnung} (${ctx.status.label}).`}
  breadcrumbs={ctx.breadcrumbs}
  {...ctx.layout}
>
  <SectionHero
    slot="hero"
    eyebrow="Haushalt"
    title={seitentitel}
    lead={`Personalausgaben, Personalstruktur und Versorgung im ${ctx.periode.bezeichnung} sowie die erwartete Wirkung des Gesetzentwurfs zur Neuordnung des öffentlichen Dienstrechts.`}
    variant="budget"
  />

  <Abschnittsliste items={abschnitte} />

  <section class="section hh-fachabschnitt" aria-labelledby="personalausgaben">
    <div class="section-header"><h2 id="personalausgaben">Personalausgaben</h2></div>
    <p class="hh-fliesstext">Personalausgaben umfassen Bezüge und Entgelte der Beschäftigten, Versorgungsbezüge, Beihilfen und sonstige personalbezogene Ausgaben (Hauptgruppe 4 des Gruppierungsplans).</p>
    <KpiGrid items={kpis} label={`Personalausgaben ${periodenjahre}`} />

    <h3 class="hh-unterueberschrift">Personalausgaben nach Arten</h3>
    <GroupedBarChart
      id="personal-arten"
      caption={`Personalausgaben nach Arten ${periodenjahre}`}
      series={jahre.map((jahr) => ({ label: jahr, art: 'haushaltsjahr' as const }))}
      categories={arten.map((art) => ({ label: art.label, values: jahre.map((jahr) => art.werte[jahr]) }))}
      kategorieSpalte="Art"
      veraenderung
    />
    <DefinitionNote titel="Abgrenzung der Arten">
      <dl class="hh-begriffe">
        {arten.map((art) => (
          <div>
            <dt>{art.label}</dt>
            <dd>{art.definition} Umfang: {art.umfang}.</dd>
          </div>
        ))}
      </dl>
    </DefinitionNote>
  </section>

  <section class="section hh-fachabschnitt" aria-labelledby="einzelplaene">
    <div class="section-header"><h2 id="einzelplaene">Personalausgaben nach Einzelplänen</h2></div>
    <GroupedBarChart
      id="personal-einzelplaene-diagramm"
      caption={`Personalausgaben nach Einzelplänen ${periodenjahre}`}
      series={jahre.map((jahr) => ({ label: jahr, art: 'haushaltsjahr' as const }))}
      categories={plaeneSortiert.filter((plan) => jahre.some((jahr) => plan.werte[jahr] !== 0)).map((plan) => ({
        label: `${plan.ep} ${plan.name}`,
        values: jahre.map((jahr) => plan.werte[jahr]),
        href: getBudgetPeriodPlanUrl(id, plan.ep),
      }))}
      kategorieSpalte="Einzelplan"
      tabelle="keine"
      hinweis="Exakte Beträge und Anteile an den Ausgaben: Personalausgaben nach Einzelplänen"
      hinweisHref="#personal-einzelplaene"
    />
    <DataTableFrame
      id="personal-einzelplaene"
      label={`Personalausgaben nach Einzelplänen ${periodenjahre}`}
      caption={`Personalausgaben nach Einzelplänen ${periodenjahre}, Beträge in Euro`}
      nomenSingular="Einzelplan"
      nomenPlural="Einzelplänen"
      seitengroesse={false}
      exportFilename={`personalausgaben-einzelplaene-${id}.csv`}
      exportMeta={exportMeta}
      breite="sehr-breit"
    >
      <FilterBar slot="werkzeuge" id="personal-einzelplaene" suche={{ label: 'Einzelplan suchen' }} export={{}} />
      <table class="data-table hh-datentabelle">
        <thead>
          <tr>
            <th scope="col" class="hh-kennung" data-sort="text" data-export-key="einzelplan">Einzelplan</th>
            <th scope="col" data-sort="text" data-export-key="bezeichnung">Bezeichnung</th>
            {jahre.map((jahr, index) => (
              <th scope="col" class="hh-zahl" data-sort="number" data-export-key={`personalausgaben_${jahr}`} aria-sort={index === 0 ? 'descending' : undefined}>{jahr}</th>
            ))}
            <th scope="col" class="hh-zahl" data-sort="number" data-export-key="veraenderung">Veränderung {erstesJahr} → {letztesJahr}</th>
            {jahre.map((jahr) => (
              <th scope="col" class="hh-zahl" data-sort="number" data-export-key={`anteil_${jahr}`}>Anteil an den Ausgaben des Einzelplans {jahr}</th>
            ))}
          </tr>
        </thead>
        <tbody>
          {plaeneSortiert.map((plan) => (
            <tr id={`personal-ep-${plan.ep}`} data-search={normalizeSearch(`${plan.ep} ${plan.name}`)}>
              <th scope="row" class="hh-kennung"><a class="hh-zeilenanker" href={`#personal-ep-${plan.ep}`}>{plan.ep}</a></th>
              <td><a class="inline-link" href={getBudgetPeriodPlanUrl(id, plan.ep)}>{plan.name}</a></td>
              {jahre.map((jahr) => (
                <td class="hh-zahl" data-export-value={plan.werte[jahr]}><Amount value={plan.werte[jahr]} exakt /></td>
              ))}
              <td class="hh-zahl" data-export-value={plan.werte[letztesJahr] - plan.werte[erstesJahr]}><Amount value={plan.werte[letztesJahr] - plan.werte[erstesJahr]} vorzeichen exakt /></td>
              {jahre.map((jahr) => {
                const anteil = plan.ausgaben[jahr] === 0 ? null : plan.werte[jahr] / plan.ausgaben[jahr];
                return (
                  <td class="hh-zahl" data-sort={anteil ?? -1} data-export-value={anteil === null ? '' : anteil.toFixed(4)}>{anteil === null ? '–' : formatShare(anteil)}</td>
                );
              })}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row" colspan="2">Insgesamt (Hauptgruppe 4)</th>
            {ausgaben.map((eintrag) => <td class="hh-zahl"><Amount value={eintrag.betrag} exakt /></td>)}
            <td class="hh-zahl"><Amount value={ausgaben[ausgaben.length - 1].betrag - ausgaben[0].betrag} vorzeichen exakt /></td>
            {ausgaben.map((eintrag) => <td class="hh-zahl">{eintrag.anteil === null ? '–' : formatShare(eintrag.anteil)}</td>)}
          </tr>
        </tfoot>
      </table>
    </DataTableFrame>
  </section>

  <section class="section hh-fachabschnitt" aria-labelledby="personalstruktur">
    <div class="section-header"><h2 id="personalstruktur">Personalstruktur</h2></div>
    <DefinitionNote titel="Methodik">
      <p>Die Angaben sind modellierte Planäquivalente in Vollzeitäquivalenten, keine gezählten Beschäftigten; Bestandsprognosen sind Schätzungen. Grundlage ist der tatsächliche Personalstand vom 30. Juni 2024, fortgeschrieben auf die Haushaltsjahre und nach Aufgabenbereichen auf die Kapitel verteilt. Planäquivalente sind keine Freigabe von Planstellen.</p>
    </DefinitionNote>
    <KpiGrid
      label={`Planäquivalente ${periodenjahre}`}
      items={jahre.map((jahr, index) => ({
        label: `Planäquivalente ${jahr}`,
        value: strukturSumme[jahr].summe,
        format: 'number' as const,
        hint: 'Vollzeitäquivalente, Schätzung',
        ...(index > 0 ? { change: { value: strukturSumme[jahr].summe - strukturSumme[jahre[index - 1]].summe, format: 'number' as const, label: `gegenüber ${jahre[index - 1]}` } } : {}),
      }))}
    />

    <h3 class="hh-unterueberschrift">Planäquivalente nach Personalbereichen</h3>
    <DataTableFrame
      id="personal-planaequivalente"
      label={`Planäquivalente nach Personalbereichen ${periodenjahre}`}
      caption={`Planäquivalente nach Personalbereichen ${periodenjahre} (Vollzeitäquivalente, Schätzung)`}
      nomenSingular="Bereich"
      nomenPlural="Bereichen"
      seitengroesse={false}
      jahresansicht={erstesJahr}
      exportFilename={`planaequivalente-${id}.csv`}
      exportMeta={exportMeta}
      breite="breit"
    >
      <FilterBar
        slot="werkzeuge"
        id="personal-planaequivalente"
        suche={false}
        jahresansicht={{ label: 'Jahr', value: erstesJahr, options: [...jahre.map((jahr) => ({ value: jahr, label: jahr })), { value: 'alle', label: 'Beide Jahre' }] }}
        export={{}}
      />
      <table class="data-table hh-datentabelle">
        <thead>
          <tr>
            <th scope="col" data-sort="text" data-export-key="bereich">Personalbereich</th>
            {jahre.map((jahr) => (
              <>
                <th scope="col" class="hh-zahl" data-sort="number" data-year-col={jahr} data-export-key={`beamte_${jahr}`}>Beamt:innen und Richter:innen {jahr}</th>
                <th scope="col" class="hh-zahl" data-sort="number" data-year-col={jahr} data-export-key={`anwaerter_${jahr}`}>darunter Anwärter:innen {jahr}</th>
                <th scope="col" class="hh-zahl" data-sort="number" data-year-col={jahr} data-export-key={`arbeitnehmer_${jahr}`}>Arbeitnehmer:innen {jahr}</th>
                <th scope="col" class="hh-zahl" data-sort="number" data-year-col={jahr} data-export-key={`auszubildende_${jahr}`}>Auszubildende {jahr}</th>
                <th scope="col" class="hh-zahl" data-sort="number" data-year-col={jahr} data-export-key={`insgesamt_${jahr}`}>Insgesamt {jahr}</th>
              </>
            ))}
          </tr>
        </thead>
        <tbody>
          {struktur.map((zeile) => (
            <tr>
              <th scope="row">{zeile.label}</th>
              {jahre.map((jahr) => (
                <>
                  <td class="hh-zahl" data-year-col={jahr}><data value={String(zeile.jahre[jahr].beamte)}>{formatNumber(zeile.jahre[jahr].beamte)}</data></td>
                  <td class="hh-zahl" data-year-col={jahr}><data value={String(zeile.jahre[jahr].anwaerter)}>{formatNumber(zeile.jahre[jahr].anwaerter)}</data></td>
                  <td class="hh-zahl" data-year-col={jahr}><data value={String(zeile.jahre[jahr].arbeitnehmer)}>{formatNumber(zeile.jahre[jahr].arbeitnehmer)}</data></td>
                  <td class="hh-zahl" data-year-col={jahr}><data value={String(zeile.jahre[jahr].auszubildende)}>{formatNumber(zeile.jahre[jahr].auszubildende)}</data></td>
                  <td class="hh-zahl" data-year-col={jahr}><strong><data value={String(zeile.jahre[jahr].summe)}>{formatNumber(zeile.jahre[jahr].summe)}</data></strong></td>
                </>
              ))}
            </tr>
          ))}
        </tbody>
        <tfoot>
          <tr>
            <th scope="row">Insgesamt</th>
            {jahre.map((jahr) => (
              <>
                <td class="hh-zahl" data-year-col={jahr}>{formatNumber(strukturSumme[jahr].beamte)}</td>
                <td class="hh-zahl" data-year-col={jahr}>{formatNumber(strukturSumme[jahr].anwaerter)}</td>
                <td class="hh-zahl" data-year-col={jahr}>{formatNumber(strukturSumme[jahr].arbeitnehmer)}</td>
                <td class="hh-zahl" data-year-col={jahr}>{formatNumber(strukturSumme[jahr].auszubildende)}</td>
                <td class="hh-zahl" data-year-col={jahr}>{formatNumber(strukturSumme[jahr].summe)}</td>
              </>
            ))}
          </tr>
        </tfoot>
      </table>
    </DataTableFrame>
    <p class="hh-fliesstext hh-klein">Auszubildende sind Personen im Vorbereitungsdienst, die nach dem Gesetzentwurf im öffentlich-rechtlichen Ausbildungsverhältnis statt im Beamtenverhältnis auf Widerruf ausgebildet werden.</p>

    {strukturJahre.length > 0 ? (
      <>
        <h3 class="hh-unterueberschrift">Bestand und Wiederbesetzung bis {strukturJahre[strukturJahre.length - 1].jahr}</h3>
        <p class="hh-fliesstext">Die vorhandenen Beamt:innen scheiden nach und nach in den Ruhestand aus. Nach dem Gesetzentwurf werden frei werdende Stellen in der Besoldungsordnung O, mit Richter:innen und Staatsanwält:innen oder im Arbeitsverhältnis wiederbesetzt. Alle Werte sind Schätzungen in Köpfen.</p>
        <TimeSeriesChart
          id="personal-bestand"
          caption={`Vorhandene Beamt:innen im Dienst und Besetzungen im Arbeitsverhältnis ${strukturJahre[0].jahr} bis ${strukturJahre[strukturJahre.length - 1].jahr} (Schätzung)`}
          jahre={strukturJahre.map((eintrag) => ({ jahr: eintrag.jahr, art: jahresart(eintrag.jahr, jahre) }))}
          series={[
            { label: 'Vorhandene Beamt:innen im Dienst', values: strukturJahre.map((eintrag) => eintrag.bestandsbeamte) },
            { label: 'Besetzungen im Arbeitsverhältnis statt Verbeamtung, aufgelaufen', values: strukturJahre.map((eintrag) => eintrag.arbeitsverhaeltnisKumuliert) },
          ]}
          format="number"
          typ="linie"
        />
        <DataTableFrame
          id="personal-wiederbesetzung"
          label="Bestand und Wiederbesetzung je Jahr"
          caption="Bestand und Wiederbesetzung je Jahr, alle Personalbereiche (Köpfe, Schätzung)"
          nomenSingular="Jahr"
          nomenPlural="Jahren"
          seitengroesse={false}
          exportFilename={`wiederbesetzung-${id}.csv`}
          exportMeta={exportMeta}
          breite="sehr-breit"
        >
          <FilterBar slot="werkzeuge" id="personal-wiederbesetzung" suche={false} export={{}} />
          <table class="data-table hh-datentabelle">
            <thead>
              <tr>
                <th scope="col" data-export-key="jahr">Jahr</th>
                <th scope="col" class="hh-zahl" data-export-key="bestand">Vorhandene Beamt:innen im Dienst</th>
                <th scope="col" class="hh-zahl" data-export-key="ruhestand">Ruhestandszugänge</th>
                <th scope="col" class="hh-zahl" data-export-key="bisher">Wiederbesetzung im Beamtenverhältnis nach bisherigem Recht (Vergleich)</th>
                <th scope="col" class="hh-zahl" data-export-key="o">Einstellungen in der Besoldungsordnung O</th>
