      breite="breit"
    >
      <FilterBar slot="werkzeuge" id="dienstrecht-regelungen" suche={{ label: 'Regelung suchen' }} jahresansicht={{ label: 'Jahre', value: 'haushalt', options: jahresansichtOptionen }} export={{}} />
