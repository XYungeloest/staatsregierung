---
import BaseLayout from '../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getHomeUrl, getLawSearchUrl, getPortalSearchUrl } from '@ostrecht/shared/lib/portal/index.ts';

const indexUrl = `${import.meta.env.BASE_URL}search-index.json`;
const lawIndexUrl = `${import.meta.env.BASE_URL}search-index-recht.json`;
const sectionOptions = siteConfig.sections.filter((section) => section.key !== 'home' && section.key !== 'law');
---

<BaseLayout
  title="Suche"
  description="Durchsuchen Sie Themen, Pressemitteilungen, Personen, Haushalt, Service und das Rechtsportal des Ostdeutschen Freistaates."
  breadcrumbs={[
    { label: 'Startseite', href: getHomeUrl() },
    { label: 'Suche', href: getPortalSearchUrl() },
  ]}
  noindex={true}
>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Suche' }]} />

  <section class="section page-header">
    <p class="eyebrow">Portalsuche</p>
    <h1>Wonach suchen Sie?</h1>
    <p class="lead">
      Die Suche findet Seiten des Staatsportals und Vorschriften des Rechtsportals. Beide werden
      getrennt ausgewiesen; der Bereichsfilter grenzt auf einen von beiden ein.
    </p>
  </section>

  <section
    class="section search-shell"
    data-portal-search-root
    data-index-url={indexUrl}
    data-law-index-url={lawIndexUrl}
    data-law-search-url={getLawSearchUrl()}
  >
    <form class="filter-bar" method="get" action={getPortalSearchUrl()} data-portal-search-form>
      <div class="filter-bar__fields">
        <label class="filter-field filter-field--wide" for="portal-search-query">
          <span>Suchbegriff</span>
          <input
            id="portal-search-query"
            type="search"
            name="q"
            autocomplete="off"
            placeholder="z. B. Kreisreform, Haushalt, Wohnvergesellschaftung, OstSchulG"
            data-portal-search-query
          />
        </label>
        <label class="filter-field" for="portal-search-area">
          <span>Bereich</span>
          <select id="portal-search-area" name="bereich" data-portal-search-area>
            <option value="">Alle Bereiche</option>
            <option value="portal">Nur Staatsportal</option>
            {sectionOptions.map((section) => (
              <option value={`portal:${section.key}`}>&nbsp;&nbsp;{section.label}</option>
            ))}
            <option value="law">Nur Recht</option>
          </select>
        </label>
        <label class="filter-field" for="portal-search-sort">
          <span>Sortierung</span>
          <select id="portal-search-sort" name="sort" data-portal-search-sort>
            <option value="relevance">Relevanz</option>
            <option value="latest">Aktualität</option>
          </select>
        </label>
      </div>
      <div class="filter-bar__actions">
        <button class="button-link" type="submit">Suchen</button>
        <button class="button-link button-link--secondary" type="reset" data-portal-search-reset>
          Zurücksetzen
        </button>
      </div>
    </form>

    <p class="search-feedback search-feedback--hint" data-portal-search-status role="status" aria-live="polite">
      Geben Sie einen Begriff ein, zum Beispiel Kreisreform, Haushalt, Kabinett oder eine
      Gesetzesabkürzung.
    </p>
    <p class="search-feedback search-feedback--examples" data-portal-search-examples>
      Beispiele: Kreisreform, Bildungsreform, Wohnvergesellschaftung, Kabinett, OGVBl.
    </p>
    <p class="search-feedback search-feedback--warning" data-portal-search-empty hidden>
      Keine Treffer gefunden. Prüfen Sie die Schreibweise oder wählen Sie einen anderen Bereich.
    </p>
    <p class="search-feedback search-feedback--warning" data-portal-search-error hidden>
      Die Suche ist derzeit nicht erreichbar. Nutzen Sie vorübergehend die Bereiche Recht, Themen,
      Presse und Service.
    </p>

    <div class="search-groups" data-portal-search-groups></div>

    <p class="search-results__more" data-portal-search-more-wrap hidden>
      <button class="button-link button-link--secondary" type="button" data-portal-search-more>
        Weitere Treffer laden
      </button>
    </p>
  </section>

  <script>
    import '../scripts/portal-search-page.ts';
  </script>
</BaseLayout>
