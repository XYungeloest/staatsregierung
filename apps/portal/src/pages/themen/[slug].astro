---
import { publicLegalSources, type PublicLegalSource } from '../../lib/project-status.ts';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import FaqAccordion from '../../components/portal/FaqAccordion.astro';
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import SectionNavigation from '../../components/portal/SectionNavigation.astro';
import TopicLegalSources from '../../components/portal/TopicLegalSources.astro';
import { campaign, campaignPath, campaignSummary } from '../../lib/fresswuerfel/config.ts';
import TopicBriefing from '../../components/portal/TopicBriefing.astro';
import TopicModule from '../../components/portal/TopicModule.astro';
import ThemaHaushalt from '../../components/haushalt/ThemaHaushalt.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { loadAllNormMetas } from '@ostrecht/shared/lib/norms/loader.ts';
import {
  getPublicationLabel,
  loadAllVerkuendungen,
} from '@ostrecht/shared/lib/norms/publications.ts';
import { getPublicationUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import { formatTopicStatus } from '@ostrecht/shared/lib/portal/presentation.ts';
import { loadLegislativeProcedures } from '@ostrecht/shared/lib/portal/legislation.ts';
import {
  getBudgetUrl, getHoldingsUrl, getTopicUrl, getSchoolSystemUrl,
  getEventUrl,
  getFreestatePageUrl,
  getHomeUrl,
  getKreisreformUrl,
  getMinistryUrl,
  getPressReleaseUrl,
  getTopicsUrl,
} from '@ostrecht/shared/lib/portal/index.ts';
import {
  loadEvents,
  loadMinistries,
  loadPressReleases,
  loadTopics,
} from '@ostrecht/shared/lib/portal/content.ts';
import { PORTAL_REFERENCE_DATE } from '@ostrecht/shared/lib/portal/dates.ts';
import type { Themenseite } from '@ostrecht/shared/lib/portal/index.ts';

export async function getStaticPaths() {
  const [topics, norms, publications] = await Promise.all([loadTopics(), loadAllNormMetas(), loadAllVerkuendungen()]);
  const resolveSource = publicLegalSources(norms, publications);
  return topics.map((topic) => ({
    params: { slug: topic.slug },
    props: { topic, legalReferences: topic.rechtsgrundlagen.map(resolveSource) },
  }));
}

const { topic, legalReferences } = Astro.props as {
  topic: Themenseite;
  legalReferences: PublicLegalSource[];
};
const topics = await loadTopics();
const ministries = await loadMinistries();
const ministryLookup = new Map(ministries.map((ministry) => [ministry.slug, ministry]));
const leadMinistry = topic ? ministryLookup.get(topic.federfuehrendesRessort) : undefined;
const coMinistries = (topic?.mitzeichnungsressorts ?? [])
  .map((slug) => ministryLookup.get(slug))
  .filter((entry): entry is NonNullable<typeof entry> => Boolean(entry));

const [pressReleases, events, legislativeProcedures] = topic
  ? await Promise.all([
      loadPressReleases(),
      loadEvents(),
      loadLegislativeProcedures(),
    ])
  : [[], [], []];
const pageType = topic?.pageType ?? 'compact';
const relatedProcedures = topic
  ? legislativeProcedures.filter((procedure) => procedure.relatedTopics.includes(topic.slug))
  : [];
const relatedPress = topic
  ? pressReleases.filter((release) => release.relatedTopicSlugs?.includes(topic.slug)).slice(0, 3)
  : [];
const relatedEvents = topic
  ? events.filter((event) => event.relatedTopicSlugs?.includes(topic.slug)).slice(0, 3)
  : [];
const relatedPublications = [...new Map(
  legalReferences
    .flatMap((entry) => entry.publication ? [[entry.publication.slug, entry.publication] as const] : []),
).values()].slice(0, 3);
const relatedTopics = topic
  ? (topic.relatedTopicSlugs?.length
      ? topic.relatedTopicSlugs.flatMap((slug) => {
          const match = topics.find((entry) => entry.slug === slug);
          return match ? [match] : [];
        })
      : topics.filter((entry) => entry.slug !== topic.slug && entry.cluster === topic.cluster).slice(0, 3))
  : [];
const hasFurtherInformation = relatedProcedures.length > 0
  || relatedPress.length > 0
  || relatedEvents.length > 0
  || relatedPublications.length > 0;
const applications = {
  territory: { label: 'Gemeinde, Kreis und Bezirk finden', href: `${getKreisreformUrl()}#bezirk-suche` },
  budget: { label: 'Haushaltsperioden und Einzelpläne öffnen', href: `${getBudgetUrl()}#perioden` },
  holdings: { label: 'Beteiligungen durchsuchen', href: `${getHoldingsUrl()}#beteiligungsnavigator` },
};
const application = topic?.application ? applications[topic.application] : undefined;
const Background = application ? 'details' : 'div';
const heading = pageType === 'dossier' ? 'Reformdossier' : 'Politik & Vorhaben';
const dossierLinks = [
  ...topic.modules.map((module) => ({ label: module.title, href: `#${module.id}` })),
  ...(legalReferences.length ? [{ label: 'Rechtsgrundlagen', href: '#rechtsgrundlagen' }] : []),
  { label: 'Stand des Vorhabens', href: '#ueberblick' },
  ...(topic.impacts?.length ? [{ label: 'Auswirkungen', href: '#auswirkungen' }] : []),
  ...(hasFurtherInformation ? [{ label: 'Verfahren und Veröffentlichungen', href: '#aktuelle-bezuege' }] : []),
  ...(topic.faq.length ? [{ label: 'Häufige Fragen', href: '#faq' }] : []),
  { label: 'Zuständigkeit', href: '#zustaendigkeit' },
];
---

{topic ? (
  <BaseLayout
    title={topic.title}
    description={topic.teaser}
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Politik & Vorhaben', href: getTopicsUrl() },
      { label: topic.title },
    ]}
    scripts={['portal-modules']}
  >
    <Breadcrumbs
      items={[
        { label: 'Startseite', href: getHomeUrl() },
        { label: 'Politik & Vorhaben', href: getTopicsUrl() },
        { label: topic.title },
      ]}
    />

    <div class={`topic-page topic-page--${pageType}`}>
    <SectionHero eyebrow={heading} title={topic.title} titleSize="long" lead={application ? topic.teaser : topic.hero ?? topic.teaser}
      status={formatTopicStatus(topic.status)} variant="topics" density={pageType === 'application' ? 'tool' : pageType}
      actions={application ? [{ ...application, primary: true }] : []} />

    {pageType === 'dossier' && <SectionNavigation collapsible label="In diesem Dossier" variant="topics" items={dossierLinks} />}
    {topic.modules.map((module) => <TopicModule {module} referenceDate={PORTAL_REFERENCE_DATE}
      hasLegalGroup={legalReferences.some((entry) => entry.group === module.id)} />)}
    <TopicBriefing {topic} referenceDate={PORTAL_REFERENCE_DATE} compact={Boolean(application)} />

    {!application && <ThemaHaushalt topicSlug={topic.slug} />}

    <TopicLegalSources {topic} references={legalReferences} />

    <Background class:list={[application && 'section topic-application-background']}>
    {application && <summary>Hintergründe, Quellen und Zuständigkeit</summary>}
    {application && <ThemaHaushalt topicSlug={topic.slug} />}
    {hasFurtherInformation ? (
      <section id="aktuelle-bezuege" class="section section-muted topic-relations" aria-labelledby="aktuelle-bezuege-title">
        <div class="section-header">
          <p class="eyebrow">Zusammenhänge</p>
          <h2 id="aktuelle-bezuege-title">Verfahren, Termine und Veröffentlichungen</h2>

        </div>
        <div class="topic-relations-grid">
          {relatedEvents.length > 0 ? (
            <section aria-labelledby="termine-title">
              <h3 id="termine-title"><PortalIcon name="calendar" /> Termine</h3>
              <ul>
                {relatedEvents.map((event) => (
                  <li><time datetime={event.date}>{siteConfig.date.formatLong(event.date)}</time><a href={getEventUrl(event.slug)}>{event.title}</a><p>{event.teaser}</p></li>
                ))}
              </ul>
            </section>
          ) : null}
          {relatedPress.length > 0 ? (
            <section aria-labelledby="presse-title">
              <h3 id="presse-title"><PortalIcon name="press" /> Presse</h3>
              <ul>
                {relatedPress.map((release) => (
                  <li><time datetime={release.date}>{siteConfig.date.formatLong(release.date)}</time><a href={getPressReleaseUrl(release.slug)}>{release.title}</a></li>
                ))}
              </ul>
            </section>
          ) : null}
          {relatedPublications.length > 0 ? (
            <section aria-labelledby="verkuendungen-title">
              <h3 id="verkuendungen-title"><PortalIcon name="law" /> Verkündungen</h3>
              <ul>
                {relatedPublications.map((publication) => (
                  <li><time datetime={publication.date}>{siteConfig.date.formatLong(publication.date)}</time><a href={getPublicationUrl(publication.slug)}>{getPublicationLabel(publication)}</a></li>
                ))}
              </ul>
            </section>
          ) : null}
          {relatedProcedures.length > 0 ? (
            <section aria-labelledby="verfahren-title">
              <h3 id="verfahren-title"><PortalIcon name="government" /> Gesetzgebung</h3>
              <ul>
                {relatedProcedures.slice(0, 4).map((procedure) => (
                  <li><span>Drucksache {procedure.documentNumber}</span><strong>{procedure.shortTitle}</strong><p>{procedure.statusLabel}</p></li>
                ))}
              </ul>
            </section>
          ) : null}
        </div>
      </section>
    ) : null}

    {topic.faq.length > 0 ? <section id="faq" class="section" aria-labelledby="faq-title">
      <div class="section-header">
        <p class="eyebrow">Fragen und Antworten</p>
        <h2 id="faq-title">Häufige Fragen</h2>
      </div>
      <FaqAccordion items={topic.faq} />
    </section> : <span id="faq" aria-hidden="true"></span>}

    <section id="zustaendigkeit" class="section section-muted topic-responsibility" aria-labelledby="zustaendigkeit-title">
      <div class="section-header">
        <p class="eyebrow">Verantwortung</p>
        <h2 id="zustaendigkeit-title">Zuständiges Ressort</h2>

      </div>
      {leadMinistry && <p>Federführung · <a href={getMinistryUrl(leadMinistry.slug)}>{leadMinistry.name}</a></p>}
      {coMinistries.length > 0 ? (
        <div class="topic-co-ministries">
          <h3>Mitwirkende Ressorts</h3>
          <ul>
            {coMinistries.map((ministry) => <li><a href={getMinistryUrl(ministry.slug)}>{ministry.kurzname}</a></li>)}
          </ul>
        </div>
      ) : null}
    </section>

    {relatedTopics.length > 0 ? (
      <section class="section topic-related" aria-labelledby="verwandte-themen-title">
        <div class="section-header">
          <p class="eyebrow">Weiterlesen</p>
          <h2 id="verwandte-themen-title">Verwandte Vorhaben</h2>
        </div>
        <ul class="topic-related-links">
          {relatedTopics.map((entry) => <li><a href={getTopicUrl(entry.slug)}>{entry.title}</a></li>)}
        </ul>
      </section>
    ) : null}

    {topic.application === 'territory' && <p id="kreisreform-link-title"><a href={getFreestatePageUrl('berlin')}>Berlin im Freistaat</a></p>}
    {topic.slug === 'bildungsreform' && <p class="section-link-row"><a href={getSchoolSystemUrl()}>Schularten, Übergänge und Abschlüsse</a></p>}
    {topic.slug === 'staatsreform-und-verfassung' && <p class="section-link-row"><a href={getFreestatePageUrl('staatsaufbau')}>Die heutige Staatsorganisation</a></p>}
    {topic.slug === 'oeffentliche-wirtschaft-und-strukturwandel' && <nav class="section link-list" aria-label="Unternehmen und Beteiligungen">
      <a href={applications.holdings.href}>Öffentliche Beteiligungen im Verzeichnis</a>
      <a href={campaignPath}>{campaignSummary(campaign).title}</a>
    </nav>}
    </Background>
    </div>
  </BaseLayout>
) : (
  <BaseLayout
    title="Thema nicht gefunden"
    description="Die angeforderte Themenseite konnte nicht geladen werden."
    breadcrumbs={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Politik & Vorhaben', href: getTopicsUrl() },
      { label: 'Nicht gefunden' },
    ]}
  >
    <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Politik & Vorhaben', href: getTopicsUrl() }, { label: 'Nicht gefunden' }]} />
    <section class="section">
      <div class="status-notice status-notice--warning">
        <h1>Themenseite nicht gefunden</h1>
        <p>Der angeforderte Inhalt konnte nicht gefunden werden. Bitte nutzen Sie die Themenübersicht.</p>
      </div>
    </section>
  </BaseLayout>
)}
