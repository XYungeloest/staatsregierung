---
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import EducationPathNav from '../../../../components/portal/EducationPathNav.astro';
import SchoolSystemChart from '../../../../components/portal/SchoolSystemChart.astro';
import SchoolSystemTable from '../../../../components/portal/SchoolSystemTable.astro';
import SchoolTypeCards from '../../../../components/portal/SchoolTypeCards.astro';
import {
  getContactUrl,
  getEducationAndSchoolUrl,
  getHomeUrl,
  getLawHomeUrl,
  getMinistryUrl,
  getSchoolSystemUrl,
  getTopicUrl,
  getTopicsUrl,
} from '@ostrecht/shared/lib/portal/index.ts';
import { getNormUrl } from '@ostrecht/shared/lib/norms/index.ts';

const title = 'Schulsystem des Ostdeutschen Freistaates | Bildung und Schule';
const pageTitle = 'Schulsystem des Ostdeutschen Freistaates';
const description = 'Überblick über Polytechnische und Erweiterte Oberschule, berufliche Bildungswege, Abschlüsse und Übergänge im Freistaat Ostdeutschland.';
const breadcrumbs = [
  { label: 'Startseite', href: getHomeUrl() },
  { label: 'Themen', href: getTopicsUrl() },
  { label: 'Bildung und Schule', href: getEducationAndSchoolUrl() },
  { label: 'Schulsystem', href: getSchoolSystemUrl() },
];
---

<BaseLayout
  title={title}
  description={description}
  breadcrumbs={breadcrumbs}
  ogType="article"
>
  <Breadcrumbs
    items={breadcrumbs.map((item, index) => index === breadcrumbs.length - 1 ? { label: item.label } : item)}
  />

  <section class="section page-header">
    <p class="eyebrow">Bildung und Schule</p>
    <h1>{pageTitle}</h1>
    <p class="lead">
      Die Polytechnische Oberschule führt als gemeinsame Schulart von Klasse 1 bis 10. Daran
      schließen die Erweiterte Oberschule, berufliche Bildungswege und der zweite Bildungsweg an.
    </p>
    <nav class="hero-actions" aria-label="Direkteinstiege Schulsystem">
      <a class="button-link" href="#grafik">Übersicht zum Schulsystem ansehen</a>
      <a class="button-link button-link--secondary" href="#allgemeinbildende-schulen">Schularten im Überblick</a>
    </nav>
  </section>

  <EducationPathNav />

  <section id="ueberblick" class="section school-system-intro" aria-labelledby="ueberblick-title">
    <div class="section-header">
      <h2 id="ueberblick-title">Überblick</h2>
      <p>
        Die Polytechnische Oberschule (POS) umfasst die Primarstufe in den Klassen 1 bis 4 und
        die Sekundarstufe I in den Klassen 5 bis 10. Beide Stufen gehören zu derselben Schulart;
        der Übergang nach Klasse 4 ist kein Schulartwechsel.
      </p>
    </div>
    <p>
      Die Erweiterte Oberschule (EOS) umfasst die Jahrgangsstufen 11 und 12 und führt zur
      allgemeinen Hochschulreife. Förderschulen und die beruflichen Schularten bleiben
      eigenständige Bestandteile des Schulsystems.
    </p>
    <aside class="panel school-system-status" aria-labelledby="rechtsstand-title">
      <p class="eyebrow">Rechts- und Umsetzungsstand</p>
      <h3 id="rechtsstand-title">Schulstruktur seit 1. August 2026</h3>
      <p>
        Die neue Schulstruktur gilt seit dem 1. August 2026. Die dazugehörigen Schulordnungen
        wurden vom 14. bis 16. August 2026 verkündet und treten überwiegend am 1. September 2026
        in Kraft. Bis zum 31. August gelten die jeweiligen Übergangsbestimmungen.
      </p>
    </aside>
  </section>

  <section id="grafik" class="section school-system-section-muted school-system-chart-section" aria-labelledby="grafik-title" data-visual-section="school-system-chart">
    <div class="section-header">
      <h2 id="grafik-title">Bildungswege im Überblick</h2>
      <p>
        Die Übersicht zeigt die POS als eine Schulart von Klasse 1 bis 10, die Brückenfunktion
        ihrer Klasse 10 zur EOS sowie berufliche und zweite Bildungswege.
      </p>
    </div>
    <SchoolSystemChart />
    <SchoolSystemTable />
  </section>

  <section id="allgemeinbildende-schulen" class="section" aria-labelledby="allgemeinbildende-title">
    <div class="section-header">
      <h2 id="allgemeinbildende-title">Allgemeinbildende Schulen</h2>
      <p>
        POS, EOS und Förderschulen bilden die allgemeinbildende Schulstruktur. Primar- und
        Sekundarstufe I sind innerhalb der POS verbunden.
      </p>
    </div>
    <SchoolTypeCards group="Allgemeinbildende Schulen" />
  </section>

  <section id="berufsbildende-schulen" class="section school-system-section-muted" aria-labelledby="berufsbildende-title">
    <div class="section-header">
      <h2 id="berufsbildende-title">Berufsbildende Schulen</h2>
      <p>
        Berufsbildende Schulen verbinden schulisches Lernen mit beruflicher Qualifizierung,
        Ausbildung, Studienzugang und Weiterbildung.
      </p>
    </div>
    <SchoolTypeCards group="Berufsbildende Schulen" />
  </section>

  <section id="abschluesse-und-uebergaenge" class="section" aria-labelledby="abschluesse-title">
    <div class="section-header">
      <h2 id="abschluesse-title">Abschlüsse und Übergänge</h2>
      <p>
        Die ab 1. September 2026 geltende Schulordnung verwendet eigene ostdeutsche
        Abschlussbezeichnungen. Die herkömmlichen Begriffe erläutern nur, welchen Berechtigungen
        die POS-Abschlüsse gleichgestellt sind.
      </p>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong>Abschluss der Polytechnischen Oberschule nach Klassenstufe 9</strong>
        <span>Er ist in seinen Berechtigungen dem Hauptschulabschluss gleichgestellt.</span>
      </li>
      <li class="record-list__item">
        <strong>Abschluss der Polytechnischen Oberschule nach Klassenstufe 10</strong>
        <span>Er ist in seinen Berechtigungen dem mittleren Schulabschluss (Realschulabschluss) gleichgestellt.</span>
      </li>
      <li class="record-list__item">
        <strong>Klasse 10 als Brücke zur EOS</strong>
        <span>Für Schüler:innen mit angestrebtem EOS-Übergang übernimmt sie die Funktion der Einführungsphase. Sie bleibt rechtlich, organisatorisch und schulartbezogen Teil der POS.</span>
      </li>
      <li class="record-list__item">
        <strong>Allgemeine Hochschulreife</strong>
        <span>Sie wird nach der Qualifikationsphase der EOS und der Abiturprüfung erworben.</span>
      </li>
    </ul>
  </section>

  <section id="schulprofil-und-bewertung" class="section school-system-section-muted" aria-labelledby="profil-title">
    <div class="section-header">
      <h2 id="profil-title">Schulprofil und Leistungsbewertung</h2>
      <p>
        Die überwiegend ab 1. September 2026 geltenden Schulordnungen regeln gemeinsame Bildung,
        Praxisbezug, Leistungsbewertung und die Stellung von Ethik, Religion und Weltanschauung.
      </p>
    </div>
    <div class="card-grid card-grid--three school-system-facts">
      <article class="panel">
        <h3>Polytechnische Bildung</h3>
        <p>
          Allgemeinbildung wird mit technischen, wirtschaftlichen und berufspraktischen
          Lernbereichen verbunden. Berufliche Orientierung, praktische Lernleistungen und das
          Produktive Lernen unterstützen den Übergang in Ausbildung und Beruf.
        </p>
      </article>
      <article class="panel">
        <h3>Noten und Punkte</h3>
        <p>
          Das allgemeine Schulnotenrecht verwendet die Noten 1 „sehr gut“, 2 „gut“,
          3 „befriedigend“, 4 „genügend“ und 5 „ungenügend“. In der Qualifikationsphase der EOS
          gilt weiterhin das System von 0 bis 15 Punkten.
        </p>
      </article>
      <article class="panel">
        <h3>Ethik als Pflichtfach</h3>
        <p>
          Öffentliche Schulen sind bekenntnisfrei. Ethik ist Pflichtfach. Religions- oder
          Weltanschauungsunterricht kann freiwillig zusätzlich angeboten werden, ersetzt Ethik
          aber nicht und ist nicht versetzungs-, abschluss-, aufnahme- oder
          gesamtqualifikationsrelevant.
        </p>
      </article>
    </div>
  </section>

  <section id="zweiter-bildungsweg" class="section school-system-section-muted" aria-labelledby="zweiter-title">
    <div class="section-header">
      <h2 id="zweiter-title">Zweiter Bildungsweg</h2>
      <p>
        Abendoberschule, Abendgymnasium und Kolleg ermöglichen Erwachsenen, einen Schulabschluss
        nachzuholen oder die allgemeine Hochschulreife zu erwerben.
      </p>
    </div>
    <SchoolTypeCards group="Weitere Bildungswege" ids={['zweiter-bildungsweg-card']} />
  </section>

  <section id="schulen-in-freier-traegerschaft" class="section" aria-labelledby="freie-title">
    <div class="section-header">
      <h2 id="freie-title">Schulen in freier Trägerschaft</h2>
      <p>
        Schulen in freier Trägerschaft ergänzen die öffentliche Schullandschaft. Sie benötigen
        die vorgesehene Genehmigung oder Anerkennung und müssen die Anforderungen an Unterricht,
        Abschlüsse und Gleichwertigkeit erfüllen.
      </p>
    </div>
    <SchoolTypeCards group="Weitere Bildungswege" ids={['freie-traegerschaft-card']} />
  </section>

  <section id="foerderung-und-unterstuetzung" class="section school-system-section-muted" aria-labelledby="foerderung-title">
    <div class="section-header">
      <h2 id="foerderung-title">Förderung und Unterstützung</h2>
      <p>
        Förderung soll Bildungswege stabilisieren und Übergänge erleichtern. Dazu gehören
        individuelle Unterstützung, sonderpädagogische Förderung, berufliche Orientierung und
        begleitende Angebote im Schulalltag.
      </p>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong>Individuelle Förderung</strong>
        <span>Schulen berücksichtigen Lernstand, Entwicklung und besonderen Unterstützungsbedarf.</span>
      </li>
      <li class="record-list__item">
        <strong>Berufliche Orientierung</strong>
        <span>Übergänge in Ausbildung, berufliche Schulen und Studium werden frühzeitig vorbereitet.</span>
      </li>
      <li class="record-list__item">
        <strong>Alltagsnahe Unterstützung</strong>
        <span>Ergänzende Programme können Teilhabe, Gesundheit und soziale Stabilität im Schulalltag stärken.</span>
      </li>
    </ul>
    <SchoolTypeCards group="Weitere Bildungswege" ids={['foerderangebote-card', 'studienqualifizierung-card']} />
  </section>

  <section id="rechtsgrundlagen" class="section" aria-labelledby="rechtsgrundlagen-title">
    <div class="section-header">
      <h2 id="rechtsgrundlagen-title">Rechtsgrundlagen</h2>
      <p>
        Das Rechtsportal dokumentiert die verkündeten Vorschriften und ihre gespeicherten
        Fassungen. Angezeigt ist hier eine nutzerorientierte Auswahl für den Überblick.
      </p>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('gesetz-zur-neuordnung-des-ostdeutschen-schulsystems')}>Gesetz zur Neuordnung des Ostdeutschen Schulsystems</a></strong>
        <span>Zentrale schulrechtliche Grundlage im Rechtsportal.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('schulordnung-polytechnische-oberschulen')}>Schulordnung Polytechnische Oberschulen</a></strong>
        <span>Regelt Aufbau, Unterricht, Leistungsbewertung und Abschlüsse der POS.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('schulordnung-erweiterte-oberschulen-und-abiturpruefung')}>Schulordnung Erweiterte Oberschulen und Abiturprüfung</a></strong>
        <span>Regelt Qualifikationsphase und Abiturprüfung der EOS.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('schulordnung-abendoberschulen')}>Schulordnung Abendoberschulen</a></strong>
        <span>Regelt die POS-Abschlüsse im zweiten Bildungsweg.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('abendgymnasien-und-kollegverordnung')}>Abendgymnasien- und Kollegverordnung</a></strong>
        <span>Regelt die Bildungsgänge zur allgemeinen Hochschulreife für Erwachsene.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('verordnung-zur-aenderung-der-schulordnung-foerderschulen-2026')}>Änderung der Schulordnung Förderschulen</a></strong>
        <span>Passt das Förderschulrecht an die neue Schulstruktur an.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('sorbische-schulverordnung')}>Sorbische Schulverordnung</a></strong>
        <span>Regelt sorbische Schulen und sorbischen Unterricht.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('ethik-und-religionsunterrichtverordnung')}>Ethik und Religionsunterrichtverordnung</a></strong>
        <span>Regelt Ethik sowie freiwilligen Religions- und Weltanschauungsunterricht.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('verordnung-zur-bereinigung-des-allgemeinbildenden-schulordnungsrechts-2026')}>Bereinigung des allgemeinbildenden Schulordnungsrechts</a></strong>
        <span>Bereinigt Übergangsrecht und überholte Vorschriften zum 31. August und 1. September 2026.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('vwv-stundentafel-eos')}>VwV Stundentafel EOS</a></strong>
        <span>Enthält Lehrpläne und Stundentafeln für die Einführungsfunktion und die EOS.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getNormUrl('vwv-produktives-lernen-pos')}>VwV Produktives Lernen POS</a></strong>
        <span>Regelt die besondere Verbindung von schulischem und praktischem Lernen.</span>
      </li>
    </ul>
  </section>

  <section id="zustaendige-stellen" class="section school-system-section-muted" aria-labelledby="stellen-title">
    <div class="section-header">
      <h2 id="stellen-title">Informationen zur zuständigen Behörde</h2>
      <p>
        Die fachliche Zuständigkeit für Schularten, Schulorganisation,
        Unterrichtsentwicklung und Bildungswege liegt beim zuständigen Bildungsressort des
        Ostdeutschen Freistaates.
      </p>
    </div>
    <article class="panel">
      <h3>Zuständige Stelle</h3>
      <p>Staatssekretariat für Volksbildung und Wissenschaft</p>
      <p>
        <a class="inline-link" href={getMinistryUrl('bildung-und-sportliche-ertuechtigung')}>Zum zuständigen Ressort</a>
        <span aria-hidden="true"> · </span>
        <a class="inline-link" href={getContactUrl()}>Kontakt</a>
        <span aria-hidden="true"> · </span>
        <a class="inline-link" href={getLawHomeUrl()}>Rechtsportal</a>
        <span aria-hidden="true"> · </span>
        <a class="inline-link" href={getEducationAndSchoolUrl()}>Themenbereich Bildung und Schule</a>
      </p>
    </article>
  </section>

  <section class="section" aria-labelledby="verwandte-title">
    <div class="section-header">
      <h2 id="verwandte-title">Verwandte Themen</h2>
    </div>
    <ul class="record-list">
      <li class="record-list__item">
        <strong><a class="inline-link" href={getTopicUrl('bildungsreform')}>Bildungsreform</a></strong>
        <span>Umsetzungsstand und nächste Schritte der Bildungsreform.</span>
      </li>
      <li class="record-list__item">
        <strong><a class="inline-link" href={getEducationAndSchoolUrl()}>Bildung und Schule</a></strong>
        <span>Übergeordneter Einstieg zu schulischer Bildung.</span>
      </li>
    </ul>
  </section>
</BaseLayout>
