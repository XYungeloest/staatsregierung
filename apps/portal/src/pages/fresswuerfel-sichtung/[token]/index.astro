---
import '@ostrecht/shared/styles/fonts.css';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getCampaignEnv } from '../../../lib/fresswuerfel/server.ts';
import { hasReviewAccess, loadReview, reviewHeaders, reviewUnavailable } from '../../../lib/fresswuerfel/review.ts';
export const prerender = false;
const env = await getCampaignEnv();
if (!hasReviewAccess(Astro.params.token, env)) return reviewUnavailable();
for (const [key, value] of Object.entries(reviewHeaders)) Astro.response.headers.set(key, value);
let review;
try { review = await loadReview(env, Astro.url); }
catch { return reviewUnavailable(503); }
const base = `/fresswuerfel-sichtung/${Astro.params.token}/`;
const date = (timestamp: number) => new Intl.DateTimeFormat('de-DE', { timeZone: 'Europe/Berlin', dateStyle: 'medium', timeStyle: 'short' }).format(timestamp);
const pageHref = (page: number) => `${base}?${new URLSearchParams({ sort: review.sort, seite: String(page) })}`;
---
<!doctype html>
<html lang="de">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex,nofollow,noarchive,nosnippet,noimageindex" />
    <meta name="referrer" content="no-referrer" />
    <meta name="description" content="Fresswürfel: gemeinsame Sichtung der eingereichten Maskottchen-Ideen." />
    <title>Fresswürfel – Ideen zur Sichtung</title>
  </head>
  <body>
    <a class="skip-link" href="#ideen">Zu den Ideen</a>
    <div class="notice">{siteConfig.simulationNotice}</div>
    <header class="shell brand-row">
      <a href="/themen/fresswuerfel-maskottchen/" class="brand" aria-label="Zur öffentlichen Wettbewerbsseite"><img src="/images/fresswuerfel/logo.png" alt="Fresswürfel" width="2172" height="724" /></a>
      <span class="review-label">Gemeinsame Sichtung</span>
    </header>
    <main class="shell">
      <section class="intro" aria-labelledby="title">
        <div><p class="eyebrow">Maskottchenwettbewerb der HO</p><h1 id="title">Eine Idee. Viele Möglichkeiten.</h1><p class="lead">Die eingereichten Vorschläge für das Fresswürfel-Maskottchen im Überblick. Zum gemeinsamen Ansehen, Vergleichen und Besprechen.</p><p>Diese Übersicht zeigt Einreichungen. Die HO hat daraus noch keine Auswahl getroffen. Kontaktadressen werden hier nicht angezeigt.</p></div>
        <div class="numbers" aria-label="Übersicht der Einreichungen"><div><strong>{review.total}</strong><span>Ideen insgesamt</span></div><div><strong>{review.withImages}</strong><span>mit Bild</span></div><div><strong>{review.total - review.withImages}</strong><span>in Worten</span></div></div>
      </section>
      <div class="toolbar">
        <form method="get" action={base} class="sort-form"><label for="sort">Reihenfolge</label><select id="sort" name="sort"><option value="neu" selected={review.sort === 'neu'}>Neueste zuerst</option><option value="alt" selected={review.sort === 'alt'}>Älteste zuerst</option><option value="name" selected={review.sort === 'name'}>Nach Namensvorschlag</option></select><button type="submit">Anwenden</button></form>
        <button id="copy-link" type="button" hidden>Link kopieren</button><span id="copy-status" role="status"></span>
      </div>
      {review.entries.length > 0 && <div class="filter"><label for="idea-filter">Ideen auf dieser Seite filtern</label><input id="idea-filter" type="search" placeholder="Namensvorschlag oder Beschreibung" autocomplete="off" /><span id="filter-status" role="status"></span></div>}
      <section id="ideen" aria-labelledby="ideas-title">
        <div class="section-title"><h2 id="ideas-title">Eingereichte Ideen</h2><p>Seite {review.page} von {review.pages}</p></div>
        {review.entries.length === 0 ? <div class="empty"><h3>Hier ist noch Platz für Ideen.</h3><p>Sobald ein Vorschlag eingereicht wurde, erscheint er in dieser Übersicht.</p></div> : <div class="idea-grid">{review.entries.map((entry) => {
          const title = entry.name || 'Noch ohne Namensvorschlag';
          const image = `${base}bild/${entry.number}.webp`;
          return <article class="idea-card" data-idea-card data-search={`${entry.name} ${entry.description}`}>
            {entry.has_image ? <a class="picture" href={image} target="_blank" rel="noreferrer" data-full-image data-title={title}><img src={image} alt={`Eingereichte Skizze zum Vorschlag „${title}“`} loading="lazy" /><span>Bild groß ansehen <span aria-hidden="true">↗</span></span></a> : <div class="text-idea"><span aria-hidden="true">Aa</span><p>Eine Idee in Worten</p></div>}
            <div class="idea-body"><p class="eyebrow">{entry.name ? 'Namensvorschlag für die Figur' : 'Beschreibung ohne Namensvorschlag'}</p><h3>{title}</h3><p class="description">{entry.description}</p><footer><time datetime={new Date(entry.created_at).toISOString()}>{date(entry.created_at)} Uhr</time><span class="number">{entry.number}</span></footer></div>
          </article>;
        })}</div>}
        <p id="filter-empty" class="empty" hidden>Keine Idee auf dieser Seite passt zu Ihrem Suchbegriff.</p>
      </section>
      {review.pages > 1 && <nav class="pagination" aria-label="Seiten der Einreichungen">{review.page > 1 && <a href={pageHref(review.page - 1)}>← Vorherige Seite</a>}<span>Seite {review.page} von {review.pages}</span>{review.page < review.pages && <a href={pageHref(review.page + 1)}>Nächste Seite →</a>}</nav>}
      <section class="criteria" aria-labelledby="criteria-title"><h2 id="criteria-title">Worauf die HO bei der Auswahl achtet</h2><ul><li>Wiedererkennbarkeit</li><li>Bezug zu Fresswürfel</li><li>Eigenständigkeit</li><li>Umsetzbarkeit als Kostüm</li></ul></section>
    </main>
    <footer class="shell page-footer"><p>Ansicht zur gemeinsamen Sichtung · Bitte geben Sie diesen Link gezielt weiter.</p><a href="/themen/fresswuerfel-maskottchen/">Zur Wettbewerbsseite →</a><p>{siteConfig.simulationNotice}</p></footer>
    <dialog id="image-dialog" aria-labelledby="image-title"><div class="dialog-bar"><h2 id="image-title">Skizze</h2><button id="close-image" type="button">Schließen ×</button></div><img id="large-image" alt="" /></dialog>
  </body>
</html>
<script>
  const filter = document.querySelector<HTMLInputElement>('#idea-filter');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-idea-card]')];
  filter?.addEventListener('input', () => {
    const query = filter.value.toLocaleLowerCase('de-DE').trim();
    let shown = 0;
    for (const card of cards) { card.hidden = !card.dataset.search!.toLocaleLowerCase('de-DE').includes(query); if (!card.hidden) shown++; }
    document.querySelector<HTMLElement>('#filter-status')!.textContent = `${shown} von ${cards.length} Ideen auf dieser Seite`;
    document.querySelector<HTMLElement>('#filter-empty')!.hidden = shown !== 0;
  });
  const dialog = document.querySelector<HTMLDialogElement>('#image-dialog')!;
  const large = document.querySelector<HTMLImageElement>('#large-image')!;
  let source: HTMLAnchorElement | null = null;
  document.querySelectorAll<HTMLAnchorElement>('[data-full-image]').forEach(link => link.addEventListener('click', event => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey || typeof dialog.showModal !== 'function') return;
    event.preventDefault(); source = link; large.src = link.href; large.alt = link.querySelector('img')!.alt;
    document.querySelector<HTMLElement>('#image-title')!.textContent = link.dataset.title!;
    dialog.showModal();
  }));
  document.querySelector('#close-image')!.addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', event => { if (event.target === dialog) dialog.close(); });
  dialog.addEventListener('close', () => { large.removeAttribute('src'); source?.focus(); });
  const copy = document.querySelector<HTMLButtonElement>('#copy-link')!;
  if (navigator.clipboard) {
    copy.hidden = false;
    copy.addEventListener('click', async () => {
      try { const url = new URL(location.href); url.search = ''; url.hash = ''; await navigator.clipboard.writeText(url.href); document.querySelector('#copy-status')!.textContent = 'Link kopiert.'; }
      catch { document.querySelector('#copy-status')!.textContent = 'Bitte kopieren Sie den Link aus der Adresszeile.'; }
    });
  }
</script>
<style>
  :global(*) { box-sizing: border-box; }
  :global(body) { margin: 0; color: #182d44; background: #f5f6f4; font-family: 'Jost', sans-serif; line-height: 1.6; }
  :global([hidden]) { display: none !important; }
  :global(a) { color: inherit; text-underline-offset: .18em; }
  :global(:focus-visible) { outline: 3px solid #176bc1; outline-offset: 4px; }
  .shell { width: min(1240px, calc(100% - 3rem)); margin-inline: auto; }
  .skip-link { position: absolute; left: 1rem; top: -10rem; background: white; padding: 1rem; z-index: 10; }
  .skip-link:focus { top: 1rem; }
  .notice { background: #102c4d; color: white; padding: .6rem max(1.5rem, calc((100vw - 1240px) / 2)); font-size: .85rem; }
  .brand-row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 2rem; border-bottom: 1px solid #c9d0d1; }
  .brand { display: inline-flex; background: #a80b13; padding: .4rem .8rem; width: 220px; }
  .brand img { width: 100%; height: auto; }
  .review-label { font-weight: 600; border-left: 4px solid #e5bb10; padding-left: 1rem; }
  .intro { display: grid; grid-template-columns: 1.5fr 1fr; gap: 3rem; padding: 3rem 0; align-items: center; }
  .eyebrow { text-transform: uppercase; letter-spacing: .09em; font-size: .75rem; font-weight: 700; color: #54616b; margin: 0 0 .5rem; }
  h1 { font-size: clamp(2rem, 4vw, 3.6rem); line-height: 1.1; margin: 0 0 1.5rem; max-width: 15ch; }
  .lead { font-size: 1.2rem; }
  .numbers { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .numbers div { border-top: 4px solid #e4ba00; padding: 1rem .4rem; }
  .numbers strong, .numbers span { display: block; }
  .numbers strong { color: #a50a14; font-size: 2.5rem; line-height: 1.2; }
  .numbers span { font-size: .9rem; }
  .toolbar, .sort-form { display: flex; flex-wrap: wrap; gap: .8rem; align-items: center; }
  .toolbar { border-block: 1px solid #c9d0d1; padding: 1rem 0; justify-content: space-between; }
  label { font-weight: 600; }
  button, select, input { font: inherit; color: inherit; border: 1px solid #71818b; border-radius: 3px; padding: .6rem .8rem; background: white; }
  button { cursor: pointer; font-weight: 600; }
  button:hover { background: #e9edf1; }
  .filter { display: flex; flex-wrap: wrap; align-items: center; gap: .8rem; margin: 1.5rem 0; }
  .filter input { min-width: 0; flex: 1 1 18rem; }
  .filter span { font-size: .9rem; }
  .section-title { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: .5rem; margin: 2rem 0 1rem; }
  h2 { font-size: 1.5rem; margin: 0; }
  .section-title p { margin: 0; }
  .idea-grid { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem; align-items: start; }
  .idea-card { min-width: 0; background: white; border: 1px solid #d5dbdd; border-top: 4px solid #b20a15; border-radius: 4px; overflow: hidden; }
  .picture { display: flex; flex-direction: column; align-items: stretch; text-decoration: none; background: #e9e6df; }
  .picture img { display: block; width: 100%; height: 320px; object-fit: contain; }
  .picture > span { background: #eeeae0; color: #253849; padding: .6rem 1.2rem; display: flex; justify-content: space-between; text-decoration: underline; }
  .idea-body { padding: 1.6rem; }
  h3 { font-size: 1.8rem; line-height: 1.25; margin: 0 0 1rem; overflow-wrap: anywhere; }
  .description { white-space: pre-wrap; overflow-wrap: anywhere; margin: 0 0 1.5rem; }
  .idea-body footer { border-top: 1px solid #d5dbdd; padding-top: 1rem; color: #58646e; font-size: .8rem; display: grid; gap: .3rem; }
  .number { overflow-wrap: anywhere; }
  .text-idea { background: #fff3b6; padding: 2rem; }
  .text-idea > span { color: #9b101b; font-size: 3rem; font-weight: 700; }
  .text-idea p { margin: 0; }
  .empty { background: white; padding: 2rem; border: 1px solid #d5dbdd; }
  .pagination { display: flex; flex-wrap: wrap; justify-content: center; gap: 1.5rem; margin-top: 2rem; }
  .criteria { padding-block: 3rem; margin-top: 2rem; border-bottom: 1px solid #c9d0d1; }
  .criteria ul { display: flex; flex-wrap: wrap; gap: .7rem 2rem; padding-left: 1.2rem; }
  .page-footer { padding-block: 2rem; font-size: .85rem; }
  dialog { width: min(1100px, calc(100vw - 2rem)); max-height: 95dvh; padding: 1rem; border: 0; border-radius: 4px; background: #f5f6f4; color: #182d44; }
  dialog::backdrop { background: #0c1b2bcc; }
  .dialog-bar { display: flex; justify-content: space-between; align-items: center; gap: 1rem; margin-bottom: 1rem; }
  .dialog-bar h2 { font-size: 1.2rem; overflow-wrap: anywhere; }
  dialog img { width: 100%; max-height: 78dvh; object-fit: contain; display: block; }
  @media (max-width: 700px) { .shell { width: calc(100% - 2rem); } .brand-row { align-items: start; flex-direction: column; padding-block: 1.2rem; } .brand { width: 190px; } .intro { grid-template-columns: 1fr; gap: 1.5rem; padding-block: 2rem; } .idea-grid { grid-template-columns: 1fr; } .numbers { gap: .5rem; } .idea-body { padding: 1.2rem; } .picture img { height: 260px; } }
  @media print { .toolbar, .filter, .pagination, .page-footer, .skip-link { display: none; } .idea-grid { grid-template-columns: 1fr 1fr; } .idea-card { break-inside: avoid; } }
</style>
