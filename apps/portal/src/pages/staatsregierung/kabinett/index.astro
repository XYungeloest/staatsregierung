---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import MinistryDirectory from '../../../components/portal/MinistryDirectory.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getGovernmentMembersUrl, getGovernmentUrl, getHomeUrl } from '@ostrecht/shared/lib/portal/routes.ts';
import { loadCabinetPageContent, loadMinistries } from '@ostrecht/shared/lib/portal/content.ts';

const [ministries, cabinetPage] = await Promise.all([loadMinistries(), loadCabinetPageContent()]);
const breadcrumbs = [{ label: 'Startseite', href: getHomeUrl() }, { label: 'Staat & Behörden', href: getGovernmentUrl() }, { label: 'Staatssekretariate und Geschäftsbereiche' }];
---
<BaseLayout title="Staatssekretariate und Geschäftsbereiche" description={cabinetPage.lead} {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <SectionHero eyebrow="Staat & Behörden" title="Staatssekretariate und Geschäftsbereiche" lead={cabinetPage.lead} variant="government" density="tool" />
  <GovernmentNavigation />
  <section id="ministerien" class="section" data-visual-section="cabinet-ministry-directory">
    <div class="section-header"><h2>Verzeichnis der Staatssekretariate</h2></div>
    {cabinetPage.organisation && <p>{cabinetPage.organisation}</p>}
    <MinistryDirectory ministries={ministries} />
  </section>
  <section class="section section-muted" aria-labelledby="kabinett-chronologie">
    <div class="section-header">
      <h2 id="kabinett-chronologie">{cabinetPage.chronologyTitle}</h2>
    </div>
    <ol class="record-list">
      {cabinetPage.chronology.map((entry) => (
        <li class="record-list__item">
          <strong><time datetime={entry.date}>{siteConfig.date.formatLong(entry.date)}</time></strong>
          <span>{entry.text}</span>
        </li>
      ))}
    </ol>
  </section>

  <p class="section-link-row"><a href={getGovernmentMembersUrl()}>Mitglieder und Personenprofile</a></p>
</BaseLayout>
