---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import {
  getCabinetUrl,
  getGovernmentUrl,
  getHomeUrl,
  getPreviousCabinetsUrl,
} from '@ostrecht/shared/lib/portal/index.ts';
import {
  loadCabinetArchiveDetailSlugs,
  loadCabinetArchives,
  loadCurrentGovernment,
} from '@ostrecht/shared/lib/portal/content.ts';

// Die Übersicht liest den Archivbestand, statt einen einzelnen Stand fest zu verdrahten. Eine
// Detailseite entsteht genau dort, wo ein Mitgliederverzeichnis liegt; Stände ohne Verzeichnis
// erscheinen als Karte ohne Link, damit kein Link ins Leere führt.
const [currentGovernment, archives, detailSlugs] = await Promise.all([
  loadCurrentGovernment(),
  loadCabinetArchives(),
  loadCabinetArchiveDetailSlugs(),
]);

const newest = archives[0];
const oldest = archives.at(-1);
const newestWithDetail = archives.find((entry) => detailSlugs.has(entry.slug));
const archiveUrl = (slug: string) => `${getPreviousCabinetsUrl()}${slug}/`;
---

<BaseLayout
  title="Frühere Kabinette"
  description="Archiv früherer Staatsregierungen des Ostdeutschen Freistaates."
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsrat', href: getGovernmentUrl() },
      { label: 'Frühere Kabinette' },
    ]}
  />

  <SectionHero
    eyebrow="Regierungsarchiv"
    title="Frühere Kabinette"
    lead="Abgeschlossene Staatsregierungen mit Amtszeit, Zusammensetzung und politischen Schwerpunkten."
    variant="government"
    facts={[
      { label: 'Aktuelles Kabinett', value: currentGovernment.title, href: getCabinetUrl() },
      { label: 'Archivierte Bestände', value: String(archives.length) },
      ...(newest && oldest
        ? [{
            label: 'Erfasster Zeitraum',
            value: `${siteConfig.date.formatLong(oldest.formedOn)} bis ${siteConfig.date.formatLong(newest.endedOn)}`,
          }]
        : []),
    ]}
    actions={newestWithDetail
      ? [{ label: newestWithDetail.cabinetName, href: archiveUrl(newestWithDetail.slug), primary: true }]
      : []}
  />
  <GovernmentNavigation />

  <section class="section section-muted">
    <div class="section-header">
      <h2>Archivierte Staatsregierungen</h2>
      <p>
        Historische Kabinettsseiten zeigen frühere Koalitionen, Mitglieder, Ressorts und
        Programmstände ohne sie mit der aktuellen Regierungsarbeit zu vermischen. Der jüngste
        Bestand steht oben.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {archives.map((archive) => (
        <article class="panel">
          <h3>{archive.cabinetName}</h3>
          <p>{archive.summary}</p>
          <p class="detail-line">
            <time datetime={archive.formedOn}>{siteConfig.date.formatLong(archive.formedOn)}</time> bis <time datetime={archive.endedOn}>{siteConfig.date.formatLong(archive.endedOn)}</time>
          </p>
          <p class="detail-line">Leitung: {archive.headOfGovernment}</p>
          {detailSlugs.has(archive.slug) ? (
            <p><a class="inline-link" href={archiveUrl(archive.slug)}>Zum Archivstand</a></p>
          ) : null}
        </article>
      ))}
    </div>
  </section>
</BaseLayout>
