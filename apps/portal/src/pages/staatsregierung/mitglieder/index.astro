---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import GovernmentMemberCard from '../../../components/portal/GovernmentMemberCard.astro';
import GovernmentNavigation from '../../../components/portal/GovernmentNavigation.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import { PORTAL_REFERENCE_DATE } from '@ostrecht/shared/lib/portal/dates.ts';
import { getGovernmentUrl, getHomeUrl } from '@ostrecht/shared/lib/portal/index.ts';
import { isActiveInterval } from '@ostrecht/shared/lib/portal/organization.ts';
import {
  loadCurrentGovernment,
  loadCurrentGovernmentMembers,
  loadOrganizationData,
} from '@ostrecht/shared/lib/portal/content.ts';

const [members, currentGovernment, organization] = await Promise.all([
  loadCurrentGovernmentMembers(),
  loadCurrentGovernment(),
  loadOrganizationData(),
]);
// Staatssekretäre sind dem Staatsrat beigeordnet, gehören ihm aber nicht als Mitglieder an.
// Die Mitgliederblöcke folgen deshalb der Mitgliedschaft aus dem Organisationsmodell und nicht
// mehr der bloßen Reihenfolge; sonst zählte die Seite die Staatssekretäre als Mitglieder mit.
const memberSlugs = new Set(currentGovernment.memberPersonSlugs);
const stateSecretarySlugs = new Set(
  organization.assignments
    .filter((entry) => entry.officeSlug === 'staatssekretaer' && isActiveInterval(entry.validFrom, entry.validTo, PORTAL_REFERENCE_DATE))
    .map((entry) => entry.personSlug),
);
const councilMembers = members.filter((member) => memberSlugs.has(member.slug));
const leadership = councilMembers.slice(0, 2);
const stateCouncilMembers = councilMembers.slice(2);
const chancelleryLeadership = members.filter((member) => member.slug === 'emma-mueller');
const stateSecretaries = members.filter((member) => stateSecretarySlugs.has(member.slug));
---

<BaseLayout title="Mitglieder des Staatsrates" description="Übersicht der Mitglieder des Staatsrates des Ostdeutschen Freistaates.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Staatsrat', href: getGovernmentUrl() },
      { label: 'Mitglieder' },
    ]}
  />

  <SectionHero
    eyebrow="Staatsrat"
    title="Mitglieder des Staatsrates"
    lead="Ämter, Geschäftsbereiche und biografische Angaben der Mitglieder des Staatsrates."
    variant="government"
    facts={[{ label: 'Mitglieder des Staatsrates', value: String(leadership.length + stateCouncilMembers.length) }]}
  />
  <GovernmentNavigation />

  <section class="section section-muted">
    <div class="section-header">
      <h2>Leitung</h2>
      <p>
        Die politische Führung des Staatsrates liegt beim Staatspräsidenten und seiner
        Stellvertretung.
      </p>
    </div>
    <div class="spotlight-grid">
      {leadership.map((member) => (
        <GovernmentMemberCard member={member} />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Weitere Mitglieder des Staatsrates</h2>
      <p>Alle weiteren Mitglieder sind mit ihren jeweiligen Geschäftsbereichen erschlossen.</p>
    </div>
    <div class="card-grid card-grid--two">
      {stateCouncilMembers.map((member) => (
        <GovernmentMemberCard member={member} variant="compact" />
      ))}
    </div>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Büro des Staatspräsidenten</h2>
      <p>Die Leitung des Büros des Staatspräsidenten wird eigenständig neben den Mitgliedern des Staatsrates ausgewiesen.</p>
    </div>
    <div class="card-grid card-grid--two">
      {chancelleryLeadership.map((member) => (
        <GovernmentMemberCard member={member} variant="compact" />
      ))}
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Staatssekretäre</h2>
      <p>
        Nach Artikel 59 Absatz 2 Satz 2 der Staatsverfassung sind dem Geschäftsbereich Frieden drei
        Staatssekretäre beigeordnet. Sie gehören dem Staatsrat nicht als Mitglieder an.
      </p>
    </div>
    <div class="card-grid card-grid--two">
      {stateSecretaries.map((member) => (
        <GovernmentMemberCard member={member} variant="compact" />
      ))}
    </div>
  </section>
</BaseLayout>
