---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import GovernmentNavigation from '../../components/portal/GovernmentNavigation.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getCabinetUrl, getCoalitionUrl, getGovernmentMemberUrl, getGovernmentMembersUrl, getHomeUrl, getMinisterPresidentUrl, getPreviousCabinetsUrl } from '@ostrecht/shared/lib/portal/routes.ts';
import { loadCabinetPageContent, loadCurrentGovernment, loadCurrentGovernmentMembers } from '@ostrecht/shared/lib/portal/content.ts';

const [government, members, cabinetPage] = await Promise.all([loadCurrentGovernment(), loadCurrentGovernmentMembers(), loadCabinetPageContent()]);
const president = members.find((member) => member.slug === government.headPersonSlug);
const breadcrumbs = [{ label: 'Startseite', href: getHomeUrl() }, { label: 'Staat & Behörden' }];
---
<BaseLayout title="Staatsrat" description="Politische Leitung, Zusammensetzung und Aufgaben des Staatsrates." {breadcrumbs}>
  <Breadcrumbs items={breadcrumbs} />
  <SectionHero eyebrow="Staat & Behörden" title={government.title} variant="government"
    lead="Die Volkskammer wählt die Mitglieder des Staatsrates. Als Spitze der vollziehenden Gewalt leitet er die Verwaltung und entscheidet über die Grundlinien der Regierungspolitik."
    image={president ? { src: president.bild, alt: president.bildAlt ?? president.name, credit: president.bildnachweis, width: 352, height: 440, widths: [240, 360, 480], kind: 'portrait' } : undefined}
    facts={[
      { label: 'Im Amt seit', value: siteConfig.date.formatLong(government.formedOn) },
      { label: 'Regierungssitz', value: government.seatOfGovernment },
      { label: 'Koalition', value: government.coalitionShort, href: getCoalitionUrl() },
    ]} />
  <GovernmentNavigation />
  <div class="content-grid" data-visual-section="government-leadership-entrypoints">
    <section class="section">
      <div class="section-header"><h2>Leitung des Staatsrates</h2></div>
      {cabinetPage.politicalContext.map((paragraph) => <p>{paragraph}</p>)}
      <dl class="meta-list">
        <div><dt>Staatspräsident</dt><dd><a href={getMinisterPresidentUrl()}>{government.headOfGovernment}</a></dd></div>
        <div><dt>Stellvertretung</dt><dd><a href={getGovernmentMemberUrl(government.deputyPersonSlug)}>{government.deputyHead}</a></dd></div>
      </dl>
      <p><a href={getGovernmentMembersUrl()}>Alle Mitglieder und ihre Ämter</a></p>
    </section>
    <section id="ministerien" class="section" data-visual-section="government-direct-entrypoints">
      <div class="section-header"><h2>Geschäftsbereiche</h2></div>
      <p>Die Staatssekretariate bearbeiten die Fachaufgaben des Staatsrates. Im Verzeichnis finden Sie die Zuständigkeiten, Leitungen und Kontaktwege.</p>
      <p><a href={getCabinetUrl()}>Zuständiges Staatssekretariat finden</a></p>
      <p><a href={getPreviousCabinetsUrl()}>Frühere Staatsräte und Kabinette</a></p>
    </section>
  </div>
</BaseLayout>
