---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import { getHomeUrl, getServiceUrl } from '@ostrecht/shared/lib/portal/index.ts';
import { loadPageBySlug } from '@ostrecht/shared/lib/portal/content.ts';
import { isAnalyticsEnabled } from '@ostrecht/shared/config/analytics.ts';
import { siteConfig } from '@ostrecht/shared/config/site.ts';

const page = await loadPageBySlug('datenschutz');
const analyticsEnabled = isAnalyticsEnabled();
---

<BaseLayout title={page?.title ?? 'Datenschutz'} description="Datenschutzhinweise des Regierungsportals.">
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Datenschutz' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>{page?.title ?? 'Datenschutz'}</h1>
  </section>

  <div class="content-grid">
    <section class="section body-copy">
      {(page?.body ?? []).map((paragraph) => (
        <p>{paragraph}</p>
      ))}

      <div class="section-header"><h2>Verantwortliche Stelle</h2></div>
      <p>{siteConfig.contact.authorityShort}, {siteConfig.contact.addressLines.join(', ')}.</p>
      <p>
        Datenschutzanfragen können an <a class="inline-link" href={`mailto:${siteConfig.contact.citizenService.email}`}>{siteConfig.contact.citizenService.email}</a>
        oder telefonisch an <a class="inline-link" href={`tel:${siteConfig.contact.citizenService.phone.replace(/\s+/gu, '')}`}>{siteConfig.contact.citizenService.phone}</a> gerichtet werden.
      </p>

      <div class="section-header"><h2>Hosting und technische Protokollierung</h2></div>
      <p>
        Das Portal wird über Cloudflare Workers und das Cloudflare-Netzwerk ausgeliefert. Für die
        sichere Bereitstellung können insbesondere IP-Adresse, Zeitpunkt, aufgerufene Adresse,
        Referrer, Browser- und Geräteangaben sowie Antwortstatus technisch verarbeitet und in
        Sicherheits- oder Zugriffsprotokollen erfasst werden. Zweck sind Auslieferung,
        Fehleranalyse, Abwehr missbräuchlicher Zugriffe und Betriebssicherheit.
      </p>
      <p>
        Eine feste Speicherdauer für Hostingprotokolle ist im Portal nicht festgelegt. Maßgeblich
        sind die beim Hosting tatsächlich konfigurierten Aufbewahrungs- und Sicherheitsregeln.
        Eine eigenständige Cloudflare-Webanalyse wird nicht eingesetzt.
      </p>

      <div class="section-header"><h2>Interaktive Karte von OpenStreetMap</h2></div>
      <p>
        Die Kreisreform ist über Suche, Bezirksübersicht und Tabellen vollständig ohne Karte
        nutzbar. Erst wenn Sie „Karte laden“ wählen, ruft der Browser Kartenkacheln von
        OpenStreetMap ab. Dabei werden technisch mindestens die IP-Adresse, der Zeitpunkt, die
        angeforderten Kacheln sowie Browser- und Referrerangaben an den Kacheldienst übertragen.
        Die Freigabe gilt nur für den aktuellen Seitenaufruf und wird nicht dauerhaft gespeichert.
      </p>
      <p>
        Zweck ist ausschließlich die von Ihnen angeforderte kartografische Darstellung. Eine
        Übertragung außerhalb des Europäischen Wirtschaftsraums kann durch die technische
        Bereitstellung des Dienstes nicht ausgeschlossen werden.
      </p>

      {analyticsEnabled ? (
        <>
          <div class="section-header"><h2>Freiwillige Reichweitenstatistik</h2></div>
          <p>
            Google Analytics 4 wird erst geladen, wenn Sie „Statistik erlauben“ auswählen. Ohne
            Zustimmung werden weder das Google-Skript noch Statistik-Anfragen gestartet. Erfasst
            werden können Seitenaufrufe, technische Geräte- und Browserangaben, gekürzte oder
            abgeleitete Standortangaben sowie von Google Analytics verwendete Kennungen.
          </p>
          <p>
            Empfänger ist Google als Anbieter des Analysedienstes. Eine Verarbeitung in Staaten
            außerhalb des Europäischen Wirtschaftsraums kann nicht ausgeschlossen werden. Die
            Verarbeitung beruht hier ausschließlich auf Ihrer freiwilligen Einwilligung. Die
            konkrete Aufbewahrungsdauer der Analysedaten ist auf dieser Website nicht
            ausgewiesen und kann deshalb an dieser Stelle nicht verbindlich angegeben werden.
          </p>
          <p>
            Ihre Auswahl wird lokal im Browser gespeichert, bis Sie sie ändern oder den
            Browserspeicher löschen.
            Bei einem Widerruf wird die weitere Übermittlung unterbunden; erreichbare
            Statistik-Cookies dieses Portals werden entfernt.
          </p>
          <p>
            <button type="button" class="button-link button-link--secondary" data-analytics-consent-reset>
              Datenschutzeinstellungen ändern
            </button>
          </p>
        </>
      ) : null}

      <div class="section-header"><h2>Lokale Funktionen und Suche</h2></div>
      <p>
        Portal- und Normensuche laden lokale Suchindizes derselben Website. Filter, Kontaktwegweiser
        und Tabellen werden im Browser verarbeitet und übertragen keine Eingaben an externe
        Dienste. Technisch notwendige Einstellungen werden nur lokal gespeichert, wenn die
        jeweilige Funktion dies ausdrücklich vorsieht.
      </p>

      <div class="section-header"><h2>Ihre Rechte</h2></div>
      <p>
        Sie können Auskunft, Berichtigung, Löschung, Einschränkung und Herausgabe der Sie
        betreffenden Daten verlangen sowie einer Verarbeitung widersprechen. Eine erteilte
        Einwilligung können Sie jederzeit für die Zukunft widerrufen. Außerdem können Sie sich an
        eine zuständige Datenschutzaufsicht wenden. Ob und in welchem Umfang ein Recht im Einzelfall
        besteht, hängt von der tatsächlich erfolgten Verarbeitung ab.
      </p>
    </section>

    <aside class="section meta-panel">
      <div class="section-header section-header--compact">
        <h2>Datenschutzprofil</h2>
      </div>
      <dl class="meta-list">
        <div>
          <dt>Benutzerkonto</dt>
          <dd>Kein öffentlicher Anmeldebereich</dd>
        </div>
        <div>
          <dt>Formulare</dt>
          <dd>Keine Online-Formulare für Kontakt oder Bewerbung</dd>
        </div>
        <div>
          <dt>Suche</dt>
          <dd>Lokale Suchindizes ohne externe Übermittlung</dd>
        </div>
        <div>
          <dt>Webanalyse</dt>
          <dd>{analyticsEnabled ? 'Google Analytics 4 nur nach Zustimmung' : 'Nicht aktiviert'}</dd>
        </div>
        <div>
          <dt>Karte</dt>
          <dd>OpenStreetMap erst nach bewusster Freigabe</dd>
        </div>
      </dl>
    </aside>
  </div>
</BaseLayout>
