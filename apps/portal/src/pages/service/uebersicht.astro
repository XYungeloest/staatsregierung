---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionNavigation from '../../components/portal/SectionNavigation.astro';
import { buildPortalRouteInventory, groupRoutesBySection } from '../../lib/route-inventory.ts';
import { getHomeUrl, getServiceUrl } from '@ostrecht/shared/lib/portal/index.ts';

const routes = (await buildPortalRouteInventory()).filter((route) => route.overview);
const groups = groupRoutesBySection(routes);
const total = routes.length;
---

<BaseLayout
  title="Übersicht"
  description="Alle Bereiche und Einstiegsseiten des Staatsportals, nach Bereichen geordnet."
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Übersicht' },
    ]}
  />

  <section class="section page-header">
    <p class="eyebrow">Service</p>
    <h1>Übersicht</h1>
    <p class="lead">
      Diese Seite führt {total} Einstiegs- und Übersichtsseiten des Staatsportals, nach Bereichen
      geordnet. Einzelne Mitteilungen, Reden, Termine, Themenseiten und Stellenangebote stehen in
      den jeweiligen Bereichen.
    </p>
  </section>

  <SectionNavigation
    label="Bereiche dieser Übersicht"
    variant="service"
    items={groups.map((group) => ({ label: group.label, href: `#bereich-${group.key}` }))}
  />

  {groups.map((group) => (
    <section
      id={`bereich-${group.key}`}
      class="section"
      aria-labelledby={`bereich-${group.key}-titel`}
    >
      <div class="section-header section-header--compact">
        <h2 id={`bereich-${group.key}-titel`}>{group.label}</h2>
        <p>{group.description}</p>
      </div>
      <ul class="record-list">
        {group.routes.map((route) => (
          <li class="record-list__item">
            <strong><a class="inline-link" href={route.path}>{route.title}</a></strong>
            {route.description ? <span>{route.description}</span> : null}
          </li>
        ))}
      </ul>
    </section>
  ))}
</BaseLayout>
