---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import JobOfferCard from '../../../components/portal/JobOfferCard.astro';
import { splitJobOffersByDeadline } from '@ostrecht/shared/lib/portal/dates.ts';
import { loadJobOffers } from '@ostrecht/shared/lib/portal/content.ts';
import { getHomeUrl, getServiceUrl } from '@ostrecht/shared/lib/portal/index.ts';

const { current: offers, expired } = splitJobOffersByDeadline(await loadJobOffers());
const ressorts = [...new Set(offers.map((offer) => offer.ressort))].sort((left, right) => left.localeCompare(right, 'de'));
const standorte = [...new Set(offers.map((offer) => offer.standort))].sort((left, right) => left.localeCompare(right, 'de'));
const employmentTypes = [...new Set(offers.map((offer) => offer.employmentType))].sort((left, right) => left.localeCompare(right, 'de'));
---

<BaseLayout title="Karriere" description="Karriere, Arbeitsfelder und aktuelle Stellenangebote des Staatsrates des Ostdeutschen Freistaates." scripts={['portal-modules']}>
  <Breadcrumbs items={[{ label: 'Startseite', href: getHomeUrl() }, { label: 'Service', href: getServiceUrl() }, { label: 'Karriere' }]} />

  <section class="section page-header">
    <p class="eyebrow">Karriere</p>
    <h1>Arbeiten für den Staatsrat</h1>
    <p class="lead">Der Karrierebereich informiert über Arbeitsfelder, Kontaktstellen und aktuelle Stellenangebote.</p>
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Karriere in der Landesverwaltung</h2>
      <p>Der Staatsrat bündelt hier Hinweise zu Aufgabenfeldern, Verfahren und ausgeschriebenen Stellen.</p>
    </div>
    <div class="card-grid card-grid--three">
      <article class="panel"><h3>Öffentliche Aufgaben</h3><p>Arbeitsfelder reichen von Verwaltung und Recht bis Kultur, Mobilität und Kommunikation.</p></article>
      <article class="panel"><h3>Klare Verfahren</h3><p>Ausschreibungen nennen Frist, Anforderungen und die zuständige Kontaktstelle.</p></article>
      <article class="panel"><h3>Gezielt suchen</h3><p>Offene Stellen können nach Ressort, Standort und Beschäftigungsart eingegrenzt werden.</p></article>
    </div>
  </section>

  <section class="section">
    <div class="section-header">
      <h2>Aktuelle Stellenangebote</h2>
      <p>Nur Stellen mit noch offener Bewerbungsfrist werden hier als aktuell angezeigt.</p>
    </div>
    {offers.length > 0 ? (
      <Fragment>
        <form class="filter-bar" id="career-filter" data-role="career-filter">
          <div class="filter-bar__fields">
            <label class="search-field"><span>Stichwort</span><input type="search" name="query" placeholder="z. B. Kultur, Presse oder Verwaltung" /></label>
            <label class="search-field"><span>Ressort</span><select name="ressort"><option value="">Alle Ressorts</option>{ressorts.map((entry) => <option value={entry}>{entry}</option>)}</select></label>
            <label class="search-field"><span>Standort</span><select name="standort"><option value="">Alle Standorte</option>{standorte.map((entry) => <option value={entry}>{entry}</option>)}</select></label>
            <label class="search-field"><span>Beschäftigungsart</span><select name="employmentType"><option value="">Alle Arten</option>{employmentTypes.map((entry) => <option value={entry}>{entry}</option>)}</select></label>
          </div>
        </form>
        <p class="search-feedback" id="career-filter-count" role="status" aria-live="polite">{offers.length} Stellenangebote sichtbar</p>
        <p class="search-feedback search-feedback--warning" id="career-filter-empty" hidden>Für diese Auswahl wurden keine Stellenangebote gefunden.</p>
        <div class="card-grid card-grid--two" id="career-filter-results">
          {offers.map((offer) => (
            <div class="job-filter-card" data-ressort={offer.ressort} data-standort={offer.standort} data-employment-type={offer.employmentType} data-search={`${offer.title} ${offer.teaser} ${offer.arbeitsbereich} ${offer.ressort}`.toLowerCase()}><JobOfferCard offer={offer} /></div>
          ))}
        </div>
      </Fragment>
    ) : <p class="search-feedback">Derzeit gibt es keine Stellenangebote mit offener Bewerbungsfrist. Bitte schauen Sie zu einem späteren Zeitpunkt wieder vorbei.</p>}
  </section>

  {expired.length > 0 ? (
    <section class="section section-muted">
      <details class="faq-accordion__item">
        <summary class="faq-accordion__summary">Archiv abgelaufener Stellenangebote ({expired.length})</summary>
        <div class="faq-accordion__body"><p>Diese Ausschreibungen sind beendet und dienen nur der Dokumentation.</p><div class="card-grid card-grid--two">{expired.map((offer) => <JobOfferCard offer={offer} />)}</div></div>
      </details>
    </section>
  ) : null}
</BaseLayout>
