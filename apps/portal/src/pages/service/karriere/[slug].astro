---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import ResponsivePicture from '@ostrecht/shared/components/portal/ResponsivePicture.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { loadJobOffers } from '@ostrecht/shared/lib/portal/content.ts';
import {
  getCareerUrl,
  getHomeUrl,
  getJobUrl,
  getServiceUrl,
  type Stellenangebot,
} from '@ostrecht/shared/lib/portal/index.ts';

export async function getStaticPaths() {
  const offers = await loadJobOffers();

  return offers.map((offer) => ({
    params: { slug: offer.slug },
    props: { offer },
  }));
}

const { offer } = Astro.props as { offer: Stellenangebot };
const relatedOffers = (await loadJobOffers())
  .filter((entry) => entry.slug !== offer.slug)
  .slice(0, 2);
---

<BaseLayout
  title={offer?.title ?? 'Stellenangebot nicht gefunden'}
  description={
    offer?.teaser ?? 'Das angeforderte Stellenangebot konnte nicht gefunden werden.'
  }
>
  <Breadcrumbs
    items={[
      { label: 'Startseite', href: getHomeUrl() },
      { label: 'Service', href: getServiceUrl() },
      { label: 'Karriere', href: getCareerUrl() },
      { label: offer?.title ?? 'Nicht gefunden' },
    ]}
  />

  {offer ? (
    <Fragment>
      <section class="section page-header">
        <p class="eyebrow">Stellenangebot</p>
        <h1>{offer.title}</h1>
        <p class="lead">{offer.teaser}</p>
        <p class="detail-line">
          {offer.ressort} · {offer.standort} · veröffentlicht am{' '}
          <time datetime={offer.datePosted}>{siteConfig.date.formatLong(offer.datePosted)}</time>
        </p>
      </section>

      <div class="content-grid">
        <section class="section">
          {offer.image ? (
            <ResponsivePicture
              className="media-banner"
              src={offer.image}
              alt={offer.imageAlt ?? `Ansichtsbild zum Stellenangebot ${offer.title}`}
              width={1280}
              height={731}
              widths={[480, 720, 960, 1280]}
              sizes="(max-width: 720px) calc(100vw - 2.4rem), (max-width: 1100px) 62vw, 760px"
              loading="eager"
              fetchpriority="high"
            />
          ) : null}
          {offer.image && offer.imageCredit ? <p class="media-credit">Bildnachweis: {offer.imageCredit}</p> : null}
          <div class="status-notice status-notice--current">
            <h2>Hinweis</h2>
            <p>
              Bewerbungen erfolgen über die in der Ausschreibung genannten Kontaktwege.
            </p>
          </div>
          <div class="body-copy">
            {offer.body.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </div>
        </section>

        <aside class="section meta-panel">
          <div class="section-header section-header--compact">
            <h2>Rahmendaten</h2>
          </div>
          <dl class="meta-list">
            <div>
              <dt>Arbeitgeber</dt>
              <dd>{offer.ressort}</dd>
            </div>
            <div>
              <dt>Arbeitsbereich</dt>
              <dd>{offer.arbeitsbereich}</dd>
            </div>
            <div>
              <dt>Arbeitsort</dt>
              <dd>{offer.standort}</dd>
            </div>
            <div>
              <dt>Beschäftigungsart</dt>
              <dd>{offer.employmentType}</dd>
            </div>
            <div>
              <dt>Vergütung</dt>
              <dd>{offer.payGrade ?? 'nach Qualifikation'}</dd>
            </div>
            <div>
              <dt>Veröffentlicht</dt>
              <dd><time datetime={offer.datePosted}>{siteConfig.date.formatLong(offer.datePosted)}</time></dd>
            </div>
            <div>
              <dt>Bewerbungsfrist</dt>
              <dd><time datetime={offer.applicationDeadline}>{siteConfig.date.formatLong(offer.applicationDeadline)}</time></dd>
            </div>
          </dl>
          <nav class="link-list">
            <a href={getCareerUrl()}>Zur Karriereübersicht</a>
            {offer.contact?.email ? <a href={`mailto:${offer.contact.email}`}>Kontakt per E-Mail</a> : null}
            {offer.contact?.telefon ? <a href={`tel:${offer.contact.telefon.replace(/\s+/g, '')}`}>Kontakt per Telefon</a> : null}
          </nav>
          {relatedOffers.length > 0 ? (
            <>
              <div class="section-header section-header--compact">
                <h2>Weitere Stellen</h2>
              </div>
              <ul class="record-list">
                {relatedOffers.map((entry) => (
                  <li class="record-list__item">
                    <strong><a class="inline-link" href={getJobUrl(entry.slug)}>{entry.title}</a></strong>
                    <span>{entry.ressort}</span>
                  </li>
                ))}
              </ul>
            </>
          ) : null}
        </aside>
      </div>
    </Fragment>
  ) : (
    <section class="section">
      <div class="status-notice status-notice--warning">
        <h1>Stellenangebot nicht gefunden</h1>
        <p>
          Der angeforderte Inhalt konnte nicht gefunden werden. Bitte nutzen Sie die
          Karriereübersicht.
        </p>
        <p><a class="inline-link" href={getCareerUrl()}>Zur Karriereübersicht</a></p>
      </div>
    </section>
  )}
</BaseLayout>
