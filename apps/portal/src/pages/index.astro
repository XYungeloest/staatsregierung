---
import BaseLayout from '../layouts/BaseLayout.astro';
import FreestateSummary from '../components/portal/FreestateSummary.astro';
import HomeMinistryList from '../components/portal/HomeMinistryList.astro';
import HomePressList from '../components/portal/HomePressList.astro';
import ImportantNoticeBand from '../components/portal/ImportantNoticeBand.astro';
import PortalAccessCard from '../components/portal/PortalAccessCard.astro';
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';
import ResponsivePicture from '@ostrecht/shared/components/portal/ResponsivePicture.astro';
import StatusBadge from '../components/portal/StatusBadge.astro';
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { loadAllVerkuendungen } from '@ostrecht/shared/lib/norms/publications.ts';
import { getPublicationUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import { buildOrganizationJsonLd, buildWebSiteJsonLd } from '@ostrecht/shared/lib/seo/index.ts';
import {
  getActionPlanUrl,
  getActiveTopicHighlights,
  getBalancedColumnCount,
  getBudgetUrl,
  getCareerUrl,
  getContactUrl,
  getFreestateUrl,
  getKreisreformUrl,
  getLawConstitutionUrl,
  getLawHomeUrl,
  getNextTopicDate,
  getPortalSearchUrl,
  getPressUrl,
  getTopicsUrl,
  getTopicUrl,
  resolvePortalPath,
} from '@ostrecht/shared/lib/portal/index.ts';
import { PORTAL_REFERENCE_DATE } from '@ostrecht/shared/lib/portal/dates.ts';
import {
  loadCurrentJobOffers,
  loadCurrentGovernment,
  loadHomeContent,
  loadMinistries,
  loadRecentPressReleases,
  loadTopics,
} from '@ostrecht/shared/lib/portal/content.ts';

const [ministries, topics, latestReleases, publications, currentJobs, currentGovernment, homeContent] = await Promise.all([
  loadMinistries(),
  loadTopics(),
  loadRecentPressReleases(3),
  loadAllVerkuendungen(),
  loadCurrentJobOffers(1),
  loadCurrentGovernment(),
  loadHomeContent(),
]);

const latestPublication = publications[0];
const latestJob = currentJobs[0];
const publicationEntryLabel = (count: number) => count === 1 ? 'Eintrag' : 'Einträge';
const currentTopics = getActiveTopicHighlights(topics, PORTAL_REFERENCE_DATE, 3);
const homeLeadTopic = currentTopics[0];
const homeLeadDate = homeLeadTopic ? getNextTopicDate(homeLeadTopic, PORTAL_REFERENCE_DATE) : undefined;
const homeSecondaryTopics = currentTopics.slice(1);

const portalAccesses = homeContent.portalAccesses.map((item) => ({
  ...item,
  href: resolvePortalPath(item.href),
}));

const importantItems = homeContent.importantItems.map((item) => ({
  title: item.governmentSlug ? currentGovernment.title : item.title ?? '',
  description: item.governmentSlug
    ? `Übergang am ${siteConfig.date.formatLong(currentGovernment.formedOn)}`
    : item.description ?? '',
  href: resolvePortalPath(item.href),
  icon: item.icon,
}));
---

<BaseLayout
  title="Regierungsportal des Ostdeutschen Freistaates"
  description="Gesetze, Reformvorhaben, Haushaltsdaten, Pressemitteilungen und zuständige Ressorts im Regierungsportal des Ostdeutschen Freistaates."
  breadcrumbs={[{ label: 'Startseite', href: '/' }]}
  structuredData={[buildWebSiteJsonLd(Astro.site), buildOrganizationJsonLd(Astro.site)]}
  mainWidth="full"
>
  <div class="home-page">
    <section class="home-hero" aria-labelledby="home-hero-title">
      <ResponsivePicture
        className="home-hero__image"
        src={homeContent.hero.image}
        alt={homeContent.hero.imageAlt}
        width={960}
        height={720}
        widths={[480, 720, 960]}
        sizes="100vw"
        loading="eager"
        fetchpriority="high"
      />
      <div class="container home-hero__inner">
        <div class="home-hero__content">
          <p class="eyebrow">{homeContent.hero.eyebrow}</p>
          <h1 id="home-hero-title">{homeContent.hero.title}</h1>
          <p class="home-hero__lead">{homeContent.hero.lead}</p>
          <form class="home-hero-search" action={getPortalSearchUrl()} method="get" role="search" aria-label="Portalsuche auf der Startseite">
            <label for="home-portal-search">{homeContent.hero.searchLabel}</label>
            <div class="home-hero-search__control">
              <input
                id="home-portal-search"
                type="search"
                name="q"
                autocomplete="off"
                placeholder={homeContent.hero.searchPlaceholder}
              />
              <button type="submit"><PortalIcon name="search" /><span>Suchen</span></button>
            </div>
            <nav class="home-search-chips" aria-label="Häufige Sucheinstiege">
              <span>Häufig gesucht:</span>
              <a href={getKreisreformUrl()}>Kreisreform</a>
              <a href={getLawConstitutionUrl()}>Verfassung</a>
              <a href={getTopicUrl('bildungsreform')}>Bildungsreform</a>
              <a href={getBudgetUrl()}>Haushalt</a>
              <a href={getActionPlanUrl()}>15-Punkte-Plan</a>
            </nav>
          </form>
        </div>
      </div>
    </section>

    <section class="home-band home-access-section" aria-labelledby="home-access-title">
      <div class="container">
        <header class="home-section-heading home-section-heading--compact">
          <div>
            <p class="eyebrow">Direkteinstiege</p>
            <h2 id="home-access-title">Zentrale Portalbereiche</h2>
          </div>
          <a href={getFreestateUrl()}>Portal im Überblick <span aria-hidden="true">→</span></a>
        </header>
        <div class="portal-access-grid" style={`--access-count: ${getBalancedColumnCount(portalAccesses.length)}`}>
          {portalAccesses.map((access) => <PortalAccessCard {...access} />)}
        </div>
      </div>
    </section>

    <section class="home-band home-important-section">
      <div class="container"><ImportantNoticeBand items={importantItems} /></div>
    </section>

    <section class="home-band home-information-section" aria-label="Aktuelles, Staatssekretariate und Orientierung">
      <div class="container home-information-grid">
        <HomePressList releases={latestReleases} />
        <HomeMinistryList ministries={ministries.slice(0, 6)} />
        <FreestateSummary />
      </div>
    </section>

    <section class="home-band home-priority-section" aria-labelledby="home-priority-title" data-visual-section="home-current-topics">
      <div class="container">
        <header class="home-section-heading">
          <div>
            <p class="eyebrow">Aktuelles Regierungshandeln</p>
            <h2 id="home-priority-title">Was im Freistaat jetzt passiert</h2>
            <p>Zeitkritische Vorhaben und jüngste Statusänderungen – mit Termin, Rechtsstand und nächstem Schritt.</p>
          </div>
          <a href={getTopicsUrl()}>Alle Themen und Reformen <span aria-hidden="true">→</span></a>
        </header>
        <div class:list={['home-priority-grid', homeSecondaryTopics.length === 0 && 'home-priority-grid--single']}>
          {homeLeadTopic ? (
            <article class:list={['home-lead-feature', homeSecondaryTopics.length === 0 && 'home-lead-feature--wide']}>
              <div class="home-lead-feature__icon"><PortalIcon name="topics" /></div>
              <div class="home-lead-feature__status"><StatusBadge status={homeLeadTopic.status} /><span>{siteConfig.vocabulary.portalContentAsOf} {siteConfig.date.formatLong(homeLeadTopic.updatedAt)}</span></div>
              <p class="eyebrow">Aktuelles Vorhaben</p>
              <h3>{homeLeadTopic.title}</h3>
              <p>{homeLeadTopic.teaser}</p>
              <dl class="home-lead-feature__facts">
                {homeLeadDate ? <div><dt>Nächster Termin</dt><dd><time datetime={homeLeadDate.date}>{siteConfig.date.formatLong(homeLeadDate.date)}</time><span>{homeLeadDate.label}</span></dd></div> : null}
                <div><dt>Nächster Schritt</dt><dd>{homeLeadTopic.naechsteSchritte[0]}</dd></div>
              </dl>
              <a class="button-link" href={getTopicUrl(homeLeadTopic.slug)}>{homeLeadTopic.title} öffnen <PortalIcon name="arrow" /></a>
            </article>
          ) : null}
          {homeSecondaryTopics.length > 0 ? (
          <div class="home-topic-list">
            {homeSecondaryTopics.map((topic) => {
              const nextDate = getNextTopicDate(topic, PORTAL_REFERENCE_DATE);
              return (
              <article>
                <div><StatusBadge status={topic.status} /></div>
                <h3><a href={getTopicUrl(topic.slug)}>{topic.title}</a></h3>
                <p>{topic.teaser}</p>
                {nextDate ? <p class="home-topic-list__date"><time datetime={nextDate.date}>{siteConfig.date.formatLong(nextDate.date)}</time> · {nextDate.label}</p> : null}
                <a class="home-topic-list__link" href={getTopicUrl(topic.slug)} aria-label={`${topic.title} ansehen`}><PortalIcon name="arrow" /></a>
              </article>
              );
            })}
          </div>
          ) : null}
        </div>
      </div>
    </section>

    <section class="home-band home-resource-section" aria-labelledby="home-resource-title">
      <div class="container">
        <header class="home-section-heading home-section-heading--compact">
          <div>
            <p class="eyebrow">Transparenz und Service</p>
            <h2 id="home-resource-title">Recht, Haushalt und Regierungsarbeit</h2>
          </div>
        </header>
        <div class:list={['home-resource-grid', latestJob && 'home-resource-grid--four']}>
          <article class="home-resource-card">
            <PortalIcon name="law" />
            <p class="eyebrow">Recht schnell finden</p>
            <h3>{latestPublication?.title ?? 'Gesetze und Vorschriften'}</h3>
            {latestPublication ? (
              <p>
                Verkündet am <time datetime={latestPublication.date}>{siteConfig.date.formatLong(latestPublication.date)}</time>
                {' · '}{latestPublication.entries.length} {publicationEntryLabel(latestPublication.entries.length)}
              </p>
            ) : <p>Aktuelle Fassungen, Fundstellen und Verkündungen im Rechtsportal.</p>}
            <a href={latestPublication ? getPublicationUrl(latestPublication.slug) : getLawHomeUrl()}>Veröffentlichung öffnen <PortalIcon name="arrow" /></a>
          </article>
          <article class="home-resource-card">
            <PortalIcon name="budget" />
            <p class="eyebrow">Doppelhaushalt 2025/2026</p>
            <h3>Öffentliche Finanzen nachvollziehen</h3>
            <p>Gesamtplan, Einzelpläne, Jahresvergleich, Sondervermögen und offene Datenausgabe.</p>
            <a href={getBudgetUrl()}>Zum Haushalt <PortalIcon name="arrow" /></a>
          </article>
          <article class="home-resource-card">
            <PortalIcon name="government" />
            <p class="eyebrow">Arbeitsprogramm</p>
            <h3>15-Punkte-Plan II</h3>
            <p>Vorhaben des ersten Staatsrates mit Umsetzungsstand und Rechtsgrundlagen.</p>
            <a href={getActionPlanUrl()}>Programm ansehen <PortalIcon name="arrow" /></a>
          </article>
          {latestJob ? (
            <article class="home-resource-card">
              <PortalIcon name="contact" />
              <p class="eyebrow">Karriere</p>
              <h3>{latestJob.title}</h3>
              <p>
                {latestJob.ressort} · Bewerbung bis{' '}
                <time datetime={latestJob.applicationDeadline}>{siteConfig.date.formatLong(latestJob.applicationDeadline)}</time>
              </p>
              <a href={getCareerUrl()}>Aktuelle Stellenangebote <PortalIcon name="arrow" /></a>
            </article>
          ) : null}
        </div>
        <div class="home-follow-row">
          <div>
            <PortalIcon name="rss" />
            <span><strong>Pressemitteilungen abonnieren</strong><small>Neue Mitteilungen stehen als RSS-Feed bereit.</small></span>
          </div>
          <a href={`${getPressUrl()}rss.xml`}>RSS-Feed öffnen</a>
          <div>
            <PortalIcon name="calendar" />
            <span><strong>Termine im Kalender</strong><small>Öffentliche Termine als Kalenderdatei.</small></span>
          </div>
          <a href={`${getPressUrl()}termine/kalender.ics`}>Kalender abonnieren</a>
        </div>
        <p class="home-contact-link"><a href={getContactUrl()}>Kontakt und weitere Serviceangebote <span aria-hidden="true">→</span></a></p>
      </div>
    </section>
  </div>
</BaseLayout>
