---
interface Item {
  label: string;
  href: string;
  current?: boolean;
}

interface Props {
  label: string;
  items: Item[];
  collapsible?: boolean;
  variant?: 'government' | 'topics' | 'law' | 'budget' | 'reform' | 'press' | 'service' | 'freestate' | 'plain';
}

const { label, items, variant = 'plain', collapsible = false } = Astro.props as Props;
const Container = collapsible ? 'details' : 'div';
const currentPath = Astro.url.pathname.replace(/\/+$/u, '/') || '/';
const pathFromHref = (href: string) => {
  if (href.startsWith('#')) return null;
  try {
    const target = new URL(href, Astro.url);
    if (target.origin !== Astro.url.origin || target.hash) return null;
    return target.pathname.replace(/\/+$/u, '/') || '/';
  } catch {
    return null;
  }
};
---

<nav class:list={['section-navigation', `section-navigation--${variant}`, collapsible && 'section-navigation--contents']} aria-label={label}>
  <Container class="section-navigation__inner">
    {collapsible ? <summary>{label}</summary> : <span class="section-navigation__label">{label}</span>}
    <ul>
      {items.map((item) => {
        const isCurrent = item.current ?? pathFromHref(item.href) === currentPath;
        return (
          <li>
            <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>{item.label}</a>
          </li>
        );
      })}
    </ul>
  </Container>
</nav>

<script>
  const wide = window.matchMedia('(min-width: 48.001rem)');
  for (const contents of document.querySelectorAll<HTMLDetailsElement>('.section-navigation--contents details')) {
    contents.open = wide.matches;
    wide.addEventListener('change', (event) => { contents.open = event.matches; });
  }
</script>
