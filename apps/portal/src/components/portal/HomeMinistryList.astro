---
import { getMinistriesUrl, getMinistryUrl, type Ministerium } from '@ostrecht/shared/lib/portal/index.ts';
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';

interface Props {
  ministries: Ministerium[];
}

const { ministries } = Astro.props as Props;
---

<section class="home-info-card home-ministries-card" aria-labelledby="home-ministries-title">
  <header class="home-info-card__header">
    <div>
      <p class="eyebrow">Ressorts</p>
      <h2 id="home-ministries-title">Ihre Staatssekretariate</h2>
    </div>
    <a href={getMinistriesUrl()}>Alle anzeigen <span aria-hidden="true">→</span></a>
  </header>
  <nav class="home-ministry-list" aria-label="Ausgewählte Staatssekretariate">
    {ministries.map((ministry) => (
      <a href={getMinistryUrl(ministry.slug)}>
        <PortalIcon name="ministry" />
        <span>{ministry.kurzname}</span>
        <PortalIcon name="arrow" />
      </a>
    ))}
  </nav>
</section>
