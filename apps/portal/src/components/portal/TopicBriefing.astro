---
import { siteConfig } from '@ostrecht/shared/config/site.ts';
import { getNextTopicDate, type Themenseite } from '@ostrecht/shared/lib/portal/index.ts';
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';
import StatusBadge from './StatusBadge.astro';

interface Props {
  topic: Themenseite;
  ministryName?: string;
  ministryHref?: string;
  referenceDate: string;
}

const { topic, ministryName, ministryHref, referenceDate } = Astro.props as Props;
const nextDate = getNextTopicDate(topic, referenceDate);
const formatDateRange = (date: string, endDate?: string) => endDate && endDate !== date
  ? `${siteConfig.date.formatLong(date)} bis ${siteConfig.date.formatLong(endDate)}`
  : siteConfig.date.formatLong(date);
---

<section id="ueberblick" class="topic-briefing" aria-labelledby="topic-briefing-title" data-visual-section="topic-briefing">
  <div class="topic-briefing__heading">
    <div>
      <p class="eyebrow">Vorhaben auf einen Blick</p>
      <h2 id="topic-briefing-title">Stand, Wirkung und nächste Schritte</h2>
    </div>
    <p class="topic-briefing__updated">
      {siteConfig.vocabulary.portalContentAsOf}: <time datetime={topic.updatedAt}>{siteConfig.date.formatLong(topic.updatedAt)}</time>
    </p>
  </div>

  <dl class="topic-fact-strip">
    <div>
      <dt><PortalIcon name="topics" /> Status</dt>
      <dd><StatusBadge status={topic.status} /></dd>
    </div>
    <div>
      <dt><PortalIcon name="calendar" /> Wichtiger Termin</dt>
      <dd>
        {nextDate ? (
          <><time datetime={nextDate.date}>{formatDateRange(nextDate.date, nextDate.endDate)}</time><span>{nextDate.label}</span></>
        ) : <span>Kein weiterer Termin belegt</span>}
      </dd>
    </div>
    <div>
      <dt><PortalIcon name="ministry" /> Federführung</dt>
      <dd>{ministryName && ministryHref ? <a href={ministryHref}>{ministryName}</a> : 'Keine Angabe'}</dd>
    </div>
    <div>
      <dt><PortalIcon name="law" /> Rechtsgrundlagen</dt>
      <dd><a href="#rechtsgrundlagen">{topic.rechtsgrundlagen.length} verknüpfte {topic.rechtsgrundlagen.length === 1 ? 'Grundlage' : 'Grundlagen'}</a></dd>
    </div>
  </dl>

  <div class="topic-progress-grid">
    <article class="topic-progress-card topic-progress-card--decided">
      <p class="topic-progress-card__label">Beschlossen</p>
      <h3>Was entschieden ist</h3>
      <ul>
        {topic.beschlossen.map((entry) => <li>{entry}</li>)}
      </ul>
    </article>
    <article class="topic-progress-card topic-progress-card--effective">
      <p class="topic-progress-card__label">Gilt oder ist umgesetzt</p>
      <h3>Was bereits erreicht ist</h3>
      <ul>
        {topic.umgesetzt.map((entry) => <li>{entry}</li>)}
      </ul>
    </article>
    <article class="topic-progress-card topic-progress-card--next">
      <p class="topic-progress-card__label">Als Nächstes</p>
      <h3>Was jetzt folgt</h3>
      <ol>
        {topic.naechsteSchritte.map((entry) => <li>{entry}</li>)}
      </ol>
    </article>
  </div>
</section>
