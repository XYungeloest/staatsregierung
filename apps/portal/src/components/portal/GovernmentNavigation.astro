---
import SectionNavigation from './SectionNavigation.astro';
import {
  getPreviousCabinetsUrl,
  getCabinetUrl,
  getGovernmentMembersUrl,
  getGovernmentUrl,
  getHoldingsUrl,
  getMinisterPresidentUrl,
} from '@ostrecht/shared/lib/portal/index.ts';
---

<SectionNavigation
  label="Staat & Behörden"
  variant="government"
  items={[
    { label: 'Staat & Behörden', href: getGovernmentUrl() },
    { label: 'Geschäftsbereiche', href: getCabinetUrl() },
    { label: 'Beteiligungen', href: getHoldingsUrl() },
    { label: 'Mitglieder', href: getGovernmentMembersUrl() },
    { label: 'Staatspräsident', href: getMinisterPresidentUrl() },
    { label: 'Frühere Staatsregierungen', href: getPreviousCabinetsUrl() },
  ]}
/>
