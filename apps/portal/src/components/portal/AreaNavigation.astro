---
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';
import { getLawHomeUrl } from '@ostrecht/shared/lib/portal/routes.ts';
import { activePortalArea, portalAreas } from '../../lib/area-navigation.ts';

interface Props { mobile?: boolean }
const { mobile = false } = Astro.props;
const current = Astro.url.pathname;
const active = activePortalArea(current);
---
<nav class={mobile ? 'mobile-nav__links area-navigation' : 'site-header__nav site-nav area-navigation'} aria-label={mobile ? 'Mobile Hauptnavigation' : 'Hauptnavigation'}>
  {portalAreas.map((area) => (
    <div class="area-nav-item" data-active={active === area || undefined}>
      <a class="area-nav-link" href={area.href} aria-current={current === area.href ? 'page' : active === area ? 'location' : undefined}>{area.label}</a>
      <details class="area-disclosure" name={mobile ? 'mobile-portal-areas' : 'desktop-portal-areas'}>
        <summary aria-label={`Unterseiten zu ${area.label}`}><PortalIcon name="disclosure" /></summary>
        <ul class="area-children">
          {area.children.map((link) => <li><a href={link.href} aria-current={link.href === current ? 'page' : undefined}>{link.label}</a></li>)}
        </ul>
      </details>
    </div>
  ))}
  <a class="area-law-link" href={getLawHomeUrl()}><PortalIcon name="law" /> OstRecht</a>
</nav>

<script>
  const selector = '.area-disclosure[open], .mobile-nav[open]';
  document.addEventListener('keydown', (event) => {
    if (event.key !== 'Escape' || !(event.target instanceof Element)) return;
    const menu = event.target.closest<HTMLDetailsElement>(selector);
    if (!menu) return;
    menu.open = false;
    menu.querySelector<HTMLElement>(':scope > summary')?.focus();
  });
  for (const type of ['click', 'focusin']) {
    document.addEventListener(type, (event) => {
      if (!(event.target instanceof Node)) return;
      for (const menu of document.querySelectorAll<HTMLDetailsElement>(selector)) {
        if (!menu.contains(event.target)) menu.open = false;
      }
    });
  }
</script>
