---
import { formatHoldingPercent } from '@ostrecht/shared/lib/portal/holdings.ts';
import type {
  BeteiligungsAbschnitt,
  BeteiligungsInventarMehrlaenderposition,
} from '@ostrecht/shared/lib/portal/schema.ts';

interface Props {
  section: BeteiligungsAbschnitt;
  sharedPositions: BeteiligungsInventarMehrlaenderposition[];
}

const { section, sharedPositions } = Astro.props as Props;
const sharedByKey = new Map(sharedPositions.map((entry) => [entry.key, entry]));
const relationLabels: Record<string, string> = {
  capital: 'Kapitalbeteiligung',
  carrier: 'Trägerposition',
  'unified-carrier': 'Vereinigte Trägerschaft',
  'six-carrier-memberships': 'Sechs Trägerpositionen',
};
---

<section id={section.id} class="section holdings-shared" aria-labelledby={`${section.id}-title`}>
  <div class="section-header">
    <h2 id={`${section.id}-title`}>{section.title}</h2>
    <p>{section.intro}</p>
  </div>
  <div class="holdings-shared-list">
    {section.items.map((item) => {
      const shared = item.dataKey ? sharedByKey.get(item.dataKey) : undefined;
      if (!shared) return null;
      const hasCapitalShare = shared.relation === 'capital' && shared.currentPercent !== null;
      const positionLabel = shared.currentPercent === null
        ? relationLabels[shared.relation] ?? 'Gemeinsame Position'
        : formatHoldingPercent(shared.currentPercent);
      return (
        <article class="holdings-shared-card">
          <div class="holdings-shared-card__heading">
            <div>
              <p class="eyebrow">{relationLabels[shared.relation] ?? 'Gemeinsame Position'}</p>
              <h3>{item.title}</h3>
            </div>
            <strong class="holdings-shared-card__value">{positionLabel}</strong>
          </div>
          {hasCapitalShare ? (
            <div class="holdings-share-bar" aria-hidden="true">
              <span style={`width: ${shared.currentPercent}%`}></span>
            </div>
          ) : null}
          <dl class="holdings-shared-card__facts">
            <div>
              <dt>Herkunftspositionen</dt>
              <dd>{shared.components.join(' · ')}</dd>
            </div>
            {shared.inheritedPercent !== null ? (
              <div>
                <dt>Gebündelt am Stichtag</dt>
                <dd>{formatHoldingPercent(shared.inheritedPercent)}</dd>
              </div>
            ) : null}
          </dl>
          <p>{item.text}</p>
        </article>
      );
    })}
  </div>
</section>
