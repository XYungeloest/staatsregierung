---
/**
 * Zeitreihe über Jahre als Säulen (Standard) oder Linie. Jedes Jahr trägt seine Art
 * (`ist`, `haushaltsjahr`, `projektion`); Projektionsjahre stehen auf einem eigenen, beschrifteten
 * Hintergrundband, ihre Säulen sind schraffiert, ihre Linienstücke gestrichelt, und Legende und
 * Tabelle nennen die Art als Text. Negative Werte laufen unter die Nulllinie; fehlende Werte
 * tragen im Diagramm die Marke „k. A.“ (keine Angabe). Die Diagrammfläche ist ein Bild
 * (`role="img"`) mit kurzer Beschreibung (Diagrammart, Jahresspanne, Projektionsjahre); die
 * Werte selbst nennt die Tabelle. Ohne Tabelle (`tabelle="keine"`) enthält die Beschreibung alle
 * Werte.
 */
import ChartData from './ChartData.astro';
import {
  axisUnit,
  formatAxisValue,
  formatExact,
  formatValue,
  niceTicks,
  PALETTE_SIZE,
  YEAR_KIND_LABELS,
  YEAR_KIND_SHORT,
  type ValueFormat,
  type YearKind,
} from './format.ts';

interface Year {
  jahr: number | string;
  art: YearKind;
}

interface Series {
  label: string;
  values: Array<number | null>;
}

interface Props {
  id: string;
  caption: string;
  jahre: Year[];
  series: Series[];
  format?: ValueFormat;
  typ?: 'saeulen' | 'linie';
  artLabels?: Partial<Record<YearKind, string>>;
  tabelle?: 'aufklappbar' | 'sichtbar' | 'keine';
  hinweis?: string;
  /** Optionales Sprungziel des Hinweises (z. B. die Tabelle mit den exakten Werten). */
  hinweisHref?: string;
}

const {
  id,
  caption,
  jahre,
  series,
  format = 'euro-compact',
  typ = 'saeulen',
  artLabels = {},
  tabelle = 'aufklappbar',
  hinweis,
  hinweisHref,
} = Astro.props as Props;

const kindLabel = (kind: YearKind) => artLabels[kind] ?? YEAR_KIND_LABELS[kind];
const count = Math.max(1, jahre.length);
const values = series.flatMap((entry) => entry.values.filter((value): value is number => typeof value === 'number'));
const ticks = niceTicks(Math.min(0, ...values), Math.max(0, ...values), 4);
const top = ticks[ticks.length - 1];
const bottom = ticks[0];
const range = top - bottom || 1;
const unit = axisUnit(Math.max(...ticks.map((tick) => Math.abs(tick))), format);

const W = count * 100;
const H = 400;
const y = (value: number) => ((top - value) / range) * H;
const topPercent = (value: number) => `${Math.round(((top - value) / range) * 10000) / 100}%`;
const zeroY = y(0);

const slotPadding = series.length > 1 ? 14 : 22;
const barGap = series.length > 1 ? 3 : 0;
const barWidth = (100 - 2 * slotPadding - barGap * (series.length - 1)) / Math.max(1, series.length);

const projectionIndexes = jahre.map((year, index) => (year.art === 'projektion' ? index : -1)).filter((index) => index >= 0);
const firstProjection = projectionIndexes[0];
const projectionCount = projectionIndexes.length;
const kinds = [...new Set(jahre.map((year) => year.art))];
const colorClass = (index: number) => `hh-farbe-${(index % PALETTE_SIZE) + 1}`;
const patternId = (index: number) => `${id}-schraffur-${index}`;
const yearLabel = (year: Year) => String(year.jahr);
const span = (indexes: number[]) =>
  indexes.length === 0
    ? ''
    : indexes.length === 1
      ? yearLabel(jahre[indexes[0]])
      : `${yearLabel(jahre[indexes[0]])} bis ${yearLabel(jahre[indexes[indexes.length - 1]])}`;
const hasMissing = series.some((entry) => jahre.some((_, index) => typeof entry.values[index] !== 'number'));
const valueList = `${series
  .map((entry) => `${entry.label}: ${jahre
    .map((year, index) => {
      const value = entry.values[index];
      return `${yearLabel(year)}${year.art === 'projektion' ? ' (Projektion)' : ''} ${typeof value === 'number' ? formatValue(value, format) : 'keine Angabe'}`;
    })
    .join(', ')}`)
  .join('; ')}.`;
const summaryLabel = [
  `${typ === 'linie' ? 'Liniendiagramm' : 'Säulendiagramm'} ${span(jahre.map((_, index) => index))}`,
  projectionCount > 0 ? `, ${span(projectionIndexes)} ${kindLabel('projektion')}` : '',
  hasMissing ? ', mit fehlenden Angaben' : '',
  '.',
  tabelle === 'keine' ? ` ${valueList}` : ' Alle Werte enthält die zugehörige Tabelle.',
].join('');

// Marken für fehlende Werte (HTML über der Fläche, damit die Schrift nicht verzerrt wird).
const zeroPercent = (zeroY / H) * 100;
const gaps =
  typ === 'saeulen'
    ? series.flatMap((entry, seriesIndex) =>
        jahre.flatMap((_, index) =>
          typeof entry.values[index] === 'number'
            ? []
            : [{ left: ((index * 100 + slotPadding + seriesIndex * (barWidth + barGap) + barWidth / 2) / W) * 100 }],
        ),
      )
    : jahre.flatMap((_, index) =>
        series.some((entry) => typeof entry.values[index] !== 'number') ? [{ left: ((index * 100 + 50) / W) * 100 }] : [],
      );
const gapBelow = zeroPercent < 15;

function linePaths(entry: Series): { solid: string; dashed: string; points: Array<{ x: number; y: number; projection: boolean }> } {
  const points = entry.values
    .map((value, index) => (typeof value === 'number' ? { x: index * 100 + 50, y: y(value), projection: jahre[index]?.art === 'projektion', index } : null))
    .filter((point): point is { x: number; y: number; projection: boolean; index: number } => point !== null);
  let solid = '';
  let dashed = '';
  points.forEach((point, position) => {
    const previous = points[position - 1];
    const contiguous = previous && previous.index === point.index - 1;
    if (!point.projection) {
      solid += `${contiguous && !previous.projection ? 'L' : 'M'}${point.x} ${point.y} `;
    } else {
      if (contiguous) {
        dashed += `M${previous.x} ${previous.y} L${point.x} ${point.y} `;
      } else {
        dashed += `M${point.x} ${point.y} `;
      }
    }
  });
  return { solid: solid.trim(), dashed: dashed.trim(), points };
}
---

<figure class:list={['hh-diagramm', 'hh-zeitreihe', `hh-zeitreihe--${typ}`]} id={id} style={`--hh-jahre: ${count}`}>
  <figcaption class="hh-diagramm__titel">{caption}</figcaption>
  <ul class="hh-legende" aria-label="Legende">
    {series.length > 1 || typ === 'linie' ? series.map((entry, index) => (
      <li class="hh-legende__eintrag">
        <span class:list={['hh-legende__muster', typ === 'linie' && 'hh-legende__muster--linie', colorClass(index)]} aria-hidden="true"></span>
        <span>{entry.label}</span>
      </li>
    )) : null}
    {hasMissing ? (
      <li class="hh-legende__eintrag">
        <span class="hh-legende__kuerzel" aria-hidden="true">k. A.</span>
        <span>keine Angabe</span>
      </li>
    ) : null}
    {kinds.map((kind) => (
      <li class="hh-legende__eintrag">
        <span
          class:list={[
            'hh-legende__muster',
            'hh-legende__muster--neutral',
            typ === 'linie' && 'hh-legende__muster--linie',
            kind === 'projektion' && (typ === 'linie' ? 'hh-legende__muster--gestrichelt' : 'hh-muster--projektion'),
            kind === 'ist' && 'hh-legende__muster--ist',
          ]}
          aria-hidden="true"
        ></span>
        <span>{kindLabel(kind)}</span>
      </li>
    ))}
  </ul>

  <div class="hh-zeitreihe__flaeche" role="img" aria-label={summaryLabel}>
    <span class="hh-zeitreihe__einheit">{unit.label}</span>
    <div class="hh-zeitreihe__kopf">
      {projectionCount > 0 ? (
        <span
          class="hh-zeitreihe__bandlabel"
          style={`grid-column: ${firstProjection + 1} / span ${projectionCount}`}
        >{projectionCount / count >= 0.34 ? kindLabel('projektion') : YEAR_KIND_SHORT.projektion}</span>
      ) : null}
    </div>
    <div class="hh-zeitreihe__yachse">
      {ticks.map((tick) => (
        <span class="hh-zeitreihe__tick" style={`top: ${topPercent(tick)}`}>{formatAxisValue(tick, unit.divisor)}</span>
      ))}
    </div>
    <div class="hh-zeitreihe__plot">
      <svg class="hh-zeitreihe__svg" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" focusable="false">
        <defs>
          {series.map((_, index) => (
            <pattern id={patternId(index)} patternUnits="userSpaceOnUse" width="14" height="14" patternTransform="rotate(45)">
              <rect class="hh-svg-hell" width="14" height="14"></rect>
              <rect class:list={['hh-svg-fuellung', colorClass(index)]} width="6" height="14"></rect>
            </pattern>
          ))}
        </defs>
        {projectionIndexes.map((index) => (
          <rect class="hh-svg-band" x={index * 100} y="0" width="100" height={H}></rect>
        ))}
        {projectionCount > 0 && firstProjection > 0 ? (
          <line class="hh-svg-grenze" x1={firstProjection * 100} x2={firstProjection * 100} y1="0" y2={H} vector-effect="non-scaling-stroke"></line>
        ) : null}
        {ticks.map((tick) => (
          <line class:list={['hh-svg-raster', tick === 0 && 'hh-svg-null']} x1="0" x2={W} y1={y(tick)} y2={y(tick)} vector-effect="non-scaling-stroke"></line>
        ))}
        {typ === 'saeulen'
          ? series.map((entry, seriesIndex) =>
              entry.values.map((value, index) => {
                if (typeof value !== 'number') return null;
                const projection = jahre[index]?.art === 'projektion';
                const x = index * 100 + slotPadding + seriesIndex * (barWidth + barGap);
                const barTop = Math.min(y(value), zeroY);
                const height = Math.max(Math.abs(y(value) - zeroY), value === 0 ? 0 : 1);
                return (
                  <rect
                    class:list={['hh-svg-saeule', colorClass(seriesIndex), projection && 'hh-svg-saeule--projektion']}
                    x={x}
                    y={barTop}
                    width={barWidth}
                    height={height}
                    style={projection ? `fill: url(#${patternId(seriesIndex)})` : undefined}
                    vector-effect="non-scaling-stroke"
                  >
                    <title>{`${yearLabel(jahre[index])}${projection ? ` (${YEAR_KIND_SHORT.projektion})` : ''} · ${entry.label}: ${formatValue(value, format)}`}</title>
                  </rect>
                );
              }),
            )
          : series.map((entry, seriesIndex) => {
              const paths = linePaths(entry);
              return (
                <g class:list={['hh-svg-linie', colorClass(seriesIndex)]}>
                  {paths.solid ? <path d={paths.solid} vector-effect="non-scaling-stroke"></path> : null}
                  {paths.dashed ? <path class="hh-svg-linie--projektion" d={paths.dashed} vector-effect="non-scaling-stroke"></path> : null}
                  {paths.points.map((point) => (
                    <path class:list={['hh-svg-punkt', point.projection && 'hh-svg-punkt--projektion']} d={`M${point.x} ${point.y} h0`} vector-effect="non-scaling-stroke"></path>
                  ))}
                </g>
              );
            })}
      </svg>
      {gaps.map((gap) => (
        <span
          class:list={['hh-zeitreihe__luecke', gapBelow && 'hh-zeitreihe__luecke--unten', typ === 'saeulen' && series.length > 1 && 'hh-zeitreihe__luecke--senkrecht']}
          style={`left: ${Math.round(gap.left * 100) / 100}%; top: ${Math.round(zeroPercent * 100) / 100}%`}
        >k. A.</span>
      ))}
    </div>
    <div class="hh-zeitreihe__xachse">
      {jahre.map((year) => (
        <span class:list={['hh-zeitreihe__jahr', year.art === 'projektion' && 'hh-zeitreihe__jahr--projektion']}>{yearLabel(year)}</span>
      ))}
    </div>
  </div>

  {hinweis ? <p class="hh-diagramm__hinweis">{hinweisHref ? <a class="inline-link" href={hinweisHref}>{hinweis}</a> : hinweis}</p> : null}
  {tabelle !== 'keine' ? (
    <ChartData label={`${caption} als Tabelle`} bezug={caption} modus={tabelle}>
      <table class="data-table hh-datentabelle">
        <caption>{caption}</caption>
        <thead>
          <tr>
            <th scope="col">Jahr</th>
            <th scope="col">Art</th>
            {series.map((entry) => <th scope="col" class="hh-zahl">{entry.label}</th>)}
          </tr>
        </thead>
        <tbody>
          {jahre.map((year, index) => (
            <tr class:list={[year.art === 'projektion' && 'hh-zeile--projektion']}>
              <th scope="row">{yearLabel(year)}</th>
              <td>{kindLabel(year.art)}</td>
              {series.map((entry) => {
                const value = entry.values[index];
                return <td class="hh-zahl">{typeof value === 'number' ? <data value={String(value)}>{formatExact(value, format)}</data> : '–'}</td>;
              })}
            </tr>
          ))}
        </tbody>
      </table>
    </ChartData>
  ) : null}
</figure>
