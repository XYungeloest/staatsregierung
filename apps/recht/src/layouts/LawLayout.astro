---
import '../styles/index.css';
import AnalyticsConsentBanner from '@ostrecht/shared/components/analytics/AnalyticsConsentBanner.astro';
import PageHead from '@ostrecht/shared/components/PageHead.astro';
import { isAnalyticsEnabled } from '@ostrecht/shared/config/analytics.ts';
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import type { SeoBreadcrumbItem, SeoImage, StructuredData } from '@ostrecht/shared/lib/seo/index.ts';
import {
  getAccessibilityUrl,
  getHomeUrl,
  getImprintUrl,
  getPrivacyUrl,
} from '@ostrecht/shared/lib/portal/routes.ts';
import {
  getHelpUrl,
  getLawPortalUrl,
  getSearchUrl,
} from '@ostrecht/shared/lib/norms/routes.ts';
import { referenceDateLabel } from '../lib/vocabulary.ts';

/**
 * Hülle von OstRecht (Richtung E „Rechtsstand“): Amtsband mit Wortmarke, Suche und fünf
 * Bereichen, Hauptbereich, Fuß mit dem Hinweis zur Simulation. Die Gestaltung liegt vollständig in apps/recht/src/styles;
 * vom Staatsportal werden nur Schriften, Kopfmetadaten und Analytik geteilt.
 */
interface Props {
  title: string;
  description?: string;
  breadcrumbs?: SeoBreadcrumbItem[];
  structuredData?: StructuredData | StructuredData[];
  noindex?: boolean;
  ogType?: 'website' | 'article';
  ogImage?: SeoImage;
  /** `contained`: Hauptbereich im Seitenraster; `full`: Seiten mit eigenen Bändern. */
  mainWidth?: 'contained' | 'full';
  canonical?: string;
  prev?: string;
  next?: string;
  /** Normseiten: Dokumentschrift vorladen. */
  documentFont?: boolean;
  /** Aktiver Bereich im Amtsband, wenn er sich nicht aus dem Pfad ergibt. */
  activeSection?: string;
  /** Zusätzliche Klasse am Body (Druck- und Seitenvarianten). */
  bodyClass?: string;
}

const {
  title,
  description = lawSiteConfig.seo.defaultDescription,
  breadcrumbs = [],
  structuredData,
  noindex = false,
  ogType = 'website',
  ogImage = lawSiteConfig.seo.defaultSocialImage,
  mainWidth = 'contained',
  canonical,
  prev,
  next,
  documentFont = false,
  activeSection,
  bodyClass,
} = Astro.props;

const currentPath = Astro.url.pathname;
const base = import.meta.env.BASE_URL;
const coatOfArmsAssetUrl = `${base}${lawSiteConfig.officialCoatOfArmsAssetPath.replace(/^\//, '')}`;
const analyticsEnabled = isAnalyticsEnabled();
const searchSuggestionsUrl = `${base}search-suggestions.json`;
const homeUrl = getLawPortalUrl();

function isActivePath(path: string): boolean {
  if (path === '/') return currentPath === '/';
  return currentPath === path || currentPath.startsWith(path);
}

const mainNavLinks = lawSiteConfig.mainNavigation.map((entry) => {
  const pathKey = entry.pathKey;
  const path = lawSiteConfig.paths[pathKey];
  const href = `${base}${path.replace(/^\//, '')}`;
  const isActive = isActivePath(path) || activeSection === pathKey;
  return { href, label: entry.label, isActive, key: pathKey };
});

/**
 * Der Fuß schließt die Seite ab und wiederholt die Recherchewege nicht: sie stehen im Amtsband
 * und – auf kleinen Bildschirmen – im Menü „Bereiche“.
 */
const footerLinks = [
  { href: getHelpUrl(), label: lawSiteConfig.targetLabels.help },
  { href: getImprintUrl(), label: 'Impressum' },
  { href: getPrivacyUrl(), label: 'Datenschutz' },
  { href: getAccessibilityUrl(), label: 'Barrierefreiheit' },
  { href: getHomeUrl(), label: 'Staatsportal' },
];
---

<!doctype html>
<html lang="de">
  <head>
    <PageHead {title} {description} {breadcrumbs} {structuredData} {noindex} {ogType} {ogImage} {canonical} {prev} {next} {documentFont} />
  </head>
  <body class:list={['law-site', bodyClass]}>
    <div class="law-shell">
      <header class="law-header">
        <a class="skip-link" href="#main-content">Zum Inhalt springen</a>
        <div class="r-container law-header__bar">
          <a class="law-wordmark" href={homeUrl} aria-label="Startseite OstRecht">
            <img src={coatOfArmsAssetUrl} alt="" width="596" height="694" />
            <span>
              <strong>{lawSiteConfig.brand}</strong>
              <small>{lawSiteConfig.bandSubline}</small>
            </span>
          </a>

          <form class="law-header-search law-header-search--compact" action={getSearchUrl()} method="get" role="search">
            <label class="visually-hidden" for="law-header-search">{lawSiteConfig.searchLabel}</label>
            <input id="law-header-search" type="search" name="q" autocomplete="off" placeholder="Vorschrift, Abkürzung, § oder Fundstelle" data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} data-law-search-url={getSearchUrl()} />
            <button type="submit">Suchen</button>
          </form>

          <nav class="law-main-nav" aria-label="Hauptnavigation">
            {mainNavLinks.map((link) => (
              <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>{link.label}</a>
            ))}
          </nav>

          <details class="law-mobile-nav">
            <summary>Bereiche</summary>
            <div class="law-mobile-nav__panel">
              <form action={getSearchUrl()} method="get" role="search">
                <label for="law-mobile-search">{lawSiteConfig.searchLabel}</label>
                <div>
                  <input class="r-input" id="law-mobile-search" type="search" name="q" autocomplete="off" placeholder="Vorschrift, Abkürzung, § oder Fundstelle" data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} data-law-search-url={getSearchUrl()} />
                  <button class="r-btn r-btn--primary" type="submit">Suchen</button>
                </div>
              </form>
              <nav aria-label="Bereiche des Rechtsportals">
                {mainNavLinks.map((link) => (
                  <a href={link.href} aria-current={link.isActive ? 'page' : undefined}>{link.label}</a>
                ))}
                <span class="r-label">Weitere Zugänge</span>
                <a href={getSearchUrl()} aria-current={isActivePath(lawSiteConfig.paths.search) ? 'page' : undefined}>{lawSiteConfig.targetLabels.search}</a>
                <a href={getAccessibilityUrl()}>Barrierefreiheit</a>
                <a href={getHomeUrl()}>Staatsportal</a>
              </nav>
            </div>
          </details>
        </div>
      </header>

      <main id="main-content" class:list={['law-main', mainWidth === 'contained' ? 'law-main--contained' : 'law-main--full']}>
        <slot />
      </main>

      <footer class="law-footer">
        <div class="r-container law-footer__inner">
          <p data-print-url={Astro.url.href} data-print-date={referenceDateLabel()}>{lawSiteConfig.authorityName} · {referenceDateLabel()} · {lawSiteConfig.officialNote}</p>
          <nav aria-label="Hilfe, rechtliche Hinweise und Staatsportal">
            {footerLinks.map((link) => <a href={link.href}>{link.label}</a>)}
          </nav>
          <p class="law-footer__simulation">{lawSiteConfig.simulationNotice}{analyticsEnabled ? <> · <button type="button" class="r-link-btn" data-analytics-consent-reset>Datenschutzeinstellungen</button></> : null}</p>
        </div>
      </footer>
    </div>
    {analyticsEnabled ? <AnalyticsConsentBanner /> : null}
    {analyticsEnabled ? <script>import '@ostrecht/shared/scripts/analytics-consent.ts';</script> : null}
    <script>import '../scripts/norm-autocomplete.ts';</script>
    <script>import '../scripts/shell.ts';</script>
  </body>
</html>
