---
/**
 * Gemeinsame Filterleiste der Verzeichnisse: Felder (Slot) in einem auto-fit-Raster, die
 * Aktionen immer an derselben Stelle, „Zurücksetzen“ immer vorhanden und ausgegraut, solange
 * kein Filter aktiv ist. Die Ergebniszahl steht unmittelbar unter der Leiste – auf allen Seiten
 * an derselben Stelle; der Bereichskopf wiederholt sie nicht.
 *
 * Das Formular ist ein GET-Formular: Filter und Seiten laufen serverseitig, die Adresse trägt
 * die Auswahl. Auswahländerungen senden es sofort ab; ohne JavaScript wirkt die Schaltfläche.
 */
interface Props {
  action: string;
  /** Beschriftung des Formulars für Hilfstechnik. */
  label: string;
  /** Mitzuführende Parameter, die nicht als Feld erscheinen (z. B. Buchstabe). */
  hidden?: Record<string, string | undefined>;
  /** Ist mindestens ein Filter aktiv? Steuert den Zustand von „Zurücksetzen“. */
  active: boolean;
  resetHref: string;
  /** Ergebniszahl in einem Satz, z. B. „23 Vorschriften; angezeigt 1–23.“ */
  count: string;
  /** Zusätzliche Attribute am Formular bzw. an der Ergebniszeile (Testanker). */
  attrs?: Record<string, string | undefined>;
  countAttrs?: Record<string, string | undefined>;
}

const { action, label, hidden = {}, active, resetHref, count, attrs = {}, countAttrs = {} } = Astro.props;
const hiddenEntries = Object.entries(hidden).filter((entry): entry is [string, string] => Boolean(entry[1]));
---

<form class="directory-filter" method="get" action={action} aria-label={label} data-directory-filter {...attrs}>
  {hiddenEntries.map(([name, value]) => <input type="hidden" name={name} value={value} />)}
  <div class="directory-filter__fields">
    <slot />
  </div>
  <div class="directory-filter__actions">
    <button class="button-link" type="submit">Filtern</button>
    {active
      ? <a class="button-link button-link--secondary" href={resetHref} data-directory-reset>Zurücksetzen</a>
      : <span class="button-link button-link--secondary directory-filter__reset--inactive" aria-disabled="true" data-directory-reset>Zurücksetzen</span>}
  </div>
</form>
<p class="directory-count" aria-live="polite" data-directory-count {...countAttrs}>{count}</p>

<script>
  for (const form of document.querySelectorAll<HTMLFormElement>('[data-directory-filter]')) {
    // Leere Felder nicht in die Adresse übernehmen (die Seite lädt neu, die Felder sind danach wieder aktiv).
    form.addEventListener('submit', () => {
      form.querySelectorAll<HTMLInputElement | HTMLSelectElement>('input[name], select[name]').forEach((field) => {
        if (!field.value.trim()) field.disabled = true;
      });
    });
    for (const select of form.querySelectorAll<HTMLSelectElement>('select')) {
      select.addEventListener('change', () => form.requestSubmit());
    }
  }
</script>
