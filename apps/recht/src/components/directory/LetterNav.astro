---
import { formatCount, NORM_UNIT } from '../../lib/counts.ts';
import type { IndexLetterCount } from '../../lib/runtime/store.ts';

/**
 * Buchstabenleiste: Sprungnavigation zwischen den Buchstabengruppen eines Verzeichnisses. Alle
 * Buchstaben stehen da; nicht belegte Gruppen sind sichtbar inaktiv statt entfernt.
 */
interface Props {
  letters: IndexLetterCount[];
  current?: string;
  hrefFor: (letter: string) => string;
  label?: string;
  withAll?: boolean;
  unit?: { one: string; many: string };
  /** Register bieten alle Buchstaben ohne normbezogene Trefferzahlen an. */
  allAvailable?: boolean;
}

const { letters, current = '', hrefFor, label = 'Anfangsbuchstabe', withAll = true, unit = NORM_UNIT, allAvailable = false } = Astro.props;
const counts = new Map(letters.map((entry) => [entry.letter, entry.count]));
const alphabet = [...'ABCDEFGHIJKLMNOPQRSTUVWXYZ', '#'];
const total = letters.reduce((sum, entry) => sum + entry.count, 0);
---

<nav class="letter-nav" aria-label={label}>
  {withAll ? <a href={hrefFor('')} aria-current={current ? undefined : 'page'} data-index-letter="" title={formatCount(total, unit.one, unit.many)}>Alle</a> : null}
  {alphabet.map((letter) => {
    const count = counts.get(letter) ?? 0;
    const name = letter === '#' ? 'Ziffern und Sonderzeichen' : letter;
    return count > 0 || allAvailable
      ? <a href={hrefFor(letter)} aria-current={letter === current ? 'page' : undefined} data-index-letter={letter} title={allAvailable ? name : `${name}: ${formatCount(count, unit.one, unit.many)}`}>{letter}</a>
      : <span aria-disabled="true" data-index-letter={letter} title={`${name}: keine ${unit.many}`}>{letter}</span>;
  })}
</nav>
