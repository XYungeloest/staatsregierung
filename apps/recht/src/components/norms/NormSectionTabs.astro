---
import { getNormHistoryUrl, getNormUrl, getNormVersionUrl, getNormFactsUrl, getNormRelationsUrl, getNormVersionFactsUrl, getNormVersionRelationsUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import { NORM_HISTORY_LABEL } from '../../lib/vocabulary.ts';

/**
 * Bereiche der Vorschrift (Reiterzeile): Text, Vorschriftendaten, Fassungen und Änderungen,
 * Rechtsbeziehungen. Primäre Bereiche besitzen eigene URLs; Hash-Anker dienen ausschließlich
 * sekundären Sprüngen innerhalb einer Ansicht. Konkrete Fassungen behalten ihre Version-ID.
 */
interface Props {
  slug: string;
  /** Konkrete angezeigte Fassung, auch wenn diese momentan die geltende ist. */
  versionId?: string;
  active: 'text' | 'facts' | 'versions' | 'relations';
}

const { slug, versionId, active } = Astro.props;
const textHref = versionId ? getNormVersionUrl(slug, versionId) : getNormUrl(slug);
const tabs = [
  { key: 'text', label: 'Text', href: textHref },
  { key: 'facts', label: 'Vorschriftendaten', href: versionId ? getNormVersionFactsUrl(slug, versionId) : getNormFactsUrl(slug) },
  { key: 'versions', label: NORM_HISTORY_LABEL, href: getNormHistoryUrl(slug) },
  { key: 'relations', label: 'Rechtsbeziehungen', href: versionId ? getNormVersionRelationsUrl(slug, versionId) : getNormRelationsUrl(slug) },
] as const;
---

<nav class="r-tabs norm-tabs" aria-label="Bereiche der Vorschrift">
  {tabs.map((tab) => <a data-norm-tab={tab.key} href={tab.href} aria-current={tab.key === active ? 'page' : undefined}>{tab.label}</a>)}
</nav>
