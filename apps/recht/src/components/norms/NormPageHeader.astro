---
import {
  formatDate,
  formatNormType,
  getNormVersionIdentity,
  toDisplayText,
  type NormRecord,
  type NormVersion,
} from '@ostrecht/shared/lib/norms/index.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  eyebrow: string;
  status: string;
  reference: string;
  referenceUrl?: string;
  publicationPdf?: string;
  htmlHref?: string;
}

const { norm, version, eyebrow, status, reference, referenceUrl, publicationPdf, htmlHref = '#normtext' } = Astro.props;
const identity = getNormVersionIdentity(norm, version);
---

<header class="section-hero section-hero--law norm-page-header">
  <div class="norm-page-header__main">
    <p class="eyebrow">{eyebrow}</p>
    <p class="norm-page-header__status"><span aria-hidden="true"></span>{status}</p>
    <h1 class="section-hero__title--long">{toDisplayText(identity.title)}</h1>
    {identity.abbr ? <p class="norm-page-header__abbr">{toDisplayText(identity.abbr)}</p> : null}
    <p class="norm-page-header__summary">{toDisplayText(identity.summary)}</p>
    <p class="norm-page-header__reference">
      <strong>Fundstelle:</strong>{' '}
      {referenceUrl ? <a href={referenceUrl}>{reference}</a> : reference}
    </p>
    <dl class="norm-page-header__facts">
      <div><dt>Normtyp</dt><dd>{formatNormType(norm.meta.type)}</dd></div>
      <div><dt>Fassungsstand</dt><dd><time datetime={version.validFrom}>{formatDate(version.validFrom)}</time></dd></div>
    </dl>
  </div>
  <nav class="norm-page-header__actions" aria-label="Werkzeuge zur Vorschrift">
    {publicationPdf ? <a href={publicationPdf}>PDF</a> : null}
    <a href={htmlHref}>HTML</a>
    <button type="button" data-copy-page-url>Link kopieren</button>
  </nav>
  <p class="copy-feedback norm-page-header__feedback" aria-live="polite" data-copy-page-feedback></p>
</header>

<script>
  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof HTMLButtonElement) || !event.target.matches('[data-copy-page-url]')) return;
    const feedback = event.target.closest<HTMLElement>('.norm-page-header')?.querySelector<HTMLElement>('[data-copy-page-feedback]');
    try {
      await navigator.clipboard.writeText(window.location.href);
      if (feedback) feedback.textContent = 'Link wurde kopiert.';
    } catch {
      if (feedback) feedback.textContent = 'Der Link kann aus der Adresszeile kopiert werden.';
    }
  });
</script>
