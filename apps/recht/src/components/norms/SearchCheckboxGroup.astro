---
interface Option {
  value: string;
  label: string;
  /** Interne Werte, die diese Option gemeinsam filtert (etwa `repealed` und `historical` als „außer Kraft“). */
  values?: string[];
}

interface Props {
  legend: string;
  name: string;
  facet: string;
  options: Option[];
  /** Versal-Etikett (erweiterte Suche) statt fetter Gruppenüberschrift (Seitenspalte). */
  caps?: boolean;
  /** Vorbelegte Werte (etwa der Standard „in Kraft“ der Geltung). */
  checked?: string[];
}

const { legend, name, facet, options, caps = false, checked = [] } = Astro.props;
---

{options.length > 0 ? (
<fieldset class:list={['r-fieldset', caps ? 'r-fieldset--caps' : undefined, 'search-filter-group']} data-search-facet-group={facet}>
  <legend>{legend}</legend>
  <div class="search-filter-group__options">
    {options.map((option) => (
      <label class="r-check search-filter-option">
        <input
          type="checkbox"
          name={name}
          value={option.value}
          checked={checked.includes(option.value)}
          data-search-filter={name}
          data-search-facet={facet}
          data-search-facet-values={option.values && option.values.length > 1 ? option.values.join(' ') : undefined}
          data-base-label={option.label}
        />
        <span data-search-facet-label>{option.label}</span>
        <span class="r-muted" data-search-facet-count aria-hidden="true"></span>
      </label>
    ))}
  </div>
</fieldset>
) : null}
