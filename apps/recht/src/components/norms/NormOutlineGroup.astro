---
import type { NormChangeMarks } from '@ostrecht/shared/lib/norms/change-marks.ts';
import type { NormOutlineItem } from '@ostrecht/shared/lib/norms/display.ts';
import { formatShortDate } from '../../lib/dates.ts';

/**
 * Ebene der Inhaltsübersicht: Gliederungseinheiten (Teil, Kapitel, Abschnitt) als `details` mit
 * Summary aus Bezeichnung, Titel und Normspanne; §§, Artikel und Anlagen als Listeneinträge.
 * Rekursiv für verschachtelte Gliederungen.
 */
interface Props {
  items: NormOutlineItem[];
  level: number;
  /** Die erste Gruppe dieser Ebene steht beim Laden offen (kein Zustand ohne JavaScript verloren). */
  openFirst?: boolean;
  /** Marken am Ort der Änderung: Einträge geänderter oder neuer Einheiten tragen „geänd.“/„neu“. */
  changes?: { marks: NormChangeMarks; validFrom: string };
}

const { items, level, openFirst = false, changes } = Astro.props;

/** Kurzmarke und vollständiger Text der Marke eines Eintrags; die Gruppe zählt ihre Marken nicht. */
function changeMark(entry: NormOutlineItem): { short: string; text: string } | undefined {
  const mark = changes?.marks.get(entry.anchor);
  if (!mark || !changes) return undefined;
  const text = `${mark.kind === 'added' ? 'neu' : 'geändert'} mit Wirkung vom ${formatShortDate(changes.validFrom)}`;
  return { short: mark.kind === 'added' ? 'neu' : 'geänd.', text };
}

function isUnit(entry: NormOutlineItem): boolean {
  return Boolean(entry.label && /^(§|Art\.|Artikel)/u.test(entry.label));
}

function isAnnex(entry: NormOutlineItem): boolean {
  return /^Anlage/u.test(entry.label ?? entry.title);
}

function unitLabels(entry: NormOutlineItem): string[] {
  const own = isUnit(entry) ? [entry.label!] : [];
  return [...own, ...entry.children.flatMap(unitLabels)];
}

/** Normspanne einer Gruppe („§§ 21–37“, „Art. 3–9“); eine einzelne Norm steht mit ihrem Zeichen. */
function rangeOf(entry: NormOutlineItem): string | undefined {
  const labels = unitLabels(entry).filter((label) => !/^Anlage/u.test(label));
  if (labels.length === 0) return undefined;
  const first = labels[0];
  const last = labels[labels.length - 1];
  if (first === last) return first;
  const prefix = /^§/u.test(first) ? '§§ ' : /^Art/u.test(first) ? 'Art. ' : '';
  const strip = (label: string) => label.replace(/^(§§?|Art\.|Artikel)\s*/u, '');
  return `${prefix}${strip(first)}–${strip(last)}`;
}

function textOf(entry: NormOutlineItem): string {
  return entry.label && entry.label !== entry.title ? `${entry.label} ${entry.title}` : entry.title;
}

let firstGroupSeen = false;
---

{items.map((entry) => {
  if (isUnit(entry) || isAnnex(entry) || entry.children.length === 0) {
    return (
      <li class:list={[isAnnex(entry) ? 'norm-outline__item--annex' : isUnit(entry) ? 'norm-outline__item--unit' : 'norm-outline__item--division']}>
        <a href={`#${entry.anchor}`} data-outline-link={entry.anchor}><span>{textOf(entry)}</span>{changeMark(entry) ? <span class="norm-outline__mark" title={changeMark(entry)!.text}><span aria-hidden="true">{changeMark(entry)!.short}</span><span class="visually-hidden">{changeMark(entry)!.text}</span></span> : null}</a>
      </li>
    );
  }
  const open = openFirst && !firstGroupSeen;
  firstGroupSeen = true;
  const range = rangeOf(entry);
  return (
    <li class="norm-outline__item--division">
      <details class="norm-outline__group" data-outline-group open={open}>
        <summary class="norm-outline__group-summary">
          <span class="norm-outline__group-title">{textOf(entry)}</span>
          {range ? <span class="norm-outline__group-range r-muted">{range}</span> : null}
        </summary>
        <div class="norm-outline__group-body">
          <a class="norm-outline__group-link" href={`#${entry.anchor}`} data-outline-link={entry.anchor}>Zum Anfang der Gliederungseinheit</a>
          <ol class="norm-outline__sublist r-num">
            <Astro.self items={entry.children} level={level + 1} changes={changes} />
          </ol>
        </div>
      </details>
    </li>
  );
})}
