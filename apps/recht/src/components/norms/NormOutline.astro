---
import type { NormOutlineItem } from '@ostrecht/shared/lib/norms/display.ts';

/**
 * Inhaltsübersicht (P3): Teile, Kapitel, Abschnitte, §§/Artikel und Anlagen als flache Liste mit
 * Einrückung, Filterfeld und Paragraphenspanne je Gliederungsebene. Auf großen Breiten die feste
 * linke Spalte, darunter ein Aufklappbereich unter der Reiterzeile (Schaltfläche „Inhalt“).
 */
interface Props {
  items: NormOutlineItem[];
  /** Zahl der §§/Artikel und Anlagen für die Fußzeile. */
  summary?: string;
  /** `desktop`: feste linke Spalte; `sheet`: Inhalt des mobilen Aufklappbereichs. */
  variant?: 'desktop' | 'sheet';
}

interface FlatItem {
  anchor: string;
  text: string;
  level: number;
  range?: string;
  kind: 'division' | 'unit' | 'annex';
}

const { items, summary, variant = 'desktop' } = Astro.props;

function unitLabels(entry: NormOutlineItem): string[] {
  const own = entry.label && /^(§|Art\.|Artikel)/u.test(entry.label) ? [entry.label] : [];
  return [...own, ...entry.children.flatMap(unitLabels)];
}

function rangeOf(entry: NormOutlineItem): string | undefined {
  const labels = unitLabels(entry).filter((label) => !/^Anlage/u.test(label));
  if (labels.length === 0) return undefined;
  const first = labels[0];
  const last = labels[labels.length - 1];
  if (first === last) return first;
  const prefix = /^§/u.test(first) ? '§§ ' : '';
  const strip = (label: string) => label.replace(/^(§§?|Art\.|Artikel)\s*/u, '');
  return `${prefix}${strip(first)}–${strip(last)}`;
}

function flatten(entries: NormOutlineItem[], level = 0): FlatItem[] {
  return entries.flatMap((entry) => {
    const isUnit = Boolean(entry.label && /^(§|Art\.|Artikel)/u.test(entry.label));
    const isAnnex = /^Anlage/u.test(entry.label ?? entry.title);
    const text = entry.label && entry.label !== entry.title ? `${entry.label} ${entry.title}` : entry.title;
    const item: FlatItem = { anchor: entry.anchor, text, level, kind: isAnnex ? 'annex' : isUnit ? 'unit' : 'division' };
    if (!isUnit && !isAnnex) item.range = rangeOf(entry);
    return [item, ...flatten(entry.children, level + 1)];
  });
}

const flat = flatten(items);
const hasDivisions = flat.some((entry) => entry.kind === 'division');
---

{flat.length > 0 ? (
  <nav class:list={['norm-outline', `norm-outline--${variant}`]} aria-label={variant === 'sheet' ? 'Inhaltsübersicht (mobil)' : 'Inhaltsübersicht'} data-norm-outline>
    <div class="norm-outline__filter">
      <label>
        <span class="visually-hidden">§ oder Stichwort in der Übersicht</span>
        <input class="r-input" type="search" placeholder="§ oder Stichwort in der Übersicht" data-outline-search />
      </label>
    </div>
    <ol class="norm-outline__list r-num">
      {flat.map((entry) => (
        <li class:list={[`norm-outline__item--${entry.kind}`, hasDivisions ? `norm-outline__item--level-${Math.min(entry.level, 3)}` : 'norm-outline__item--level-0']}>
          <a href={`#${entry.anchor}`} data-outline-link={entry.anchor}>
            <span>{entry.text}</span>
            {entry.range ? <span class="r-muted">{entry.range}</span> : null}
          </a>
        </li>
      ))}
    </ol>
    {summary ? <p class="norm-outline__summary r-caption">{summary} · Übersicht bleibt beim Lesen sichtbar; die aktuelle Stelle wird hervorgehoben.</p> : null}
  </nav>
) : null}
