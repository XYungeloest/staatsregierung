---
import type { NormOutlineItem } from '@ostrecht/shared/lib/norms/display.ts';
import NormOutlineGroup from './NormOutlineGroup.astro';

/**
 * Inhaltsübersicht (P3): Teile, Kapitel und Abschnitte als zugängliche Aufklappgruppen mit
 * Bezeichnung, Titel und Normspanne („§§ 21–37“), darin die einzelnen §§/Artikel; Anlagen am
 * Ende. Sehr lange Vorschriften erscheinen so nicht als flache Liste. Auf großen Breiten die feste
 * linke Spalte, darunter der Aufklappbereich unter der Reiterzeile (Schaltfläche „Inhalt“).
 * Die erste Gruppe steht beim Laden offen; die Gruppe der gelesenen Stelle öffnet norm-page.ts.
 */
interface Props {
  items: NormOutlineItem[];
  /** Zahl der §§/Artikel und Anlagen für die Fußzeile. */
  summary?: string;
  /** `desktop`: feste linke Spalte; `sheet`: Inhalt des mobilen Aufklappbereichs. */
  variant?: 'desktop' | 'sheet';
}

const { items, summary, variant = 'desktop' } = Astro.props;
const hasDivisions = items.some((entry) => entry.children.length > 0 && !/^(§|Art\.|Artikel|Anlage)/u.test(entry.label ?? ''));
---

{items.length > 0 ? (
  <nav class:list={['norm-outline', `norm-outline--${variant}`, hasDivisions ? 'norm-outline--grouped' : undefined]} aria-label={variant === 'sheet' ? 'Inhaltsübersicht (mobil)' : 'Inhaltsübersicht'} data-norm-outline>
    <div class="norm-outline__filter">
      <label>
        <span class="visually-hidden">§ oder Stichwort in der Übersicht</span>
        <input class="r-input" type="search" placeholder="§ oder Stichwort in der Übersicht" data-outline-search />
      </label>
    </div>
    <ol class="norm-outline__list r-num">
      <NormOutlineGroup items={items} level={0} openFirst={true} />
    </ol>
    {summary ? <p class="norm-outline__summary r-caption">{summary}</p> : null}
  </nav>
) : null}
