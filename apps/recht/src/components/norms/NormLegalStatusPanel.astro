---
import NormOriginBadge from './NormOriginBadge.astro';
import { LEGAL_BASELINE_DATE, type NormOriginInfo } from '@ostrecht/shared/lib/norms/origin.ts';
import { classifyNormOriginVersion } from '@ostrecht/shared/lib/norms/origin-presentation.ts';
import {
  getNormCompareSelectionUrl,
  getNormUrl,
  getNormVersionUrl,
} from '@ostrecht/shared/lib/norms/routes.ts';
import { formatDate } from '@ostrecht/shared/lib/norms/display.ts';
import { toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import { classifyNormVersion, EDITORIAL_REFERENCE_DATE } from '@ostrecht/shared/lib/norms/versions.ts';
import type { NormRecord, NormVersion } from '@ostrecht/shared/lib/norms/schema.ts';

/**
 * Gemeinsamer Hinweis „Rechtsstand und Herkunft“ der Normseite: eine Statuszeile zur
 * angezeigten Fassung, die Herkunftskennzeichnung, die letzte ostdeutsche Änderung und die
 * Quellenwege (Ausgangsfassung, Vergleich, amtliche sächsische Quelle, Änderungsvorschrift).
 * Ersetzt die früheren getrennten Kästen „Rechtsstand“ und „Übernommenes Recht“.
 */
interface Props {
  norm: NormRecord;
  version: NormVersion;
  origin: NormOriginInfo;
}

const { norm, version, origin } = Astro.props;
const temporalKind = classifyNormVersion(norm, version);
const status = norm.meta.status;
const versionKind = classifyNormOriginVersion(origin, version);
const baselineVersion = origin.baselineVersionId
  ? norm.versions.find((entry) => entry.versionId === origin.baselineVersionId)
  : undefined;
const baselineUrl = baselineVersion
  ? classifyNormVersion(norm, baselineVersion) === 'current'
    ? getNormUrl(norm.meta.slug)
    : getNormVersionUrl(norm.meta.slug, baselineVersion.versionId)
  : undefined;
const compareUrl = baselineVersion && baselineVersion.versionId !== version.versionId
  ? getNormCompareSelectionUrl(norm.meta.slug, baselineVersion.versionId, version.versionId)
  : undefined;
const lastOwnChange = origin.ownChanges.at(-1);
const showCurrentLink = versionKind !== 'inherited-amended' && versionKind !== 'ostdeutsch-original' && temporalKind !== 'current' && origin.kind === 'inherited-amended';
const statusText = temporalKind === 'historical'
  ? `Historische Fassung, gültig ab ${formatDate(version.validFrom)}${version.validTo ? ` bis ${formatDate(version.validTo)}` : '; ein genaues Gültigkeitsende ist nicht gespeichert'}.`
  : temporalKind === 'future'
    ? `Verkündet; tritt am ${formatDate(version.validFrom)} in Kraft und gehört bis dahin nicht zum geltenden Rechtsstand.`
    : temporalKind === 'unknown-effective'
      ? 'Veröffentlicht; der Eintritt der Bedingung für das Inkrafttreten ist durch die vorliegenden Quellen noch nicht belegt.'
      : status === 'one-time-act'
        ? `Abgeschlossener einmaliger Rechtsakt mit Wirkung vom ${formatDate(version.validFrom)}; die Fassung bleibt zu Dokumentationszwecken verfügbar.`
        : `Geltende Fassung mit Rechtsstand vom ${formatDate(version.validFrom)}${version.validTo ? `, gültig bis ${formatDate(version.validTo)}` : ''} (Stichtag ${formatDate(EDITORIAL_REFERENCE_DATE)}).`;
const amendmentCount = origin.ownAmendmentCount;
const originText = versionKind === 'ostdeutsch-original'
  ? 'Erst im Freistaat Ostdeutschland geschaffen; kein übernommenes sächsisches Ausgangsrecht.'
  : versionKind === 'baseline'
    ? origin.kind === 'inherited-unchanged'
      ? 'Aus dem sächsischen Rechtsstand vom 1. November 2023 übernommen und seitdem im Freistaat Ostdeutschland nicht geändert.'
      : 'Diese Fassung ist der am 1. November 2023 übernommene sächsische Ausgangsrechtsstand; die Vorschrift wurde seitdem im Freistaat Ostdeutschland geändert.'
    : versionKind === 'inherited-intermediate'
      ? 'Übernommener sächsischer Rechtsstand vor der ersten nachgewiesenen ostdeutschen Änderung der Vorschrift.'
      : versionKind === 'inherited-amended'
        ? `Aus dem sächsischen Rechtsstand vom 1. November 2023 übernommen; die angezeigte Fassung berücksichtigt ${amendmentCount === 1 ? 'eine ostdeutsche Änderung' : `${amendmentCount} ostdeutsche Änderungen`}.`
        : 'Die vorliegenden Quellen reichen für eine sichere Zuordnung zu übernommenem Ausgangsrecht oder eigenständig geschaffenem Landesrecht noch nicht aus.';
const headingId = `norm-legal-status-${norm.meta.slug}-${version.versionId}`;
const links = [
  ...(baselineUrl && baselineUrl !== getNormVersionUrl(norm.meta.slug, version.versionId) && versionKind !== 'baseline'
    ? [{ href: baselineUrl, label: `Ausgangsfassung vom ${formatDate(LEGAL_BASELINE_DATE)}` }]
    : []),
  ...(showCurrentLink ? [{ href: getNormUrl(norm.meta.slug), label: 'Geltende Fassung' }] : []),
  ...(compareUrl ? [{ href: compareUrl, label: 'Mit Ausgangsrecht vergleichen' }] : []),
  ...(lastOwnChange?.relatedNormSlug ? [{ href: getNormUrl(lastOwnChange.relatedNormSlug), label: 'Ostdeutsche Änderungsvorschrift' }] : []),
  ...(origin.baselineSourceUrl ? [{ href: origin.baselineSourceUrl, label: 'Amtliche sächsische Quelle' }] : []),
];
---

<aside class:list={['norm-legal-status', `norm-legal-status--${temporalKind}`, `norm-legal-status--${origin.kind}`]} aria-labelledby={headingId} data-visual-section="norm-legal-status">
  <div class="norm-legal-status__head">
    <h2 id={headingId}>Rechtsstand und Herkunft</h2>
    <NormOriginBadge kind={origin.kind} variant="full" />
  </div>
  <p class="norm-legal-status__status"><span class="norm-legal-status__term">Rechtsstand</span> {statusText}</p>
  <p class="norm-legal-status__origin"><span class="norm-legal-status__term">Herkunft</span> {originText}</p>
  {lastOwnChange && origin.kind === 'inherited-amended' ? (
    <p class="norm-legal-status__change">
      <span class="norm-legal-status__term">Zuletzt ostdeutsch geändert</span>{' '}
      <time datetime={lastOwnChange.date}>{formatDate(lastOwnChange.date)}</time>
      {lastOwnChange.citation ? <> · {toDisplayText(lastOwnChange.citation)}</> : null}
    </p>
  ) : null}
  {links.length > 0 ? (
    <nav class="link-list link-list--inline norm-legal-status__links" aria-label="Ausgangsrecht, Vergleich und Quellen">
      {links.map((link) => <a href={link.href}>{link.label}</a>)}
    </nav>
  ) : null}
</aside>
