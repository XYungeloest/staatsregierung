---
import { formatDate, getNormHistoryUrl, type NormRecord } from '@ostrecht/shared/lib/norms/index.ts';
import { NORM_HISTORY_LABEL } from '../../lib/vocabulary.ts';
import { describeChange } from '../../lib/history-labels.ts';

interface Props { norm: NormRecord; }
const { norm } = Astro.props;
const entries = [...norm.history.entries].sort((left, right) => right.date.localeCompare(left.date)).slice(0, 4);
---

{entries.length > 0 ? (
  <section class="norm-side-card" data-visual-section="norm-history-summary">
    <h2>Letzte Änderungen</h2>
    <ol class="norm-side-history">
      {entries.map((entry) => (
        <li>
          <time datetime={entry.date}>{formatDate(entry.date)}</time>
          <span>{describeChange(entry)}</span>
        </li>
      ))}
    </ol>
    <a class="law-card-footer-link" href={getNormHistoryUrl(norm.meta.slug)}>{NORM_HISTORY_LABEL}</a>
  </section>
) : null}
