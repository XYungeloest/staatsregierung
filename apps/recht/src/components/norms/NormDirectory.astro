---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import NormDirectoryListing from '../directory/NormDirectoryListing.astro';
import { getLawPortalUrl, getSearchUrl } from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { loadNormDirectory } from '../../lib/runtime/directory.ts';

/**
 * Normtyp-Verzeichnis (Gesetze, Verordnungen, Verwaltungsvorschriften, Förderrichtlinien):
 * Bereichskopf mit Volltextsuche, darunter das gemeinsame Verzeichnismuster. Filter und Seiten
 * laufen serverseitig; ein Aufruf liefert höchstens eine Seite.
 */
interface Props {
  title: string;
  lead: string;
  href: string;
  type: NormType;
}

const { title, lead, href, type } = Astro.props;
const store = await getNormStore(Astro.locals);
const { filters } = await store.getSearchFilters();
const view = await loadNormDirectory(store, {
  basePath: href,
  scope: { types: [type] },
  searchParams: Astro.url.searchParams,
  fields: ['q', 'subject', 'status', 'origin'],
  filterOptions: { subjects: filters.subjects },
});
const pageTitle = view.result.page > 1 ? `${title} (Seite ${view.result.page} von ${view.result.pageCount})` : title;
---

<LawLayout
  title={pageTitle}
  description={`${title} des Ostdeutschen Freistaates alphabetisch, nach Sachgebiet und Rechtsstand recherchieren.`}
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: title, href }]}
  canonical={view.canonical}
  noindex={view.noindex}
  prev={view.pagination.prev}
  next={view.pagination.next}
>
  <Breadcrumbs items={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: title }]} />
  <SectionHero eyebrow="Rechtsportal" title={title} lead={lead} variant="law">
    <form class="law-directory-search" action={getSearchUrl()} method="get">
      <input type="hidden" name="type" value={type} />
      <label class="search-field"><span>Volltextsuche in diesem Normtyp</span><input type="search" name="q" placeholder={`${title} durchsuchen`} autocomplete="off" data-law-norm-autocomplete data-law-suggestions-url={`${import.meta.env.BASE_URL}search-suggestions.json`} /></label>
      <button class="button-link" type="submit">Suchen</button>
    </form>
  </SectionHero>

  <NormDirectoryListing view={view} heading={`${title} im Verzeichnis`} filterLabel={`${title} filtern`} />
</LawLayout>
