---
import LawLayout from '../../layouts/LawLayout.astro';
import NormDirectoryListing from '../directory/NormDirectoryListing.astro';
import { getLawPortalUrl, getSearchUrl } from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { loadNormDirectory } from '../../lib/runtime/directory.ts';

/**
 * Typseite (Gesetze, Verordnungen, Verwaltungsvorschriften): das Listenmuster von P6b als
 * vorgefilterte Variante ohne Untergliederungsspalte; der Kopf nennt den Normtyp.
 */
interface Props {
  title: string;
  lead: string;
  href: string;
  type: NormType;
}

const { title, lead, href, type } = Astro.props;
const store = await getNormStore(Astro.locals);
const { filters } = await store.getSearchFilters();
const view = await loadNormDirectory(store, {
  basePath: href,
  scope: { types: [type] },
  searchParams: Astro.url.searchParams,
  fields: ['q', 'subject', 'status', 'origin'],
  filterOptions: { subjects: filters.subjects },
});
const pageTitle = view.result.page > 1 ? `${title} (Seite ${view.result.page} von ${view.result.pageCount})` : title;
const searchSuggestionsUrl = `${import.meta.env.BASE_URL}search-suggestions.json`;
---

<LawLayout
  title={pageTitle}
  description={`${title} des Ostdeutschen Freistaates alphabetisch, nach Sachgebiet, Geltung und Herkunft recherchieren.`}
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: title, href }]}
  canonical={view.canonical}
  noindex={view.noindex}
  prev={view.pagination.prev}
  next={view.pagination.next}
>
  <header class="r-page-head r-page-head--type">
    <p class="r-kicker"><a href={getLawPortalUrl()}>OstRecht</a><span>{title}</span></p>
    <h1>{title}</h1>
    <p class="r-lead">{lead}</p>
    <form class="r-type-search" action={getSearchUrl()} method="get" role="search">
      <input type="hidden" name="type" value={type} />
      <label class="r-field r-type-search__field"><span>Volltextsuche in diesem Normtyp</span><input class="r-input" type="search" name="q" placeholder={`${title} durchsuchen`} autocomplete="off" data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} data-law-search-url={getSearchUrl()} /></label>
      <button class="r-btn r-btn--primary" type="submit">Suchen</button>
    </form>
  </header>

  <NormDirectoryListing view={view} heading={`${title} im Verzeichnis`} filterLabel={`${title} filtern`} showType={false} caption={`${title} mit Abkürzung, Geltung, Rechtsstand und Herkunft`} />
</LawLayout>
