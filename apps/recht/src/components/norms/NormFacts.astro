---
import { LEGAL_BASELINE_DATE, type NormOriginInfo } from '@ostrecht/shared/lib/norms/origin.ts';
import { classifyNormOriginVersion } from '@ostrecht/shared/lib/norms/origin-presentation.ts';
import { getNormCompareSelectionUrl, getNormHistoryUrl, getNormUrl, getNormVersionUrl, getPublicationUrl, getSubjectUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import { formatSubjectLabel } from '@ostrecht/shared/config/law-subjects.ts';
import { formatDate, getNormTitleBlock } from '@ostrecht/shared/lib/norms/display.ts';
import { formatNormType, toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import { classifyNormVersion } from '@ostrecht/shared/lib/norms/versions.ts';
import { formatNormOriginKind } from '@ostrecht/shared/lib/norms/origin.ts';
import type { NormBodyBlock, NormRecord, NormVersion } from '@ostrecht/shared/lib/norms/schema.ts';
import type { NormPublicationReference } from '@ostrecht/shared/lib/norms/publications.ts';
import { formatSourceLabel } from '../../lib/source-labels.ts';
import { formatShortDate } from '../../lib/dates.ts';
import { shortCitation } from '../../lib/norm-head.ts';
import { referenceDateLabel, validityLabel, VALIDITY_FIELD_LABEL, LEGAL_STATUS_FIELD_LABEL } from '../../lib/vocabulary.ts';

/**
 * Vorschriftendaten (P3c): jede Angabe zur Vorschrift genau einmal, nur belegte Felder; darunter
 * die Änderungsvorschriften mit Wirksamkeitstag und die zusätzlichen Angaben zu Staatsverträgen
 * und Verwaltungsabkommen.
 */
interface Props {
  norm: NormRecord;
  version: NormVersion;
  origin: NormOriginInfo;
  fullCitation: string;
  publicationReference?: NormPublicationReference;
  /** Bezeichnungen der verlinkten Änderungsvorschriften (Slug → Titel), aus store.getNormLabels. */
  amendmentLabels?: Map<string, { title: string; shortTitle?: string | null; abbr?: string | null }>;
  /** Auf der Fassungsseite kopiert der Werkzeugknopf den unveränderlichen Fassungslink. */
  immutableLink?: boolean;
}

const { norm, version, origin, fullCitation, publicationReference, amendmentLabels, immutableLink = false } = Astro.props;
const temporalKind = classifyNormVersion(norm, version);
const status = norm.meta.status;
const versionKind = classifyNormOriginVersion(origin, version);
const immutableVersion = immutableLink || temporalKind !== 'current';
const title = getNormTitleBlock({ title: norm.meta.title, shortTitle: norm.meta.shortTitle, abbr: norm.meta.abbr });

const legalStatusText = temporalKind === 'historical'
  ? `Historische Fassung, gültig ab ${formatDate(version.validFrom)}${version.validTo ? ` bis ${formatDate(version.validTo)}` : '; ein genaues Gültigkeitsende ist nicht belegt'}.`
  : temporalKind === 'future'
    ? `Verkündet; tritt am ${formatDate(version.validFrom)} in Kraft und gehört bis dahin nicht zum geltenden Rechtsstand.`
    : temporalKind === 'unknown-effective'
      ? 'Veröffentlicht; der Eintritt der Bedingung für das Inkrafttreten ist durch die vorliegenden Quellen noch nicht belegt.'
      : status === 'one-time-act'
        ? `Abgeschlossener einmaliger Rechtsakt mit Wirkung vom ${formatDate(version.validFrom)}; die Fassung bleibt zu Dokumentationszwecken verfügbar.`
        : `Geltende Fassung, gültig ab ${formatDate(version.validFrom)}${version.validTo ? ` bis ${formatDate(version.validTo)}` : ''}; ${referenceDateLabel()}.`;

const amendmentCount = origin.ownAmendmentCount;
const originText = versionKind === 'ostdeutsch-original'
  ? 'Erst im Freistaat Ostdeutschland geschaffen; kein übernommenes sächsisches Ausgangsrecht.'
  : versionKind === 'baseline'
    ? origin.kind === 'inherited-unchanged'
      ? 'Aus dem sächsischen Rechtsstand vom 1. November 2023 übernommen und seitdem im Freistaat Ostdeutschland nicht geändert.'
      : 'Diese Fassung ist der am 1. November 2023 übernommene sächsische Ausgangsrechtsstand; die Vorschrift wurde seitdem im Freistaat Ostdeutschland geändert.'
    : versionKind === 'inherited-intermediate'
      ? 'Übernommener sächsischer Rechtsstand vor der ersten nachgewiesenen ostdeutschen Änderung der Vorschrift.'
      : versionKind === 'inherited-amended'
        ? `Aus dem sächsischen Rechtsstand vom 1. November 2023 übernommen; die angezeigte Fassung berücksichtigt ${amendmentCount === 1 ? 'eine ostdeutsche Änderung' : `${amendmentCount} ostdeutsche Änderungen`}.`
        : 'Die vorliegenden Quellen reichen für eine sichere Zuordnung zu übernommenem Ausgangsrecht oder eigenständig geschaffenem Landesrecht noch nicht aus.';

const baselineVersion = origin.baselineVersionId ? norm.versions.find((entry) => entry.versionId === origin.baselineVersionId) : undefined;
const baselineUrl = baselineVersion
  ? classifyNormVersion(norm, baselineVersion) === 'current' ? getNormUrl(norm.meta.slug) : getNormVersionUrl(norm.meta.slug, baselineVersion.versionId)
  : undefined;
const compareUrl = baselineVersion && baselineVersion.versionId !== version.versionId
  ? getNormCompareSelectionUrl(norm.meta.slug, baselineVersion.versionId, version.versionId)
  : undefined;
const showCurrentLink = versionKind !== 'inherited-amended' && versionKind !== 'ostdeutsch-original' && temporalKind !== 'current' && origin.kind === 'inherited-amended';
const originLinks = [
  ...(baselineUrl && baselineUrl !== getNormVersionUrl(norm.meta.slug, version.versionId) && versionKind !== 'baseline' ? [{ href: baselineUrl, label: `Ausgangsfassung vom ${formatDate(LEGAL_BASELINE_DATE)}` }] : []),
  ...(showCurrentLink ? [{ href: getNormUrl(norm.meta.slug), label: 'Geltende Fassung' }] : []),
  ...(compareUrl ? [{ href: compareUrl, label: 'Mit Ausgangsrecht vergleichen' }] : []),
  ...(origin.baselineSourceUrl ? [{ href: origin.baselineSourceUrl, label: 'Amtliche sächsische Quelle (REVOSax)' }] : []),
];

const amendments = [...origin.ownChanges].sort((left, right) => right.date.localeCompare(left.date));
const amendmentTitle = (slug: string | undefined, fallback: string): string => {
  const identity = slug ? amendmentLabels?.get(slug) : undefined;
  return identity ? getNormTitleBlock(identity).heading : toDisplayText(fallback);
};

const hasDistinctInitialCitation = norm.meta.initialCitation.trim() !== version.citation.trim();
const sourceReference = version.sourceReferences?.[0] ?? norm.meta.sourceReferences?.[0];
const isAgreement = norm.meta.type === 'verwaltungsabkommen' || norm.meta.type === 'staatsvertrag';
const documentDateLabel = isAgreement ? 'Abschlussdatum' : 'Normdatum';
const showDocumentDate = Boolean(norm.meta.documentDate) && norm.meta.documentDate !== version.validFrom;
const showPublicationDate = Boolean(norm.meta.publicationDate) && norm.meta.publicationDate !== norm.meta.documentDate;
const inForceSince = norm.meta.effectiveDate ?? (norm.history.initialVersionId ? norm.versions.find((entry) => entry.versionId === norm.history.initialVersionId)?.validFrom : undefined);

/** Umfang: §§/Artikel, Gliederungsebenen und Anlagen des angezeigten Normkörpers. */
function countBlocks(blocks: NormBodyBlock[], counts = { units: 0, articles: 0, parts: 0, annexes: 0 }, quoted = false): typeof counts {
  for (const block of blocks) {
    const isQuoted = quoted || block.type === 'quotedProvision';
    if (!isQuoted) {
      if (block.type === 'paragraph') counts.units += 1;
      if (block.type === 'article') counts.articles += 1;
      if (block.type === 'part' || block.type === 'chapter') counts.parts += 1;
      if (block.type === 'annex') counts.annexes += 1;
    }
    if (block.children) countBlocks(block.children, counts, isQuoted);
  }
  return counts;
}
const counts = countBlocks(version.body ?? []);
const scope = [
  counts.units > 0 ? `${counts.units} ${counts.units === 1 ? 'Paragraph' : 'Paragraphen'}` : '',
  counts.articles > 0 ? `${counts.articles} Artikel` : '',
  counts.parts > 0 ? `${counts.parts} ${counts.parts === 1 ? 'Teil' : 'Teile'}` : '',
  counts.annexes > 0 ? `${counts.annexes} ${counts.annexes === 1 ? 'Anlage' : 'Anlagen'}` : '',
  `${norm.versions.length} ${norm.versions.length === 1 ? 'Fassung' : 'Fassungen'}`,
].filter(Boolean).join(' · ');
---

<section class:list={['norm-facts', `norm-facts--${temporalKind}`]} id="vorschriftendaten" aria-labelledby="norm-facts-title" data-visual-section="norm-facts" data-copy-group>
  <h2 id="norm-facts-title" class="r-label r-label--rule">Vorschriftendaten</h2>
  <dl class="r-dl norm-facts__list">
    <dt>Langtitel</dt><dd>{toDisplayText(norm.meta.title)}</dd>
    {title.longTitle ? <><dt>Kurztitel</dt><dd>{title.heading}</dd></> : null}
    {norm.meta.abbr ? <><dt>Abkürzung</dt><dd>{toDisplayText(norm.meta.abbr)}</dd></> : null}
    <dt>Normtyp</dt><dd>{formatNormType(norm.meta.type)}</dd>
    <dt>{VALIDITY_FIELD_LABEL}</dt><dd>{validityLabel(status)}{status !== 'in-force' && norm.meta.expiryDate ? ` seit ${formatDate(norm.meta.expiryDate)}` : ''}</dd>
    <dt>{LEGAL_STATUS_FIELD_LABEL}</dt><dd>{legalStatusText}</dd>
    <dt>Vollzitat</dt>
    <dd>
      <span data-full-citation id="norm-facts-full-citation">{toDisplayText(fullCitation)}</span>
      <button class="r-link-btn norm-facts__copy" type="button" data-copy-text="norm-facts-full-citation" data-copy-done="Vollzitat wurde kopiert." data-copy-full-citation>Vollzitat kopieren</button>
    </dd>
    <dt>Fundstelle</dt>
    <dd>
      {publicationReference ? (
        <>
          <a href={getPublicationUrl(publicationReference.publicationSlug)}>{toDisplayText(publicationReference.publicationTitle)}</a>
          {' · '}<time datetime={publicationReference.publicationDate}>{formatShortDate(publicationReference.publicationDate)}</time>
          {publicationReference.pages ? ` · Seiten ${toDisplayText(publicationReference.pages)}` : publicationReference.startPage ? ` · Beginn auf Seite ${toDisplayText(publicationReference.startPage)}` : ''}
        </>
      ) : shortCitation(version.citation) || toDisplayText(version.citation)}
      {hasDistinctInitialCitation ? <span class="r-muted"> · Stammfundstelle: {shortCitation(norm.meta.initialCitation) || toDisplayText(norm.meta.initialCitation)}</span> : null}
    </dd>
    {showDocumentDate ? <><dt>{documentDateLabel}</dt><dd><time datetime={norm.meta.documentDate}>{formatDate(norm.meta.documentDate!)}</time></dd></> : null}
    {showPublicationDate ? <><dt>Veröffentlicht</dt><dd><time datetime={norm.meta.publicationDate}>{formatDate(norm.meta.publicationDate!)}</time></dd></> : null}
    {inForceSince ? <><dt>Inkrafttreten</dt><dd><time datetime={inForceSince}>{formatDate(inForceSince)}</time></dd></> : null}
    {norm.meta.dateNote ? <><dt>Datierungshinweis</dt><dd>{toDisplayText(norm.meta.dateNote)}</dd></> : null}
    <dt>Rechtsherkunft</dt>
    <dd>
      <span class="r-strong">{formatNormOriginKind(origin.kind)}.</span> {originText}
      {originLinks.length > 0 ? <span class="norm-facts__links r-meta">{originLinks.map((link, index) => <>{index > 0 ? ' · ' : ''}<a href={link.href}>{link.label}</a></>)}</span> : null}
    </dd>
    {norm.meta.subjects.length > 0 ? (
      <><dt>Sachgebiete</dt><dd>{norm.meta.subjects.map((subject, index) => <>{index > 0 ? ' · ' : ''}<a href={getSubjectUrl(subject)}>{formatSubjectLabel(toDisplayText(subject), { withNumber: true, short: true })}</a></>)}</dd></>
    ) : null}
    {norm.meta.responsibleMinistry ? <><dt>Zuständiger Geschäftsbereich</dt><dd>{toDisplayText(norm.meta.responsibleMinistry)}</dd></> : null}
    {norm.meta.enactingBody ? <><dt>Erlassendes Organ</dt><dd>{toDisplayText(norm.meta.enactingBody)}</dd></> : null}
    {norm.meta.originEnactingBody ? <><dt>Ursprungsorgan der übernommenen Quelle</dt><dd>{toDisplayText(norm.meta.originEnactingBody)}</dd></> : null}
    {sourceReference ? <><dt>Quelle</dt><dd>{sourceReference.url ? <a href={sourceReference.url}>{formatSourceLabel(sourceReference.label)}</a> : formatSourceLabel(sourceReference.label)}{sourceReference.verifiedAt ? <span class="r-muted"> · geprüft am {formatShortDate(sourceReference.verifiedAt)}</span> : null}</dd></> : null}
    {version.sourceNotes && version.sourceNotes.length > 0 ? version.sourceNotes.map((note) => <><dt>{toDisplayText(note.label)}</dt><dd>{toDisplayText(note.text)}</dd></>) : null}
    <dt>Umfang</dt><dd>{scope}</dd>
  </dl>

  <div class="norm-facts__link-tools r-meta">
    <button class="r-link-btn" type="button" data-copy-url data-copy-href={immutableVersion ? getNormVersionUrl(norm.meta.slug, version.versionId) : getNormUrl(norm.meta.slug)} data-copy-done={immutableVersion ? 'Link zu dieser Fassung wurde kopiert.' : 'Link zur Vorschrift wurde kopiert.'} data-copy-norm-link>
      {immutableVersion ? 'Link zu dieser Fassung kopieren' : 'Link zur Vorschrift kopieren'}
    </button>
    <span class="r-muted">{immutableVersion ? 'Dieser Link führt dauerhaft zu dieser Fassung.' : 'Dieser allgemeine Link führt zur jeweils als geltend ausgewiesenen Fassung.'}</span>
    <span class="r-feedback" aria-live="polite" data-copy-feedback></span>
  </div>

  {amendments.length > 0 ? (
    <div class="norm-facts__amendments">
      <h3 class="r-label r-label--rule">Änderungsvorschriften</h3>
      <table class="r-table norm-facts__amendment-table">
        <caption class="visually-hidden">Änderungsvorschriften mit Wirksamkeitstag, Bezeichnung und Fundstelle</caption>
        <tbody>
          {amendments.map((entry) => (
            <tr>
              <td class:list={['r-nowrap', 'r-meta', entry.date > (norm.versions.find((candidate) => classifyNormVersion(norm, candidate) === 'current')?.validFrom ?? '') ? 'r-future-text' : 'r-muted']}>wirksam {formatShortDate(entry.date)}</td>
              <td>
                {entry.relatedNormSlug ? <a href={getNormUrl(entry.relatedNormSlug)}>{amendmentTitle(entry.relatedNormSlug, entry.title)}</a> : toDisplayText(entry.title)}
                <div class="r-meta">{entry.type === 'repeal' ? 'Aufhebung' : 'Änderung'}{shortCitation(entry.citation) ? ` · ${shortCitation(entry.citation)}` : ''} · <a href={getNormHistoryUrl(norm.meta.slug)}>Auswirkungen auf geltendes Recht</a></div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  ) : null}

  {norm.meta.agreementDetails ? (
    <div class="norm-facts__agreement">
      <h3 class="r-label r-label--rule">Vertrags- und Abkommensdaten</h3>
      <dl class="r-dl">
        <dt>Abschlussdatum</dt><dd><time datetime={norm.meta.agreementDetails.signedOn}>{formatDate(norm.meta.agreementDetails.signedOn)}</time></dd>
        <dt>Abschlussort</dt><dd>{toDisplayText(norm.meta.agreementDetails.signedAt)}</dd>
        {norm.meta.agreementDetails.publishedOn ? <><dt>Veröffentlicht</dt><dd><time datetime={norm.meta.agreementDetails.publishedOn}>{formatDate(norm.meta.agreementDetails.publishedOn)}</time></dd></> : null}
        {norm.meta.agreementDetails.effectiveOn ? <><dt>Wirksam</dt><dd><time datetime={norm.meta.agreementDetails.effectiveOn}>{formatDate(norm.meta.agreementDetails.effectiveOn)}</time>{norm.meta.agreementDetails.effectivenessNote ? ` · ${toDisplayText(norm.meta.agreementDetails.effectivenessNote)}` : ''}</dd></> : null}
        <dt>Vertragspartner</dt><dd>{norm.meta.agreementDetails.parties.map((party) => toDisplayText(party.name)).join(' · ')}</dd>
        <dt>Unterzeichner:innen</dt><dd>{norm.meta.agreementDetails.signatories.map((signatory) => `${toDisplayText(signatory.name)} (${toDisplayText(signatory.office)})`).join(' · ')}</dd>
        <dt>Rechtsgrundlage</dt>
        <dd>{norm.meta.agreementDetails.legalBases.map((basis, index) => <>{index > 0 ? ' · ' : ''}{basis.url ? <a href={basis.url}>{toDisplayText(basis.label)} – {toDisplayText(basis.title)}</a> : `${toDisplayText(basis.label)} – ${toDisplayText(basis.title)}`}</>)}</dd>
      </dl>
    </div>
  ) : null}
</section>
