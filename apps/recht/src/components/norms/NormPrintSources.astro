---
import { toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import { formatSourceLabel } from '../../lib/source-labels.ts';
import type { NormRecord, NormVersion } from '@ostrecht/shared/lib/norms/schema.ts';
import type { NormPublicationReference, Verkuendung } from '@ostrecht/shared/lib/norms/publications.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  publicationReference?: NormPublicationReference;
  publication?: Verkuendung;
}

const { norm, version, publicationReference, publication } = Astro.props;
---

<section class="section norm-print-sources" aria-labelledby="drucken-quellen">
  <div class="section-header section-header--compact">
    <h2 id="drucken-quellen">Drucken und Quellen</h2>
    <p>Druckfunktionen des Portals und nachgewiesene Veröffentlichungsquellen.</p>
  </div>
  <ul class="norm-source-actions">
    <li>
      <button class="text-link-button" type="button" data-print-page>Gesamtansicht drucken</button>
      <span>Die Druckansicht ist eine Portalansicht, keine eigenständige amtliche Verkündung.</span>
    </li>
    {publication?.pdf ? (
      <li>
        <a class="inline-link" href={publication.pdf}>Amtliche Ausgabe (PDF)</a>
        <span>Amtliche Ausgabe zur Fundstelle.</span>
      </li>
    ) : publicationReference ? (
      <li>
        <span class="norm-source-actions__label">Amtliche Ausgabe (PDF)</span>
        <span>Für diese Ausgabe ist im Portal keine belegte PDF-Datei hinterlegt.</span>
      </li>
    ) : null}
  </ul>
  {norm.meta.sourceReferences && norm.meta.sourceReferences.length > 0 ? (
    <div class="norm-citation-copy">
      <h3>Quellenhierarchie</h3>
      <ul>
        {norm.meta.sourceReferences.map((source) => (
          <li>
            <strong>
              {source.url ? (
                <a class="inline-link" href={source.url}>{formatSourceLabel(source.label)}</a>
              ) : formatSourceLabel(source.label)}
            </strong>
            {source.pageRange ? ` · Seiten ${source.pageRange}` : ''}
          </li>
        ))}
      </ul>
    </div>
  ) : null}
  {version.sourceNotes && version.sourceNotes.length > 0 ? (
    <div class="norm-citation-copy">
      <h3>Quellenhinweise</h3>
      <dl class="meta-list">
        {version.sourceNotes.map((note) => (
          <div>
            <dt>{toDisplayText(note.label)}</dt>
            <dd>{toDisplayText(note.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  ) : null}
</section>
