---
import { getPublicationUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import { toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import { getNormVersionPdfPath } from '../../lib/norm-links.ts';
import type { NormRecord, NormVersion } from '@ostrecht/shared/lib/norms/schema.ts';
import type { NormPublicationReference, Verkuendung } from '@ostrecht/shared/lib/norms/publications.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  fullCitation: string;
  publicationReference?: NormPublicationReference;
  publication?: Verkuendung;
}

const { norm, version, fullCitation, publicationReference, publication } = Astro.props;
const citation = toDisplayText(fullCitation);
---

<section class="section norm-print-sources" aria-labelledby="drucken-quellen">
  <div class="section-header section-header--compact">
    <h2 id="drucken-quellen">Drucken und Quellen</h2>
    <p>Druckfunktionen des Portals und nachgewiesene Veröffentlichungsquellen.</p>
  </div>
  <ul class="norm-source-actions">
    <li>
      <a class="inline-link" href={getNormVersionPdfPath(norm.meta.slug, version.versionId)} type="application/pdf">Fassung als PDF</a>
      <span>Aus dem Vorschriftentext erzeugte Portalfassung mit Vollzitat, Rechtsstand und Seitenzahlen; keine amtliche Verkündung.</span>
    </li>
    <li>
      <button class="text-link-button" type="button" data-print-page>Gesamtansicht drucken</button>
      <span>Die Druckansicht ist eine Portalansicht, keine eigenständige amtliche Verkündung.</span>
    </li>
    {publicationReference ? (
      <li>
        <a class="inline-link" href={`${getPublicationUrl(publicationReference.publicationSlug)}#${publicationReference.entryId}`}>
          Zugehörige Verkündungsseite
        </a>
        <span>{toDisplayText(publicationReference.publicationTitle)}</span>
      </li>
    ) : null}
    {publication?.pdf ? (
      <li>
        <a class="inline-link" href={publication.pdf}>Amtliche Ausgabe (PDF)</a>
        <span>Amtliche Ausgabe zur Fundstelle.</span>
      </li>
    ) : publicationReference ? (
      <li>
        <span class="norm-source-actions__label">Amtliche Ausgabe (PDF)</span>
        <span>Für diese Ausgabe ist im Portal keine belegte PDF-Datei hinterlegt.</span>
      </li>
    ) : null}
  </ul>
  {norm.meta.sourceReferences && norm.meta.sourceReferences.length > 0 ? (
    <div class="norm-citation-copy">
      <h3>Quellenhierarchie</h3>
      <ul>
        {norm.meta.sourceReferences.map((source) => (
          <li>
            <strong>
              {source.url ? (
                <a class="inline-link" href={source.url}>{toDisplayText(source.label)}</a>
              ) : toDisplayText(source.label)}
            </strong>
            {source.pageRange ? ` · Seiten ${source.pageRange}` : ''}
          </li>
        ))}
      </ul>
    </div>
  ) : null}
  {version.sourceNotes && version.sourceNotes.length > 0 ? (
    <div class="norm-citation-copy">
      <h3>Quellenhinweise</h3>
      <dl class="meta-list">
        {version.sourceNotes.map((note) => (
          <div>
            <dt>{toDisplayText(note.label)}</dt>
            <dd>{toDisplayText(note.text)}</dd>
          </div>
        ))}
      </dl>
    </div>
  ) : null}
  <div class="norm-citation-copy">
    <label for={`citation-${norm.meta.slug}`}>Vollzitat dieser Fassung</label>
    <div>
      <textarea id={`citation-${norm.meta.slug}`} rows="4" readonly>{citation}</textarea>
      <button type="button" data-copy-value={`citation-${norm.meta.slug}`}>Vollzitat kopieren</button>
    </div>
    <p class="norm-citation-copy__note">
      Das Vollzitat nennt die Vorschrift selbst, ihre Stammfundstelle und die letzte für diese
      Fassung nachgewiesene Änderung.
    </p>
    <p class="copy-feedback" aria-live="polite" data-copy-feedback></p>
  </div>
</section>

<script>
  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof HTMLButtonElement)) return;
    const inputId = event.target.dataset.copyValue;
    if (!inputId) return;
    const input = document.getElementById(inputId);
    if (!(input instanceof HTMLInputElement || input instanceof HTMLTextAreaElement)) return;
    input.select();
    const feedback = event.target.closest('.norm-citation-copy')?.querySelector<HTMLElement>('[data-copy-feedback]');
    try {
      await navigator.clipboard.writeText(input.value);
      if (feedback) feedback.textContent = 'Vollzitat wurde kopiert.';
    } catch {
      if (feedback) feedback.textContent = 'Das Vollzitat ist markiert und kann manuell kopiert werden.';
    }
  });
</script>
