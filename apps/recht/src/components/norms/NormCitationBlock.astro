---
import { getPublicationUrl } from '@ostrecht/shared/lib/norms/routes.ts';
import {
  formatDate,
  formatNormStatus,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/presentation.ts';
import { classifyNormVersion, EDITORIAL_REFERENCE_DATE } from '@ostrecht/shared/lib/norms/versions.ts';
import { getNormVersionIdentity } from '@ostrecht/shared/lib/norms/identity.ts';
import type { NormRecord, NormVersion } from '@ostrecht/shared/lib/norms/schema.ts';
import type { NormPublicationReference } from '@ostrecht/shared/lib/norms/publications.ts';

interface Props {
  norm: NormRecord;
  version: NormVersion;
  fullCitation: string;
  publicationReference?: NormPublicationReference;
  immutableLink?: boolean;
}

const { norm, version, fullCitation, publicationReference, immutableLink = false } = Astro.props;
const identity = getNormVersionIdentity(norm, version);
const temporalKind = classifyNormVersion(norm, version);
const statusLabel = temporalKind === 'current'
  ? `${formatNormStatus(norm.meta.status)} am ${formatDate(EDITORIAL_REFERENCE_DATE)}`
  : temporalKind === 'future'
    ? 'Zukünftige Fassung'
    : temporalKind === 'historical'
      ? 'Historische Fassung'
      : 'Inkrafttreten nicht belegt';
const historyEntry = [...norm.history.entries]
  .filter((entry) => entry.affectingVersionId === version.versionId)
  .sort((left, right) => right.date.localeCompare(left.date))[0];
const effectiveFrom = temporalKind === 'unknown-effective' ? undefined : version.validFrom;
const validTo = version.validTo;
const sourceReference = version.sourceReferences?.[0] ?? norm.meta.sourceReferences?.[0];
const immutableVersion = immutableLink || temporalKind !== 'current';
---

<section class="norm-citation-status" aria-labelledby={`citation-status-${norm.meta.slug}-${version.versionId}`} data-visual-section="norm-citation-status">
  <div class="norm-citation-status__heading">
    <p class="eyebrow">Zitieren und Rechtsstand</p>
    <h2 id={`citation-status-${norm.meta.slug}-${version.versionId}`}>{toDisplayText(identity.shortTitle || identity.title)}</h2>
  </div>
  <dl class="norm-citation-status__facts">
    <div class="norm-citation-status__citation">
      <dt>Vollzitat</dt>
      <dd>{toDisplayText(fullCitation)}</dd>
    </div>
    <div>
      <dt>Fassungsstatus</dt>
      <dd>{statusLabel}</dd>
    </div>
    {historyEntry ? (
      <div>
        <dt>Letzte Änderung dieser Fassung</dt>
        <dd>{toDisplayText(historyEntry.title)} · <time datetime={historyEntry.date}>{formatDate(historyEntry.date)}</time></dd>
      </div>
    ) : null}
    {effectiveFrom ? (
      <div>
        <dt>In Kraft ab</dt>
        <dd><time datetime={effectiveFrom}>{formatDate(effectiveFrom)}</time></dd>
      </div>
    ) : null}
    {validTo ? (
      <div>
        <dt>Fassung gültig bis</dt>
        <dd><time datetime={validTo}>{formatDate(validTo)}</time></dd>
      </div>
    ) : null}
    {publicationReference ? (
      <div>
        <dt>Verkündungsquelle</dt>
        <dd><a class="inline-link" href={getPublicationUrl(publicationReference.publicationSlug)}>{toDisplayText(publicationReference.publicationTitle)}</a></dd>
      </div>
    ) : sourceReference ? (
      <div>
        <dt>Quellenbeleg</dt>
        <dd>{sourceReference.url
          ? <a class="inline-link" href={sourceReference.url}>{toDisplayText(sourceReference.label)}</a>
          : toDisplayText(sourceReference.label)}</dd>
      </div>
    ) : null}
  </dl>
  <div class="norm-citation-status__link-tools">
    <button class="text-link-button" type="button" data-copy-norm-link>
      {immutableVersion ? 'Link zu dieser Fassung kopieren' : 'Link zur Vorschrift kopieren'}
    </button>
    <span>
      {immutableVersion
        ? 'Dieser Link bleibt der gespeicherten Fassung zugeordnet.'
        : 'Dieser allgemeine Link führt zur jeweils als geltend ausgewiesenen Fassung.'}
    </span>
    <span class="copy-feedback" aria-live="polite" data-copy-norm-link-feedback></span>
  </div>
</section>

<script>
  document.addEventListener('click', async (event) => {
    if (!(event.target instanceof HTMLButtonElement) || !event.target.matches('[data-copy-norm-link]')) return;
    const url = new URL(window.location.href);
    url.hash = '';
    url.search = '';
    const feedback = event.target.closest<HTMLElement>('.norm-citation-status')?.querySelector<HTMLElement>('[data-copy-norm-link-feedback]');
    try {
      await navigator.clipboard.writeText(url.toString());
      if (feedback) feedback.textContent = 'Link wurde kopiert.';
    } catch {
      if (feedback) feedback.textContent = 'Der Link kann aus der Adresszeile kopiert werden.';
    }
  });
</script>
