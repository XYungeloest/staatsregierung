---
import {
  describeNormOriginKind,
  formatNormOriginBadge,
  type NormOriginBadgeVariant,
  type NormOriginKind,
} from '@ostrecht/shared/lib/norms/origin.ts';

/**
 * Zentrale Kennzeichnung der Rechtsherkunft (Statuspunkt plus Text). Wird in Listen,
 * Suchtreffern und auf der Normseite verwendet; die Bezeichnungen kommen ausschließlich aus
 * origin.ts, Farbe ist nur unterstützend.
 */
interface Props {
  kind?: NormOriginKind | null;
  variant?: NormOriginBadgeVariant;
  class?: string;
}

const { kind: rawKind, variant = 'compact', class: className } = Astro.props;
const kind: NormOriginKind = rawKind ?? 'origin-unresolved';
---

<span class:list={['origin-badge', `origin-badge--${kind}`, { 'origin-badge--full': variant === 'full' }, className]} data-origin-kind={kind} title={describeNormOriginKind(kind)}>
  <span class="origin-badge__dot" aria-hidden="true"></span>
  <span class="origin-badge__label">{formatNormOriginBadge(kind, variant)}</span>
</span>
