---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../layouts/LawLayout.astro';
import {
  EDITORIAL_REFERENCE_DATE,
  LEGAL_CHANGE_ENTRY_TYPES,
  formatPublicationEntryType,
  getAdministrativeRulesUrl,
  getFundingUrl,
  getIndexUrl,
  getLawConstitutionUrl,
  getLawPortalUrl,
  getLawsUrl,
  getNormHistoryUrl,
  getNormUrl,
  getPublicationLabel,
  getPublicationUrl,
  getPublicationsUrl,
  getRegulationsUrl,
  getSearchUrl,
  getSubjectSlug,
  getSubjectsUrl,
  listPublicationEntries,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../lib/runtime/context.ts';
import { CHANGE_FEED_PATH, CHANGE_SERVICE_LIMIT, changeDetail, columnEventLabel, eventLabel, futureEventLabel, loadChangeService } from '../lib/change-service.ts';
import { formatCount, formatNormCount } from '../lib/counts.ts';
import { referenceDateLabel } from '../lib/vocabulary.ts';
import { formatShortDate } from '../lib/dates.ts';

// Startseite (P1): geltendes Recht als Normalfall. Bestandszahlen, Sachgebiete, dreispaltiger
// Änderungsdienst (Rechtswirkung) und die neuesten amtlichen Veröffentlichungen
// (Publikationsgeschehen) – getrennt, aus der D1-Projektion, ohne den Normenbestand zu laden.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const HOME_CHANGE_LIMIT = CHANGE_SERVICE_LIMIT;
const HOME_PUBLICATION_ENTRY_LIMIT = 6;

const [stats, subjectAreas, columns, latestPublications] = await Promise.all([
  store.getCorpusStats(),
  store.listSubjectAreas(),
  // Die drei Spalten der Rechtswirkung; der RSS-Feed liest dieselben (change-service.ts).
  loadChangeService(store),
  store.listPublications({ limit: 6 }),
]);

const searchSuggestionsUrl = `${import.meta.env.BASE_URL}search-suggestions.json`;

/**
 * Schnellzugriff: redaktionell hervorgehobene Vorschriften (Production Board P1) – keine
 * Nutzungsstatistik, deshalb nicht „meistgenutzt“. Nur Vorschriften, die der Bestand kennt,
 * werden verlinkt; die Verfassung hat ihre feste Adresse.
 */
const QUICK_ACCESS_SLUGS = ['ostdeutsches-schulgesetz', 'saechsische-gemeindeordnung', 'ostdeutsches-polizeivollzugsdienstgesetz'] as const;
const quickAccessLabels = await store.getNormLabels([...QUICK_ACCESS_SLUGS]);
const quickAccess = QUICK_ACCESS_SLUGS.flatMap((slug) => {
  const identity = quickAccessLabels.get(slug);
  return identity ? [{ href: getNormUrl(slug), label: toDisplayText(identity.shortTitle || identity.title) }] : [];
});

/** Zugänge nach Normtyp: die vier Übersichten ohne Bestandszahlen (die Zahlen tragen die Übersichten selbst). */
const typeAccess: Array<{ type: NormType; href: string; label: string }> = [
  { type: 'gesetz', href: getLawsUrl(), label: lawSiteConfig.targetLabels.laws },
  { type: 'verordnung', href: getRegulationsUrl(), label: lawSiteConfig.targetLabels.regulations },
  { type: 'verwaltungsvorschrift', href: getAdministrativeRulesUrl(), label: lawSiteConfig.targetLabels.administrativeRules },
  { type: 'foerderrichtlinie', href: getFundingUrl(), label: lawSiteConfig.targetLabels.funding },
];

const publicationRows = listPublicationEntries(latestPublications).slice(0, HOME_PUBLICATION_ENTRY_LIMIT);
const seriesLabels = [...new Set(latestPublications.map((publication) => publication.publication))];
---

<LawLayout
  title="OstRecht"
  description="OstRecht zeigt das geltende Landesrecht des Ostdeutschen Freistaates in konsolidierter Fassung und macht Herkunft, Änderungen und amtliche Veröffentlichungen sichtbar."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }]}
  mainWidth="full"
>
  <section class="r-home-entry" aria-labelledby="law-home-title">
    <div class="r-container r-home-entry__grid">
      <div class="r-home-entry__main">
        <h1 id="law-home-title" class="r-h1">Das Recht des Freistaates Ostdeutschland</h1>
        <p class="r-lead r-home-entry__lead">Geltendes Landesrecht in konsolidierter Fassung · {formatNormCount(stats.normCount)}, davon {stats.inForceCount} in Kraft · {referenceDateLabel()}</p>
        <form class="r-home-search" action={getSearchUrl()} method="get" role="search" data-search-shell>
          <label class="r-field r-field--label-caps r-home-search__field">
            <span>Gesetz, Verordnung, Abkürzung, Paragraph oder Fundstelle</span>
            <input class="r-input r-input--lg" id="law-home-search" type="search" name="q" autocomplete="off" placeholder="z. B. Gesetz, Abkürzung, § 12 oder OGVBl." data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} data-law-search-url={getSearchUrl()} />
          </label>
          <button class="r-btn r-btn--primary r-btn--lg" type="submit">Suchen</button>
        </form>
        <div class="r-home-search__hint r-meta">
          <span>Vorschlagsliste ab dem 2. Zeichen: Abkürzungen, Kurztitel, Fundstellen.<span class="r-home-search__key"> <kbd>/</kbd> fokussiert die Suche.</span></span>
          <a href={`${getSearchUrl()}?filter=erweitert`}>Erweiterte Suche</a>
        </div>
        <nav class="r-home-direct r-meta" aria-label="Schnellzugriff">
          <span class="r-muted">Schnellzugriff:</span>
          <a href={getLawConstitutionUrl()}>{lawSiteConfig.targetLabels.constitution}</a>
          {quickAccess.map((entry) => <a href={entry.href}>{entry.label}</a>)}
        </nav>
        <nav class="r-home-direct r-meta" aria-label="Zugänge nach Normtyp">
          <span class="r-muted">Nach Normtyp:</span>
          {typeAccess.map((entry) => <a href={entry.href}>{entry.label}</a>)}
        </nav>
      </div>
      <div class="r-home-subjects">
        <h2 class="r-h2 r-h2--sub r-h2--rule">{lawSiteConfig.targetLabels.subjects}</h2>
        <ol class="r-home-subjects__list r-num">
          {subjectAreas.map((area) => (
            <li>
              <span class="r-muted">{area.number ?? ''}</span>
              <a href={`${getSubjectsUrl()}#subject-area-${getSubjectSlug(area.name)}`}>{area.name}</a>
              <span class="r-muted">{area.normCount}</span>
            </li>
          ))}
        </ol>
        <p class="r-home-subjects__more r-meta r-inline-list">
          <a href={getSubjectsUrl()}>Alle Sachgebiete</a>
          <a href={getIndexUrl()}>{lawSiteConfig.targetLabels.index}</a>
        </p>
      </div>
    </div>
  </section>

  <section class="r-home-changes" id="aenderungsdienst" aria-labelledby="aenderungsdienst-title">
    <div class="r-container">
      <div class="r-section-head">
        <h2 id="aenderungsdienst-title" class="r-h2 r-h2--sub">Änderungsdienst</h2>
        <span class="r-meta r-inline-list"><span>Veränderung des Rechtsbestands</span><span>Verkündung und Rechtswirkung getrennt</span><a href={`${getSearchUrl()}?sort=activity`}>Vollständiges Protokoll</a><a href={CHANGE_FEED_PATH} type="application/rss+xml" data-change-feed>RSS</a></span>
      </div>
      <div class="r-home-changes__grid">
        {columns.map((column) => (
          <section class="r-home-changes__column" data-visual-section={column.key === 'current' ? 'law-latest-status' : column.key === 'future' ? 'law-future-changes' : 'law-repealed'}>
            <h3 class:list={['r-h3', 'r-home-changes__heading', `r-home-changes__heading--${column.tone}`]}>{column.heading}</h3>
            <ol class="r-home-changes__list" data-law-change-list={column.key} data-law-current-change-list={column.key === 'current' ? '' : undefined} data-law-future-change-list={column.key === 'future' ? '' : undefined}>
              {column.entries.map((change, index) => (
                <li
                  data-law-change
                  data-effective-date={change.date}
                  data-change-type={change.changeType}
                  data-current-label={eventLabel(change)}
                  data-future-label={futureEventLabel(change)}
                  hidden={index >= HOME_CHANGE_LIMIT}
                >
                  <time class:list={['r-num', column.key === 'future' ? 'r-future-text' : 'r-muted']} datetime={change.date}>{column.key === 'future' ? `ab ${formatShortDate(change.date)}` : formatShortDate(change.date)}</time>
                  <div>
                    <a class="r-home-changes__norm" href={getNormUrl(change.slug)}>{toDisplayText(change.normShortTitle)}</a>
                    {' '}<span class="r-home-changes__event" data-law-change-label>{columnEventLabel(column.key, change)}</span>
                    <div class="r-caption r-inline-list">{changeDetail(change).map((part) => <span>{part}</span>)}<a href={getNormHistoryUrl(change.slug)}>Änderungsverlauf</a></div>
                  </div>
                </li>
              ))}
            </ol>
            <p class="r-meta r-home-changes__empty" data-law-change-empty hidden={column.entries.length > 0}>{column.empty}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="r-home-publications" aria-labelledby="home-publications-title">
    <div class="r-container">
      <div class="r-section-head">
        <h2 id="home-publications-title" class="r-h2 r-h2--sub">Neueste amtliche Veröffentlichungen</h2>
        <span class="r-meta r-inline-list">{seriesLabels.map((label) => <span>{label}</span>)}<a href={getPublicationsUrl()}>Alle amtlichen Veröffentlichungen</a></span>
      </div>
      {publicationRows.length > 0 ? (
        <div class="r-table-wrap">
          <table class="r-table r-table--meta r-table--dense r-home-publications__table">
            <caption class="visually-hidden">Neueste amtliche Veröffentlichungen mit Datum, Gegenstand, Dokumentart und Fundstelle</caption>
            <tbody>
              {publicationRows.map(({ publication, entry }) => (
                <tr>
                  <td class="r-muted r-nowrap"><time datetime={publication.date}>{formatShortDate(publication.date)}</time></td>
                  <td><a href={`${getPublicationUrl(publication.slug)}#${entry.id}`}>{toDisplayText(entry.title)}</a></td>
                  <td class="r-nowrap r-muted">{formatPublicationEntryType(entry.type)}</td>
                  <td class="r-right r-nowrap"><a href={getPublicationUrl(publication.slug)}>{getPublicationLabel(publication)}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="r-meta">Im Bestand sind noch keine amtlichen Veröffentlichungen verzeichnet.</p>
      )}
      <p class="r-caption r-home-publications__count">{formatCount(stats.publicationCount, 'Ausgabe', 'Ausgaben')} der Verkündungsblätter im Bestand.</p>
    </div>
  </section>

  <script>import '../scripts/law-future-changes.ts';</script>
</LawLayout>
