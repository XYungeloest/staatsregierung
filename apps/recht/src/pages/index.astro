---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../layouts/LawLayout.astro';
import {
  EDITORIAL_REFERENCE_DATE,
  LEGAL_CHANGE_ENTRY_TYPES,
  formatNormType,
  formatPublicationEntryType,
  getAdministrativeRulesUrl,
  getFundingUrl,
  getIndexUrl,
  getLawConstitutionUrl,
  getLawPortalUrl,
  getLawsUrl,
  getNormHistoryUrl,
  getNormUrl,
  getPublicationLabel,
  getPublicationUrl,
  getPublicationsUrl,
  getRegulationsUrl,
  getSearchUrl,
  getSubjectSlug,
  getSubjectsUrl,
  listPublicationEntries,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../lib/runtime/context.ts';
import type { NormChange } from '../lib/runtime/store.ts';
import { formatCount, formatNormCount } from '../lib/counts.ts';
import { describeChange } from '../lib/history-labels.ts';
import { countNormTypes } from '../lib/type-counts.ts';
import { referenceDateLabel } from '../lib/vocabulary.ts';
import { formatShortDate } from '../lib/dates.ts';

// Startseite (P1): geltendes Recht als Normalfall. Bestandszahlen, Sachgebiete, dreispaltiger
// Änderungsdienst (Rechtswirkung) und die neuesten amtlichen Veröffentlichungen
// (Publikationsgeschehen) – getrennt, aus der D1-Projektion, ohne den Normenbestand zu laden.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const HOME_CHANGE_LIMIT = 5;
const HOME_CHANGE_CANDIDATE_LIMIT = 12;
const HOME_PUBLICATION_ENTRY_LIMIT = 6;
const HOME_CHANGE_TYPES = [...LEGAL_CHANGE_ENTRY_TYPES];
const IN_FORCE_TYPES = HOME_CHANGE_TYPES.filter((type) => type !== 'repeal');

const [stats, subjectAreas, inForceChanges, futureChanges, repealChanges, latestPublications, typeCounts] = await Promise.all([
  store.getCorpusStats(),
  store.listSubjectAreas(),
  // Neu in Kraft getreten: Erlass und Änderung bis zum Stichtag, je Norm das jüngste Ereignis.
  store.listChanges({ changeTypes: IN_FORCE_TYPES, until: EDITORIAL_REFERENCE_DATE, order: 'desc', limit: HOME_CHANGE_CANDIDATE_LIMIT, distinctNorms: true }),
  // Verkündet, noch nicht in Kraft: alle Rechtsereignisse nach dem Stichtag, nächstes zuerst.
  store.listChanges({ changeTypes: HOME_CHANGE_TYPES, after: EDITORIAL_REFERENCE_DATE, order: 'asc', limit: HOME_CHANGE_CANDIDATE_LIMIT, distinctNorms: true }),
  // Außer Kraft getreten: Aufhebungen bis zum Stichtag.
  store.listChanges({ changeTypes: ['repeal'], until: EDITORIAL_REFERENCE_DATE, order: 'desc', limit: HOME_CHANGE_CANDIDATE_LIMIT, distinctNorms: true }),
  store.listPublications({ limit: 6 }),
  countNormTypes(store),
]);

const searchSuggestionsUrl = `${import.meta.env.BASE_URL}search-suggestions.json`;

/** Direktzugriffe: Verfassung und die Normtypen mit eigener Übersicht; weitere Typen als Suchfilter. */
const typeAccess: Array<{ type: NormType; href: string }> = [
  { type: 'gesetz', href: getLawsUrl() },
  { type: 'verordnung', href: getRegulationsUrl() },
  { type: 'verwaltungsvorschrift', href: getAdministrativeRulesUrl() },
  { type: 'foerderrichtlinie', href: getFundingUrl() },
];
const furtherTypes = stats.types
  .filter((type) => !typeAccess.some((entry) => entry.type === type) && type !== 'aenderungsvorschrift' && type !== 'berichtigung')
  .map((type) => ({ type, href: `${getSearchUrl()}?type=${encodeURIComponent(type)}` }));
const directTypes = [...typeAccess, ...furtherTypes].filter((entry) => (typeCounts[entry.type] ?? 0) > 0 || typeAccess.includes(entry));

/** Wortlaut einer Änderungszeile: das Ereignis, die Änderungsvorschrift mit Fundstelle. */
function eventLabel(change: NormChange): string {
  if (change.changeType === 'initial') return change.type === 'aenderungsvorschrift' ? 'verkündet' : `neue ${formatNormType(change.type)}`;
  if (change.changeType === 'repeal') return 'aufgehoben';
  return 'geändert';
}
function futureEventLabel(change: NormChange): string {
  if (change.changeType === 'repeal') return 'tritt außer Kraft';
  return change.changeType === 'initial' ? 'tritt in Kraft' : 'wird geändert';
}
function changeDetail(change: NormChange): string {
  const description = describeChange(change);
  const citation = toDisplayText(change.citation ?? '').trim();
  if (description && citation && !description.includes(citation)) return `${description} · ${citation}`;
  return description || citation;
}

const publicationRows = listPublicationEntries(latestPublications).slice(0, HOME_PUBLICATION_ENTRY_LIMIT);
const seriesLabels = [...new Set(latestPublications.map((publication) => publication.publication))];
const columns = [
  { key: 'current', heading: 'Neu in Kraft getreten', tone: 'in-force', entries: inForceChanges, empty: 'Im Bestand ist keine neu in Kraft getretene Vorschrift verzeichnet.' },
  { key: 'future', heading: 'Verkündet, noch nicht in Kraft', tone: 'future', entries: futureChanges, empty: 'Derzeit ist keine künftige Änderung verkündet.' },
  { key: 'repealed', heading: 'Außer Kraft getreten', tone: 'repealed', entries: repealChanges, empty: 'Im Bestand ist keine Aufhebung verzeichnet.' },
] as const;
---

<LawLayout
  title="OstRecht"
  description="OstRecht zeigt das geltende Landesrecht des Ostdeutschen Freistaates in konsolidierter Fassung und macht Herkunft, Änderungen und amtliche Veröffentlichungen sichtbar."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }]}
  mainWidth="full"
  activeSection={Astro.url.hash === '#aenderungsdienst' ? 'changes' : undefined}
>
  <section class="r-home-entry" aria-labelledby="law-home-title">
    <div class="r-container r-home-entry__grid">
      <div class="r-home-entry__main">
        <h1 id="law-home-title" class="r-h1">Das Recht des Freistaates Ostdeutschland</h1>
        <p class="r-lead r-home-entry__lead">Geltendes Landesrecht in konsolidierter Fassung · {formatNormCount(stats.normCount)}, davon {stats.inForceCount} in Kraft · {referenceDateLabel()}</p>
        <form class="r-home-search" action={getSearchUrl()} method="get" role="search" data-search-shell>
          <label class="r-field r-field--label-caps r-home-search__field">
            <span>Gesetz, Verordnung, Abkürzung, Paragraph oder Fundstelle</span>
            <input class="r-input r-input--lg" id="law-home-search" type="search" name="q" autocomplete="off" placeholder="z. B. Gesetz, Abkürzung, § 12 oder OGVBl. 2026 Nr. 16" data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} data-law-search-url={getSearchUrl()} />
          </label>
          <button class="r-btn r-btn--primary r-btn--lg" type="submit">Suchen</button>
        </form>
        <div class="r-home-search__hint r-meta">
          <span>Vorschlagsliste ab dem 2. Zeichen: Abkürzungen, Kurztitel, Fundstellen. <kbd>/</kbd> fokussiert die Suche.</span>
          <a href={`${getSearchUrl()}?filter=erweitert`}>Erweiterte Suche</a>
        </div>
        <div class="r-home-direct r-meta">
          <span class="r-muted">Direkt:</span>
          <a href={getLawConstitutionUrl()}>{lawSiteConfig.targetLabels.constitution}</a>
          <span class="r-home-direct__sep" aria-hidden="true">|</span>
          {directTypes.map((entry) => (
            <a href={entry.href}>{formatNormType(entry.type)}{typeCounts[entry.type] !== undefined ? ` (${typeCounts[entry.type]})` : ''}</a>
          ))}
        </div>
      </div>
      <div class="r-home-subjects">
        <h2 class="r-label r-label--rule">{lawSiteConfig.targetLabels.subjects}</h2>
        <ol class="r-home-subjects__list r-num">
          {subjectAreas.map((area) => (
            <li>
              <span class="r-muted">{area.number ?? ''}</span>
              <a href={`${getSubjectsUrl()}#subject-area-${getSubjectSlug(area.name)}`}>{area.name}</a>
              <span class="r-muted">{area.normCount}</span>
            </li>
          ))}
          <li>
            <span></span>
            <a href={getIndexUrl()}>A–Z · Stichwortregister · Abkürzungen</a>
            <span></span>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <section class="r-home-changes" id="aenderungsdienst" aria-labelledby="aenderungsdienst-title">
    <div class="r-container">
      <div class="r-section-head">
        <h2 id="aenderungsdienst-title">Änderungsdienst</h2>
        <span class="r-meta">Veränderung des Rechtsbestands · Verkündung und Rechtswirkung getrennt · <a href={`${getSearchUrl()}?sort=activity`}>Vollständiges Protokoll</a></span>
      </div>
      <div class="r-home-changes__grid">
        {columns.map((column) => (
          <section class="r-home-changes__column" data-visual-section={column.key === 'current' ? 'law-latest-status' : column.key === 'future' ? 'law-future-changes' : 'law-repealed'}>
            <h3 class:list={['r-label', 'r-home-changes__heading', `r-home-changes__heading--${column.tone}`]}>{column.heading}</h3>
            <ol class="r-home-changes__list" data-law-change-list={column.key} data-law-current-change-list={column.key === 'current' ? '' : undefined} data-law-future-change-list={column.key === 'future' ? '' : undefined}>
              {column.entries.map((change, index) => (
                <li
                  data-law-change
                  data-effective-date={change.date}
                  data-change-type={change.changeType}
                  data-current-label={eventLabel(change)}
                  data-future-label={futureEventLabel(change)}
                  hidden={index >= HOME_CHANGE_LIMIT}
                >
                  <time class:list={['r-num', column.key === 'future' ? 'r-future-text' : 'r-muted']} datetime={change.date}>{column.key === 'future' ? `ab ${formatShortDate(change.date)}` : formatShortDate(change.date)}</time>
                  <div>
                    <a class="r-home-changes__norm" href={getNormUrl(change.slug)}>{toDisplayText(change.normShortTitle)}</a>
                    {' '}<span class="r-home-changes__event" data-law-change-label>{column.key === 'future' ? futureEventLabel(change) : eventLabel(change)}</span>
                    <div class="r-caption">{changeDetail(change)} · <a href={getNormHistoryUrl(change.slug)}>Änderungsverlauf</a></div>
                  </div>
                </li>
              ))}
            </ol>
            <p class="r-meta r-home-changes__empty" data-law-change-empty hidden={column.entries.length > 0}>{column.empty}</p>
          </section>
        ))}
      </div>
    </div>
  </section>

  <section class="r-home-publications" aria-labelledby="home-publications-title">
    <div class="r-container">
      <div class="r-section-head">
        <h2 id="home-publications-title" class="r-label">Neueste amtliche Veröffentlichungen{seriesLabels.length > 0 ? ` · ${seriesLabels.join(' · ')}` : ''}</h2>
        <a class="r-meta" href={getPublicationsUrl()}>Alle amtlichen Veröffentlichungen</a>
      </div>
      {publicationRows.length > 0 ? (
        <div class="r-table-wrap">
          <table class="r-table r-table--meta r-table--dense r-home-publications__table">
            <caption class="visually-hidden">Neueste amtliche Veröffentlichungen mit Datum, Gegenstand, Dokumentart, herausgebender Stelle und Fundstelle</caption>
            <tbody>
              {publicationRows.map(({ publication, entry }) => (
                <tr>
                  <td class="r-muted r-nowrap"><time datetime={publication.date}>{formatShortDate(publication.date)}</time></td>
                  <td><a href={`${getPublicationUrl(publication.slug)}#${entry.id}`}>{toDisplayText(entry.title)}</a></td>
                  <td class="r-nowrap r-muted">{formatPublicationEntryType(entry.type)}</td>
                  <td class="r-muted">{toDisplayText(publication.publisher ?? '')}</td>
                  <td class="r-right r-nowrap"><a href={getPublicationUrl(publication.slug)}>{getPublicationLabel(publication)}</a></td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      ) : (
        <p class="r-meta">Im Bestand sind noch keine amtlichen Veröffentlichungen verzeichnet.</p>
      )}
      <p class="r-caption r-home-publications__count">{formatCount(stats.publicationCount, 'Ausgabe', 'Ausgaben')} der Verkündungsblätter im Bestand.</p>
    </div>
  </section>

  <script>import '../scripts/law-future-changes.ts';</script>
</LawLayout>
