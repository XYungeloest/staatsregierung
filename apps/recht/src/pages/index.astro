---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../layouts/LawLayout.astro';
import PortalIcon from '@ostrecht/shared/components/portal/PortalIcon.astro';
import NormOriginBadge from '../components/norms/NormOriginBadge.astro';
import { formatDate, formatNormType, getIndexUrl, getLawPortalUrl, getNormHistoryUrl, getNormUrl, getPublicationEntriesUrl, getPublicationLabel, getPublicationUrl, getPublicationsUrl, getSearchUrl, getSubjectsUrl, getSubjectSlug, EDITORIAL_REFERENCE_DATE, LEGAL_CHANGE_ENTRY_TYPES, toDisplayText } from '@ostrecht/shared/lib/norms/index.ts';
import { getNormStore } from '../lib/runtime/context.ts';
import { NORM_HISTORY_LABEL } from '../lib/vocabulary.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

// Startseite: nur Bestandszahlen, Hauptbereiche, die jüngsten Historieneinträge (Index auf
// change_date) und die neuesten Ausgaben – kein Laden des Normenbestands.
const HOME_CHANGE_CANDIDATE_LIMIT = 12;
// Gleich lange Spalten: aktuelle und künftige Änderungen zeigen dieselbe Anzahl Einträge.
const HOME_CURRENT_CHANGE_LIMIT = 4;
const HOME_FUTURE_CHANGE_LIMIT = 4;
const HOME_PUBLICATION_LIMIT = 3;
/** Rechtsereignisse der Startseite: dieselbe Definition wie die Rechtsänderung (ohne Hinweise). */
const HOME_CHANGE_TYPES = [...LEGAL_CHANGE_ENTRY_TYPES];
const [stats, subjectAreas, latestChanges, futureChanges, latestPublications] = await Promise.all([
  store.getCorpusStats(),
  // Alle acht Hauptgruppen der amtlichen Systematik in ihrer Reihenfolge.
  store.listSubjectAreas(),
  // Letzte Rechtsereignisse bis zum Stichtag: Erlass neuer Vorschriften, Änderungen und Aufhebungen,
  // je Norm nur das jüngste Ereignis, nach Ereignisdatum absteigend (keine redaktionelle Auswahl).
  store.listChanges({ changeTypes: HOME_CHANGE_TYPES, until: EDITORIAL_REFERENCE_DATE, order: 'desc', limit: HOME_CHANGE_CANDIDATE_LIMIT, distinctNorms: true }),
  store.listChanges({ changeTypes: HOME_CHANGE_TYPES, after: EDITORIAL_REFERENCE_DATE, order: 'asc', limit: HOME_CHANGE_CANDIDATE_LIMIT, distinctNorms: true }),
  store.listPublications({ limit: HOME_PUBLICATION_LIMIT }),
]);
const homeSearchTypes = [...stats.types]
  .sort((left, right) => formatNormType(left).localeCompare(formatNormType(right), 'de'));
const searchSuggestionsUrl = `${import.meta.env.BASE_URL}search-suggestions.json`;
const quickAccess = [
  { title: lawSiteConfig.targetLabels.index, text: 'Alphabetische Übersicht', href: getIndexUrl(), icon: 'law' as const },
  { title: 'Neue Regelungen', text: 'Nach Rechtsstand sortiert', href: `${getSearchUrl()}?sort=rechtsstand`, icon: 'calendar' as const },
  { title: 'Änderungen', text: 'Rechtsentwicklung nachvollziehen', href: `${getSearchUrl()}?sort=activity`, icon: 'arrow' as const },
  { title: 'Verkündungsblätter', text: 'Ausgaben und Fundstellen', href: getPublicationsUrl(), icon: 'law' as const },
  { title: lawSiteConfig.targetLabels.subjects, text: 'Recht nach Themen geordnet', href: getSubjectsUrl(), icon: 'topics' as const },
];
---

<LawLayout
  title="OstRecht"
  description="OstRecht bietet die Recherche in geltenden und historischen Normfassungen, Fundstellen und Verkündungen des Ostdeutschen Freistaates."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }]}
>
  <section class="law-home-hero" aria-labelledby="law-home-title">
    <div class="law-home-hero__intro">
      <p class="eyebrow">Rechtsportal des Ostdeutschen Freistaates</p>
      <h1 id="law-home-title">Das Recht des Freistaates Ostdeutschland</h1>
      <p>Gesetze, Verordnungen und Verwaltungsvorschriften recherchieren, aktuelle Fassungen lesen und Änderungen nachvollziehen.</p>
    </div>
    <div class="law-home-hero__search">
      <form class="law-global-search" action={getSearchUrl()} method="get" role="search">
        <label class="visually-hidden" for="law-home-search">Gesetz, Verordnung, Paragraph oder Stichwort suchen</label>
        <div class="law-global-search__control">
          <PortalIcon name="search" />
          <input id="law-home-search" type="search" name="q" autocomplete="off" placeholder="Gesetz, Verordnung, Paragraph oder Stichwort suchen" data-law-norm-autocomplete data-law-suggestions-url={searchSuggestionsUrl} />
          <label class="visually-hidden" for="law-home-type">Inhaltsart</label>
          <select id="law-home-type" name="type">
            <option value="">Alle Inhalte</option>
            {homeSearchTypes.map((type) => <option value={type}>{formatNormType(type)}</option>)}
          </select>
          <button type="submit">Suchen</button>
        </div>
      </form>
      <!-- Jeder Chip ist ein Suchfilter; ein Chip führt zur vollständigen Suche (Befund Q7). -->
      <nav class="law-search-chips" aria-label="Direkte Suchfilter">
        <a href={`${getSearchUrl()}?type=gesetz`}>Gesetze</a>
        <a href={`${getSearchUrl()}?type=verordnung`}>Verordnungen</a>
        <a href={`${getSearchUrl()}?type=verwaltungsvorschrift`}>Verwaltungsvorschriften</a>
        <a href={`${getSearchUrl()}?type=foerderrichtlinie`}>Förderrichtlinien</a>
        <a href={getSearchUrl()}>Erweiterte Suche</a>
      </nav>
      <p class="law-home-hero__inventory">{stats.inForceCount} geltende Vorschriften und {stats.publicationCount} erschlossene Ausgaben im Bestand.</p>
    </div>
  </section>

  <nav class="law-quick-access" aria-label="Schnellzugriffe" data-visual-section="law-research-paths">
    {quickAccess.map((entry) => (
      <a href={entry.href}>
        <PortalIcon name={entry.icon} />
        <span><strong>{entry.title}</strong><small>{entry.text}</small></span>
        <PortalIcon name="arrow" />
      </a>
    ))}
  </nav>

  <div class="law-home-dashboard">
    <div class="law-home-dashboard__row law-home-dashboard__row--changes">
      <section class="law-dashboard-card" data-visual-section="law-latest-status">
        <header class="law-dashboard-card__header">
          <div><PortalIcon name="arrow" /><h2>Aktuelle Änderungen</h2></div>
          <a href={`${getSearchUrl()}?sort=activity`}>Alle anzeigen</a>
        </header>
        <ol class="law-dashboard-list" data-law-current-change-list>
          {latestChanges.map((change, index) => (
            <li
              data-law-change
              data-effective-date={change.date}
              data-current-label={formatNormType(change.type)}
              data-future-label="tritt künftig in Kraft"
              hidden={index >= HOME_CURRENT_CHANGE_LIMIT}
            >
              <time datetime={change.date}>{formatDate(change.date)}</time>
              <span class="law-type-label" data-law-change-label>{formatNormType(change.type)}</span>
              <div>
                <h3><a href={getNormUrl(change.slug)}>{toDisplayText(change.normShortTitle)}</a></h3>
                <p>{toDisplayText(change.title)}</p>
                <p class="record-list__meta"><NormOriginBadge kind={change.originKind} /><a class="law-row-link" href={getNormHistoryUrl(change.slug)}>{NORM_HISTORY_LABEL}</a></p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="law-dashboard-card law-dashboard-card--future" data-visual-section="law-future-changes">
        <header class="law-dashboard-card__header">
          <div><PortalIcon name="calendar" /><h2>Künftige Änderungen</h2></div>
          <a href={`${getSearchUrl()}?versionScope=future`}>Alle anzeigen</a>
        </header>
        <p class="law-dashboard-card__future-intro">Vorschriften, die nach dem aktuellen Rechtsstand in Kraft treten.</p>
        <ol class="law-dashboard-list law-dashboard-list--future" data-law-future-change-list>
          {futureChanges.map((change, index) => (
            <li
              data-law-change
              data-effective-date={change.date}
              data-current-label={formatNormType(change.type)}
              data-future-label="tritt künftig in Kraft"
              hidden={index >= HOME_FUTURE_CHANGE_LIMIT}
            >
              <time datetime={change.date}>{formatDate(change.date)}</time>
              <span class="law-type-label law-type-label--future" data-law-change-label>tritt künftig in Kraft</span>
              <div>
                <h3><a href={getNormUrl(change.slug)}>{toDisplayText(change.normShortTitle)}</a></h3>
                <p>{toDisplayText(change.title)}</p>
                <a class="law-row-link" href={getNormHistoryUrl(change.slug)}>{NORM_HISTORY_LABEL}</a>
              </div>
            </li>
          ))}
        </ol>
        <p class="law-dashboard-card__empty" data-law-future-empty hidden={futureChanges.length > 0}>Derzeit ist keine künftige Änderung verkündet.</p>
      </section>
    </div>

    <div class="law-home-dashboard__row law-home-dashboard__row--band">
      <section class="law-dashboard-card">
        <header class="law-dashboard-card__header">
          <div><PortalIcon name="law" /><h2>Neu verkündet</h2></div>
          <a href={getPublicationsUrl()}>Alle anzeigen</a>
        </header>
        <ol class="law-dashboard-list">
          {latestPublications.map((publication) => (
            <li>
              <time datetime={publication.date}>{formatDate(publication.date)}</time>
              <span class="law-type-label">{getPublicationLabel(publication)}</span>
              <div>
                <h3><a href={getPublicationUrl(publication.slug)}>{toDisplayText(publication.title)}</a></h3>
                <p>{publication.entries.slice(0, 3).map((entry) => toDisplayText(entry.title)).join('; ')}{publication.entries.length > 3 ? ' …' : ''}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>

      <section class="law-dashboard-card law-topic-card">
        <header class="law-dashboard-card__header">
          <div><PortalIcon name="topics" /><h2>{lawSiteConfig.targetLabels.subjects}</h2></div>
          <a href={getSubjectsUrl()}>Alle anzeigen</a>
        </header>
        <ul>
          {subjectAreas.map((area) => (
            <li><a href={`${getSubjectsUrl()}#subject-area-${getSubjectSlug(area.name)}`}>{area.number ? `${area.number} ${area.name}` : area.name}<span>{area.normCount}</span></a></li>
          ))}
        </ul>
        <p class="law-topic-card__note">Eine Vorschrift kann mehreren Sachgebieten zugeordnet sein; die Zahlen summieren sich deshalb nicht zum Bestand.</p>
      </section>

      <section class="law-service-card">
        <h2>Rechtsportal-Funktionen</h2>
        <a href={`${getSearchUrl()}?versionScope=current`}><strong>Konsolidierte Fassungen</strong><span>Derzeit geltende Normtexte</span></a>
        <a href={`${getSearchUrl()}?sort=activity`}><strong>Änderungsverlauf</strong><span>Fassungen und Änderungen im Zeitverlauf</span></a>
        <a href={getPublicationEntriesUrl()}><strong>PDF und HTML</strong><span>Fundstellen und aufbereitete Normtexte</span></a>
        <a href={getIndexUrl()}><strong>{lawSiteConfig.targetLabels.index}</strong><span>Vorschriften, Abkürzungen und Stichwörter von A bis Z</span></a>
      </section>
    </div>
  </div>

  <section class="law-trust-strip" aria-label="Merkmale des Rechtsportals">
    <div><strong>Amtlich</strong><span>Auf Grundlage belegter Verkündungen.</span></div>
    <div><strong>Aktuell</strong><span>Konsolidierte Fassungen und Änderungen.</span></div>
    <div><strong>Verständlich</strong><span>Strukturierte Normdarstellung.</span></div>
    <div><strong>Zugänglich</strong><span>Responsiv und barrierearm.</span></div>
  </section>

  <script>import '../scripts/law-future-changes.ts';</script>
</LawLayout>
