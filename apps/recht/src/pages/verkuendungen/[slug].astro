---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import {
  formatDate,
  formatPublicationEntryType,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionUrl,
  getPublicationEntriesUrl,
  getPublicationUrl,
  getPublicationsUrl,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import {
  formatIssueHeadline,
  formatPublisherLine,
  formatVersionDateLabel,
  publicationSourceLinks,
} from '../../lib/publication-presentation.ts';
import { getNormStore } from '../../lib/runtime/context.ts';

// Verkündungsseiten werden zur Laufzeit aus der D1-Projektion aufgebaut.
export const prerender = false;

const store = await getNormStore(Astro.locals);
const publication = await store.getPublication(Astro.params.slug ?? '');
if (!publication) return Astro.rewrite('/404');
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
// Nur die in dieser Ausgabe zitierten Normen: ihre Fassungsübersicht und ihre in D1
// vorberechneten Rechtsbeziehungen (law_norm_derived) statt des gesamten Bestands.
const citedSlugs = [...new Set(publication.entries.map((entry) => entry.normSlug).filter((slug): slug is string => Boolean(slug)))];
const [versionSummaries, derivedEntries] = await Promise.all([
  store.listVersionSummaries({ slugs: citedSlugs }),
  Promise.all(citedSlugs.map(async (slug) => [slug, await store.getDerived(slug)] as const)),
]);
const knownSlugs = new Set(versionSummaries.map((version) => version.slug));
const versionKinds = new Map(versionSummaries.map((version) => [`${version.slug}:${version.versionId}`, version.temporalKind]));
const versionDates = new Map(versionSummaries.map((version) => [`${version.slug}:${version.versionId}`, version.validFrom]));
const relationLookup = new Map(derivedEntries.map(([slug, derived]) => [slug, derived?.relations ?? []]));
const publisherLine = formatPublisherLine(publication.publisher);
const sourceLinks = publicationSourceLinks(publication);

function getEntryNormUrl(normSlug: string | undefined, versionId: string | undefined): string | undefined {
  if (!normSlug || !knownSlugs.has(normSlug)) {
    return undefined;
  }

  const kind = versionId ? versionKinds.get(`${normSlug}:${versionId}`) : undefined;
  return !kind || kind === 'current'
    ? getNormUrl(normSlug)
    : getNormVersionUrl(normSlug, versionId as string);
}
---

<LawLayout
  title={publication.title}
  description={`${publication.title} mit Fundstellen und verlinkten Fassungen.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Verkündungen', href: getPublicationsUrl() },
    { label: publication.title, href: getPublicationUrl(publication.slug) },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Verkündungen', href: getPublicationsUrl() },
      { label: publication.title },
    ]}
  />

  <SectionHero
    eyebrow="Verkündung"
    title={toDisplayText(publication.title)}
    lead={`${formatIssueHeadline(publication)} mit den verzeichneten Veröffentlichungen und den verlinkten Fassungen.`}
    variant="law"
    facts={[
      { label: 'Ausgabedatum', value: formatDate(publication.date) },
      { label: 'Einträge', value: String(publication.entries.length) },
      ...(publication.place ? [{ label: 'Ausgabeort', value: toDisplayText(publication.place) }] : []),
    ]}
    actions={[
      { label: 'Alle Verkündungen', href: getPublicationsUrl(), primary: true },
      { label: 'Fundstellen', href: getPublicationEntriesUrl() },
    ]}
  >
    {publisherLine ? <p>{toDisplayText(publisherLine)}</p> : null}
    <button class="text-link-button" type="button" data-print-page>Seite drucken</button>
  </SectionHero>

  <div class="law-publication-detail">
    <section class="law-publication-entries" aria-labelledby="publication-entries-heading">
      <header>
        <span class="section-eyebrow">Inhalt der Ausgabe</span>
        <h2 id="publication-entries-heading">Veröffentlichungen</h2>
        <p>Jeder Eintrag verbindet die amtliche Fundstelle mit der verlinkten Fassung.</p>
      </header>
      <ol>
          {publication.entries.map((entry) => {
            const normUrl = getEntryNormUrl(entry.normSlug, entry.versionId);
            const legalRelations = entry.normSlug
              ? (relationLookup.get(entry.normSlug) ?? []).filter((relation) => relation.kind === 'amends' || relation.kind === 'repeals')
              : [];
            const versionLabel = entry.normSlug && entry.versionId
              ? formatVersionDateLabel(entry.versionId, versionDates.get(`${entry.normSlug}:${entry.versionId}`))
              : undefined;

            return (
              <li id={entry.id}>
                <div class="law-publication-entry__number" aria-hidden="true">{String(publication.entries.indexOf(entry) + 1).padStart(2, '0')}</div>
                <div class="law-publication-entry__content">
                  <span class="law-publication-entry__type">{formatPublicationEntryType(entry.type)}</span>
                  <h3>{normUrl ? <a href={normUrl}>{toDisplayText(entry.title)}</a> : toDisplayText(entry.title)}</h3>
                  <p class="law-publication-entry__citation"><strong>Fundstelle</strong>{toDisplayText(entry.citation)}
                  {entry.pages
                    ? <span> · Seiten {entry.pages}</span>
                    : entry.startPage
                      ? <span> · Beginn auf Seite {entry.startPage}</span>
                      : null}
                  </p>
                  <div class="law-publication-entry__links">
                  {normUrl ? (
                    <>
                      {versionLabel ? <span class="law-publication-entry__version">{versionLabel}</span> : null}
                      {legalRelations.length > 0 ? (
                        <ul class="publication-relation-list">
                          {legalRelations.map((relation) => {
                            const resultingUrl = relation.resultingVersionUrl;
                            return (
                              <li>
                                {relation.kind === 'repeals' ? 'Hebt auf: ' : 'Ändert: '}
                                <a class="inline-link" href={getNormUrl(relation.slug)}>{toDisplayText(relation.shortTitle)}</a>
                                {resultingUrl ? <> · <a class="inline-link" href={resultingUrl}>entstandene Fassung</a></> : null}
                              </li>
                            );
                          })}
                        </ul>
                      ) : null}
                    </>
                  ) : (
                    <span>Text nicht im Rechtsportal enthalten</span>
                  )}
                  </div>
                </div>
              </li>
            );
          })}
      </ol>
    </section>

    <aside class="law-publication-sources">
      <span class="section-eyebrow">Dokumentnachweis</span>
      <h2>Ausgabe und Quellen</h2>
      <p>
        Die verlinkte Fassung und die Fundstelle weisen die Ausgabe nach, in der die Vorschrift
        oder Bekanntmachung geführt wird.
      </p>
    {publication.pdf ? (
      <p class="section-link-row">
        <a class="inline-link" href={publication.pdf}>Ausgabe als PDF öffnen</a>
      </p>
    ) : (
      <p class="detail-line">Für diese Ausgabe liegt derzeit kein PDF vor.</p>
    )}
    {sourceLinks.length > 0 ? (
      <ul class="link-list">
        {sourceLinks.map((source) => (
          <li>
            <a class="inline-link" href={source.url}>{toDisplayText(source.label)}</a>
            {source.pageRange ? ` · Seiten ${source.pageRange}` : ''}
          </li>
        ))}
      </ul>
    ) : null}
    </aside>
  </div>
</LawLayout>
