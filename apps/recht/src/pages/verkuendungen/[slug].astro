---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import {
  formatDate,
  formatPublicationEntryType,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionUrl,
  getPublicationLabel,
  getPublicationUrl,
  getPublicationsUrl,
  getReferencesUrl,
  toDisplayText,
  classifyNormVersion,
  buildNormRelations,
  getApplicableVersion,
  getNormVersionIdentity,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormRelation } from '@ostrecht/shared/lib/norms/relations.ts';
import { getNormStore } from '../../lib/runtime/context.ts';

// Verkündungsseiten werden zur Laufzeit aus der D1-Projektion aufgebaut.
export const prerender = false;

const store = getNormStore(Astro.locals);
const publication = await store.getPublication(Astro.params.slug ?? '');
if (!publication) return Astro.rewrite('/404');
const norms = await store.listNorms();
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const normBySlug = new Map(norms.map((norm) => [norm.meta.slug, norm]));
const relationLookup = buildNormRelations(norms);

function getEntryNormUrl(normSlug: string | undefined, versionId: string | undefined): string | undefined {
  if (!normSlug) {
    return undefined;
  }

  const norm = normBySlug.get(normSlug);
  if (!norm) {
    return undefined;
  }

  const version = versionId ? norm.versions.find((entry) => entry.versionId === versionId) : undefined;
  return !version || classifyNormVersion(norm, version) === 'current'
    ? getNormUrl(normSlug)
    : getNormVersionUrl(normSlug, version.versionId);
}

function getResultingVersionUrl(relation: NormRelation): string | undefined {
  if (!relation.resultingNorm || !relation.resultingVersionId) return undefined;
  const version = relation.resultingNorm.versions.find((entry) => entry.versionId === relation.resultingVersionId);
  if (!version) return undefined;
  return classifyNormVersion(relation.resultingNorm, version) === 'current'
    ? getNormUrl(relation.resultingNorm.meta.slug)
    : getNormVersionUrl(relation.resultingNorm.meta.slug, version.versionId);
}
---

<LawLayout
  title={publication.title}
  description={`${publication.title} mit Fundstellen und verlinkten Normfassungen.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Verkündungen', href: getPublicationsUrl() },
    { label: publication.title, href: getPublicationUrl(publication.slug) },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Verkündungen', href: getPublicationsUrl() },
      { label: publication.title },
    ]}
  />

  <SectionHero
    eyebrow="Verkündung"
    title={toDisplayText(publication.title)}
    lead={`${getPublicationLabel(publication)} vom ${formatDate(publication.date)} mit den verzeichneten Veröffentlichungen und Verknüpfungen zu Normfassungen.`}
    variant="law"
    facts={[
      { label: 'Ausgabedatum', value: formatDate(publication.date) },
      { label: 'Einträge', value: String(publication.entries.length) },
      ...(publication.place ? [{ label: 'Ausgabeort', value: toDisplayText(publication.place) }] : []),
    ]}
    actions={[
      { label: 'Alle Verkündungen', href: getPublicationsUrl(), primary: true },
      { label: 'Fundstellen', href: getReferencesUrl() },
    ]}
  >
    {publication.publisher ? <p>Herausgegeben von {toDisplayText(publication.publisher)}.</p> : null}
    <button class="text-link-button" type="button" data-print-page>Seite drucken</button>
  </SectionHero>

  <div class="law-publication-detail">
    <main class="law-publication-entries">
      <header>
        <span class="section-eyebrow">Inhalt der Ausgabe</span>
        <h2>Veröffentlichungen</h2>
        <p>Jeder Eintrag verbindet die amtliche Fundstelle mit der zugehörigen Normfassung.</p>
      </header>
      <ol>
          {publication.entries.map((entry) => {
            const normUrl = getEntryNormUrl(entry.normSlug, entry.versionId);
            const legalRelations = entry.normSlug
              ? (relationLookup.get(entry.normSlug) ?? []).filter((relation) => relation.kind === 'amends' || relation.kind === 'repeals')
              : [];

            return (
              <li id={entry.id}>
                <div class="law-publication-entry__number" aria-hidden="true">{String(publication.entries.indexOf(entry) + 1).padStart(2, '0')}</div>
                <div class="law-publication-entry__content">
                  <span class="law-publication-entry__type">{formatPublicationEntryType(entry.type)}</span>
                  <h3>{toDisplayText(entry.title)}</h3>
                  <p class="law-publication-entry__citation"><strong>Fundstelle</strong>{toDisplayText(entry.citation)}
                  {entry.pages
                    ? <span> · Seiten {entry.pages}</span>
                    : entry.startPage
                      ? <span> · Beginn auf Seite {entry.startPage}</span>
                      : null}
                  </p>
                  <div class="law-publication-entry__links">
                  {normUrl ? (
                    <>
                      <a class="inline-link" href={normUrl}>
                        {entry.versionId ? `Fassung ${entry.versionId}` : 'Norm öffnen'}
                      </a>
                      {legalRelations.length > 0 ? (
                        <ul class="publication-relation-list">
                          {legalRelations.map((relation) => {
                            const resultingUrl = getResultingVersionUrl(relation);
                            const relationIdentity = getNormVersionIdentity(relation.norm, getApplicableVersion(relation.norm));
                            return (
                              <li>
                                {relation.kind === 'repeals' ? 'Hebt auf: ' : 'Ändert: '}
                                <a class="inline-link" href={getNormUrl(relation.norm.meta.slug)}>{toDisplayText(relationIdentity.shortTitle)}</a>
                                {resultingUrl ? <> · <a class="inline-link" href={resultingUrl}>entstandene Fassung</a></> : null}
                              </li>
                            );
                          })}
                        </ul>
                      ) : null}
                    </>
                  ) : (
                    <span>Keine Normfassung zugeordnet</span>
                  )}
                  </div>
                </div>
              </li>
            );
          })}
      </ol>
    </main>

    <aside class="law-publication-sources">
      <span class="section-eyebrow">Dokumentnachweis</span>
      <h2>Ausgabe und Quellen</h2>
      <p>
        Die verlinkte Normfassung und die Fundstelle dokumentieren die Ausgabe, in der die
        Vorschrift oder Bekanntmachung geführt wird.
      </p>
    {publication.pdf ? (
      <p class="section-link-row">
        <a class="inline-link" href={publication.pdf}>Ausgabe als PDF öffnen</a>
      </p>
    ) : (
      <p class="detail-line">Für diese Ausgabe liegt derzeit kein PDF vor.</p>
    )}
    {publication.sourceReferences && publication.sourceReferences.length > 0 ? (
      <ul class="link-list">
        {publication.sourceReferences.map((source) => (
          <li>
            <strong>{toDisplayText(source.label)}</strong>
            {source.pageRange ? ` · Seiten ${source.pageRange}` : ''}
          </li>
        ))}
      </ul>
    ) : null}
    </aside>
  </div>
</LawLayout>
