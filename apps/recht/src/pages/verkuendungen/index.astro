---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import DirectoryEntry from '../../components/directory/DirectoryEntry.astro';
import DirectoryFilterBar from '../../components/directory/DirectoryFilterBar.astro';
import DirectoryPagination from '../../components/directory/DirectoryPagination.astro';
import NormOriginBadge from '../../components/norms/NormOriginBadge.astro';
import {
  comparePublicationsNewestFirst,
  formatDate,
  formatPublicationEntryType,
  getLawPortalUrl,
  getNormUrl,
  getNormVersionUrl,
  getPublicationLabel,
  getPublicationSearchAliases,
  getPublicationUrl,
  getPublicationsUrl,
  listPublicationEntries,
  toDisplayText,
  type NormOriginKind,
  type Verkuendung,
} from '@ostrecht/shared/lib/norms/index.ts';
import { VERSION_FIELD_LABEL } from '../../lib/vocabulary.ts';
import { formatCount } from '../../lib/counts.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { DEFAULT_PAGE_SIZE, normalizePage, normalizeQueryText } from '../../lib/runtime/store.ts';
import { buildPagination, pageUrl } from '../../lib/runtime/pagination.ts';

// Verkündungen sind eine Metadatentabelle (law_publications, keine Normen); Filter, Ansicht und
// Seiten laufen serverseitig über GET-Parameter, die Antwort enthält höchstens eine Seite.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const basePath = getPublicationsUrl();
const publications = await store.listPublications();
const years = [...new Set(publications.map((publication) => publication.year))].sort((left, right) => right - left);
const publicationNames = [...new Set(publications.map((publication) => publication.publication))].sort((left, right) => left.localeCompare(right, 'de'));
const entryTypes = [...new Set(publications.flatMap((publication) => publication.entries.map((entry) => entry.type)))].sort();

const params = Astro.url.searchParams;
const clean = (value: string | null, allowed?: string[]): string => {
  const text = (value ?? '').trim().slice(0, 100);
  return !text || (allowed && !allowed.includes(text)) ? '' : text;
};
const view = params.get('ansicht') === 'eintraege' ? 'eintraege' : 'ausgaben';
const state = {
  publication: clean(params.get('publication'), publicationNames),
  year: clean(params.get('year'), years.map(String)),
  issue: clean(params.get('issue')),
  type: clean(params.get('type'), entryTypes),
  q: clean(params.get('q')),
  sortierung: clean(params.get('sortierung'), ['aelteste']),
};
const oldestFirst = state.sortierung === 'aelteste';
const query = normalizeQueryText(state.q);

// Beide Ansichten folgen derselben Reihenfolge: jüngste Ausgabe zuerst, innerhalb eines Tages
// nach Blatt und Ausgabennummer. Die Seite ordnet selbst, damit Datei- und D1-Variante gleich sind.
const ordered = [...publications].sort(comparePublicationsNewestFirst);
const sortedPublications = oldestFirst ? [...ordered].reverse() : ordered;

const matchesIssue = (publication: Verkuendung): boolean =>
  (!state.publication || publication.publication === state.publication)
  && (!state.year || String(publication.year) === state.year)
  && (!state.issue || publication.issue === state.issue);

const filteredPublications = sortedPublications.filter((publication) =>
  matchesIssue(publication)
  && (!state.type || publication.entries.some((entry) => entry.type === state.type))
  && (!query || [publication.title, ...getPublicationSearchAliases(publication), ...publication.entries.map((entry) => entry.title)].join(' ').toLocaleLowerCase('de-DE').includes(query)));

const filteredEntries = listPublicationEntries(sortedPublications).filter(({ publication, entry }) =>
  matchesIssue(publication)
  && (!state.type || entry.type === state.type)
  && (!query || `${entry.title} ${entry.citation}`.toLocaleLowerCase('de-DE').includes(query)));

const total = view === 'eintraege' ? filteredEntries.length : filteredPublications.length;
const { page } = normalizePage(params.get('seite'));
const pageCount = Math.max(1, Math.ceil(total / DEFAULT_PAGE_SIZE));
const current = Math.min(page, pageCount);
const from = (current - 1) * DEFAULT_PAGE_SIZE;
const issueItems = view === 'ausgaben' ? filteredPublications.slice(from, from + DEFAULT_PAGE_SIZE) : [];
const entryItems = view === 'eintraege' ? filteredEntries.slice(from, from + DEFAULT_PAGE_SIZE) : [];

const filterParams = { publication: state.publication, year: state.year, issue: state.issue, type: state.type, q: state.q, sortierung: state.sortierung };
const viewParams = { ...filterParams, ansicht: view === 'eintraege' ? 'eintraege' : '' };
const active = Object.values(filterParams).some(Boolean);
const pagination = buildPagination({ page: current, pageCount, basePath, params: viewParams });
const firstIndex = total === 0 ? 0 : from + 1;
const lastIndex = Math.min(current * DEFAULT_PAGE_SIZE, total);
const unit = view === 'eintraege'
  ? { one: 'Eintrag', many: 'Einträge' }
  : { one: 'Ausgabe', many: 'Ausgaben' };
const count = total === 0
  ? `Keine ${unit.many} passen zur Auswahl.`
  : `${formatCount(total, unit.one, unit.many)}${active ? ' passen zur Auswahl' : ''}${total > DEFAULT_PAGE_SIZE ? `; angezeigt ${firstIndex}–${lastIndex}` : ''}.`;

// Nur die Normen der aktuellen Seite: Rechtsherkunft der Ausgaben, Fassungen der Einträge.
const pageSlugs = [...new Set([
  ...issueItems.flatMap((publication) => publication.entries.map((entry) => entry.normSlug)),
  ...entryItems.map(({ entry }) => entry.normSlug),
].filter((slug): slug is string => Boolean(slug)))];
const [normSummaries, versionSummaries] = await Promise.all([
  store.getNormSummaries(pageSlugs),
  view === 'eintraege' ? store.listVersionSummaries({ slugs: pageSlugs }) : Promise.resolve([]),
]);
const versionKinds = new Map(versionSummaries.map((version) => [`${version.slug}:${version.versionId}`, version.temporalKind]));
const versionDates = new Map(versionSummaries.map((version) => [`${version.slug}:${version.versionId}`, version.validFrom]));

const originsOf = (slugs: Array<string | undefined>): NormOriginKind[] => [...new Set(slugs
  .filter((slug): slug is string => Boolean(slug))
  .map((slug) => normSummaries.get(slug)?.originKind)
  .filter((kind): kind is NormOriginKind => Boolean(kind)))];

function getEntryNormUrl(normSlug: string | undefined, versionId: string | undefined): string | undefined {
  if (!normSlug || !normSummaries.has(normSlug)) return undefined;
  const kind = versionId ? versionKinds.get(`${normSlug}:${versionId}`) : undefined;
  return !kind || kind === 'current' ? getNormUrl(normSlug) : getNormVersionUrl(normSlug, versionId as string);
}

const yearCounts = new Map(years.map((year) => [
  year,
  view === 'eintraege'
    ? listPublicationEntries(publications).filter(({ publication }) => publication.year === year).length
    : publications.filter((publication) => publication.year === year).length,
]));
const heading = view === 'eintraege' ? 'Einträge' : 'Ausgaben';
const pageTitle = `Verkündungen${view === 'eintraege' ? ' – Einträge' : ''}${current > 1 ? ` (Seite ${current} von ${pageCount})` : ''}`;
const views = [
  { value: 'ausgaben', label: 'Ausgaben' },
  { value: 'eintraege', label: 'Einträge' },
] as const;
---

<LawLayout
  title={pageTitle}
  description="Ausgaben der Verkündungsblätter und ihre Einträge mit Fundstelle, Datum und verlinkter Fassung."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Verkündungen', href: basePath },
  ]}
  canonical={pageUrl(basePath, { ...viewParams, seite: current })}
  noindex={active}
  prev={pagination.prev}
  next={pagination.next}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Verkündungen' },
    ]}
  />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Verkündungen"
    lead="Ausgaben der Verkündungsblätter und ihre Einträge: Datum, Fundstelle, verlinkte Fassung und die Rechtsherkunft der verkündeten Vorschriften."
    variant="law"
    facts={[
      { label: 'Verkündungsblätter', value: String(publicationNames.length) },
      { label: 'Jahrgänge', value: String(years.length) },
    ]}
  />

  <section class="directory" aria-labelledby="verkuendungen-heading" data-directory>
    <h2 id="verkuendungen-heading" class="directory__heading">{heading}</h2>
    <nav class="law-view-switch" aria-label="Ansicht" data-view-switch>
      {views.map((entry) => (
        <a
          href={pageUrl(basePath, { ...filterParams, ansicht: entry.value === 'ausgaben' ? '' : entry.value })}
          aria-current={view === entry.value ? 'page' : undefined}
          data-view={entry.value}
        >{entry.label}</a>
      ))}
    </nav>

    <DirectoryFilterBar action={basePath} label={`${heading} filtern`} hidden={{ ansicht: view === 'eintraege' ? 'eintraege' : undefined }} active={active} resetHref={pageUrl(basePath, { ansicht: view === 'eintraege' ? 'eintraege' : '' })} count={count}>
      <label class="search-field"><span>Verkündungsblatt</span><select name="publication"><option value="" selected={!state.publication}>Alle Verkündungsblätter</option>{publicationNames.map((entry) => <option value={entry} selected={entry === state.publication}>{entry}</option>)}</select></label>
      <label class="search-field"><span>Jahr</span><select name="year"><option value="" selected={!state.year}>Alle Jahre</option>{years.map((entry) => <option value={String(entry)} selected={String(entry) === state.year}>{entry}</option>)}</select></label>
      <label class="search-field"><span>Ausgabennummer</span><input name="issue" inputmode="numeric" value={state.issue} /></label>
      <label class="search-field"><span>Normtyp</span><select name="type"><option value="" selected={!state.type}>Alle Normtypen</option>{entryTypes.map((entry) => <option value={entry} selected={entry === state.type}>{formatPublicationEntryType(entry)}</option>)}</select></label>
      <label class="search-field"><span>Titel oder Suchbegriff</span><input type="search" name="q" value={state.q} autocomplete="off" maxlength="100" /></label>
      <label class="search-field"><span>Reihenfolge</span><select name="sortierung"><option value="" selected={!oldestFirst}>Neueste Ausgabe zuerst</option><option value="aelteste" selected={oldestFirst}>Älteste Ausgabe zuerst</option></select></label>
    </DirectoryFilterBar>

    <nav class="letter-nav" aria-label="Jahrgänge">
      <a href={pageUrl(basePath, { ...viewParams, year: '' })} aria-current={state.year ? undefined : 'page'}>Alle</a>
      {years.map((year) => {
        const yearCount = yearCounts.get(year) ?? 0;
        return (
          <a href={pageUrl(basePath, { ...viewParams, year: String(year) })} aria-current={String(year) === state.year ? 'page' : undefined} title={`${yearCount} ${yearCount === 1 ? unit.one : unit.many}`}>{year}</a>
        );
      })}
    </nav>

    {view === 'ausgaben' && issueItems.length > 0 ? (
      <ol class="directory-list" start={firstIndex} data-directory-list>
        {issueItems.map((publication) => {
          const origins = originsOf(publication.entries.map((entry) => entry.normSlug));
          const preview = publication.entries.slice(0, 3).map((entry) => toDisplayText(entry.title)).join('; ');
          return (
            <DirectoryEntry
              title={toDisplayText(publication.title)}
              href={getPublicationUrl(publication.slug)}
              lead={{ label: 'Ausgabe vom', text: formatDate(publication.date), datetime: publication.date }}
              description={publication.entries.length > 3 ? `${preview} …` : preview}
              facts={[
                { label: 'Kurzzitat', value: getPublicationLabel(publication) },
                { label: 'Einträge', value: String(publication.entries.length) },
              ]}
              attrs={{ 'data-directory-entry': '', 'data-year': String(publication.year), 'data-publication': publication.publication }}
            >
              <Fragment slot="badges">
                {origins.length > 0
                  ? origins.map((kind) => <NormOriginBadge kind={kind} />)
                  : <NormOriginBadge kind={null} />}
              </Fragment>
            </DirectoryEntry>
          );
        })}
      </ol>
    ) : null}

    {view === 'eintraege' && entryItems.length > 0 ? (
      <ol class="directory-list" start={firstIndex} data-directory-list>
        {entryItems.map(({ publication, entry }) => {
          const normUrl = getEntryNormUrl(entry.normSlug, entry.versionId);
          const summary = entry.normSlug ? normSummaries.get(entry.normSlug) : undefined;
          const versionDate = entry.normSlug && entry.versionId
            ? versionDates.get(`${entry.normSlug}:${entry.versionId}`) ?? (/^\d{4}-\d{2}-\d{2}$/u.test(entry.versionId) ? entry.versionId : undefined)
            : undefined;
          return (
            <DirectoryEntry
              title={toDisplayText(entry.title)}
              href={`${getPublicationUrl(publication.slug)}#${entry.id}`}
              lead={{ label: 'Verkündet am', text: formatDate(publication.date), datetime: publication.date }}
              subtitle={toDisplayText(entry.citation)}
              typeLabel={formatPublicationEntryType(entry.type)}
              originKind={summary ? (summary.originKind ?? null) : undefined}
              facts={[
                { label: 'Ausgabe', value: getPublicationLabel(publication), href: getPublicationUrl(publication.slug) },
                normUrl
                  ? { label: VERSION_FIELD_LABEL, value: versionDate ? formatDate(versionDate) : 'Vorschrift öffnen', href: normUrl }
                  : { label: VERSION_FIELD_LABEL, value: 'nicht im Rechtsportal enthalten' },
              ]}
              attrs={{ 'data-directory-entry': '', 'data-year': String(publication.year), 'data-type': entry.type }}
            />
          );
        })}
      </ol>
    ) : null}

    {total === 0 ? (
      <p class="directory-empty" data-directory-empty>Passen Sie die Filter an oder <a class="inline-link" href={pageUrl(basePath, { ansicht: view === 'eintraege' ? 'eintraege' : '' })}>setzen Sie die Auswahl zurück</a>.</p>
    ) : null}

    <DirectoryPagination pagination={pagination} label={`Seiten der ${view === 'eintraege' ? 'Eintragsliste' : 'Ausgabenliste'}`} attrs={{ 'data-directory-pagination': '' }} />
  </section>
</LawLayout>
