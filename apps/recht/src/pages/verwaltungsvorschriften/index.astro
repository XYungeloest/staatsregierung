---
import NormDirectory from '../../components/norms/NormDirectory.astro';
import { getAdministrativeRulesUrl } from '@ostrecht/shared/lib/norms/index.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion – seitenweise, nie vollständig.
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---
<NormDirectory title="Verwaltungsvorschriften" lead="Allgemeine Verwaltungsvorschriften des Ostdeutschen Freistaates strukturiert recherchieren." href={getAdministrativeRulesUrl()} type="verwaltungsvorschrift" />
