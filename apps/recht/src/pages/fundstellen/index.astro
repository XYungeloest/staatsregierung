---
import { getPublicationsUrl } from '@ostrecht/shared/lib/norms/index.ts';
import { pageUrl } from '../../lib/runtime/pagination.ts';

/**
 * Fundstellen und Verkündungen sind eine Seite: Die Einträge der Verkündungsblätter stehen
 * unter /verkuendungen/ in der Ansicht „Einträge“. Diese Adresse bleibt dauerhaft gültig
 * und führt mit denselben Filtern dorthin.
 */
export const prerender = false;

const params = Astro.url.searchParams;
return Astro.redirect(pageUrl(getPublicationsUrl(), {
  ansicht: 'eintraege',
  publication: params.get('publication') ?? '',
  year: params.get('year') ?? '',
  issue: params.get('issue') ?? '',
  type: params.get('type') ?? '',
  q: params.get('q') ?? '',
  seite: params.get('seite') ?? '',
}), 301);
---
