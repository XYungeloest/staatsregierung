---
import { getIndexUrl } from '@ostrecht/shared/lib/norms/index.ts';
import { pageUrl } from '../../lib/runtime/pagination.ts';

// Der alphabetische Zugang liegt unter /a-z/. Diese Adresse bleibt dauerhaft erreichbar und
// leitet mit Buchstabe, Herkunft, Seite und Stichwortstand weiter, damit alte Verweise und
// Lesezeichen dieselbe Ansicht öffnen.
export const prerender = false;

const parameters = Astro.url.searchParams;
const value = (name: string): string => (parameters.get(name) ?? '').trim().slice(0, 100);
return Astro.redirect(pageUrl(getIndexUrl(), {
  buchstabe: value('buchstabe'),
  herkunft: value('herkunft'),
  aenderungen: value('aenderungen'),
  seite: value('seite'),
  stichwort: value('stichwort'),
  stichwortseite: value('stichwortseite'),
}), 301);
---
