---
import { getSearchUrl } from '@ostrecht/shared/lib/norms/index.ts';
import { pageUrl } from '../../lib/runtime/pagination.ts';

/**
 * Die Rechtsentwicklung ist keine eigene Übersicht mehr: Herkunft, Normtyp, Sachgebiet und
 * Geltung sind Filter der Rechtssuche. Diese Adresse bleibt dauerhaft gültig und leitet
 * mit denselben Parameternamen dorthin weiter.
 */
export const prerender = false;

const params = Astro.url.searchParams;
return Astro.redirect(pageUrl(getSearchUrl(), {
  q: params.get('q') ?? '',
  origin: params.get('origin') ?? '',
  type: params.get('type') ?? '',
  subject: params.get('subject') ?? '',
  status: params.get('status') ?? '',
}), 301);
---
