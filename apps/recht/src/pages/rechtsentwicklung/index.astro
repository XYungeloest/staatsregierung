---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import DirectoryEntry from '../../components/directory/DirectoryEntry.astro';
import DirectoryFilterBar from '../../components/directory/DirectoryFilterBar.astro';
import DirectoryPagination from '../../components/directory/DirectoryPagination.astro';
import {
  formatDate,
  formatNormOriginKind,
  formatNormStatus,
  formatNormType,
  getLawDevelopmentOverviewUrl,
  getLawPortalUrl,
  getNormCompareSelectionUrl,
  getNormUrl,
  LEGAL_BASELINE_DATE,
  toDisplayText,
  type NormOriginKind,
} from '@ostrecht/shared/lib/norms/index.ts';
import { formatSubjectLabel } from '@ostrecht/shared/config/law-subjects.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { DEFAULT_PAGE_SIZE, normalizePage } from '../../lib/runtime/store.ts';
import { buildPagination, pageUrl } from '../../lib/runtime/pagination.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion: Filter und Seiten
// laufen serverseitig (GET-Formular), die Antwort enthält nie den gesamten Bestand.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const basePath = getLawDevelopmentOverviewUrl();
const originKinds: NormOriginKind[] = [
  'ostdeutsch-original',
  'inherited-amended',
  'inherited-unchanged',
  'origin-unresolved',
];
const [{ filters }, originCounts] = await Promise.all([store.getSearchFilters(), store.countByOriginKind()]);
const types = filters.types;
const statuses = filters.statuses;
const subjects = filters.subjects;

const params = Astro.url.searchParams;
const clean = (value: string | null, allowed?: string[]): string => {
  const text = (value ?? '').trim();
  if (!text) return '';
  return allowed && !allowed.includes(text) ? '' : text;
};
const state = {
  q: clean(params.get('q')).slice(0, 200),
  origin: clean(params.get('origin'), originKinds) as NormOriginKind | '',
  type: clean(params.get('type'), types.map((entry) => entry.value)),
  subject: clean(params.get('subject'), subjects),
  status: clean(params.get('status'), statuses.map((entry) => entry.value)),
};
const { page: requestedPage } = normalizePage(params.get('seite'));
const result = await store.queryNormSummaries({
  q: state.q || undefined,
  originKind: state.origin || undefined,
  types: state.type ? [state.type] : undefined,
  statuses: state.status ? [state.status] : undefined,
  subject: state.subject || undefined,
  page: requestedPage,
  pageSize: DEFAULT_PAGE_SIZE,
  // Jüngste Rechtsänderung zuerst: neue und geänderte Vorschriften vor unverändert übernommenem Recht.
  sort: 'activity',
});
const filterParams = { q: state.q, origin: state.origin, type: state.type, subject: state.subject, status: state.status };
const pagination = buildPagination({ page: result.page, pageCount: result.pageCount, basePath, params: filterParams });
const filtered = Object.values(filterParams).some(Boolean);
const firstIndex = result.total === 0 ? 0 : (result.page - 1) * result.pageSize + 1;
const lastIndex = Math.min(result.page * result.pageSize, result.total);
const count = result.total === 0
  ? 'Für die gewählte Filterkombination wurden keine Vorschriften gefunden.'
  : `${result.total} ${result.total === 1 ? 'Vorschrift' : 'Vorschriften'}${filtered ? ' passen zur Auswahl' : ' im Bestand'}${result.total > result.pageSize ? `; angezeigt ${firstIndex}–${lastIndex}` : ''}.`;
const pageTitle = `Rechtsentwicklung seit 1. November 2023${result.page > 1 ? ` (Seite ${result.page} von ${result.pageCount})` : ''}`;
---

<LawLayout
  title={pageTitle}
  description="Übersicht über eigenständig geschaffenes, übernommenes und fortentwickeltes Landesrecht."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Rechtsentwicklung', href: basePath },
  ]}
  canonical={pageUrl(basePath, { ...filterParams, seite: result.page })}
  noindex={filtered}
  prev={pagination.prev}
  next={pagination.next}
>
  <Breadcrumbs items={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Rechtsentwicklung' },
  ]} />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Rechtsentwicklung seit 1. November 2023"
    titleSize="long"
    lead="Ausgangspunkt für übernommenes sächsisches Landesrecht ist grundsätzlich der am 1. November 2023 geltende Rechtsstand. Seitdem wird der Rechtsbestand des Freistaates eigenständig fortentwickelt."
    variant="law"
    facts={originKinds.map((kind) => ({ label: formatNormOriginKind(kind), value: String(originCounts[kind] ?? 0) }))}
  />

  <section class="section directory law-development" aria-labelledby="development-heading" data-law-development data-directory>
    <div class="section-header">
      <h2 id="development-heading">Vorschriften recherchieren</h2>
      <p>Die Einordnung wird aus gespeicherten Fassungen, Quellen und Rechtsbeziehungen abgeleitet. Die Adresse dieser Seite enthält Ihre Auswahl und lässt sich so weitergeben.</p>
    </div>
    <DirectoryFilterBar action={basePath} label="Rechtsentwicklung filtern" active={filtered} resetHref={basePath} count={count} attrs={{ 'data-development-filter-form': '' }} countAttrs={{ 'data-development-count': '' }}>
      <label class="search-field">
        <span>Freitext</span>
        <input type="search" name="q" value={state.q} autocomplete="off" maxlength="200" placeholder="Titel, Abkürzung oder Stichwort" data-development-filter="q" />
      </label>
      <label class="search-field">
        <span>Rechtsentwicklung</span>
        <select name="origin" data-development-filter="origin">
          <option value="" selected={!state.origin}>Alle Kategorien</option>
          {originKinds.map((kind) => <option value={kind} selected={state.origin === kind}>{formatNormOriginKind(kind)}</option>)}
        </select>
      </label>
      <label class="search-field">
        <span>Normtyp</span>
        <select name="type" data-development-filter="type">
          <option value="" selected={!state.type}>Alle Normtypen</option>
          {types.map((type) => <option value={type.value} selected={state.type === type.value}>{type.label}</option>)}
        </select>
      </label>
      <label class="search-field">
        <span>Sachgebiet</span>
        <select name="subject" data-development-filter="subject">
          <option value="" selected={!state.subject}>Alle Sachgebiete</option>
          {subjects.map((subject) => <option value={subject} selected={state.subject === subject}>{formatSubjectLabel(subject, { withNumber: true, short: true })}</option>)}
        </select>
      </label>
      <label class="search-field">
        <span>Status</span>
        <select name="status" data-development-filter="status">
          <option value="" selected={!state.status}>Alle Status</option>
          {statuses.map((status) => <option value={status.value} selected={state.status === status.value}>{status.label}</option>)}
        </select>
      </label>
    </DirectoryFilterBar>

    {result.items.length > 0 ? (
      <ol class="directory-list" start={firstIndex} data-directory-list>
        {result.items.map((norm) => {
          const originKind = norm.originKind ?? 'origin-unresolved';
          const compareUrl = norm.originBaselineVersionId && norm.originBaselineVersionId !== norm.currentVersionId
            ? getNormCompareSelectionUrl(norm.slug, norm.originBaselineVersionId, norm.currentVersionId)
            : undefined;
          return (
            <DirectoryEntry
              title={toDisplayText(norm.title)}
              href={getNormUrl(norm.slug)}
              lead={{ text: formatDate(norm.currentValidFrom), datetime: norm.currentValidFrom }}
              subtitle={norm.abbr ? toDisplayText(norm.abbr) : undefined}
              description={toDisplayText(norm.summary)}
              typeLabel={formatNormType(norm.type)}
              originKind={originKind}
              facts={[
                { label: 'Rechtsstand', value: formatNormStatus(norm.status) },
                ...(norm.originLastOwnChangeDate ? [{ label: 'Letzte eigene Rechtsänderung', value: formatDate(norm.originLastOwnChangeDate), datetime: norm.originLastOwnChangeDate }] : []),
              ]}
              actions={compareUrl ? [{ label: 'Mit Ausgangsrecht vergleichen', href: compareUrl }] : []}
              attrs={{ 'data-directory-entry': '', 'data-development-item': '', 'data-origin': originKind, 'data-type': norm.type, 'data-status': norm.status }}
            />
          );
        })}
      </ol>
    ) : (
      <p class="directory-empty" data-development-empty>Passen Sie die Filter an oder <a class="inline-link" href={basePath}>setzen Sie die Auswahl zurück</a>.</p>
    )}

    <DirectoryPagination pagination={pagination} label="Seiten der Trefferliste" attrs={{ 'data-directory-pagination': '' }} />
  </section>

  <section class="section section-muted">
    <div class="section-header">
      <h2>Zwei verschiedene Stichtage</h2>
    </div>
    <p>
      Der <time datetime={LEGAL_BASELINE_DATE}>1. November 2023</time> bezeichnet den Ausgangsrechtsstand für übernommenes sächsisches Recht.
      Welcher gespeicherte Rechtsstand derzeit als geltend angezeigt wird, richtet sich getrennt davon nach dem redaktionellen Stichtag des Portals.
    </p>
  </section>
</LawLayout>
