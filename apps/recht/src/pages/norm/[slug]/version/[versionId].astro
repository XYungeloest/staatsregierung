---
import LawLayout from '../../../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import NormBody from '../../../../components/norms/NormBody.astro';
import NormCitationBlock from '../../../../components/norms/NormCitationBlock.astro';
import NormMetaCard from '../../../../components/norms/NormMetaCard.astro';
import NormOutline from '../../../../components/norms/NormOutline.astro';
import NormLegalStatusPanel from '../../../../components/norms/NormLegalStatusPanel.astro';
import NormDocumentTools from '../../../../components/norms/NormDocumentTools.astro';
import NormPrintSources from '../../../../components/norms/NormPrintSources.astro';
import NormVersionNavigation from '../../../../components/norms/NormVersionNavigation.astro';
import NormPageHeader from '../../../../components/norms/NormPageHeader.astro';
import NormHistorySummary from '../../../../components/norms/NormHistorySummary.astro';
import { buildNormOutline, formatDate, toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import {
  getLawPortalUrl,
  getNormUrl,
  getPublicationUrl,
  classifyNormVersion,
  getNormVersionIdentity,
} from '@ostrecht/shared/lib/norms/index.ts';
import { getNormStore } from '../../../../lib/runtime/context.ts';
import { versionHeaderState } from '../../../../lib/norm-header.ts';

// Konkrete Fassungen werden zur Laufzeit aus D1 gelesen; nur der angefragte
// Normkörper wird geladen.
export const prerender = false;

const slug = Astro.params.slug ?? '';
const versionId = Astro.params.versionId ?? '';
const store = await getNormStore(Astro.locals);
const norm = await store.getNorm(slug, [versionId]);
const version = norm?.versions.find((entry) => entry.versionId === versionId);
if (!norm || !version) return Astro.rewrite('/404');
const [derived, fullCitation, publicationReference] = await Promise.all([
  store.getDerived(slug),
  store.getFullCitation(slug, versionId),
  store.getPublicationReference(slug, versionId),
]);
if (!derived) return Astro.rewrite('/404');
const publication = publicationReference ? await store.getPublication(publicationReference.publicationSlug) : null;
const temporalKind = classifyNormVersion(norm, version);
const outline = buildNormOutline(version.body);
const identity = getNormVersionIdentity(norm, version);
const currentIdentity = getNormVersionIdentity(norm, norm.versions.find((entry) => classifyNormVersion(norm, entry) === 'current') ?? version);
const normTitle = toDisplayText(identity.title);
const normSeoTitle = identity.abbr ? `${normTitle} (${toDisplayText(identity.abbr)})` : normTitle;
const versionDescription = `${temporalKind === 'future' ? 'Zukünftige' : temporalKind === 'historical' ? 'Historische' : 'Veröffentlichte'} Fassung von ${normTitle} mit Stand vom ${formatDate(version.validFrom)} im Rechtsbereich des Freistaates Ostdeutschland.`;
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const header = versionHeaderState(norm, version);
---

<LawLayout
  title={`${normSeoTitle} ${version.versionId}`}
  description={versionDescription}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: toDisplayText(currentIdentity.shortTitle || currentIdentity.title), href: getNormUrl(norm.meta.slug) },
    { label: `Fassung vom ${formatDate(version.validFrom)}` },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: toDisplayText(currentIdentity.shortTitle || currentIdentity.title), href: getNormUrl(norm.meta.slug) },
      { label: `Fassung vom ${formatDate(version.validFrom)}` },
    ]}
  />

  <NormPageHeader
    norm={norm}
    version={version}
    eyebrow={header.eyebrow}
    status={header.status}
    reference={toDisplayText(version.citation)}
    referenceUrl={publicationReference ? getPublicationUrl(publicationReference.publicationSlug) : undefined}
    publicationPdf={publication?.pdf}
  />
  <NormVersionNavigation norm={norm} version={version} currentPage="history" />
  <div class="norm-workspace">
    <aside class="norm-toc-column"><NormOutline items={outline} /></aside>
    <article class="norm-document-column">
      <NormLegalStatusPanel norm={norm} version={version} origin={derived.origin} />
      <section class="section" id="normtext">
        <div class="section-header">
          <h2>{temporalKind === 'future' ? 'Zukünftiger Normtext' : temporalKind === 'historical' ? 'Historischer Normtext' : 'Veröffentlichter Normtext'}</h2>
          <p>{toDisplayText(version.changeNote)}</p>
        </div>
        <NormDocumentTools norm={norm} />
        <NormBody blocks={version.body} references={derived.textReferences} />
      </section>
      <NormPrintSources
        norm={norm}
        version={version}
        fullCitation={fullCitation ?? version.citation}
        publicationReference={publicationReference}
        publication={publication ?? undefined}
      />
    </article>
    <aside class="norm-info-column">
      <details class="norm-info-panel" open>
        <summary>Rechtsstand und weitere Informationen</summary>
        <div class="content-stack norm-sidebar">
          <NormCitationBlock
            norm={norm}
            version={version}
            fullCitation={fullCitation ?? version.citation}
            publicationReference={publicationReference}
            immutableLink
          />
          <NormMetaCard norm={norm} version={version} publicationReference={publicationReference} />
          <NormHistorySummary norm={norm} />
        </div>
      </details>
    </aside>
  </div>
</LawLayout>
