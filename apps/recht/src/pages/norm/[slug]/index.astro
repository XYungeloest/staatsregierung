---
import LawLayout from '../../../layouts/LawLayout.astro';
import NormBody from '../../../components/norms/NormBody.astro';
import NormHead from '../../../components/norms/NormHead.astro';
import NormOutline from '../../../components/norms/NormOutline.astro';
import NormOutlineSheet from '../../../components/norms/NormOutlineSheet.astro';
import NormSectionTabs from '../../../components/norms/NormSectionTabs.astro';
import NormAside from '../../../components/norms/NormAside.astro';
import { buildNormOutline } from '@ostrecht/shared/lib/norms/display.ts';
import { formatNormStatus, formatNormType, toDisplayText } from '@ostrecht/shared/lib/norms/presentation.ts';
import { getLawPortalUrl, getNormUrl, getNormVersionIdentity, getNormVersionUrl } from '@ostrecht/shared/lib/norms/index.ts';
import { getCurrentVersion } from '@ostrecht/shared/lib/norms/versions.ts';
import { buildLegislationJsonLd } from '@ostrecht/shared/lib/seo/index.ts';
import { getNormStore } from '../../../lib/runtime/context.ts';
import { displayChangeNote } from '../../../lib/history-labels.ts';
import { buildNormHeadModel } from '../../../lib/norm-head.ts';
import { loadNormView, outlineSummary } from '../../../lib/norm-view.ts';
import { formatShortDate } from '../../../lib/dates.ts';

// Vorschrift in der geltenden Fassung (P3): zur Laufzeit aus der D1-Projektion, nur der
// angezeigte Normkörper wird geladen.
export const prerender = false;

const slug = Astro.params.slug ?? '';
const store = await getNormStore(Astro.locals);
const norm = await store.getNorm(slug, 'current');
if (!norm) return Astro.rewrite('/404');
const currentVersion = getCurrentVersion(norm);
const view = await loadNormView(store, norm, currentVersion);
if (!view) return Astro.rewrite('/404');
const { derived, fullCitation, publicationReference, publication, amendmentLabels, nextFutureReference } = view;
const model = buildNormHeadModel(norm, currentVersion, { origin: derived.origin, publicationReference, amendmentLabels, nextFutureReference });
const outline = buildNormOutline(currentVersion.body);
const summary = outlineSummary(outline);
const identity = getNormVersionIdentity(norm, currentVersion);
const normTitle = toDisplayText(identity.title);
const normLabel = identity.abbr ? `${normTitle} (${toDisplayText(identity.abbr)})` : normTitle;
const responsibility = toDisplayText(norm.meta.responsibleMinistry);
const description = `${normLabel} im Rechtsbereich des Freistaates Ostdeutschland. Status: ${formatNormStatus(norm.meta.status)}.${responsibility ? ` Zuständiger Geschäftsbereich: ${responsibility}.` : ''}`;
const structuredData = buildLegislationJsonLd({
  name: normTitle,
  alternateName: toDisplayText(identity.shortTitle),
  identifier: toDisplayText(fullCitation),
  description: toDisplayText(identity.summary),
  url: getNormUrl(norm.meta.slug),
  legislationType: formatNormType(norm.meta.type),
  legislationDate: norm.meta.documentDate,
  datePublished: norm.meta.publicationDate,
  effectiveDate: norm.meta.effectiveDate,
});
const changeNote = displayChangeNote(currentVersion.changeNote);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---

<LawLayout
  documentFont
  mainWidth="full"
  title={normLabel}
  description={description}
  structuredData={structuredData}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: toDisplayText(identity.shortTitle || identity.title), href: getNormUrl(norm.meta.slug) },
  ]}
>
  <NormHead norm={norm} version={currentVersion} model={model} officialPdf={publication?.pdf} fullCitation={fullCitation} />
  <div class="norm-tabs-row"><NormSectionTabs slug={norm.meta.slug} active="text" /></div>
  <NormOutlineSheet items={outline} summary={summary} />

  <div class="norm-workspace">
    <div class="norm-workspace__outline"><NormOutline items={outline} summary={summary} /></div>

    <article class="norm-document" id="normtext" data-visual-section="norm-text" aria-labelledby="normtext-title">
      <h2 id="normtext-title" class="visually-hidden">Vorschriftentext</h2>
      {changeNote ? <p class="norm-document__lead">{changeNote}</p> : null}
      <div class="norm-body">
        <NormBody blocks={currentVersion.body} references={derived.textReferences} />
      </div>
      {model.nextFuture ? (
        <p class="r-note r-note--future">
          <span>Diese Vorschrift wird zum {formatShortDate(model.nextFuture.version.validFrom)} geändert{model.nextFuture.citation ? ` – ${model.nextFuture.publicationHref ? '' : ''}` : ''}{model.nextFuture.citation ? <>{model.nextFuture.publicationHref ? <a href={model.nextFuture.publicationHref}>{model.nextFuture.citation}</a> : model.nextFuture.citation}</> : null}, verkündet, noch nicht in Kraft. <a href={getNormVersionUrl(norm.meta.slug, model.nextFuture.version.versionId)}>Künftige Fassung anzeigen</a></span>
        </p>
      ) : null}
    </article>

    <NormAside norm={norm} version={currentVersion} origin={derived.origin} fullCitation={fullCitation} publicationReference={publicationReference} publication={publication} />
  </div>

  <script>import '../../../scripts/norm-page.ts';</script>
</LawLayout>
