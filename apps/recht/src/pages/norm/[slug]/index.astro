---
import LawLayout from '../../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import NormBody from '../../../components/norms/NormBody.astro';
import NormCitationBlock from '../../../components/norms/NormCitationBlock.astro';
import NormMetaCard from '../../../components/norms/NormMetaCard.astro';
import NormOutline from '../../../components/norms/NormOutline.astro';
import NormLegalStatusPanel from '../../../components/norms/NormLegalStatusPanel.astro';
import NormLegalRelations from '../../../components/norms/NormLegalRelations.astro';
import NormDocumentTools from '../../../components/norms/NormDocumentTools.astro';
import NormPrintSources from '../../../components/norms/NormPrintSources.astro';
import NormVersionNavigation from '../../../components/norms/NormVersionNavigation.astro';
import NormPageHeader from '../../../components/norms/NormPageHeader.astro';
import NormHistorySummary from '../../../components/norms/NormHistorySummary.astro';
import { getPressReleaseIndexUrl, getTopicsUrl } from '@ostrecht/shared/lib/portal/routes.ts';
import {
  buildNormOutline,
  formatDate,
  formatNormStatus,
  formatNormType,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/presentation.ts';
import {
  getLawPortalUrl,
  getNormUrl,
  getPublicationUrl,
  getNormVersionIdentity,
} from '@ostrecht/shared/lib/norms/index.ts';
import { getCurrentVersion } from '@ostrecht/shared/lib/norms/versions.ts';
import { buildLegislationJsonLd } from '@ostrecht/shared/lib/seo/index.ts';
import { getNormStore } from '../../../lib/runtime/context.ts';
import { normHeaderState } from '../../../lib/norm-header.ts';

// Normseiten werden zur Laufzeit aus der D1-Projektion ausgeliefert; sie werden
// nicht mehr für jede Norm beim Build vorgerendert.
export const prerender = false;

const slug = Astro.params.slug ?? '';
const store = await getNormStore(Astro.locals);
const norm = await store.getNorm(slug, 'current');
if (!norm) return Astro.rewrite('/404');
const currentVersion = getCurrentVersion(norm);
const [derived, fullCitation, publicationReference] = await Promise.all([
  store.getDerived(slug),
  store.getFullCitation(slug, currentVersion.versionId),
  store.getPublicationReference(slug, currentVersion.versionId),
]);
if (!derived) return Astro.rewrite('/404');
const publication = publicationReference ? await store.getPublication(publicationReference.publicationSlug) : null;
const currentReference = publicationReference
  ? `${toDisplayText(publicationReference.publication)} ${publicationReference.publicationDate.slice(0, 4)} Nr. ${toDisplayText(publicationReference.issue)}${
      publicationReference.pages
        ? ` S. ${toDisplayText(publicationReference.pages)}`
        : publicationReference.startPage
          ? ` S. ${toDisplayText(publicationReference.startPage)}`
          : ''
    }`
  : toDisplayText(currentVersion.citation);
const outline = buildNormOutline(currentVersion.body);
const identity = getNormVersionIdentity(norm, currentVersion);
const normTitle = toDisplayText(identity.title);
const normLabel = identity.abbr ? `${normTitle} (${toDisplayText(identity.abbr)})` : normTitle;
const normStatusLabel = formatNormStatus(norm.meta.status);
const responsibility = toDisplayText(norm.meta.responsibleMinistry);
const currentDescription = `${normLabel} im Rechtsbereich des Freistaates Ostdeutschland. Status: ${normStatusLabel}.${responsibility ? ` Zuständiger Geschäftsbereich: ${responsibility}.` : ''}`;
const structuredData = buildLegislationJsonLd({
  name: normTitle,
  alternateName: toDisplayText(identity.shortTitle),
  identifier: toDisplayText(fullCitation ?? currentVersion.citation),
  description: toDisplayText(identity.summary),
  url: getNormUrl(norm.meta.slug),
  legislationType: formatNormType(norm.meta.type),
  legislationDate: norm.meta.documentDate,
  datePublished: norm.meta.publicationDate,
  effectiveDate: norm.meta.effectiveDate,
});
const relatedNorms = derived.recommendations;
const relatedTopics = derived.portalLinks.topics;
const relatedPressReleases = derived.portalLinks.pressReleases;
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const header = normHeaderState(norm, currentVersion);
---

<LawLayout
  title={normLabel}
  description={currentDescription}
  structuredData={structuredData}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: toDisplayText(identity.shortTitle || identity.title), href: getNormUrl(norm.meta.slug) },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: toDisplayText(identity.shortTitle || identity.title) },
    ]}
  />

  <NormPageHeader
    norm={norm}
    version={currentVersion}
    eyebrow={header.eyebrow}
    status={header.status}
    reference={currentReference}
    referenceUrl={publicationReference ? getPublicationUrl(publicationReference.publicationSlug) : undefined}
    publicationPdf={publication?.pdf}
  />
  <NormVersionNavigation norm={norm} version={currentVersion} />
  <div class="norm-workspace">
    <aside class="norm-toc-column" id="norm-inhalt"><NormOutline items={outline} /></aside>

    <article class="norm-document-column">
      <NormLegalStatusPanel norm={norm} version={currentVersion} origin={derived.origin} />
      <section class="section" id="normtext" data-visual-section="norm-text">
        <div class="section-header">
          <h2>Vorschriftentext</h2>
          <p>{toDisplayText(currentVersion.changeNote)}</p>
        </div>
        <NormDocumentTools norm={norm} />
        <NormBody blocks={currentVersion.body} references={derived.textReferences} />
      </section>
      <NormPrintSources
        norm={norm}
        version={currentVersion}
        fullCitation={fullCitation ?? currentVersion.citation}
        publicationReference={publicationReference}
        publication={publication ?? undefined}
      />
      <NormLegalRelations norm={norm} relations={derived.relations} />
    </article>

    <aside class="norm-info-column" data-visual-section="norm-sidebar">
      <details class="norm-info-panel" open>
        <summary>Rechtsstand und weitere Informationen</summary>
        <div class="content-stack norm-sidebar">
          <NormCitationBlock
            norm={norm}
            version={currentVersion}
            fullCitation={fullCitation ?? currentVersion.citation}
            publicationReference={publicationReference}
          />
          <NormMetaCard
            norm={norm}
            version={currentVersion}
            publicationReference={publicationReference}
          />
          <NormHistorySummary norm={norm} />
          {relatedNorms.length > 0 || relatedTopics.length > 0 || relatedPressReleases.length > 0 ? (
            <section class="section norm-sidebar__portal-links" data-visual-section="norm-portal-relations">
          <div class="section-header section-header--compact">
            <h2>Weiterführende Bezüge</h2>
          </div>
          {relatedNorms.length > 0 ? (
            <>
              <h3 id="normverwandt">Verwandte Vorschriften</h3>
              <ul class="norm-sidebar__link-list">
                {relatedNorms.map((entry) => (
                  <li>
                    <a class="inline-link" href={getNormUrl(entry.slug)}>
                      {toDisplayText(entry.shortTitle || entry.title)}
                    </a>
                    <span>{entry.relation}</span>
                  </li>
                ))}
              </ul>
            </>
          ) : null}
          {relatedTopics.length > 0 || relatedPressReleases.length > 0 ? <h3 class="norm-sidebar__portal-heading">Im Staatsportal</h3> : null}
          {relatedTopics.length > 0 ? (
            <>
              <h4>Themen und Projekte</h4>
              <ul class="norm-sidebar__link-list">
                {relatedTopics.map((topic) => (
                  <li>
                    <a class="inline-link" href={topic.url}>{topic.title}</a>
                  </li>
                ))}
              </ul>
              <p class="section-link-row">
                <a class="inline-link" href={getTopicsUrl()}>Zu Themen & Projekte</a>
              </p>
            </>
          ) : null}
          {relatedPressReleases.length > 0 ? (
            <>
              <h4>Pressemitteilungen</h4>
              <ul class="norm-sidebar__link-list">
                {relatedPressReleases.map((release) => (
                  <li>
                    <a class="inline-link" href={release.url}>{release.title}</a>
                    <time datetime={release.date}>{formatDate(release.date)}</time>
                  </li>
                ))}
              </ul>
              <p class="section-link-row">
                <a class="inline-link" href={getPressReleaseIndexUrl()}>Zu den Pressemitteilungen</a>
              </p>
            </>
          ) : null}
            </section>
          ) : null}
        </div>
      </details>
    </aside>
  </div>
</LawLayout>
