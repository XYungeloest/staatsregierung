---
import NormDirectory from '../../components/norms/NormDirectory.astro';
import { getLawsUrl } from '@ostrecht/shared/lib/norms/index.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion – seitenweise, nie vollständig.
export const prerender = false;

Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
---
<NormDirectory title="Gesetze" lead="Gesetze des Ostdeutschen Freistaates alphabetisch, nach Sachgebiet und Rechtsstand erschließen." href={getLawsUrl()} type="gesetz" />
