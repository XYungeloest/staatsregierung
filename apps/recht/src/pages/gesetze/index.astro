---
import NormDirectory from '../../components/norms/NormDirectory.astro';
import { getLawsUrl } from '@ostrecht/shared/lib/norms/index.ts';
import { getNormStore } from '../../lib/runtime/context.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const norms = (await store.listNorms()).filter((norm) => norm.meta.type === 'gesetz');
---
<NormDirectory title="Gesetze" lead="Gesetze des Ostdeutschen Freistaates alphabetisch, nach Sachgebiet und Rechtsstand erschließen." href={getLawsUrl()} {norms} />
