---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../../layouts/LawLayout.astro';
import FilterForm from '../../components/ui/FilterForm.astro';
import NormTable from '../../components/directory/NormTable.astro';
import Pagination from '../../components/ui/Pagination.astro';
import {
  formatNormOriginKind,
  getFundingUrl,
  getLawPortalUrl,
  NORM_ORIGIN_KINDS,
} from '@ostrecht/shared/lib/norms/index.ts';
import { lawFundingAreas } from '@ostrecht/shared/config/law-subjects.ts';
import type { DirectoryNormSummary } from '../../lib/norm-summary.ts';
import { VALIDITY_FIELD_LABEL, validityOptions } from '../../lib/vocabulary.ts';
import { formatCount } from '../../lib/counts.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { DEFAULT_PAGE_SIZE, normalizePage, normalizeQueryText } from '../../lib/runtime/store.ts';
import { buildPagination, pageUrl } from '../../lib/runtime/pagination.ts';

/**
 * Förderrichtlinien: nach den zehn amtlichen Förderbereichen 550–559 gegliedert, im Listenmuster
 * von P6b als vorgefilterte Variante; je Förderbereich höchstens eine Seite.
 */
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const basePath = getFundingUrl();
const all = (await store.listNormSummariesByType('foerderrichtlinie')) as DirectoryNormSummary[];
const WITHOUT_AREA = 'weitere';
const areas = [
  ...lawFundingAreas.map((area) => ({ id: `bereich-${area.number}`, number: area.number, title: area.title })),
  { id: `bereich-${WITHOUT_AREA}`, number: WITHOUT_AREA, title: 'Weitere Förderrichtlinien' },
];
const areaOf = (norm: DirectoryNormSummary): string => {
  const number = (norm.fundingArea ?? '').trim();
  return lawFundingAreas.some((area) => area.number === number) ? number : WITHOUT_AREA;
};
const params = Astro.url.searchParams;
const clean = (value: string | null, allowed?: readonly string[], maxLength = 200): string => {
  const text = (value ?? '').trim().slice(0, maxLength);
  if (!text) return '';
  return allowed && !allowed.includes(text) ? '' : text;
};
const statusOptions = validityOptions([...new Set(all.map((norm) => norm.status))]);
const state = {
  q: clean(params.get('q')),
  status: clean(params.get('status'), statusOptions.map((option) => option.value), 40),
  origin: clean(params.get('origin'), NORM_ORIGIN_KINDS, 40),
  bereich: clean(params.get('bereich'), areas.map((area) => area.number), 20),
};
const selectedStatuses = statusOptions.find((option) => option.value === state.status)?.statuses;
const query = normalizeQueryText(state.q);
const matches = (norm: DirectoryNormSummary): boolean =>
  (!selectedStatuses || selectedStatuses.includes(norm.status))
  && (!state.origin || norm.originKind === state.origin)
  && (!query || [norm.title, norm.shortTitle, norm.abbr ?? '', ...norm.keywords].join(' ').toLocaleLowerCase('de-DE').includes(query));
const filtered = all.filter(matches);
const inForce = all.filter((norm) => norm.status === 'in-force').length;
const countsByArea = new Map(areas.map((area) => [area.number, filtered.filter((norm) => areaOf(norm) === area.number).length]));
const visibleAreas = areas.filter((area) => (countsByArea.get(area.number) ?? 0) > 0 && (!state.bereich || state.bereich === area.number));
const active = Boolean(state.q || state.status || state.origin || state.bereich);
const filterParams = { q: state.q, status: state.status, origin: state.origin, bereich: state.bereich };
const single = state.bereich ? filtered.filter((norm) => areaOf(norm) === state.bereich) : [];
const { page } = normalizePage(params.get('seite'));
const pageCount = state.bereich ? Math.max(1, Math.ceil(single.length / DEFAULT_PAGE_SIZE)) : 1;
const current = Math.min(page, pageCount);
const pagination = buildPagination({ page: current, pageCount, basePath, params: filterParams });
const entriesOf = (number: string): DirectoryNormSummary[] => {
  const rows = filtered.filter((norm) => areaOf(norm) === number);
  if (state.bereich === number) {
    const from = (current - 1) * DEFAULT_PAGE_SIZE;
    return rows.slice(from, from + DEFAULT_PAGE_SIZE);
  }
  return rows.slice(0, DEFAULT_PAGE_SIZE);
};
const FUNDING_UNIT = { one: 'Förderrichtlinie', many: 'Förderrichtlinien' };
const total = state.bereich ? single.length : filtered.length;
const firstIndex = state.bereich ? (total === 0 ? 0 : (current - 1) * DEFAULT_PAGE_SIZE + 1) : 1;
const lastIndex = state.bereich ? Math.min(current * DEFAULT_PAGE_SIZE, total) : total;
const count = total === 0
  ? 'Keine Förderrichtlinien passen zur Auswahl.'
  : `${formatCount(total, FUNDING_UNIT.one, FUNDING_UNIT.many)}${active ? ' passen zur Auswahl' : ''}${lastIndex < total ? ` · angezeigt ${firstIndex}–${lastIndex}` : ''}.`;
const pageTitle = `${lawSiteConfig.targetLabels.funding}${current > 1 ? ` (Seite ${current} von ${pageCount})` : ''}`;
---

<LawLayout
  title={pageTitle}
  description="Förderrichtlinien des Ostdeutschen Freistaates nach den amtlichen Förderbereichen."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: lawSiteConfig.targetLabels.funding, href: basePath }]}
  canonical={pageUrl(basePath, { ...filterParams, seite: current })}
  noindex={active}
  prev={pagination.prev}
  next={pagination.next}
>
  <header class="r-page-head">
    <p class="r-kicker"><span>Normtyp</span><span>{lawSiteConfig.targetLabels.funding}</span></p>
    <h1>{lawSiteConfig.targetLabels.funding}</h1>
    <p class="r-lead">{formatCount(all.length, FUNDING_UNIT.one, FUNDING_UNIT.many)}, davon {inForce} in Kraft. Die Gliederung folgt den amtlichen Förderbereichen {lawFundingAreas[0]?.number}–{lawFundingAreas[lawFundingAreas.length - 1]?.number}; jeder Abschnitt führt zu den Richtlinien dieses Bereichs.</p>
    <nav class="r-subjects__jump r-meta" aria-label="Förderbereiche">
      {areas.map((area) => {
        const areaCount = countsByArea.get(area.number) ?? 0;
        return areaCount > 0 ? <a href={`#${area.id}`} data-funding-link={area.number}>{area.number === WITHOUT_AREA ? area.title : `${area.number} ${area.title}`} <span class="r-muted">{areaCount}</span></a> : null;
      })}
    </nav>
  </header>

  <div class="r-directory">
    <div class="r-directory__main">
      <FilterForm action={basePath} label="Förderrichtlinien filtern" active={active} resetHref={basePath} count={count} layout="row">
        <label class="r-field"><span>Titel, Abkürzung oder Stichwort</span><input class="r-input" type="search" name="q" value={state.q} autocomplete="off" maxlength="200" placeholder="z. B. Schulhausbau" /></label>
        <label class="r-field"><span>Förderbereich</span><select class="r-select" name="bereich"><option value="" selected={!state.bereich}>Alle Förderbereiche</option>{areas.map((area) => <option value={area.number} selected={area.number === state.bereich}>{area.number === WITHOUT_AREA ? area.title : `${area.number} ${area.title}`}</option>)}</select></label>
        <label class="r-field"><span>{VALIDITY_FIELD_LABEL}</span><select class="r-select" name="status"><option value="" selected={!state.status}>{lawSiteConfig.vocabulary.validity.any}</option>{statusOptions.map((option) => <option value={option.value} selected={option.value === state.status}>{option.label}</option>)}</select></label>
        <label class="r-field"><span>Rechtsherkunft</span><select class="r-select" name="origin"><option value="" selected={!state.origin}>Alle Herkunftsarten</option>{NORM_ORIGIN_KINDS.map((kind) => <option value={kind} selected={kind === state.origin}>{formatNormOriginKind(kind)}</option>)}</select></label>
      </FilterForm>

      {visibleAreas.length > 0 ? visibleAreas.map((area) => {
        const rows = entriesOf(area.number);
        const areaCount = countsByArea.get(area.number) ?? 0;
        const label = area.number === WITHOUT_AREA ? area.title : `${area.number} ${area.title}`;
        return (
          <section class="r-funding-area" id={area.id} aria-labelledby={`${area.id}-heading`} data-directory data-funding-section={area.number}>
            <div class="r-section-head">
              <h2 id={`${area.id}-heading`} class="r-h2 r-h2--sub">{label}</h2>
              <span class="r-meta">{formatCount(areaCount, FUNDING_UNIT.one, FUNDING_UNIT.many)}{!state.bereich && areaCount > rows.length ? <> · <a href={pageUrl(basePath, { ...filterParams, bereich: area.number })}>alle anzeigen</a></> : null}</span>
            </div>
            <NormTable items={rows} showType={false} caption={`Förderrichtlinien im Förderbereich ${label}`} attrs={{ 'data-directory-list': '' }} />
          </section>
        );
      }) : (
        <p class="r-note" data-directory-empty>Passen Sie die Filter an oder <a href={basePath}>setzen Sie die Auswahl zurück</a>.</p>
      )}
      {state.bereich ? <Pagination pagination={pagination} label="Seiten des Förderbereichs" range={total > 0 ? `${firstIndex}–${lastIndex} von ${total}` : undefined} attrs={{ 'data-directory-pagination': '' }} /> : null}
    </div>
  </div>
</LawLayout>
