---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import {
  formatDate,
  getFundingUrl,
  getLawPortalUrl,
  getNormUrl,
  getSubjectUrl,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { groupSummariesBySubject } from '../../lib/runtime/overview.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

const fundingNorms = await store.listNormSummariesByType('foerderrichtlinie');
const subjectGroups = groupSummariesBySubject(fundingNorms);
const latestFunding = [...fundingNorms]
  .sort((left, right) => right.currentValidFrom.localeCompare(left.currentValidFrom))
  .slice(0, 4);
---

<LawLayout
  title="Förderrichtlinien"
  description="Systematischer Einstieg zu Förderrichtlinien im Rechtsbereich des Freistaates Ostdeutschland."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Förderrichtlinien', href: getFundingUrl() },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Förderrichtlinien' },
    ]}
  />

  <SectionHero
    eyebrow="OstRecht"
    title="Förderrichtlinien"
    lead="Dieser Einstieg bündelt die veröffentlichten Förderrichtlinien und ordnet sie nach Sachgebieten."
    variant="law"
    facts={[{ label: 'Im Normenbestand', value: String(fundingNorms.length) }]}
  />

  {latestFunding.length > 0 ? (
    <section class="section section-muted">
      <div class="section-header">
        <h2>Aktuelle Förderrichtlinien</h2>
        <p>Die zuletzt in Kraft getretenen Förderrichtlinien im Überblick.</p>
      </div>
      <div class="card-grid">
        {latestFunding.map((norm) => (
            <article class="panel">
              <h3><a class="inline-link" href={getNormUrl(norm.slug)}>{toDisplayText(norm.shortTitle)}</a></h3>
              <p>{toDisplayText(norm.summary)}</p>
              <p class="detail-line">Gültig seit <time datetime={norm.currentValidFrom}>{formatDate(norm.currentValidFrom)}</time>{norm.responsibleMinistry ? ` · ${toDisplayText(norm.responsibleMinistry)}` : ''}</p>
            </article>
        ))}
      </div>
    </section>
  ) : null}

  <section class="section">
    <div class="section-header">
      <h2>Systematische Liste</h2>
      <p>Die Zuordnung folgt den vorhandenen Sachgebieten der veröffentlichten Richtlinien.</p>
    </div>
    {subjectGroups.length > 0 ? (
      <div class="content-grid content-grid--wide">
        {subjectGroups.map((group) => (
          <section class="panel">
            <h3><a class="inline-link" href={getSubjectUrl(group.name)}>{toDisplayText(group.name)}</a></h3>
            <ul class="record-list">
              {group.norms.map((norm) => (
                <li class="record-list__item">
                  <a class="inline-link" href={getNormUrl(norm.slug)}>{toDisplayText(norm.shortTitle)}</a>
                  {norm.responsibleMinistry ? <span>{toDisplayText(norm.responsibleMinistry)}</span> : null}
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <article class="panel">
        <h2>Keine Förderrichtlinien veröffentlicht</h2>
        <p>Im aktuellen Normenbestand sind noch keine Förderrichtlinien erfasst.</p>
      </article>
    )}
  </section>
</LawLayout>
