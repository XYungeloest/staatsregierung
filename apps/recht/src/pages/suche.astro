---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../layouts/LawLayout.astro';
import SearchCheckboxGroup from '../components/norms/SearchCheckboxGroup.astro';
import {
  getIndexUrl,
  getLawPortalUrl,
  getSearchUrl,
  getSubjectsUrl,
  type NormStatus,
} from '@ostrecht/shared/lib/norms/index.ts';
import { formatSubjectLabel } from '@ostrecht/shared/config/law-subjects.ts';
import { getNormStore } from '../lib/runtime/context.ts';
import { VALIDITY_FIELD_LABEL, VERSION_FIELD_LABEL, VERSION_SCOPE_OPTIONS, validityLabel } from '../lib/vocabulary.ts';

// Die Suchseite ist eine statische Hülle (P2/P2b); Treffer liefert zur Laufzeit /api/suche.json aus D1.
const store = await getNormStore(Astro.locals);
const [{ filters, documentCount }, searchPublications] = await Promise.all([
  store.getSearchFilters(),
  store.listSearchPublications(),
]);
filters.publications = [...new Set(searchPublications.map((publication) => publication.publication))].sort((left, right) => left.localeCompare(right, 'de'));
filters.years = [...new Set(searchPublications.map((publication) => publication.year))].sort((left, right) => right.localeCompare(left));
const searchApiUrl = `${import.meta.env.BASE_URL}api/suche.json`;
const statusOptions = filters.statuses.map((option) => ({ value: option.value, label: validityLabel(option.value as NormStatus) }));
const subjectOptions = filters.subjects.map((option) => ({ value: option, label: formatSubjectLabel(option, { withNumber: true, short: true }) }));
const sortOptions = [
  { value: 'relevance', label: 'Relevanz' },
  { value: 'title', label: 'Titel A–Z' },
  { value: 'activity', label: 'Neueste Rechtsänderung' },
  { value: 'rechtsstand', label: 'Neuester Rechtsstand' },
  { value: 'publication', label: 'Neueste Verkündung' },
];
---

<LawLayout
  title={lawSiteConfig.targetLabels.search}
  description="Suche im Landesrecht des Ostdeutschen Freistaates: Titel, Abkürzungen, Fundstellen, Metadaten und Vorschriftentexte."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: lawSiteConfig.targetLabels.search, href: getSearchUrl() }]}
  noindex={true}
>
  <section class="r-search" aria-labelledby="search-form-title" data-search-root data-search-api={searchApiUrl} data-index-url={getIndexUrl()} data-subjects-url={getSubjectsUrl()}>
    <h2 class="visually-hidden" id="search-form-title">Suchanfrage und Filter</h2>

    <form class="r-search__form" action={getSearchUrl()} method="get" data-search-form>
      <div class="r-search__layout">
        <div class="r-search__main">
          <h1 class="r-search__title">Suche im Landesrecht</h1>
          <div class="r-search__bar">
            <label class="r-search__query">
              <span class="visually-hidden">Suchbegriff</span>
              <input class="r-input r-input--lg" type="search" name="q" autocomplete="off" placeholder="Gesetz, Verordnung, Abkürzung, Paragraph oder Fundstelle" data-search-query />
            </label>
            <label class="r-field r-search__scope">
              <span>Suchbereich</span>
              <select class="r-select r-select--lg" name="scope" data-search-filter="scope">
                <option value="all">Alle Inhalte</option>
                <option value="title">Titel und Abkürzung</option>
                <option value="metadata">Metadaten und Fundstellen</option>
                <option value="body">Normtext</option>
              </select>
            </label>
            <button class="r-btn r-btn--primary r-btn--lg" type="submit">Suchen</button>
          </div>

          <div class="r-search__active" data-search-active-filters hidden>
            <span class="r-strong">Aktive Filter</span>
            <div class="r-search__active-list" data-search-active-list></div>
            <button class="r-link-btn" type="button" data-search-clear-filters>Alle Filter löschen</button>
          </div>

          <details class="r-search__advanced" id="erweiterte-suche" data-search-filter-panel="more" data-search-advanced>
            <summary><span>Weitere Filter · Erweiterte Suche</span><span class="r-muted" data-search-panel-count></span></summary>
            <div class="r-search__advanced-grid" aria-label="Erweiterte Suche">
              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Textsuche</legend>
                <div class="r-fieldset__body">
                  <label class="r-field"><span>Exakte Wortfolge</span><input class="r-input" type="search" name="exact" autocomplete="off" placeholder="„schriftlichen und einem mündlichen Teil“" data-search-filter="exact" /></label>
                  <label class="r-field"><span>Enthält nicht</span><input class="r-input" type="search" name="exclude" autocomplete="off" placeholder="z. B. Hochschule" data-search-filter="exclude" /></label>
                  <label class="r-check"><input type="checkbox" name="includeAmendments" value="1" data-search-filter="includeAmendments" /><span>Änderungsvorschriften vollständig einbeziehen</span></label>
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Norm und Zuständigkeit</legend>
                <div class="r-fieldset__body">
                  <SearchCheckboxGroup legend="Ressort" name="ministry" facet="ministry" options={filters.ministries.map((option) => ({ value: option, label: option }))} />
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Rechtsherkunft</legend>
                <div class="r-fieldset__body">
                  <SearchCheckboxGroup legend="Rechtsherkunft" name="origin" facet="origin" options={filters.origins} />
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>{VERSION_FIELD_LABEL}</legend>
                <div class="r-fieldset__body">
                  <label class="r-field"><span class="visually-hidden">{VERSION_FIELD_LABEL}</span>
                    <select class="r-select" name="versionScope" data-search-filter="versionScope">
                      {VERSION_SCOPE_OPTIONS.map((option) => <option value={option.value} selected={option.value === 'current'}>{option.label}</option>)}
                    </select>
                  </label>
                  <p class="r-caption">Historische Fassungen erscheinen als Fassungen ihrer Vorschrift, nicht als eigene Vorschriften.</p>
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Zeit</legend>
                <div class="r-fieldset__body">
                  <label class="r-field"><span>Geltungstag</span><input class="r-input" type="date" name="geltungstag" data-search-filter="geltungstag" /></label>
                  <div class="r-search__pair">
                    <label class="r-field"><span>Gültig ab</span><input class="r-input" type="date" name="validFrom" data-search-filter="validFrom" /></label>
                    <label class="r-field"><span>Gültig bis</span><input class="r-input" type="date" name="validTo" data-search-filter="validTo" /></label>
                  </div>
                  <p class="r-caption">Der Geltungstag wirkt nur auf diese Suchanfrage.</p>
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Fundstelle</legend>
                <div class="r-fieldset__body">
                  <SearchCheckboxGroup legend="Verkündungsblatt" name="publicationSource" facet="publicationSource" options={filters.publications.map((option) => ({ value: option, label: option }))} />
                  <SearchCheckboxGroup legend="Jahr" name="publicationYear" facet="publicationYear" options={filters.years.map((option) => ({ value: option, label: option }))} />
                  <div class="r-search__pair">
                    <label class="r-field"><span>Nr.</span><input class="r-input" type="text" name="publicationIssue" inputmode="numeric" data-search-filter="publicationIssue" /></label>
                    <label class="r-field"><span>Seite</span><input class="r-input" type="text" name="publicationPage" inputmode="numeric" data-search-filter="publicationPage" /></label>
                  </div>
                  <label class="r-field"><span>Fundstelle (frei)</span><input class="r-input" type="search" name="citation" autocomplete="off" placeholder="z. B. OGVBl. 2026 Nr. 16" data-search-filter="citation" /></label>
                </div>
              </fieldset>

              <fieldset class="r-fieldset r-fieldset--caps">
                <legend>Speichern</legend>
                <div class="r-fieldset__body" data-copy-group>
                  <p class="r-caption">Die Suchanfrage liegt vollständig in der Adresse. Der Link lässt sich teilen und als Lesezeichen sichern.</p>
                  <button class="r-btn r-btn--block" type="button" data-copy-url data-copy-keep-query="true" data-copy-done="Link zur Suchanfrage wurde kopiert.">Link zur Suchanfrage kopieren</button>
                  <p class="r-feedback" aria-live="polite" data-copy-feedback></p>
                </div>
              </fieldset>

              <div class="r-search__advanced-actions">
                <button class="r-btn r-btn--primary" type="submit">Filter anwenden</button>
                <button class="r-btn" type="button" data-search-clear-filters>Zurücksetzen</button>
                <span class="r-caption">Abweichungen vom Standard erscheinen über der Trefferliste als aktive Filter.</span>
              </div>
            </div>
          </details>

          <div class="r-search__results-head">
            <p class="r-meta" aria-live="polite" data-search-summary>Treffer werden geladen.</p>
            <label class="r-field r-search__sort">
              <span>Sortierung</span>
              <select class="r-select" name="sort" data-search-filter="sort">
                {sortOptions.map((option) => <option value={option.value}>{option.label}</option>)}
              </select>
            </label>
          </div>
          <div class="r-search__results" data-search-results></div>
          <div class="r-search__more">
            <button class="r-btn" type="button" data-search-more hidden>Weitere Treffer laden</button>
          </div>
        </div>

        <aside class="r-search__aside" aria-label="Suchfilter">
          <details class="r-search__filters" data-search-filters open>
            <summary class="r-search__filters-summary"><span class="r-label">Eingrenzen</span></summary>
            <div class="r-search__filters-body">
              <div class="r-search__filters-head">
                <h2 class="r-label">Eingrenzen</h2>
                <a class="r-caption" href={getSearchUrl()} data-search-reset-link>Zurücksetzen</a>
              </div>
              <SearchCheckboxGroup legend={VALIDITY_FIELD_LABEL} name="status" facet="status" options={statusOptions} />
              <SearchCheckboxGroup legend="Normtyp" name="type" facet="type" options={filters.types} />
              <SearchCheckboxGroup legend="Sachgebiet" name="subject" facet="subject" options={subjectOptions} />
              <div class="r-search__more-filters">
                <a href="#erweiterte-suche" data-search-open-advanced>Weitere Filter · Erweiterte Suche</a>
                <p class="r-caption">Exakte Wortfolge, Ausschluss, Ressort, Rechtsherkunft, Fassungsbereich, Geltungstag, Fundstelle, Änderungsvorschriften.</p>
              </div>
            </div>
          </details>
          <div class="r-box r-box--muted r-search__tips">
            <h2 class="r-label">Suchhinweise</h2>
            <ul class="r-search__tips-list">
              <li>„…“ sucht die exakte Wortgruppe.</li>
              <li>schul* findet Wortanfänge.</li>
              <li>Abkürzungen, Fundstellen (OGVBl. 2026 Nr. 16) und Normadressen (§ 12) führen direkt zum Ziel.</li>
              <li>Der Bestand umfasst {documentCount} Fassungen.</li>
            </ul>
          </div>
        </aside>
      </div>
    </form>

    <noscript>
      <p class="r-note">Für die freie Volltextsuche wird JavaScript benötigt. Die alphabetischen und systematischen Einstiege (<a href={getIndexUrl()}>A–Z und Register</a>, <a href={getSubjectsUrl()}>Sachgebiete</a>) bleiben erreichbar.</p>
    </noscript>
  </section>
  <script>import '../scripts/search-page.ts';</script>
</LawLayout>
