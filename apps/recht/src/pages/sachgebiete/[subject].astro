---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import {
  formatNormType,
  getLawPortalUrl,
  getSearchUrl,
  getNormUrl,
  getSubjectsUrl,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../../lib/runtime/context.ts';

// Sachgebietsseiten werden zur Laufzeit aus der D1-Projektion aufgebaut.
export const prerender = false;

const store = await getNormStore(Astro.locals);
// Sachgebiet und Hauptbereich aus den Metadatenzeilen, die Normen des Sachgebiets per SQL-Filter.
const subjectSlug = Astro.params.subject ?? '';
const [subjects, areaGroups] = await Promise.all([store.listSubjectSummaries(), store.listSubjectAreas()]);
const subject = subjects.find((entry) => entry.slug === subjectSlug);
if (!subject) return Astro.rewrite('/404');
const group = { name: subject.name, slug: subject.slug, norms: await store.listNormSummaries({ subjectSlug }) };
const area = areaGroups.find((entry) => entry.subjects.some((entry) => entry.slug === group.slug));
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const typeCounts = [...group.norms.reduce((map: Map<string, number>, norm) => {
  map.set(norm.type, (map.get(norm.type) ?? 0) + 1);
  return map;
}, new Map<string, number>()).entries()].sort(([left], [right]) => left.localeCompare(right, 'de'));
---

<LawLayout
  title={`Sachgebiet ${toDisplayText(group.name)}`}
  description={`Sachgebiet ${toDisplayText(group.name)} im Rechtsbereich des Freistaates Ostdeutschland.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Sachgebiete', href: getSubjectsUrl() },
    { label: toDisplayText(group.name) },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Sachgebiete', href: getSubjectsUrl() },
      { label: toDisplayText(group.name) },
    ]}
  />

  <SectionHero
    eyebrow="Sachgebiet"
    title={toDisplayText(group.name)}
    lead={`Diesem Sachgebiet sind aktuell ${group.norms.length} Normen zugeordnet.${area ? ` Es gehört zum Bereich ${area.name}.` : ''}`}
    variant="law"
    facts={[{ label: 'Vorschriften', value: String(group.norms.length) }]}
    actions={[
      { label: 'Sachgebiet durchsuchen', href: `${getSearchUrl()}?subject=${encodeURIComponent(group.name)}`, primary: true },
      { label: 'Alle Sachgebiete', href: getSubjectsUrl() },
    ]}
  />

  <section class="law-subject-overview" aria-labelledby="subject-overview-title">
    <div class="law-subject-overview__intro">
      <span class="section-eyebrow">Bestand im Überblick</span>
      <h2 id="subject-overview-title">Recht in diesem Sachgebiet</h2>
      <p>Die Vorschriften sind nach ihrem geltenden Titel erschlossen und führen direkt zum aktuellen Rechtsstand.</p>
    </div>
    <dl class="law-subject-stats">
      <div class="law-subject-stats__total">
        <dt>Vorschriften insgesamt</dt>
        <dd>{group.norms.length}</dd>
      </div>
      {typeCounts.map(([type, count]) => (
        <div>
          <dt>{formatNormType(type as NormType)}</dt>
          <dd>{count}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section class="law-subject-records">
    <div class="law-subject-records__header">
      <div>
        <span class="section-eyebrow">Zugeordnete Rechtsgrundlagen</span>
        <h2>Vorschriften</h2>
        <p>Aktuelle und gespeicherte Normen mit fachlicher Zuständigkeit.</p>
      </div>
      <a class="button button--secondary" href={`${getSearchUrl()}?subject=${encodeURIComponent(group.name)}`}>Ergebnisse filtern</a>
    </div>
    <ul class="law-subject-record-list">
      {group.norms.map((norm) => (
        <li>
          <div class="law-subject-record-list__type">
            <span>{formatNormType(norm.type)}</span>
            {norm.abbr ? <strong>{toDisplayText(norm.abbr)}</strong> : null}
          </div>
          <div class="law-subject-record-list__content">
            <a href={getNormUrl(norm.slug)}>{toDisplayText(norm.title)}</a>
            <span>{toDisplayText(norm.responsibleMinistry)}</span>
          </div>
          <span class="law-subject-record-list__arrow" aria-hidden="true">→</span>
        </li>
      ))}
    </ul>
  </section>
</LawLayout>
