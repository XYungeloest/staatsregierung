---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../../layouts/LawLayout.astro';
import NormDirectoryListing from '../../components/directory/NormDirectoryListing.astro';
import {
  formatNormType,
  getLawPortalUrl,
  getSearchUrl,
  getSubjectSlug,
  getSubjectUrl,
  getSubjectsUrl,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { loadNormDirectory } from '../../lib/runtime/directory.ts';
import { formatNormCount } from '../../lib/counts.ts';

// Sachgebietsseite (P6b): Kopf mit amtlicher Nummer, links die Untergliederung der Hauptgruppe
// und die Filter, rechts die Vorschriften im Listenmuster von P6.
export const prerender = false;

const store = await getNormStore(Astro.locals);
const subjectSlug = Astro.params.subject ?? '';
const [subjects, areaGroups, { filters }] = await Promise.all([store.listSubjectSummaries(), store.listSubjectAreas(), store.getSearchFilters()]);
const subject = subjects.find((entry) => entry.slug === subjectSlug);
if (!subject) return Astro.rewrite('/404');
const area = areaGroups.find((entry) => entry.subjects.some((entry) => entry.slug === subject.slug));
const basePath = getSubjectsUrl() + `${subject.slug}/`;
const view = await loadNormDirectory(store, {
  basePath,
  scope: { subjectSlug: subject.slug },
  searchParams: Astro.url.searchParams,
  fields: ['q', 'type', 'status', 'origin', 'aenderungen'],
  filterOptions: { types: filters.types },
});
// Verteilung nach Normtyp und Geltung aus der Grundmenge des Sachgebiets (Übersichtszeilen).
const summaries = await store.listNormSummaries({ subjectSlug: subject.slug });
const typeCounts = summaries.reduce((map: Map<string, number>, norm) => map.set(norm.type, (map.get(norm.type) ?? 0) + 1), new Map<string, number>());
const typeRows = [...typeCounts.entries()].sort(([left], [right]) => formatNormType(left as NormType).localeCompare(formatNormType(right as NormType), 'de'));
const inForce = summaries.filter((norm) => norm.status === 'in-force').length;
const ministries = summaries.reduce((map: Map<string, number>, norm) => norm.responsibleMinistry ? map.set(norm.responsibleMinistry, (map.get(norm.responsibleMinistry) ?? 0) + 1) : map, new Map<string, number>());
const leadMinistry = [...ministries.entries()].sort((left, right) => right[1] - left[1])[0]?.[0];
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const title = toDisplayText(subject.name);
const pageTitle = view.result.page > 1 ? `Sachgebiet ${title} (Seite ${view.result.page} von ${view.result.pageCount})` : `Sachgebiet ${title}`;
const siblings = area?.subjects ?? [];
const neighbours = siblings.filter((entry) => entry.slug !== subject.slug).slice(0, 3);
---

<LawLayout
  title={pageTitle}
  description={`Sachgebiet ${subject.number ? `${subject.number} ` : ''}${title} im Rechtsbereich des Freistaates Ostdeutschland: Vorschriften nach Titel, Normtyp, Geltung und Herkunft.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: lawSiteConfig.targetLabels.subjects, href: getSubjectsUrl() },
    { label: title },
  ]}
  canonical={view.canonical}
  noindex={view.noindex}
  prev={view.pagination.prev}
  next={view.pagination.next}
  activeSection="subjects"
>
  <header class="r-page-head r-subject__head" data-copy-group>
    <p class="r-kicker">
      <span>Sachgebiet</span>
      <a href={getSubjectsUrl()}>{lawSiteConfig.targetLabels.subjects}</a>
      {area ? <a href={`${getSubjectsUrl()}#subject-area-${getSubjectSlug(area.name)}`}>{area.number ? `${area.number} ` : ''}{area.name}</a> : null}
      {subject.number ? <span>{subject.number}</span> : null}
    </p>
    <h1 class="r-subject__title">{subject.number ? <span class="r-subject__number">{subject.number}</span> : null}<span class="r-subject__name">{title}</span></h1>
    <div class="r-subject__meta r-meta">
      <span><strong class="r-strong">{formatNormCount(inForce)}</strong> in Kraft</span>
      {summaries.length - inForce > 0 ? <span>{summaries.length - inForce} künftig in Kraft oder außer Kraft</span> : null}
      {leadMinistry ? <span>Zuständig überwiegend: {toDisplayText(leadMinistry)}</span> : null}
      <span>Amtliche Systematik</span>
      <span class="r-subject__links r-inline-list"><a href={`${getSearchUrl()}?subject=${encodeURIComponent(subject.name)}`}>Suche in diesem Sachgebiet</a><button class="r-link-btn" type="button" data-copy-url data-copy-done="Link zum Sachgebiet wurde kopiert.">Link kopieren</button><span class="r-feedback" aria-live="polite" data-copy-feedback></span></span>
    </div>
  </header>

  <NormDirectoryListing view={view} heading="Vorschriften" filterLabel="Vorschriften des Sachgebiets filtern" filterLayout="aside" caption={`Vorschriften des Sachgebiets ${title}`}>
    <Fragment slot="aside-top">
      {area && siblings.length > 0 ? (
        <nav class="r-subject__siblings" aria-label="Untergliederung">
          <span class="r-label">Sachgebiete der Hauptgruppe {area.number ?? ''}</span>
          <ol class="r-num">
            {siblings.map((entry) => (
              <li>
                <a href={getSubjectUrl(entry.name)} aria-current={entry.slug === subject.slug ? 'page' : undefined}>
                  <span class="r-muted">{entry.number ?? ''}</span>
                  <span>{toDisplayText(entry.shortTitle ?? entry.name)}</span>
                  <span class="r-muted">{entry.normCount}</span>
                </a>
              </li>
            ))}
          </ol>
        </nav>
      ) : null}
      {typeRows.length > 1 ? (
        <dl class="r-subject__types r-dl r-dl--compact">
          {typeRows.map(([type, count]) => <><dt>{formatNormType(type as NormType)}</dt><dd class="r-num">{count}</dd></>)}
        </dl>
      ) : null}
    </Fragment>
    <Fragment slot="aside-bottom">
      {neighbours.length > 0 ? (
        <p class="r-caption r-subject__neighbours r-inline-list"><span>Benachbart:</span>{neighbours.map((entry) => <a href={getSubjectUrl(entry.name)}>{entry.number ? `${entry.number} ` : ''}{toDisplayText(entry.shortTitle ?? entry.name)}</a>)}</p>
      ) : null}
    </Fragment>
  </NormDirectoryListing>
</LawLayout>
