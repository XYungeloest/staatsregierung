---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import NormDirectoryListing from '../../components/directory/NormDirectoryListing.astro';
import {
  formatNormType,
  getLawPortalUrl,
  getSearchUrl,
  getSubjectsUrl,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import type { NormType } from '@ostrecht/shared/lib/norms/schema.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { loadNormDirectory } from '../../lib/runtime/directory.ts';

// Sachgebietsseiten werden zur Laufzeit aus der D1-Projektion aufgebaut: Kopf und Verteilung
// aus Metadatenzeilen, die Vorschriften seitenweise über das gemeinsame Verzeichnismuster.
export const prerender = false;

const store = await getNormStore(Astro.locals);
const subjectSlug = Astro.params.subject ?? '';
const [subjects, areaGroups, { filters }] = await Promise.all([store.listSubjectSummaries(), store.listSubjectAreas(), store.getSearchFilters()]);
const subject = subjects.find((entry) => entry.slug === subjectSlug);
if (!subject) return Astro.rewrite('/404');
const area = areaGroups.find((entry) => entry.subjects.some((entry) => entry.slug === subject.slug));
const basePath = getSubjectsUrl() + `${subject.slug}/`;
const view = await loadNormDirectory(store, {
  basePath,
  scope: { subjectSlug: subject.slug },
  searchParams: Astro.url.searchParams,
  fields: ['q', 'type', 'status', 'origin'],
  filterOptions: { types: filters.types },
});
// Verteilung nach Normtyp aus den Buchstabenzählern des Sachgebiets ist nicht ableitbar; sie
// kommt aus der Sachgebietsübersicht, die nur Zähler trägt – ohne den Bestand zu laden.
const typeCounts = (await store.listNormSummaries({ subjectSlug: subject.slug }))
  .reduce((map: Map<string, number>, norm) => map.set(norm.type, (map.get(norm.type) ?? 0) + 1), new Map<string, number>());
const typeRows = [...typeCounts.entries()].sort(([left], [right]) => formatNormType(left as NormType).localeCompare(formatNormType(right as NormType), 'de'));
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const title = toDisplayText(subject.name);
// Eyebrow und Einleitung nennen die amtliche Gliederungsnummer und die Hauptgruppe.
const eyebrow = subject.number ? `Sachgebiet ${subject.number}` : 'Sachgebiet';
const areaLead = area ? ` Es gehört zur Hauptgruppe ${area.number ? `${area.number} ` : ''}${area.name}.` : '';
const pageTitle = view.result.page > 1 ? `Sachgebiet ${title} (Seite ${view.result.page} von ${view.result.pageCount})` : `Sachgebiet ${title}`;
---

<LawLayout
  title={pageTitle}
  description={`Sachgebiet ${title} im Rechtsbereich des Freistaates Ostdeutschland.`}
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Sachgebiete', href: getSubjectsUrl() },
    { label: title },
  ]}
  canonical={view.canonical}
  noindex={view.noindex}
  prev={view.pagination.prev}
  next={view.pagination.next}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Sachgebiete', href: getSubjectsUrl() },
      { label: title },
    ]}
  />

  <SectionHero
    eyebrow={eyebrow}
    title={title}
    lead={`Vorschriften dieses Sachgebiets nach Titel, Normtyp, Rechtsstand und Herkunft.${areaLead}`}
    variant="law"
    actions={[
      { label: 'Sachgebiet durchsuchen', href: `${getSearchUrl()}?subject=${encodeURIComponent(subject.name)}`, primary: true },
      { label: 'Alle Sachgebiete', href: getSubjectsUrl() },
    ]}
  />

  {typeRows.length > 1 ? (
    <section class="law-subject-overview" aria-labelledby="subject-overview-title">
      <div class="law-subject-overview__intro">
        <span class="section-eyebrow">Verteilung</span>
        <h2 id="subject-overview-title">Normtypen in diesem Sachgebiet</h2>
        <p>Die Vorschriften sind nach ihrem geltenden Titel erschlossen und führen direkt zum aktuellen Rechtsstand.</p>
      </div>
      <dl class="law-subject-stats">
        {typeRows.map(([type, count]) => (
          <div>
            <dt>{formatNormType(type as NormType)}</dt>
            <dd>{count}</dd>
          </div>
        ))}
      </dl>
    </section>
  ) : null}

  <NormDirectoryListing view={view} heading="Vorschriften" filterLabel="Vorschriften des Sachgebiets filtern" />
</LawLayout>
