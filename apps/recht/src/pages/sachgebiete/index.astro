---
import { lawSiteConfig } from '@ostrecht/shared/config/site.ts';
import LawLayout from '../../layouts/LawLayout.astro';
import { getLawPortalUrl, getSubjectUrl, getSubjectSlug, getSubjectsUrl, toDisplayText } from '@ostrecht/shared/lib/norms/index.ts';
import { lawSubjectGroups } from '@ostrecht/shared/config/law-subjects.ts';
import { getNormStore } from '../../lib/runtime/context.ts';
import { formatNormCount } from '../../lib/counts.ts';

// Sachgebiete: die amtliche zweistufige Systematik als Listen je Hauptgruppe (Grammatik von P6).
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');
const [groups, areaGroups, stats] = await Promise.all([store.listSubjectSummaries(), store.listSubjectAreas(), store.getCorpusStats()]);
---

<LawLayout
  title={lawSiteConfig.targetLabels.subjects}
  description="Vorschriften des Freistaates Ostdeutschland nach der amtlichen Sachgebietssystematik: Hauptgruppen und nummerierte Sachgebiete."
  breadcrumbs={[{ label: 'OstRecht', href: getLawPortalUrl() }, { label: lawSiteConfig.targetLabels.subjects, href: getSubjectsUrl() }]}
>
  <header class="r-page-head">
    <h1>{lawSiteConfig.targetLabels.subjects}</h1>
    <p class="r-lead">Vorschriften nach der amtlichen Sachgebietsgliederung: {lawSubjectGroups.length} Hauptgruppen mit ihren nummerierten Sachgebieten. Die erste Stelle nennt die Hauptgruppe, beide Stellen zusammen das Sachgebiet. {groups.length} Sachgebiete sind mit Vorschriften belegt; {formatNormCount(stats.normCount)} im Bestand, davon {stats.inForceCount} in Kraft.</p>
    <nav class="r-subjects__jump r-meta" aria-label="Hauptgruppen">
      {areaGroups.map((area) => <a href={`#subject-area-${getSubjectSlug(area.name)}`}>{area.number ? `${area.number} ` : ''}{area.name}</a>)}
    </nav>
  </header>

  <div class="r-subjects">
    {areaGroups.map((area) => (
      <section class="r-subjects__area" id={`subject-area-${getSubjectSlug(area.name)}`} aria-labelledby={`subject-area-title-${getSubjectSlug(area.name)}`}>
        <div class="r-subjects__area-head">
          <h2 id={`subject-area-title-${getSubjectSlug(area.name)}`}>{area.number ? <span class="r-subjects__number">{area.number}</span> : null}{area.name}</h2>
          <p class="r-meta">{area.description} · {formatNormCount(area.normCount)}</p>
        </div>
        <table class="r-table r-subjects__table">
          <caption class="visually-hidden">Sachgebiete der Hauptgruppe {area.name} mit Nummer und Zahl der Vorschriften</caption>
          <tbody>
            {area.subjects.map((group) => (
              <tr data-directory-entry>
                <td class="r-muted r-nowrap r-num">{group.number ?? ''}</td>
                <td><a href={getSubjectUrl(group.name)}>{toDisplayText(group.name)}</a></td>
                <td class="r-right r-muted r-num">{group.normCount}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </section>
    ))}
  </div>
</LawLayout>
