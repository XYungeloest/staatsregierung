---
import LawLayout from '../../layouts/LawLayout.astro';
import Breadcrumbs from '@ostrecht/shared/components/Breadcrumbs.astro';
import SectionHero from '@ostrecht/shared/components/portal/SectionHero.astro';
import DirectoryEntry from '../../components/directory/DirectoryEntry.astro';
import {
  getLawPortalUrl,
  getSubjectUrl,
  getSubjectSlug,
  toDisplayText,
} from '@ostrecht/shared/lib/norms/index.ts';
import { lawSubjectGroups } from '@ostrecht/shared/config/law-subjects.ts';
import { getNormStore } from '../../lib/runtime/context.ts';

// Übersichten lesen den Bestand zur Laufzeit aus der D1-Projektion.
export const prerender = false;

const store = await getNormStore(Astro.locals);
Astro.response.headers.set('Cache-Control', 'public, max-age=300, s-maxage=3600');

// Sachgebiete, Hauptgruppen und Bestandszahlen sind vorberechnete Metadatenzeilen.
const [groups, areaGroups, stats] = await Promise.all([store.listSubjectSummaries(), store.listSubjectAreas(), store.getCorpusStats()]);
---

<LawLayout
  title="Sachgebiete"
  description="Sachgebietsübersicht des Rechtsbereichs mit thematischem Zugang zum Normenbestand."
  breadcrumbs={[
    { label: 'OstRecht', href: getLawPortalUrl() },
    { label: 'Sachgebiete', href: getLawPortalUrl() + 'sachgebiete/' },
  ]}
>
  <Breadcrumbs
    items={[
      { label: 'OstRecht', href: getLawPortalUrl() },
      { label: 'Sachgebiete' },
    ]}
  />

  <SectionHero
    eyebrow="Rechtsportal"
    title="Sachgebiete"
    lead="Vorschriften nach der amtlichen Sachgebietsgliederung recherchieren: acht Hauptgruppen mit ihren nummerierten Sachgebieten."
    variant="law"
    facts={[{ label: 'Hauptgruppen', value: String(lawSubjectGroups.length) }, { label: 'Vorschriften im Bestand', value: String(stats.normCount) }]}
  />

  <section class="section">
    <div class="section-header">
      <h2>Systematische Übersicht</h2>
      <p>Die Nummern sind die amtlichen Gliederungsnummern: die erste Stelle nennt die Hauptgruppe, beide Stellen zusammen das Sachgebiet. {groups.length} Sachgebiete sind mit Vorschriften belegt.</p>
    </div>
    {areaGroups.map((area) => (
      <section class="directory directory--area" id={`subject-area-${getSubjectSlug(area.name)}`} aria-labelledby={`subject-area-title-${getSubjectSlug(area.name)}`}>
        <h3 id={`subject-area-title-${getSubjectSlug(area.name)}`} class="directory__heading">{area.number ? `${area.number} ${area.name}` : area.name}</h3>
        <p class="directory__lead">{area.description}</p>
        <ol class="directory-list directory-list--grid">
          {area.subjects.map((group) => (
            <DirectoryEntry
              title={group.number ? `${group.number} ${toDisplayText(group.name)}` : toDisplayText(group.name)}
              href={getSubjectUrl(group.name)}
              compact
              facts={[{ label: 'Vorschriften', value: String(group.normCount) }]}
              attrs={{ 'data-directory-entry': '' }}
            />
          ))}
        </ol>
      </section>
    ))}
  </section>
</LawLayout>
